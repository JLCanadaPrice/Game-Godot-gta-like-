[gd_resource type="StandardMaterial3D" format=3]

; Gyrophare, temps ROUGE. Un materiau PAR ETAT, jamais par vehicule : c'est la condition pour que tous les gyrophares du jeu tiennent dans les memes appels de dessin.
;
; Couleur volontairement SOUS 1.0 : le tonemapper ACES delave les hautes lumieres, et un rouge
; pose a 1.0 ressort saumon (184,121,82 mesure) au lieu de rouge. Mesure, pas devine.
;
; Materiau UNIQUE de cet etat, partage par TOUS les vehicules du jeu. Une copie par vehicule ferait
; autant d'appels de dessin que de voitures, que rien ne pourrait regrouper (regression payee sur
; les mats de lampadaire, cf. LampPoleLayer).
;
; NON ECLAIRE, shading_mode = 0. Rappel du chiffre, paye trois fois sur ce projet :
; 0 = UNSHADED, 1 = PER_PIXEL, 2 = PER_VERTEX.
;
; Il habille les triangles d'optique EXTRAITS du maillage du modele (cf. VehicleLightParts) : c'est
; la geometrie du vehicule qui s'allume, rien n'est ajoute par-dessus.

[resource]
resource_name = "vehicle_gyro_rouge"
shading_mode = 0
albedo_color = Color(0.66, 0.015, 0.01, 1)
disable_receive_shadows = true
grow = true
grow_amount = 0.006
