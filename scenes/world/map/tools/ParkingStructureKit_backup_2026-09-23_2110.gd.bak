extends RefCounted

# PARKING À ÉTAGES (Business_ParkingStructure, pack EverythingLibrary) rendu praticable — chantier du 2026-09-21.
# Utilisé par DowntownBuildingsBake (3 exemplaires au centre-ville) et par PlacesBake (l'exemplaire de l'aéroport).
#
# Relevé sur les sommets du modèle avant d'écrire une ligne (repère du modèle : origine au niveau du sol, entrée
# côté +Z) :
#  - 5 plateaux praticables, dessus à 0,35 / 4,95 / 9,50 / 14,05 / 18,60 m. Chaque étage est UNE pièce de
#    28 triangles, dalle de 0,40 m et muret de rive de 1,93 m d'un seul tenant ; intérieur x -21,76..21,76,
#    z -9,75..9,80 ; le rez-de-chaussée (76 triangles) porte aussi la fondation, jusqu'à -2,43 m ;
#  - une rangée de 5 poteaux au milieu (z ±0,54 ; x = 0, ±10, ±16), des montants de façade, 4 tours d'angle pleines
#    et une tour arrière pleine ; au bout est (et ouest), deux montants découpent trois travées (z ±2,46..3,54) ;
#  - la « cage vitrée » est une tour (x ±5,52, z 7,48..11,87) que chaque plateau traverse : une pièce de 11 x 2,3 m
#    par niveau, fermée côté parking ; au rez-de-chaussée un passage de 7,7 m la traverse (l'entrée des voitures) ;
#  - les boîtiers des plafonniers sont dans base_072 ; light_006 ne contient que les cônes, écartés à la fusion
#    (BuildingModels.EXCLUS) ;
#  - enroulement des faces : convention de Godot (faces avant en sens horaire vues du côté de leur normale).

const MODELE := "Business_ParkingStructure"
const CLE := "el:" + MODELE


# Collision EXACTE du parking : les triangles du maillage fusionné — dalles, murets, poteaux, tours — au lieu de la
# boîte pleine qui en faisait un bloc sur lequel on ne marchait que sur le toit. Une collision de triangles n'a
# qu'un côté : chaque triangle est orienté comme Godot l'attend (enroulement horaire vu du côté de la normale de
# sommet), et l'on compte ceux qu'il a fallu retourner.
static func collision(mesh: Mesh) -> ConcavePolygonShape3D:
	var faces := PackedVector3Array()
	var retournes := 0
	for s in mesh.get_surface_count():
		var a := mesh.surface_get_arrays(s)
		var v: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
		var n: PackedVector3Array = a[Mesh.ARRAY_NORMAL]
		var idx: PackedInt32Array = a[Mesh.ARRAY_INDEX]
		for t in range(0, idx.size() - 2, 3):
			var p0 := v[idx[t]]
			var p1 := v[idx[t + 1]]
			var p2 := v[idx[t + 2]]
			var nn := n[idx[t]] + n[idx[t + 1]] + n[idx[t + 2]]
			if (p1 - p0).cross(p2 - p0).dot(nn) > 0.0:
				faces.append(p0)
				faces.append(p2)
				faces.append(p1)
				retournes += 1
			else:
				faces.append(p0)
				faces.append(p1)
				faces.append(p2)
	var forme := ConcavePolygonShape3D.new()
	forme.set_faces(faces)
	# Deux faces : le modèle a des cloisons SANS ÉPAISSEUR (la face intérieure de la tour vitrée, z = 7,48, est un
	# seul plan) ; d'un seul côté, on la traverserait depuis la pièce de l'escalier.
	forme.backface_collision = true
	forme.set_meta("triangles", faces.size() / 3)
	forme.set_meta("retournes", retournes)
	return forme


# Dessus des plateaux praticables, relevés sur le maillage : surfaces horizontales tournées vers le haut de plus de
# 500 m² à une même hauteur (le plancher de chaque niveau en fait 851).
static func planchers(mesh: Mesh) -> PackedFloat32Array:
	var aires := {}
	for s in mesh.get_surface_count():
		var a := mesh.surface_get_arrays(s)
		var v: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
		var n: PackedVector3Array = a[Mesh.ARRAY_NORMAL]
		var idx: PackedInt32Array = a[Mesh.ARRAY_INDEX]
		for t in range(0, idx.size() - 2, 3):
			var nn := (n[idx[t]] + n[idx[t + 1]] + n[idx[t + 2]]).normalized()
			if nn.y < 0.99:
				continue
			var p0 := v[idx[t]]
			var y := snappedf((p0.y + v[idx[t + 1]].y + v[idx[t + 2]].y) / 3.0, 0.01)
			aires[y] = float(aires.get(y, 0.0)) + (v[idx[t + 1]] - p0).cross(v[idx[t + 2]] - p0).length() * 0.5
	var out := PackedFloat32Array()
	for y in aires:
		if float(aires[y]) > 500.0:
			out.append(y)
	out.sort()
	return out


# --- géométrie : triangles à couleurs de sommet, dans le repère du modèle -------------------------------------------------

# Maillage modifiable : sommets, normales, couleurs, indices, au format du maillage fusionné de BuildingModels (une
# surface, couleurs de sommet, enroulement horaire vu de la normale).
class Maillage:
	var v := PackedVector3Array()
	var n := PackedVector3Array()
	var c := PackedColorArray()
	var i := PackedInt32Array()

	static func depuis(mesh: Mesh) -> Maillage:
		var m := Maillage.new()
		var a := mesh.surface_get_arrays(0)
		m.v = a[Mesh.ARRAY_VERTEX]
		m.n = a[Mesh.ARRAY_NORMAL]
		m.c = a[Mesh.ARRAY_COLOR] if a[Mesh.ARRAY_COLOR] != null else PackedColorArray()
		if m.c.is_empty():
			m.c.resize(m.v.size())
			m.c.fill(Color.WHITE)
		m.i = a[Mesh.ARRAY_INDEX]
		return m

	# Triangle orienté comme Godot l'attend (horaire vu du côté de `normale`).
	func tri(p0: Vector3, p1: Vector3, p2: Vector3, normale: Vector3, c0: Color, c1: Color, c2: Color) -> void:
		var base := v.size()
		var inverse := (p1 - p0).cross(p2 - p0).dot(normale) > 0.0
		v.append_array(PackedVector3Array([p0, p2, p1] if inverse else [p0, p1, p2]))
		c.append_array(PackedColorArray([c0, c2, c1] if inverse else [c0, c1, c2]))
		for k in 3:
			n.append(normale)
		i.append_array(PackedInt32Array([base, base + 1, base + 2]))

	func quad(a: Vector3, b: Vector3, cc: Vector3, d: Vector3, normale: Vector3, couleur: Color) -> void:
		tri(a, b, cc, normale, couleur, couleur, couleur)
		tri(a, cc, d, normale, couleur, couleur, couleur)

	# Boîte alignée sur les axes, faces tournées vers l'extérieur. `sans` : faces à omettre ("-y", "+x", ...).
	func boite(mn: Vector3, mx: Vector3, couleur: Color, sans: Array = []) -> void:
		var faces := {
			"+x": [Vector3(mx.x, mn.y, mn.z), Vector3(mx.x, mn.y, mx.z), Vector3(mx.x, mx.y, mx.z), Vector3(mx.x, mx.y, mn.z), Vector3.RIGHT],
			"-x": [Vector3(mn.x, mn.y, mx.z), Vector3(mn.x, mn.y, mn.z), Vector3(mn.x, mx.y, mn.z), Vector3(mn.x, mx.y, mx.z), Vector3.LEFT],
			"+y": [Vector3(mn.x, mx.y, mn.z), Vector3(mx.x, mx.y, mn.z), Vector3(mx.x, mx.y, mx.z), Vector3(mn.x, mx.y, mx.z), Vector3.UP],
			"-y": [Vector3(mn.x, mn.y, mx.z), Vector3(mx.x, mn.y, mx.z), Vector3(mx.x, mn.y, mn.z), Vector3(mn.x, mn.y, mn.z), Vector3.DOWN],
			"+z": [Vector3(mx.x, mn.y, mx.z), Vector3(mn.x, mn.y, mx.z), Vector3(mn.x, mx.y, mx.z), Vector3(mx.x, mx.y, mx.z), Vector3.BACK],
			"-z": [Vector3(mn.x, mn.y, mn.z), Vector3(mx.x, mn.y, mn.z), Vector3(mx.x, mx.y, mn.z), Vector3(mn.x, mx.y, mn.z), Vector3.FORWARD],
		}
		for cle in faces:
			if cle in sans:
				continue
			var f: Array = faces[cle]
			quad(f[0], f[1], f[2], f[3], f[4], couleur)

	# DÉCOUPE : retire un rectangle des faces planes perpendiculaires à `axe` ("x", "y" ou "z") dont la coordonnée
	# est dans [a_min, a_max]. `rect` est dans les deux autres coordonnées : (x, z) pour "y", (z, y) pour "x", (x, y)
	# pour "z". Chaque triangle touché est remplacé par ses morceaux HORS du rectangle — le triangle moins le
	# rectangle se découpe en au plus quatre polygones convexes (à gauche, à droite, puis devant et derrière dans la
	# bande du milieu), chacun rogné par Sutherland-Hodgman et retriangulé en éventail dans le même sens. Couleurs
	# interpolées le long des arêtes. Rend le nombre de triangles touchés : une cote relevée qui ne toucherait rien
	# est une cote fausse, et l'appelant échoue.
	func decouper(axe: String, a_min: float, a_max: float, rect: Rect2) -> int:
		var k_axe := {"x": 0, "y": 1, "z": 2}[axe] as int
		var k_u := {"x": 2, "y": 0, "z": 0}[axe] as int
		var k_v := {"x": 1, "y": 2, "z": 1}[axe] as int
		var u0 := rect.position.x
		var u1 := rect.end.x
		var v0 := rect.position.y
		var v1 := rect.end.y
		var nv := PackedVector3Array()
		var nn := PackedVector3Array()
		var nc := PackedColorArray()
		var ni := PackedInt32Array()
		var touches := 0
		for t in range(0, i.size() - 2, 3):
			var p := [v[i[t]], v[i[t + 1]], v[i[t + 2]]]
			var cols := [c[i[t]], c[i[t + 1]], c[i[t + 2]]]
			var normale: Vector3 = n[i[t]]
			var plan := absf((p[0] as Vector3)[k_axe] - (p[1] as Vector3)[k_axe]) < 0.005 and absf((p[0] as Vector3)[k_axe] - (p[2] as Vector3)[k_axe]) < 0.005
			var dedans := plan and (p[0] as Vector3)[k_axe] >= a_min and (p[0] as Vector3)[k_axe] <= a_max
			var pu := [(p[0] as Vector3)[k_u], (p[1] as Vector3)[k_u], (p[2] as Vector3)[k_u]]
			var pv := [(p[0] as Vector3)[k_v], (p[1] as Vector3)[k_v], (p[2] as Vector3)[k_v]]
			if dedans:
				dedans = maxf(pu[0], maxf(pu[1], pu[2])) > u0 + 0.0001 and minf(pu[0], minf(pu[1], pu[2])) < u1 - 0.0001 \
						and maxf(pv[0], maxf(pv[1], pv[2])) > v0 + 0.0001 and minf(pv[0], minf(pv[1], pv[2])) < v1 - 0.0001
			if not dedans:
				var b := nv.size()
				for s in 3:
					nv.append(p[s])
					nn.append(n[i[t + s]])
					nc.append(cols[s])
				ni.append_array(PackedInt32Array([b, b + 1, b + 2]))
				continue
			touches += 1
			var poly := [[p[0], cols[0]], [p[1], cols[1]], [p[2], cols[2]]]
			var morceaux := [
				Maillage._rogner(poly, k_u, u0, -1.0),
				Maillage._rogner(poly, k_u, u1, 1.0),
				Maillage._rogner(Maillage._rogner(Maillage._rogner(poly, k_u, u0, 1.0), k_u, u1, -1.0), k_v, v0, -1.0),
				Maillage._rogner(Maillage._rogner(Maillage._rogner(poly, k_u, u0, 1.0), k_u, u1, -1.0), k_v, v1, 1.0),
			]
			for m: Array in morceaux:
				for s in range(1, m.size() - 1):
					var q0: Vector3 = m[0][0]
					var q1: Vector3 = m[s][0]
					var q2: Vector3 = m[s + 1][0]
					if (q1 - q0).cross(q2 - q0).length_squared() < 1e-10:
						continue
					var b := nv.size()
					nv.append_array(PackedVector3Array([q0, q1, q2]))
					nc.append_array(PackedColorArray([m[0][1], m[s][1], m[s + 1][1]]))
					for r in 3:
						nn.append(normale)
					ni.append_array(PackedInt32Array([b, b + 1, b + 2]))
		v = nv
		n = nn
		c = nc
		i = ni
		return touches

	# Sutherland-Hodgman sur un demi-plan : garde les points dont la coordonnée `k` est du côté `signe` de `seuil`
	# (signe -1 : coordonnée <= seuil ; +1 : >= seuil). Points : [position, couleur].
	static func _rogner(poly: Array, k: int, seuil: float, signe: float) -> Array:
		var out: Array = []
		if poly.size() < 3:
			return out
		for s in poly.size():
			var a: Array = poly[s]
			var b: Array = poly[(s + 1) % poly.size()]
			var da := ((a[0] as Vector3)[k] - seuil) * signe
			var db := ((b[0] as Vector3)[k] - seuil) * signe
			if da >= 0.0:
				out.append(a)
			if (da >= 0.0) != (db >= 0.0):
				var tt := da / (da - db)
				out.append([(a[0] as Vector3).lerp(b[0], tt), (a[1] as Color).lerp(b[1], tt)])
		return out

	# Couleur d'une face : celle du premier triangle horizontal (axe "y") ou vertical trouvé au point `p`, pour que
	# les faces ajoutées (bords de trémie, joues de travée) prennent la teinte de la pièce qu'elles prolongent.
	func couleur_pres(p: Vector3, axe: String) -> Color:
		var k := {"x": 0, "y": 1, "z": 2}[axe] as int
		var meilleur := Color(0.3, 0.3, 0.3)
		var d_min := INF
		for t in range(0, i.size() - 2, 3):
			var q := v[i[t]]
			if absf(q[k] - p[k]) > 0.01:
				continue
			var cen := (q + v[i[t + 1]] + v[i[t + 2]]) / 3.0
			var d := cen.distance_to(p)
			if d < d_min:
				d_min = d
				meilleur = c[i[t]]
		return meilleur

	# DOUBLURE : ajoute, pour chaque face plane perpendiculaire à `axe` dans [a_min, a_max] qui recoupe `rect` (mêmes
	# conventions que decouper), la même face retournée — enroulement inverse, normale opposée, même couleur. Une
	# cloison du modèle qui n'a qu'un côté (on voyait à travers depuis l'intérieur) devient opaque des deux côtés.
	# Rend le nombre de faces doublées.
	func doubler(axe: String, a_min: float, a_max: float, rect: Rect2) -> int:
		var k_axe := {"x": 0, "y": 1, "z": 2}[axe] as int
		var k_u := {"x": 2, "y": 0, "z": 0}[axe] as int
		var k_v := {"x": 1, "y": 2, "z": 1}[axe] as int
		var ajout := 0
		var n_tri := i.size()
		for t in range(0, n_tri - 2, 3):
			var p0 := v[i[t]]
			var p1 := v[i[t + 1]]
			var p2 := v[i[t + 2]]
			if absf(p0[k_axe] - p1[k_axe]) > 0.005 or absf(p0[k_axe] - p2[k_axe]) > 0.005:
				continue
			if p0[k_axe] < a_min or p0[k_axe] > a_max:
				continue
			var umax := maxf(p0[k_u], maxf(p1[k_u], p2[k_u]))
			var umin := minf(p0[k_u], minf(p1[k_u], p2[k_u]))
			var vmax := maxf(p0[k_v], maxf(p1[k_v], p2[k_v]))
			var vmin := minf(p0[k_v], minf(p1[k_v], p2[k_v]))
			if umax <= rect.position.x + 0.0001 or umin >= rect.end.x - 0.0001 or vmax <= rect.position.y + 0.0001 or vmin >= rect.end.y - 0.0001:
				continue
			var b := v.size()
			v.append_array(PackedVector3Array([p0, p2, p1]))
			c.append_array(PackedColorArray([c[i[t]], c[i[t + 2]], c[i[t + 1]]]))
			for k in [0, 2, 1]:
				n.append(-n[i[t + k]])
			i.append_array(PackedInt32Array([b, b + 1, b + 2]))
			ajout += 1
		return ajout

	# RETRAIT : enlève les triangles dont le CENTRE est dans la boîte. Sert à vider le volume d'une rampe de ce que le
	# modèle y laisse pendre : les bandeaux de plafonnier, relevés à la sonde le 2026-09-22 à 20 cm au-dessus du
	# tablier, qui arrêtaient net la voiture. Le centre et pas les trois sommets : un bandeau fait 9 m de long
	# (x 9,42..18,40, z -5,73..-5,02) et traverse la bande, donc aucun de ses triangles n'y tient en entier.
	# Rend le nombre de triangles retirés.
	func retirer_boite(mn: Vector3, mx: Vector3) -> int:
		var nv := PackedVector3Array()
		var nn := PackedVector3Array()
		var nc := PackedColorArray()
		var ni := PackedInt32Array()
		var retires := 0
		for t in range(0, i.size() - 2, 3):
			var cen := (v[i[t]] + v[i[t + 1]] + v[i[t + 2]]) / 3.0
			var dedans := cen.x >= mn.x and cen.x <= mx.x and cen.y >= mn.y and cen.y <= mx.y and cen.z >= mn.z and cen.z <= mx.z
			if dedans:
				retires += 1
				continue
			var b := nv.size()
			for k in 3:
				nv.append(v[i[t + k]])
				nn.append(n[i[t + k]])
				nc.append(c[i[t + k]])
			ni.append_array(PackedInt32Array([b, b + 1, b + 2]))
		v = nv
		n = nn
		c = nc
		i = ni
		return retires

	func ajouter(autre: Maillage) -> void:
		var b := v.size()
		v.append_array(autre.v)
		n.append_array(autre.n)
		c.append_array(autre.c)
		for k in autre.i:
			i.append(b + k)

	func vers_mesh(materiau: Material, nom: String, lods := true) -> Mesh:
		var arrays := []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = v
		arrays[Mesh.ARRAY_NORMAL] = n
		arrays[Mesh.ARRAY_COLOR] = c
		arrays[Mesh.ARRAY_INDEX] = i
		var importer := ImporterMesh.new()
		importer.add_surface(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, materiau, nom)
		if lods:
			importer.generate_lods(25.0, 60.0, [])
		return importer.get_mesh()

	# Faces de collision (trois sommets par triangle), dans l'enroulement du maillage.
	func faces() -> PackedVector3Array:
		var out := PackedVector3Array()
		for k in i:
			out.append(v[k])
		return out


# --- le parking praticable : cotes relevées sur le modèle --------------------------------------------------------------

const RIVE_BOUT_INT := 21.76               # face intérieure du muret de bout est (x)
const RIVE_BOUT_EXT := 23.10               # face extérieure (x)
const RIVE_HAUT := 1.95                    # hauteur du muret au-dessus du plancher (6,88 - 4,93 ; 2,31 - 0,36)
const TRAVEE_SUD := Vector2(-7.70, -3.54)  # travée sud du bout est (z) : entre la tour d'angle et le montant
const MONTANT_X := Vector2(22.12, 22.99)   # montant qui borde la travée au nord (x), plein de 0 à 18,99 m
const TOUR_ANGLE_X := 24.18                # face est de la tour d'angle, pour z < -7,70
const TOUR_VITREE_Z := 7.48                # face de la tour vitrée côté parking : un plan SANS épaisseur
const PASSAGE_OUEST_X := -3.87             # joue ouest du passage d'entrée du rez (plan x = -3,87, y 0..4,58)

# Escalier (dans la pièce de la tour vitrée, x -5,52..5,52, z 7,48..9,80) : deux volées de 13 contremarches de part et
# d'autre d'un palier, giron 0,28 m (32° pour 4,57 m entre planchers). Rampe de collision INVISIBLE par les nez de
# marches : le joueur la monte comme une pente, les marches ne sont que visuelles.
const GIRON := 0.28
const DEMI_MARCHES := 13
const ESC_X0 := -4.2                       # première contremarche de la volée A (vers +x)
const ESC_PIED := -4.48                    # pied de la rampe A, et arrivée de la rampe B à l'étage (= bord de trémie)
const ESC_PALIER := Vector2(-0.84, 0.64)   # palier intermédiaire (x)
const ESC_A := Vector2(7.60, 8.60)         # volée A (z)
const ESC_B := Vector2(8.70, 9.70)         # volée B (z)
const ESC_MUR := Vector2(8.60, 8.70)       # mur d'échiffre entre les volées (z)
const ESC_TREMIE := Rect2(-4.48, 7.55, 5.12, 2.25)   # trémie dans la dalle du dessus : x -4,48..0,64, z 7,55..9,80
const ESC_PORTE := Vector2(-5.52, -4.2)    # porte dans la face de la tour (x), 2,2 m de haut
const ESC_PORTE_H := 2.2
const GC_H := 1.05                         # garde-corps : 1,05 m au-dessus de ce qu'il borde
# Cage vitrée : ses faces n'ont qu'un côté dans le modèle ; depuis l'escalier on voyait au travers (étape 5).
const CAGE := Rect2(-5.52, 7.48, 11.04, 4.39)   # x -5,52..5,52, z 7,48..11,87
const BETON_ESCALIER := Color(0.46, 0.46, 0.44)
const GARDE_CORPS := Color(0.30, 0.31, 0.33)


# Dessous des dalles, relevés comme les planchers (faces tournées vers le bas de plus de 500 m²) : le plus haut sous
# chaque plancher, à moins de 0,5 m.
static func dessous(mesh: Mesh, sols: PackedFloat32Array) -> PackedFloat32Array:
	var aires := {}
	var a := mesh.surface_get_arrays(0)
	var v: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
	var n: PackedVector3Array = a[Mesh.ARRAY_NORMAL]
	var idx: PackedInt32Array = a[Mesh.ARRAY_INDEX]
	for t in range(0, idx.size() - 2, 3):
		var nn := (n[idx[t]] + n[idx[t + 1]] + n[idx[t + 2]]).normalized()
		if nn.y > -0.99:
			continue
		var p0 := v[idx[t]]
		var y := snappedf((p0.y + v[idx[t + 1]].y + v[idx[t + 2]].y) / 3.0, 0.01)
		aires[y] = float(aires.get(y, 0.0)) + (v[idx[t + 1]] - p0).cross(v[idx[t + 2]] - p0).length() * 0.5
	var out := PackedFloat32Array()
	for s in sols:
		var meilleur := s - 0.37
		for y in aires:
			if float(aires[y]) > 500.0 and y < s and y > s - 0.5:
				meilleur = y
		out.append(meilleur)
	return out


# Le parking rendu praticable, dans son repère : maillage (la fusion du modèle, découpé et complété, un seul
# matériau) et triangles de collision (le modèle découpé, les escaliers, leurs rampes invisibles).
# `escaliers` : nombre d'étages desservis par l'escalier (1 = rez -> niveau 1) ;
# `travees` : plateaux dont la travée sud du bout est est ouverte (raccord à l'ancienne rampe extérieure) ;
# `rampes` : nombre de rampes intérieures empilées (4 = du rez au toit).
static func praticable(mesh: Mesh, materiau: Material, nom: String, escaliers: int, travees: Array, rampes := 0) -> Dictionary:
	var sols := planchers(mesh)
	var bas := dessous(mesh, sols)
	var m := Maillage.depuis(mesh)
	var col := Maillage.new()      # collision seule (rampes invisibles)
	var stats := {"planchers": sols, "dessous": bas, "decoupes": {}}
	var fautes: Array[String] = []
	for k in escaliers:
		_porte(m, sols[k], stats, fautes)
		if k == 0:
			_compte(stats, fautes, "joue ouest du passage", m.decouper("x", PASSAGE_OUEST_X - 0.01, PASSAGE_OUEST_X + 0.01,
					Rect2(TOUR_VITREE_Z, -0.01, 11.87 - TOUR_VITREE_Z, 4.60)))
		_tremie(m, sols[k + 1], bas[k + 1], stats, fautes)
		_escalier(m, col, sols[k], sols[k + 1], k == escaliers - 1)
	if escaliers > 0:
		_porte(m, sols[escaliers], stats, fautes)
	for k: int in travees:
		_travee(m, sols[k], stats, fautes)
	# RAMPES INTÉRIEURES : toutes les découpes d'abord (une découpe cherche des faces dans un plan, et le tablier
	# d'une rampe touche justement le plan du plancher qu'il rejoint), les géométries ensuite.
	for k in rampes:
		var bt := rampe_bouts(sols[k + 1] - sols[k])
		_tremie_rampe(m, sols[k + 1], bas[k + 1], bt, k == rampes - 1, stats, fautes)
		# ce que le modèle laisse pendre dans le volume de la rampe (boîtiers de plafonnier) : retiré, sinon la
		# voiture bute dessus à 20 cm au-dessus du tablier
		stats["decoupes"]["plafonniers dans la bande"] = int(stats["decoupes"].get("plafonniers dans la bande", 0)) 				+ m.retirer_boite(Vector3(bt.x - 0.5, sols[k + 1] - 1.0, RAMPE_Z - RAMPE_DEMI - 0.1),
				Vector3(20.0, sols[k + 1] - 0.15, RAMPE_Z + RAMPE_DEMI + 0.1))
	for k in rampes:
		_rampe(m, sols[k], sols[k + 1], k == 0)
	if rampes > 0:
		_barre_hauteur(m, sols[0])
	var pl := places(sols, m)
	var faces := m.faces()
	faces.append_array(col.faces())
	# cage vitrée opaque DE L'INTÉRIEUR : ses quatre faces doublées à l'envers, APRÈS les découpes de portes (la
	# doublure en garde les trous). Visuel seulement : la collision est déjà à deux faces.
	var bas_haut := Vector2(-3.0, 30.0)
	_compte(stats, fautes, "doublure de la cage (face cote parking)", m.doubler("z", TOUR_VITREE_Z - 0.01, TOUR_VITREE_Z + 0.01,
			Rect2(CAGE.position.x, bas_haut.x, CAGE.size.x, bas_haut.y - bas_haut.x)))
	_compte(stats, fautes, "doublure de la cage (face avant)", m.doubler("z", CAGE.end.y - 0.01, CAGE.end.y + 0.01,
			Rect2(CAGE.position.x, bas_haut.x, CAGE.size.x, bas_haut.y - bas_haut.x)))
	for x: float in [CAGE.position.x, CAGE.end.x]:
		_compte(stats, fautes, "doublure de la cage (flancs)", m.doubler("x", x - 0.01, x + 0.01,
				Rect2(CAGE.position.y, bas_haut.x, CAGE.size.y, bas_haut.y - bas_haut.x)))
	return {"mesh": m.vers_mesh(materiau, nom), "faces": faces, "stats": stats, "fautes": fautes, "planchers": sols,
			"places": pl}


static func _compte(stats: Dictionary, fautes: Array[String], quoi: String, touches: int) -> void:
	stats["decoupes"][quoi] = int(stats["decoupes"].get(quoi, 0)) + touches
	if touches == 0:
		fautes.append("découpe « %s » : aucun triangle touché, la cote relevée ne correspond plus au modèle" % quoi)


# Porte dans la face de la tour vitrée côté parking, au niveau `y`.
static func _porte(m: Maillage, y: float, stats: Dictionary, fautes: Array[String]) -> void:
	_compte(stats, fautes, "porte de la tour", m.decouper("z", TOUR_VITREE_Z - 0.01, TOUR_VITREE_Z + 0.01,
			Rect2(ESC_PORTE.x, y, ESC_PORTE.y - ESC_PORTE.x, ESC_PORTE_H)))


# Trémie dans la dalle du plancher `y` (dessous `yb`) : dessus, dessous et, au niveau 1, plafond du passage d'entrée
# (4,58 m) retirés sur ESC_TREMIE ; quatre chants de dalle ajoutés, à la teinte de la dalle.
static func _tremie(m: Maillage, y: float, yb: float, stats: Dictionary, fautes: Array[String]) -> void:
	var r := ESC_TREMIE
	var teinte := m.couleur_pres(Vector3(r.position.x - 1.0, y, r.get_center().y), "y")
	_compte(stats, fautes, "trémie", m.decouper("y", yb - 0.01, y + 0.01, r))
	var x0 := r.position.x
	var x1 := r.end.x
	var z0 := r.position.y
	var z1 := r.end.y
	m.quad(Vector3(x0, yb, z0), Vector3(x0, yb, z1), Vector3(x0, y, z1), Vector3(x0, y, z0), Vector3.RIGHT, teinte)
	m.quad(Vector3(x1, yb, z0), Vector3(x1, yb, z1), Vector3(x1, y, z1), Vector3(x1, y, z0), Vector3.LEFT, teinte)
	m.quad(Vector3(x0, yb, z0), Vector3(x1, yb, z0), Vector3(x1, y, z0), Vector3(x0, y, z0), Vector3.BACK, teinte)
	m.quad(Vector3(x0, yb, z1), Vector3(x1, yb, z1), Vector3(x1, y, z1), Vector3(x0, y, z1), Vector3.FORWARD, teinte)


# Travée sud du bout est ouverte au plancher `y` : muret retiré (faces extérieure, intérieure et dessus) entre la tour
# d'angle et le montant ; sol prolongé jusqu'au bord ; joue nord du muret coupé, de part et d'autre du montant (la
# joue sud est la face de la tour d'angle).
static func _travee(m: Maillage, y: float, stats: Dictionary, fautes: Array[String]) -> void:
	var tz := TRAVEE_SUD
	var sol := m.couleur_pres(Vector3(RIVE_BOUT_INT - 1.0, y, tz.x * 0.5 + tz.y * 0.5), "y")
	var muret := m.couleur_pres(Vector3(RIVE_BOUT_EXT, y + 1.0, tz.x * 0.5 + tz.y * 0.5), "x")
	_compte(stats, fautes, "muret de bout (face ext.)", m.decouper("x", RIVE_BOUT_EXT - 0.01, RIVE_BOUT_EXT + 0.01, Rect2(tz.x, y, tz.y - tz.x, RIVE_HAUT + 0.02)))
	_compte(stats, fautes, "muret de bout (face int.)", m.decouper("x", RIVE_BOUT_INT - 0.01, RIVE_BOUT_INT + 0.01, Rect2(tz.x, y - 0.02, tz.y - tz.x, RIVE_HAUT + 0.04)))
	_compte(stats, fautes, "muret de bout (dessus)", m.decouper("y", y + RIVE_HAUT - 0.02, y + RIVE_HAUT + 0.02, Rect2(RIVE_BOUT_INT, tz.x, RIVE_BOUT_EXT - RIVE_BOUT_INT, tz.y - tz.x)))
	m.quad(Vector3(RIVE_BOUT_INT, y, tz.x), Vector3(RIVE_BOUT_EXT, y, tz.x), Vector3(RIVE_BOUT_EXT, y, tz.y), Vector3(RIVE_BOUT_INT, y, tz.y), Vector3.UP, sol)
	for xs: Vector2 in [Vector2(RIVE_BOUT_INT, MONTANT_X.x), Vector2(MONTANT_X.y, RIVE_BOUT_EXT)]:
		m.quad(Vector3(xs.x, y, tz.y), Vector3(xs.y, y, tz.y), Vector3(xs.y, y + RIVE_HAUT, tz.y), Vector3(xs.x, y + RIVE_HAUT, tz.y), Vector3.FORWARD, muret)


# Escalier du plancher y0 au plancher y1, dans la tour vitrée. Visuel (marches pleines, palier, mur d'échiffre,
# garde-corps) dans `m`, avec collision ; rampes invisibles par les nez de marches dans `col`.
static func _escalier(m: Maillage, col: Maillage, y0: float, y1: float, dernier: bool) -> void:
	var r := (y1 - y0) / float(2 * DEMI_MARCHES)
	var ya := y0 + r * DEMI_MARCHES              # palier
	# volée A : marches pleines posées sur le plancher
	for k in range(1, DEMI_MARCHES):
		var xa := ESC_X0 + float(k - 1) * GIRON
		m.boite(Vector3(xa, y0, ESC_A.x), Vector3(xa + GIRON, y0 + r * k, ESC_A.y), BETON_ESCALIER)
	# palier, dalle de 0,15 m (au rez, le passage des voitures passe dessous)
	m.boite(Vector3(ESC_PALIER.x, ya - 0.15, ESC_A.x), Vector3(ESC_PALIER.y, ya, ESC_B.y), BETON_ESCALIER)
	# volée B : marches portées, sous-face en escalier ; la 13e affleure le plancher du dessus (bord de trémie)
	for k in range(1, DEMI_MARCHES + 1):
		var xb := ESC_PALIER.x - float(k) * GIRON
		m.boite(Vector3(xb, ya + r * k - r - 0.15, ESC_B.x), Vector3(xb + GIRON, ya + r * k, ESC_B.y), BETON_ESCALIER)
	# mur d'échiffre entre les volées, garde-corps au bout du palier, écran côté vitrage (le muret de façade est derrière)
	var haut := y1 + (1.0 if dernier else 0.0)
	m.boite(Vector3(ESC_X0, y0, ESC_MUR.x), Vector3(ESC_PALIER.x, haut, ESC_MUR.y), BETON_ESCALIER)
	m.boite(Vector3(ESC_PALIER.y, ya, ESC_A.x), Vector3(ESC_PALIER.y + 0.06, ya + 1.0, ESC_B.y), GARDE_CORPS)
	m.boite(Vector3(ESC_PIED, y0 + RIVE_HAUT, ESC_B.y + 0.02), Vector3(ESC_PALIER.y, y1 + 1.0, ESC_B.y + 0.10), GARDE_CORPS)
	# GARDE-CORPS DE LA TRÉMIE, au plancher du dessus (2026-09-22) : son bord est, au droit du palier — on y tombait sur le
	# palier, 2,3 m plus bas, depuis la partie est de la cage. Au dernier étage desservi, le couloir de la volée A est un
	# trou (aucune volée n'y part) : garde-corps en travers, au bord de trémie. Aux étages intermédiaires, la volée A
	# suivante part de ce couloir : la fente entre le bord de trémie et sa première contremarche est comblée.
	m.boite(Vector3(ESC_PALIER.y, y1, ESC_TREMIE.position.y), Vector3(ESC_PALIER.y + 0.06, y1 + GC_H, ESC_TREMIE.end.y), GARDE_CORPS)
	if dernier:
		m.boite(Vector3(ESC_PIED - 0.06, y1, ESC_TREMIE.position.y), Vector3(ESC_PIED, y1 + GC_H, ESC_MUR.x), GARDE_CORPS)
	else:
		m.boite(Vector3(ESC_PIED, y1 - 0.15, ESC_A.x), Vector3(ESC_X0, y1, ESC_A.y), BETON_ESCALIER)
	# rampes invisibles PAR LES NEZ DE MARCHES : A du pied (plancher) au palier, palier, B du palier au plancher du
	# dessus. Le nez d'une marche de B est son bord EST (on monte vers -x) : la ligne des nez part du palier un giron
	# à l'est de la première marche (-0,56) et atteint le plancher au nez de la 13e (-4,2), dont le dessus affleure
	# jusqu'au bord de trémie. Posée de -0,84 à -4,48, elle passait une contremarche SOUS chaque nez et le pied
	# d'une capsule butait sur la première marche (vu par ParkingStructureTest).
	var nez_b := ESC_PALIER.x + GIRON
	col.quad(Vector3(ESC_PIED, y0, ESC_A.x), Vector3(ESC_PALIER.x, ya, ESC_A.x), Vector3(ESC_PALIER.x, ya, ESC_A.y), Vector3(ESC_PIED, y0, ESC_A.y), Vector3.UP, Color.WHITE)
	col.quad(Vector3(ESC_PALIER.x, ya, ESC_A.x), Vector3(ESC_PALIER.y, ya, ESC_A.x), Vector3(ESC_PALIER.y, ya, ESC_B.y), Vector3(ESC_PALIER.x, ya, ESC_B.y), Vector3.UP, Color.WHITE)
	col.quad(Vector3(nez_b, ya, ESC_B.x), Vector3(ESC_X0, y1, ESC_B.x), Vector3(ESC_X0, y1, ESC_B.y), Vector3(nez_b, ya, ESC_B.y), Vector3.UP, Color.WHITE)
	col.quad(Vector3(ESC_X0, y1, ESC_B.x), Vector3(ESC_PIED, y1, ESC_B.x), Vector3(ESC_PIED, y1, ESC_B.y), Vector3(ESC_X0, y1, ESC_B.y), Vector3.UP, Color.WHITE)


# --- RAMPE INTÉRIEURE, 16 % (2026-09-22) --------------------------------------------------------------------------------
#
# Choisie par le joueur après l'évaluation de l'étape 8 : les quatre parkings identiques, tout en intérieur. Elle tient
# à 16 % (28,56 m de pente plus 0,70 m de raccords à mi-pente, dans une dalle de 43,52 m entre murets), pas à 12 %
# (38,1 m, la conclusion de l'étape 5). Implantation, la seule possible : la bande du MUR ARRIÈRE, entre la tour
# arrière (z -7,48) et la rangée de poteaux (z ±0,54) — axe z = -5,55, bande de 3,80 m, voie de 3,50 m entre
# garde-corps, montant vers +x. La bande côté façade ne peut pas servir : la cage d'escalier et sa porte y donnent.
#
# Les rampes se SUPERPOSENT d'un niveau à l'autre, même profil décalé d'un étage : la dalle du dessus est percée sur
# toute la bande, la rampe du dessus fait le plafond de celle du dessous, et la hauteur libre vaut 4,20 m (4,57 moins
# l'épaisseur de dalle), constante. Aux deux bouts, un demi-tour de 4,70 m de rayon autour des poteaux de bout, qui
# tombent dans son îlot ; la voie de retour longe la façade et laisse 4,67 m de profondeur pour 10 places par niveau.
#
# Cotes de sécurité vérifiées par ParkingStructureTest : pente relevée sur la COLLISION, garde-corps de 1,05 m sur les
# deux bords de chaque rampe et autour de chaque trémie (piéton ET voiture poussés contre chacun), barre de hauteur à
# l'entrée.
const RAMPE_PENTE := 0.16
const RAMPE_RACCORD := 0.7                 # raccord à mi-pente à chaque bout : la voiture ne talonne pas au changement
const RAMPE_Z := -5.55                     # axe de la voie
const RAMPE_DEMI := 1.9                    # demi-largeur de la bande, garde-corps compris
const RAMPE_GC := 0.15                     # épaisseur d'un garde-corps
const RAMPE_GC_H := 1.05                   # hauteur d'un garde-corps au-dessus de ce qu'il borde
const RAMPE_DALLE := 0.37                  # épaisseur de la rampe, la même que les dalles du modèle
const RAMPE_JEU := 0.02                    # la trémie déborde la bande : deux faces dans le même plan scintillent
const RAMPE_GC_DEPART := 4.45              # m après le pied : avant, c'est le parapet de la rampe du dessus qui borde
const ENROBE_RAMPE := Color(0.26, 0.26, 0.27)
const BETON_RAMPE := Color(0.52, 0.52, 0.50)


# Abscisses du pied et du haut de la rampe, pour une montée de `h`.
static func rampe_bouts(h: float) -> Vector2:
	var l := h / RAMPE_PENTE + RAMPE_RACCORD
	return Vector2(-l * 0.5, l * 0.5)


# Hauteur de la voie au-dessus du plancher de départ, à l'abscisse x.
static func rampe_hauteur(x: float, bouts: Vector2, h: float) -> float:
	var l := bouts.y - bouts.x
	var d := clampf(x - bouts.x, 0.0, l)
	if d < RAMPE_RACCORD:
		return 0.5 * RAMPE_PENTE * d * d / RAMPE_RACCORD
	if d > l - RAMPE_RACCORD:
		var r := l - d
		return h - 0.5 * RAMPE_PENTE * r * r / RAMPE_RACCORD
	return 0.5 * RAMPE_PENTE * RAMPE_RACCORD + RAMPE_PENTE * (d - RAMPE_RACCORD)


# Trémie de la rampe dans la dalle du plancher `y` (sous-face `yb`) : la bande entière, plus 2 cm de jeu à l'ouest et
# sur les deux longs côtés (à l'est, c'est le bout de la rampe qui ferme la dalle). Chants, puis garde-corps au ras du
# plancher le long des deux longs côtés : au dernier niveau, sur toute la longueur et fermé à l'ouest, puisqu'aucune
# rampe ne part de là ; en dessous, seulement passé RAMPE_GC_DEPART, avant quoi c'est le parapet de la rampe qui part
# de ce plancher qui borde le trou.
static func _tremie_rampe(m: Maillage, y: float, yb: float, bouts: Vector2, dernier: bool, stats: Dictionary, fautes: Array[String]) -> void:
	var z0 := RAMPE_Z - RAMPE_DEMI - RAMPE_JEU
	var z1 := RAMPE_Z + RAMPE_DEMI + RAMPE_JEU
	var x0 := bouts.x - RAMPE_JEU
	var x1 := bouts.y
	var teinte := m.couleur_pres(Vector3(x0 - 1.5, y, RAMPE_Z), "y")
	_compte(stats, fautes, "trémie de rampe", m.decouper("y", yb - 0.01, y + 0.01, Rect2(x0, z0, x1 - x0, z1 - z0)))
	m.quad(Vector3(x0, yb, z0), Vector3(x0, yb, z1), Vector3(x0, y, z1), Vector3(x0, y, z0), Vector3.RIGHT, teinte)
	m.quad(Vector3(x0, yb, z0), Vector3(x1, yb, z0), Vector3(x1, y, z0), Vector3(x0, y, z0), Vector3.BACK, teinte)
	m.quad(Vector3(x0, yb, z1), Vector3(x1, yb, z1), Vector3(x1, y, z1), Vector3(x0, y, z1), Vector3.FORWARD, teinte)
	var xg := x0 if dernier else bouts.x + RAMPE_GC_DEPART
	m.boite(Vector3(xg, y, z0 - RAMPE_GC), Vector3(x1, y + RAMPE_GC_H, z0), GARDE_CORPS)
	m.boite(Vector3(xg, y, z1), Vector3(x1, y + RAMPE_GC_H, z1 + RAMPE_GC), GARDE_CORPS)
	if dernier:
		m.boite(Vector3(x0 - RAMPE_GC, y, z0 - RAMPE_GC), Vector3(x0, y + RAMPE_GC_H, z1 + RAMPE_GC), GARDE_CORPS)


# La rampe du plancher y0 au plancher y1 : tablier (dessus, dessous, flancs, bout est), parapets de 1,05 m des deux
# côtés, et au rez les flancs prolongés jusqu'au sol pour qu'on ne passe pas sous la rampe.
static func _rampe(m: Maillage, y0: float, y1: float, premier: bool) -> void:
	var h := y1 - y0
	var b := rampe_bouts(h)
	var zc0 := RAMPE_Z - RAMPE_DEMI
	var zc1 := RAMPE_Z + RAMPE_DEMI
	var n := int(ceil((b.y - b.x) / 0.5))
	for i in n:
		var x0 := b.x + (b.y - b.x) * float(i) / float(n)
		var x1 := b.x + (b.y - b.x) * float(i + 1) / float(n)
		var h0 := y0 + rampe_hauteur(x0, b, h)
		var h1 := y0 + rampe_hauteur(x1, b, h)
		m.quad(Vector3(x0, h0, zc0), Vector3(x1, h1, zc0), Vector3(x1, h1, zc1), Vector3(x0, h0, zc1), Vector3.UP, ENROBE_RAMPE)
		m.quad(Vector3(x0, h0 - RAMPE_DALLE, zc0), Vector3(x1, h1 - RAMPE_DALLE, zc0), Vector3(x1, h1 - RAMPE_DALLE, zc1),
				Vector3(x0, h0 - RAMPE_DALLE, zc1), Vector3.DOWN, BETON_RAMPE)
		m.quad(Vector3(x0, h0 - RAMPE_DALLE, zc0), Vector3(x1, h1 - RAMPE_DALLE, zc0), Vector3(x1, h1, zc0), Vector3(x0, h0, zc0), Vector3.FORWARD, BETON_RAMPE)
		m.quad(Vector3(x0, h0 - RAMPE_DALLE, zc1), Vector3(x1, h1 - RAMPE_DALLE, zc1), Vector3(x1, h1, zc1), Vector3(x0, h0, zc1), Vector3.BACK, BETON_RAMPE)
		for zg: Vector2 in [Vector2(zc0, zc0 + RAMPE_GC), Vector2(zc1 - RAMPE_GC, zc1)]:
			m.quad(Vector3(x0, h0, zg.y), Vector3(x1, h1, zg.y), Vector3(x1, h1 + RAMPE_GC_H, zg.y), Vector3(x0, h0 + RAMPE_GC_H, zg.y), Vector3.BACK, GARDE_CORPS)
			m.quad(Vector3(x0, h0, zg.x), Vector3(x1, h1, zg.x), Vector3(x1, h1 + RAMPE_GC_H, zg.x), Vector3(x0, h0 + RAMPE_GC_H, zg.x), Vector3.FORWARD, GARDE_CORPS)
			m.quad(Vector3(x0, h0 + RAMPE_GC_H, zg.x), Vector3(x1, h1 + RAMPE_GC_H, zg.x), Vector3(x1, h1 + RAMPE_GC_H, zg.y),
					Vector3(x0, h0 + RAMPE_GC_H, zg.y), Vector3.UP, GARDE_CORPS)
		if premier:
			var s0 := maxf(h0 - RAMPE_DALLE, y0)
			var s1 := maxf(h1 - RAMPE_DALLE, y0)
			m.quad(Vector3(x0, y0, zc0), Vector3(x1, y0, zc0), Vector3(x1, s1, zc0), Vector3(x0, s0, zc0), Vector3.FORWARD, BETON_RAMPE)
			m.quad(Vector3(x0, y0, zc1), Vector3(x1, y0, zc1), Vector3(x1, s1, zc1), Vector3(x0, s0, zc1), Vector3.BACK, BETON_RAMPE)
	# bout est : la tranche de la rampe ferme le chant de la dalle percée (même épaisseur, d'où aucune face en double)
	m.quad(Vector3(b.y, y1 - RAMPE_DALLE, zc0), Vector3(b.y, y1 - RAMPE_DALLE, zc1), Vector3(b.y, y1, zc1), Vector3(b.y, y1, zc0), Vector3.RIGHT, BETON_RAMPE)
	if premier:
		m.quad(Vector3(b.y, y0, zc0), Vector3(b.y, y0, zc1), Vector3(b.y, y1 - RAMPE_DALLE, zc1), Vector3(b.y, y1 - RAMPE_DALLE, zc0), Vector3.RIGHT, BETON_RAMPE)


# --- BARRE DE HAUTEUR À L'ENTRÉE (2026-09-22) -------------------------------------------------------------------------
#
# Comme dans un vrai parking à étages : un portique en travers de l'entrée, qui arrête dehors ce qui ne peut pas
# monter la rampe. Sa hauteur vient de la MESURE, pas d'un chiffre rond choisi au hasard : sur les 72 modèles du
# catalogue passés dans la rampe (montée et descente d'un étage, évaluation de l'étape 8), le plus haut qui passe est
# le 4x4 lowpoly, 2,07 m de caisse. La barre est donc à 2,15 m : 8 cm de garde, aucun de ceux qui passent n'est
# arrêté, et 22 des 34 refusés par la rampe (fourgons, camions, bus, ambulances) le sont dehors. Les 12 autres sont
# des voitures BASSES mais trop longues ou trop larges pour les demi-tours (limousine, coupés lowpoly, gros
# pick-ups) : une barre de hauteur ne peut rien contre elles, un vrai parking non plus.
const BARRE_HAUTEUR := 2.15
const BARRE_X := Vector2(-4.12, 4.12)       # le portique barre tout le passage d'entrée (x ±3,87)
const BARRE_Z := Vector2(11.95, 12.15)      # juste devant la façade (z 11,87), sous l'auvent
const BARRE_EPAIS := 0.25                   # hauteur de la poutre
const BARRE_JAUNE := Color(0.80, 0.66, 0.10)
const BARRE_GRIS := Color(0.32, 0.32, 0.34)


static func barre_texte() -> String:
	return "%.2f m" % BARRE_HAUTEUR


# Où poser le panneau : sur la face extérieure de la poutre, au milieu du passage.
static func barre_panneau(y_sol: float) -> Vector3:
	return Vector3(0.0, y_sol + BARRE_HAUTEUR + BARRE_EPAIS * 0.5, BARRE_Z.y + 0.01)


static func _barre_hauteur(m: Maillage, y_sol: float) -> void:
	var haut := y_sol + BARRE_HAUTEUR
	for x: Vector2 in [Vector2(BARRE_X.x, BARRE_X.x + 0.25), Vector2(BARRE_X.y - 0.25, BARRE_X.y)]:
		m.boite(Vector3(x.x, y_sol - 0.5, BARRE_Z.x), Vector3(x.y, haut + BARRE_EPAIS, BARRE_Z.y), BARRE_GRIS)
	m.boite(Vector3(BARRE_X.x, haut, BARRE_Z.x), Vector3(BARRE_X.y, haut + BARRE_EPAIS, BARRE_Z.y), BARRE_JAUNE)


# --- PLACES MARQUÉES (2026-09-22) -------------------------------------------------------------------------------------
#
# Dix places par niveau, le long de la façade, exactement ce que l'évaluation de l'étape 8 avait chiffré : la bande
# arrière est prise par la rampe, l'allée occupe le milieu, il reste la profondeur d'une place entre l'allée et le
# muret de rive. Relevé sur le modèle : intérieur du plateau z -9,75..9,80, muret de rive à 9,80 ; cage d'escalier
# x ±5,52 à partir de z 7,48 ; tours d'angle x ±(20,13..24,18) à partir de |z| 7,70. D'où deux files de CINQ places
# de 2,80 m, de part et d'autre de la cage, entre x ±6,12 et x ±20,12 : 14,00 m chacune, au centimètre.
#
# Une place fait 2,80 x 5,20 m comme celles des parkings de surface (PlacesBake._parking), nez vers la façade, et
# c'est l'allée (z 3,85) qui la dessert. Une voiture de 4,20 m s'y arrête à 0,50 m du muret : aucun montant de façade
# n'est dans son emprise.
const PL_PROF := 5.2
const PL_LARG := 2.8
const PL_Z := 9.75                             # fond de la place (le muret de rive est à 9,80)
const PL_TRAIT := 0.12
const PL_FILES := [Vector2(-20.12, -6.12), Vector2(6.12, 20.12)]
const PL_PEINTURE := Color(0.86, 0.86, 0.84)
const PL_HAUT := 0.006                         # le trait, au-dessus du tablier


# Dessine le marquage dans `m` et rend les places : [{"niveau": k, "centre": Vector3 (repère du modèle), "nez": Vector2}].
# Le nez pointe vers la façade (+z) : c'est la marche avant, `_garer_sur_place` retourne une partie des voitures.
static func places(sols: PackedFloat32Array, m: Maillage) -> Array:
	var sortie: Array = []
	for k in sols.size():
		var y: float = sols[k] + PL_HAUT
		for f: Vector2 in PL_FILES:
			var n := int(round((f.y - f.x) / PL_LARG))
			for i in n + 1:
				var x: float = f.x + (f.y - f.x) * float(i) / float(n)
				m.quad(Vector3(x - PL_TRAIT * 0.5, y, PL_Z - PL_PROF), Vector3(x + PL_TRAIT * 0.5, y, PL_Z - PL_PROF),
						Vector3(x + PL_TRAIT * 0.5, y, PL_Z), Vector3(x - PL_TRAIT * 0.5, y, PL_Z), Vector3.UP, PL_PEINTURE)
			for i in n:
				var xc: float = f.x + (f.y - f.x) * (float(i) + 0.5) / float(n)
				sortie.append({"niveau": k, "centre": Vector3(xc, sols[k], PL_Z - PL_PROF * 0.5), "nez": Vector2(0.0, 1.0)})
	return sortie


# Le tirage d'une voiture sur une place. Il vit ICI et pas dans un cuiseur parce que les quatre parkings doivent se
# garnir de la même façon : l'aérogare passe par PlacesBake, les trois autres par DowntownBuildingsBake, et deux
# copies du même tirage auraient dérivé à la première retouche. Mêmes réglages que le parking de surface de
# l'aérogare (PlacesBake._garer_sur_place), dont il reprend le principe : tirage STABLE dérivé de la position, donc
# une place garde sa voiture, son angle et son décalage d'une cuisson à l'autre.
const PL_MODELES := [
	"Sedans/Veh_Sedan_01_Blue", "Sedans/Veh_Sedan_01_White", "Sedans/Veh_Sedan_02_Red",
	"Sedans/Veh_Sedan_02_White", "Sedans/Veh_Sedan_01_Yellow", "SUVs/Veh_SUV_01_White",
	"SUVs/Veh_SUV_02_Green", "SUVs/Veh_SUV_03_Blue", "SUVs/Veh_SUV_01_Red",
	"Coupes/Veh_Coupe_01_Red", "Microcar/Veh_Microcar_Yellow", "Minivan/Veh_Minivan_White",
]
const PL_VEH := "res://assets/vehicle_models_extra/city_vehicles_UNVERIFIED_LICENSE/"
const PL_TRAVERS := 3.0        # degrés de travers, au plus (moins qu'en surface : les places sont serrées)
const PL_AVANCE := 0.35
const PL_LATERAL := 0.22
const PL_ARRIERE := 40         # % de voitures garées en marche arrière
const Fenetres := preload("res://scenes/world/map/tools/BuildingWindows.gd")


# Rend {} si la place reste vide, sinon {"model": chemin, "pos": Vector2 monde, "yaw": float}.
# `pos` et `nez` sont en coordonnées MONDE ; `nez` pointe vers le fond de la place.
static func tirage_place(pos: Vector2, nez: Vector2, vide: int) -> Dictionary:
	var h := Fenetres.cle(Vector3(pos.x, 0.0, pos.y))
	if h % 100 < vide:
		return {}
	var chemin: String = PL_VEH + PL_MODELES[(h >> 7) % PL_MODELES.size()] + ".glb"
	if not ResourceLoader.exists(chemin):
		push_error("ParkingStructureKit : modèle absent %s" % chemin)
		return {}
	var travers := (float((h >> 11) % 2001) / 1000.0 - 1.0) * deg_to_rad(PL_TRAVERS)
	var avance := (float((h >> 17) % 2001) / 1000.0 - 1.0) * PL_AVANCE
	var lateral := (float((h >> 23) % 2001) / 1000.0 - 1.0) * PL_LATERAL
	var cote := Vector2(-nez.y, nez.x)
	var arriere := ((h >> 3) % 100) < PL_ARRIERE
	# Le cap enregistré est celui du MODÈLE BRUT, même convention que partout ailleurs : nez vers (-x, -z).
	return {"model": chemin, "pos": pos + nez * avance + cote * lateral,
			"yaw": atan2(-nez.x, -nez.y) + travers + (PI if arriere else 0.0), "arriere": arriere}


# Combien de places occupées, par niveau : un parking se vide en montant, comme dans la vraie vie. Le dernier
# chiffre vaut pour le toit. C'est aussi ce qui borne le nombre de véhicules posés (5 niveaux x 4 parkings).
const PL_REMPLISSAGE := [67, 50, 33, 25, 17]


static func remplissage(niveau: int) -> int:
	return int(PL_REMPLISSAGE[mini(niveau, PL_REMPLISSAGE.size() - 1)])


# --- ÉCLAIRAGE INTÉRIEUR (2026-09-22) ---------------------------------------------------------------------------------
#
# Un parking à étages est sombre DE JOUR aussi : ses lumières sont allumées en permanence, il n'y a rien à fondre au
# crépuscule. D'où un matériau non éclairé à couleur fixe, partagé par les quatre parkings, et des maillages toujours
# visibles — pas de groupe, pas de bascule, zéro travail par image.
#
# CE QU'ON ALLUME EXISTE DÉJÀ DANS LE MODÈLE. `light_006` ne contient pas que les cônes opaques écartés le
# 2026-09-21 : relevé triangle par triangle, il porte 162 triangles PLATS (trois sommets à la même hauteur au mm) et
# 136 non plats. Les plats sont les VITRES des plafonniers — 17 panneaux, quatre par niveau couvert à
# x ±(9,42..18,40) et z ±(5,02..5,73), 8,98 x 0,71 m chacun, plus un de 8,58 x 0,31 m sous l'auvent de l'entrée.
# C'est cette géométrie-là qu'on rallume, recopiée 12 mm plus bas sur le matériau partagé, comme le verre des
# lampadaires et les optiques des véhicules. Les cônes, eux, restent écartés.
#
# CE QU'ON AJOUTE, et pourquoi : les deux panneaux z < 0 de chaque niveau tombent dans la bande de la rampe et
# disparaissent avec le plafond que la rampe a remplacé (même boîte de découpe que leurs boîtiers, §11). Une rampe
# de vrai parking a ses propres luminaires, qui suivent la pente : on pose donc trois bandeaux par rampe COUVERTE,
# 12 cm sous le tablier du dessus, donc à 4,08 m au-dessus de la voie. La rampe du haut n'en a pas : sa trémie perce
# la dalle du toit sur toute la bande, elle est à ciel ouvert. La cage d'escalier n'a aucun luminaire dans le modèle
# et elle est fermée : elle reçoit un panneau par niveau, à l'est de sa trémie.
const GLB := "res://assets/building_pack_everythinglibrary/Business/Business_ParkingStructure.glb"
const LUM_MATERIAU := "res://scenes/world/parking_glow_material.tres"
const LUM_COULEUR := Color(0.98, 0.93, 0.80)   # blanc chaud, sous 1.0 : le tonemapper ACES délave ce qu'on y pose
const LUM_DESCENTE := 0.012                    # la copie allumée, sous la vitre d'origine
const LUM_SOUS_PLAFOND := 0.12                 # bandeaux ajoutés : tant sous la face qu'ils éclairent
const LUM_RAMPE_X := [-9.0, 0.0, 9.0]          # abscisses des bandeaux d'une rampe
const LUM_RAMPE_L := 2.4                       # longueur d'un bandeau
const LUM_RAMPE_LARG := 0.5
const LUM_ALLEE_X := [-16.0, -8.0, 0.0, 8.0, 16.0]   # file de bandeaux le long de l'allée de circulation
const LUM_ALLEE_Z := 3.85                      # axe de l'allée (le même que celle du retour de la rampe)
const LUM_CAGE := Rect2(1.4, 8.30, 1.8, 0.5)   # panneau de la cage : x 1,4..3,2, z 8,30..8,80 (à l'est de ESC_TREMIE)
const LUM_CAGE_TOIT := 2.6                     # panneau du haut, au-dessus du plancher du toit


# Le matériau partagé. Créé par la première cuisson qui en a besoin, relu ensuite : les deux cuiseurs l'appellent, et
# deux matériaux au lieu d'un couperaient le regroupement — la leçon déjà payée sur les mâts de lampadaire.
static func materiau_lumiere() -> StandardMaterial3D:
	if ResourceLoader.exists(LUM_MATERIAU):
		return load(LUM_MATERIAU)
	var m := StandardMaterial3D.new()
	m.resource_name = "ParkingLumieres"
	m.albedo_color = LUM_COULEUR
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	ResourceSaver.save(m, LUM_MATERIAU)
	return load(LUM_MATERIAU)


# Les vitres du modèle, en repère du modèle : un triangle par entrée, sommets déjà transformés.
static func _vitres_modele() -> Array:
	var racine: Node3D = (load(GLB) as PackedScene).instantiate()
	var mi := _premier_maillage(racine, "light_")
	var sortie: Array = []
	if mi == null:
		racine.free()
		return sortie
	var xf := _dans_modele(mi, racine)
	for s in mi.mesh.get_surface_count():
		var a := mi.mesh.surface_get_arrays(s)
		var v: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
		var idx: PackedInt32Array = a[Mesh.ARRAY_INDEX]
		var n := (idx.size() / 3) if idx.size() > 0 else (v.size() / 3)
		for t in n:
			var p: Array[Vector3] = []
			for k in 3:
				p.append(xf * v[idx[t * 3 + k] if idx.size() > 0 else t * 3 + k])
			if absf(p[0].y - p[1].y) < 0.001 and absf(p[0].y - p[2].y) < 0.001:
				sortie.append(p)
	racine.free()
	return sortie


static func _premier_maillage(n: Node, prefixe: String) -> MeshInstance3D:
	if n is MeshInstance3D and String(n.name).begins_with(prefixe) and (n as MeshInstance3D).mesh != null:
		return n
	for e in n.get_children():
		var r := _premier_maillage(e, prefixe)
		if r != null:
			return r
	return null


static func _dans_modele(n: Node3D, racine: Node3D) -> Transform3D:
	var xf := Transform3D()
	var c: Node = n
	while c != null and c != racine.get_parent():
		xf = (c as Node3D).transform * xf
		c = c.get_parent()
	return xf


# Le maillage des lumières et la liste de leurs centres (pour le bassin de vraies lumières), en repère du modèle.
static func eclairage(sols: PackedFloat32Array, rampes: int, escaliers: int) -> Dictionary:
	var m := Maillage.new()
	var tetes := PackedVector3Array()
	var compte := {"vitres du modele": 0, "vitres dans la bande": 0, "bandeaux de rampe": 0, "panneaux de cage": 0}
	# 1. les vitres du modèle, moins celles que la rampe a emportées avec leur plafond
	var boites: Array[AABB] = []
	for k in rampes:
		var bt := rampe_bouts(sols[k + 1] - sols[k])
		var mn := Vector3(bt.x - 0.5, sols[k + 1] - 1.2, RAMPE_Z - RAMPE_DEMI - 0.1)
		boites.append(AABB(mn, Vector3(20.0, sols[k + 1] - 0.15, RAMPE_Z + RAMPE_DEMI + 0.1) - mn))
	var groupes := {}
	for tri: Array in _vitres_modele():
		var c: Vector3 = (tri[0] + tri[1] + tri[2]) / 3.0
		var emportee := false
		for b in boites:
			if b.has_point(c):
				emportee = true
				break
		if emportee:
			compte["vitres dans la bande"] = int(compte["vitres dans la bande"]) + 1
			continue
		compte["vitres du modele"] = int(compte["vitres du modele"]) + 1
		var bas := Vector3(0.0, -LUM_DESCENTE, 0.0)
		m.tri(tri[0] + bas, tri[1] + bas, tri[2] + bas, Vector3.DOWN, LUM_COULEUR, LUM_COULEUR, LUM_COULEUR)
		var cle := "%.2f|%d|%d" % [c.y, signi(c.x), signi(c.z)]
		if not groupes.has(cle):
			groupes[cle] = [Vector3(1e9, 1e9, 1e9), Vector3(-1e9, -1e9, -1e9)]
		for q: Vector3 in tri:
			groupes[cle][0] = (groupes[cle][0] as Vector3).min(q)
			groupes[cle][1] = (groupes[cle][1] as Vector3).max(q)
	for cle in groupes:
		tetes.append(((groupes[cle][0] as Vector3) + (groupes[cle][1] as Vector3)) * 0.5 - Vector3(0, LUM_DESCENTE, 0))
	# 2. bandeaux des rampes COUVERTES (la dernière est à ciel ouvert : sa trémie perce la dalle du toit)
	for k in maxi(rampes - 1, 0):
		var h_haut := sols[k + 2] - sols[k + 1]
		var bt_haut := rampe_bouts(h_haut)
		for x: float in LUM_RAMPE_X:
			var y := sols[k + 1] + rampe_hauteur(x, bt_haut, h_haut) - RAMPE_DALLE - LUM_SOUS_PLAFOND
			_panneau(m, Rect2(x - LUM_RAMPE_L * 0.5, RAMPE_Z - LUM_RAMPE_LARG * 0.5, LUM_RAMPE_L, LUM_RAMPE_LARG), y)
			tetes.append(Vector3(x, y, RAMPE_Z))
			compte["bandeaux de rampe"] = int(compte["bandeaux de rampe"]) + 1
	# 3. file de l'allée. Le modèle n'a que quatre luminaires par niveau, aux deux bouts, et la rampe en a emporté
	# deux : le milieu du plateau restait NOIR, vu à l'image avant de l'ajouter. Un vrai parking aligne ses
	# plafonniers le long de l'allée, c'est ce qu'on fait — cinq bandeaux à 4,08 m au-dessus du plancher.
	for k in rampes:
		var yp := sols[k + 1] - RAMPE_DALLE - LUM_SOUS_PLAFOND
		for x: float in LUM_ALLEE_X:
			_panneau(m, Rect2(x - LUM_RAMPE_L * 0.5, LUM_ALLEE_Z - LUM_RAMPE_LARG * 0.5, LUM_RAMPE_L, LUM_RAMPE_LARG), yp)
			tetes.append(Vector3(x, yp, LUM_ALLEE_Z))
			compte["bandeaux d'allee"] = int(compte.get("bandeaux d'allee", 0)) + 1
	# 4. cage d'escalier : un panneau par niveau desservi, plus un sous le toit de la cage
	for k in escaliers + 1:
		var y := (sols[k + 1] - RAMPE_DALLE - LUM_SOUS_PLAFOND) if k < escaliers else (sols[escaliers] + LUM_CAGE_TOIT)
		_panneau(m, LUM_CAGE, y)
		tetes.append(Vector3(LUM_CAGE.position.x + LUM_CAGE.size.x * 0.5, y, LUM_CAGE.position.y + LUM_CAGE.size.y * 0.5))
		compte["panneaux de cage"] = int(compte["panneaux de cage"]) + 1
	return {"maillage": m, "tetes": tetes, "compte": compte}


static func _panneau(m: Maillage, r: Rect2, y: float) -> void:
	m.quad(Vector3(r.position.x, y, r.position.y), Vector3(r.end.x, y, r.position.y),
			Vector3(r.end.x, y, r.end.y), Vector3(r.position.x, y, r.end.y), Vector3.DOWN, LUM_COULEUR)


# --- rampe extérieure en hélice : SUPPRIMÉE le 2026-09-22 ---------------------------------------------------------
#
# Elle montait le long du bout est de l'aérogare, seul exemplaire à en avoir une ; les trois parkings du centre-ville
# n'avaient aucune rampe. Le joueur les a voulus identiques et tous praticables en voiture (§11, étape 9) : la rampe
# INTÉRIEURE à 16 % tient dans la bande arrière des quatre, donc l'hélice n'avait plus d'emploi. Son code
# (`helice()`, `hauteur()`, `point()`, `_parvis()`, `_pente_max()` et leurs constantes) et la méta
# `parking_helice_axe` sont retirés d'ici ; ils restent dans l'historique git, au commit `033557e` et avant.
# Ce qu'elle a coûté à mesurer, et qui vaut encore si on remet un jour une rampe dehors : à 12 %, 4,57 m d'un plancher
# à l'autre exigent 38,1 m de rampe dans une dalle de 42 m, d'où le passage dehors ; une hélice tient la pente sur
# 300° de tour, bord intérieur à 11,7 % ; et sa jupe fermée jusqu'au sol ENFERMAIT la bouche de la rampe d'entrée,
# piège qui n'est apparu qu'en y conduisant une voiture.
