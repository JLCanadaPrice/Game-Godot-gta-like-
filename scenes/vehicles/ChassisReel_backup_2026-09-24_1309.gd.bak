extends "res://assets/car_physics/MAIN/car.gd"

# CHÂSSIS RÉEL (essai du 2026-09-24, étape 1 de la conduite réaliste, CLAUDE.md §13).
#
# La voiture du joueur reste une Car (Car.gd) : son modèle, ses feux, sa zone de tir, sa zone d'écrasement, ses taches,
# sa place dans la circulation. Quand le joueur prend le volant en conduite réaliste (F7), elle se dote de ce
# châssis — le cœur physique du pack VitaVehicle (un RigidBody3D, quatre roues à rayon, boîte automatique, pneus), réparé
# le 2026-09-21 (f2fe587) — et le SUIT : la Car prend sa position et son cap, son modèle son roulis et son tangage, ses
# roues leur rotation, leur braquage et leur débattement. Le châssis est invisible et ne porte que la physique.
#
# Construit sur les MESURES du modèle (Car._mesures_chassis) et sur la FICHE du véhicule (FichesVehicules, le tableau
# resources/vehicle_physics/fiches_vehicules.csv, CLAUDE.md §14) : roues posées sur les centres relevés (6 pour un tandem,
# 2 physiques pour un essieu arrière d'une seule pièce), pneu au rayon relevé, empattement et voie du modèle, coque = la
# silhouette du modèle (une par pièce de caisse pour les camions, bus et pick-up) relevée à la garde au sol de la fiche ;
# masse, centre de gravité, puissance, vitesse de pointe, suspension, barres anti-roulis, adhérence, freins, traînée : ceux
# de la fiche. Convention de masse de l'auteur du pack : Weight = masse en kg, masse du corps = Weight / 10 (ses forces
# sont au dixième des vraies). Tout ce qui dans le pack ne suit pas la masse est ramené à elle ici, roue par roue (cf.
# configurer) : ressorts et amortisseurs, raideur des pneus, couple des freins, seuils de l'ABS.
#
# Repère du châssis : celui du pack, avant en +Z, gauche en +X (celui de la Car a l'avant en -Z : demi-tour autour de Y).
#
# Trois défauts du pack corrigés ici, sans toucher à ses fichiers :
#  - PÉDALES RESTÉES ENFONCÉES À LA SORTIE. Le pack ne met ses pédales à jour que si `Controlled` ; en sortant le pied
#    sur W, l'accélérateur restait enfoncé et la voiture vide repartait. Et il lit W et S même sans conducteur, pour
#    passer une vitesse depuis le point mort : un joueur qui marche à côté (mêmes touches) l'enclenchait. Sans conducteur,
#    c'est maintenant le stationnement : pédales à zéro, frein de parking, frein à main (controls).
#  - RECUL APRÈS UN ARRÊT (~5 cm/s, CLAUDE.md §5). Le pack n'a aucune résistance au roulement et passe au point mort
#    sous 1,5 m/s. Résistance au roulement (CRR) ; et, sans pédale, sous V_MAINTIEN, le frein tient la voiture comme un
#    maintien automatique — relâché dès qu'on accélère.
#  - W QUI NE RÉPOND PAS TOUT DE SUITE. Depuis le point mort, la boîte attendait ~0,5 s avant d'enclencher la première ;
#    ramené à ~3 pas. La marche arrière garde son délai : c'est S TENU à l'arrêt qui recule, pas un appui bref.
#
# Et la voiture du pack n'est PAS une berline : mesuré le 2026-09-24 (ConduiteReelleTest --trace), elle plafonnait à
# 82,7 km/h en DEUXIÈME, à 6 400 tr/min, sans jamais atteindre les 6 500 tr/min où sa boîte passe la troisième — environ
# 20 kW aux roues, quand une berline en a 80 à 110, et une traînée LINÉAIRE en vitesse (0,025 x v m/s²), 2,5 fois la
# vraie à 100 km/h. Réglée ici sur chaque véhicule : traînée en v², sur la surface frontale MESURÉE du modèle et le cx de
# sa fiche ; couple du moteur multiplié selon la puissance de la fiche (couple_pour) ; boîte étagée pour sa vitesse de
# pointe, tenue par un limiteur.
# Enfin le pneu du pack est VISQUEUX : sa force naît du glissement, et une voiture freinée en pente doit glisser un peu
# pour être retenue (mesuré : 3,7 cm en 2 s sur la rampe à 16 %). Freinée et presque arrêtée, elle est maintenant tenue
# franchement, dans la limite de l'adhérence (_adherence_arret).
#
# DIRECTION (2026-09-24, demande du joueur après les vidéos : « 45 % de volant donne 5,8 m de rayon au lieu de 9, à
# 12 km/h »). L'assistance de direction du pack ajoute au volant deux termes : un contre-braquage proportionnel au lacet
# (SteeringAssistanceAngular), et un terme de DÉRIVE (SteeringAssistance), moins le sinus de l'angle entre la vitesse du
# centre de gravité et l'axe de la voiture. En virage lent, ce centre, à 1,39 m devant l'essieu arrière, file vers
# l'INTÉRIEUR du virage — c'est la géométrie, pas une glissade — : le pack le prend pour une dérive, rajoute du braquage,
# le virage se resserre, et ainsi de suite jusqu'à la butée. Mesuré (sonde hors dépôt, D:/p-recree/sondes/2026-09-24_braquage/),
# 45 % de volant à 12 km/h : braquage effectif x 1,82, rayon 5,3 m pour 9,5 m à l'épure ; sans le terme de lacet c'est
# pire (x 2,2) ; sans assistance, 10,2 m. À vitesse c'est l'inverse : l'assistance reprend du braquage (x 0,59 à 43 km/h),
# et c'est elle qui tient la voiture dans les changements de voie mesurés à 108 km/h. Elle est donc DOSÉE PAR LA VITESSE :
# nulle sous ASSISTANCE_V0 (en manœuvre, le rayon suit le volant), entière au-delà de ASSISTANCE_V1 (rien ne change à
# vitesse), en courbe douce entre les deux.

const Roue := preload("res://scenes/vehicles/ChassisRoue.gd")

# Réglages communs à tous les véhicules ; tout ce qui est propre à l'un d'eux vient de sa fiche.
const DEBATTEMENT := 0.51         # longueur du rayon de roue au-delà du rayon du pneu (la berline de l'étape 1 : 0,81 m)
const BUTEE := 0.10               # course de compression entre le repos et la butée
const RPM_VMAX := 6000.0          # régime en cinquième à la vitesse de pointe : celui de la puissance maximale du moteur
const RPM_MONTEE := 6300.0        # boîte automatique : passage au rapport supérieur, pied au plancher
const RPM_DESCENTE := 3700.0      # rétrogradage quand le rapport inférieur tomberait sous ce régime, pied au plancher
const CHARGE_REF := 4.37          # charge (pack, par pas) d'une roue avant de la berline de l'étape 1, où la raideur du pneu
                                  # du pack était juste : elle suit ici la charge de chaque roue
const MARGE_FREIN_AV := 0.03      # répartition du freinage : un peu plus sur l'avant que la charge au freinage maximal
const CRR := 0.012                # résistance au roulement d'un pneu de tourisme sur enrobé
const FREIN_MOTEUR := 0.4         # m/s² : frein moteur, en prise, pied levé (cf. _frein_moteur)
const KW_ROUES_PAR_K := 70.0      # puissance aux roues par unité du multiplicateur de couple (mesurée, cf. couple_pour)
const RENDEMENT_TRANSMISSION := 0.85
const V_MAINTIEN := 1.5           # m/s : sous cette vitesse, sans pédale, le frein ralentit puis tient la voiture
const FREIN_RALENTIR := 0.35      # pédale de frein appliquée en roulant sous V_MAINTIEN
const V_ARRET := 0.3              # m/s : en deçà, maintien franc
const FREIN_MAINTIEN := 1.0
const DELAI_MARCHE_AVANT := 4     # compte de la boîte (décrémenté de 2 par pas), 60 dans le pack
const REPOS_V := 0.05             # m/s et rad/s : immobile
const REPOS_PAS := 30             # pas physiques immobile, sans conducteur, avant de figer le corps
const MU_ARRET := 0.8             # adhérence d'un pneu arrêté sur enrobé sec
const GLISSE_SATURATION := 0.945 # m/s : glissement où le pneu du pack sature, à l'arrêt et adhérence 1 (cf. _antipatinage)
const PART_ANTIPATINAGE := 0.9    # l'antipatinage tient les roues motrices à cette part de ce glissement
const GAIN_ANTIPATINAGE := 1.0
const ASSISTANCE_DERIVE := 1.0    # SteeringAssistance du pack (car.gd), entière au-delà de ASSISTANCE_V1
const ASSISTANCE_LACET := 0.12    # SteeringAssistanceAngular du pack, idem
const ASSISTANCE_V0 := 5.0        # m/s (18 km/h) : en dessous, pas d'assistance de direction (cf. DIRECTION en tête)
const ASSISTANCE_V1 := 10.0       # m/s (36 km/h) : au-delà, l'assistance du pack entière

var cout_roues_us := 0            # versé par les roues (ChassisRoue), remis à zéro à chaque pas
var roues: Array = []             # les roues du châssis, dans l'ordre des mesures
var fige := false
var _gel_culler := false
var _maintien := false
var _pas_repos := 0
var _cout_car_us := 0
var _cout_dernier_pas := 0
var _g := 9.8
var _tailles := {}                # roue -> rayon du pneu en unités du pack (w_size de wheel.gd, calculé à son 1er pas seulement)
var fiche := {}                   # la fiche du véhicule (FichesVehicules)
var v_max := 70.0                 # vitesse de pointe (m/s), tenue par le limiteur (controls)
var _c_trainee := 0.0             # traînée : décélération = _c_trainee x v² (1/m)


# Construit le châssis sur les mesures du modèle (cf. Car._mesures_chassis), AVANT son entrée dans l'arbre : le _ready du
# pack cherche ses roues motrices par leur nom.
func configurer(m: Dictionary, braquage_max: float, f: Dictionary) -> void:
	name = "ChassisReel"
	fiche = f
	var masse_kg := FichesVehicules.nombre(f, "masse_kg")
	Weight = masse_kg                # convention de l'auteur du pack : Weight en kg, masse du corps = Weight / 10
	mass = masse_kg / 10.0
	LengthScale = 0.3
	TransmissionType = 1
	DragCoefficient = 0.0            # la traînée linéaire du pack est remplacée par _trainee()
	LiftAngle = 0.0                  # le couple cabreur du pack, proportionnel à la vitesse, sans réalité physique
	regler_couple(couple_pour(FichesVehicules.nombre(f, "puissance_kw")))
	v_max = FichesVehicules.nombre(f, "vitesse_max_kmh") / 3.6
	Controlled = false
	can_sleep = false
	continuous_cd = true
	# AMORTISSEMENT DU CORPS (trouvé le 2026-09-24). Un RigidBody3D reçoit par défaut celui du projet, 0,1 /s en
	# translation comme en rotation (physics/3d/default_linear_damp) : une « traînée » de 0,1 x v, soit 2,5 m/s² à 90 km/h
	# et 5,4 à 195 — plus que la traînée et le roulement réels réunis. Mesuré sur la berline : ses pneus avant poussaient
	# de 6,4 kN à 90 km/h, elle n'accélérait que de 2,1 m/s². Traînée et roulement sont modélisés ici (_trainee,
	# _resistance_roulement), la rotation est amortie par les amortisseurs et les pneus : le corps n'en reçoit pas d'autre.
	linear_damp_mode = RigidBody3D.DAMP_MODE_REPLACE
	linear_damp = 0.0
	angular_damp_mode = RigidBody3D.DAMP_MODE_REPLACE
	angular_damp = 0.0
	collision_layer = 4          # la couche des véhicules, comme Car.tscn
	collision_mask = 5           # décor + véhicules, comme Car.tscn
	contact_monitor = true
	max_contacts_reported = 4
	_g = float(ProjectSettings.get_setting("physics/3d/default_gravity", 9.8))
	var liste: Array = m["roues"]
	var y_sol: float = m["y_sol"]
	var z_av := 0.0
	var z_ar := 0.0
	var n_av := 0
	var n_ar := 0
	for r: Dictionary in liste:
		if bool(r["avant"]):
			z_av += (r["centre"] as Vector3).z
			n_av += 1
		else:
			z_ar += (r["centre"] as Vector3).z
			n_ar += 1
	z_av /= float(n_av)
	z_ar /= float(n_ar)
	var empattement := z_av - z_ar
	# géométrie de direction du pack : centre du virage sur l'essieu arrière prolongé (le milieu d'un tandem), à
	# Steer_Radius de l'axe à fond de braquage — le rayon du modèle bicyclette au même angle (MAX_STEER_RAD de Car.gd)
	AckermannPoint = z_ar
	Steer_Radius = empattement / tan(braquage_max)
	var calc := FichesVehicules.calculees(f, float(m["voie"]), float(m["hauteur"]), n_av, n_ar)
	var avant := FichesVehicules.nombre(f, "avant_pct") / 100.0
	var cdg := Vector3(0.0, y_sol + float(calc["cdg_m"]), z_ar + avant * empattement)
	center_of_mass_mode = RigidBody3D.CENTER_OF_MASS_MODE_CUSTOM
	center_of_mass = cdg
	var trainee := Marker3D.new()
	trainee.name = "DRAG_CENTRE"
	trainee.position = cdg
	add_child(trainee)
	_c_trainee = 0.5 * 1.225 * FichesVehicules.nombre(f, "cx") * float(m["surface"]) / masse_kg
	var k := 0
	for forme in m["coques"]:
		var cs := CollisionShape3D.new()
		cs.name = "Coque" if k == 0 else "Coque_%d" % k
		cs.shape = forme
		add_child(cs)
		k += 1
	# Roues. Chaque ressort porte sa part du poids : raideur et amortisseur de la fiche (N/mm et N.s/m réels), ramenés aux
	# unités du pack (forces au dixième, une impulsion par pas de 1/60 s) ; posées au-dessus du centre relevé de la course
	# à vide moins l'écrasement statique, pour que la roue repose exactement sur le centre de la roue du modèle. Le pneu du
	# pack a une raideur qui ne suit pas la charge : elle y est ramenée (CHARGE_REF). Barre anti-roulis : le pack module le
	# ressort d'une roue par l'écart de compression avec sa jumelle ; AR_Elast = phi / ((1 - phi) x 2 x écrasement) donne
	# à la barre la part phi de la raideur en roulis de l'essieu.
	var transmission := FichesVehicules.texte(f, "transmission")
	var par_pas := mass * _g / float(Engine.physics_ticks_per_second)
	var adherence := FichesVehicules.nombre(f, "adherence")
	# Répartition du freinage : celle de la charge au freinage maximal de la fiche (le transfert vers l'avant vaut
	# hauteur du centre de gravité / empattement x décélération / g), un peu plus sur l'avant. Moins, les roues arrière
	# bloquent avant les avant et la voiture part en tête-à-queue au freinage (mesuré : 34,5° sur la berline, dont
	# l'arrière ne porte plus que 17 % du poids à 9,5 m/s²) ; plus, elle freine moins fort qu'elle ne pourrait.
	var transfert := float(calc["cdg_m"]) / empattement * FichesVehicules.nombre(f, "freinage_ms2") / _g
	var frein_av := clampf(avant + transfert + MARGE_FREIN_AV, 0.5, 0.9)
	var somme_biais := 0.0
	var somme_rayons := 0.0
	var r_motrices := 0.0
	var motrices: Array[String] = []
	for r: Dictionary in liste:
		var av := bool(r["avant"])
		var n := n_av if av else n_ar
		var charge := (avant if av else 1.0 - avant) * par_pas / float(n)
		var ressort := float(calc["raideur_av_nmm" if av else "raideur_ar_nmm"]) * 1000.0 / 10.0 / 60.0
		var amort := float(calc["amort_av_nsm" if av else "amort_ar_nsm"]) / 10.0 / 60.0
		var j0 := charge / ressort
		var jante := maxi(roundi((float(r["rayon"]) / 0.00049035 - 222.0) / 25.4), 10)
		var rayon_pneu := (222.0 + 25.4 * jante) * 0.00049035
		var longueur := rayon_pneu + DEBATTEMENT
		var w = Roue.new()
		w.name = String(r["nom"])
		w.target_position = Vector3(0.0, -longueur, 0.0)
		w.position = (r["centre"] as Vector3) + Vector3(0.0, longueur - j0 - rayon_pneu, 0.0)
		w.TyreSettings = {"GripInfluence": adherence, "Width (mm)": 185.0, "Aspect Ratio": 60.0, "Rim Size (in)": float(jante)}
		var gomme: Dictionary = (w.CompoundSettings as Dictionary).duplicate()
		gomme["Stiffness"] = charge / CHARGE_REF
		w.CompoundSettings = gomme
		w.S_Stiffness = ressort
		w.S_Damping = amort
		w.S_ReboundDamping = amort
		w.S_MaxCompression = j0 + BUTEE
		var biais := (frein_av if av else 1.0 - frein_av) * 2.0 / float(n)
		w.B_Bias = biais
		somme_biais += biais
		somme_rayons += rayon_pneu
		w.HB_Bias = 0.0 if av else 1.0
		w.A_Geometry1 = 0.345 * rayon_pneu / 0.2957
		w.SwayBarConnection = String(r["jumelle"])
		var phi := clampf(FichesVehicules.nombre(f, "antiroulis_av_pct" if av else "antiroulis_ar_pct") / 100.0, 0.0, 0.85)
		w.AR_Elast = phi / ((1.0 - phi) * 2.0 * j0)
		if av:
			w.Caster = 2.0
		if transmission == "I" or (transmission == "T") == av:
			w.Differed_Wheel = String(r["jumelle"])
			motrices.append(String(r["nom"]))
			r_motrices += rayon_pneu
		for chemin in ["geometry", "animation", "animation/camber", "animation/camber/wheel", "velocity", "velocity/step",
				"velocity2", "velocity2/step"]:
			var parent: Node = w if not chemin.contains("/") else w.get_node(chemin.get_base_dir())
			var nd := Marker3D.new()
			nd.name = chemin.get_file()
			parent.add_child(nd)
		# repos : la roue sur le centre relevé
		var centre_local := Vector3(0.0, -(longueur - j0) + rayon_pneu, 0.0)
		(w.get_node("geometry") as Node3D).position = centre_local
		(w.get_node("animation") as Node3D).position = centre_local
		add_child(w)
		roues.append(w)
		_tailles[w] = rayon_pneu / LengthScale
	Powered_Wheels = motrices
	# freins : la décélération de la fiche, quelle que soit la masse (la force d'un frein du pack ne la suit pas)
	var b_couple := mass * FichesVehicules.nombre(f, "freinage_ms2") / (60.0 * (somme_rayons / float(liste.size())) * somme_biais)
	for w in roues:
		w.B_Torque = b_couple
	# l'ABS du pack (toutes les roues à la fois, par à-coups) est coupé : chaque roue a le sien (ChassisRoue)
	var reglage_abs: Array = ABS.duplicate()
	reglage_abs[3] = false
	ABS = reglage_abs
	# Boîte : le pont pour que la cinquième atteigne la vitesse de pointe à RPM_VMAX ; la boîte automatique décide sur la
	# vitesse des roues motrices multipliée par leur rayon en pieds (AutoSettings[0] x w_size) : ses seuils y sont ramenés,
	# faute de quoi elle ne quittait jamais la première au-delà de 0,33 m de rayon (SUV, pick-up, camions, bus), et l'écart
	# de rétrogradage (300 tr/min x w_size dans le pack) la faisait hésiter entre deux rapports.
	r_motrices /= float(maxi(motrices.size(), 1))
	FinalDriveRatio = RPM_VMAX * r_motrices / (float(GearRatios[GearRatios.size() - 1]) * RatioMult * v_max)
	var taille: float = r_motrices / float(LengthScale)
	var auto: Array = AutoSettings.duplicate()
	auto[0] = RPM_MONTEE / taille
	auto[1] = (RPM_MONTEE - RPM_DESCENTE) / taille
	AutoSettings = auto


# Multiplicateur du couple du moteur du pack pour un moteur de `p_kw`. Mesuré en accélération pied au plancher (sonde hors
# dépôt, D:/p-recree/sondes/2026-09-24_fiches/sonde_puissance, puissance réelle aux roues = 10 x (m a + traînée +
# roulement) x v) : KW_ROUES_PAR_K kW aux roues par unité de k, de 68 à 73 selon le véhicule (berline, micro-citadine,
# sportive, camion, bus, k de 0,3 à 6) ; et la transmission en perd 15 %, comme une vraie.
static func couple_pour(p_kw: float) -> float:
	return p_kw * RENDEMENT_TRANSMISSION / KW_ROUES_PAR_K


func _ready():
	super()
	body_entered.connect(_contact)


# Couple du moteur : celui de la voiture du pack (les valeurs par défaut de car.gd, que PlayerCarPhysics garde) x k.
func regler_couple(k: float) -> void:
	BuildUpTorque = 0.0035 * k
	TorqueRise = 30.0 * k
	OffsetTorque = 110.0 * k
	VVT_BuildUpTorque = 0.0
	VVT_TorqueRise = 60.0 * k
	VVT_OffsetTorque = 70.0 * k
	# Pertes internes du moteur. Sa traînée (proportionnelle au régime, le gros des pertes à haut régime) suit k : la
	# puissance devient alors proportionnelle à k, sans le décalage de -27 kW qu'elle faisait (mesuré). Son frottement (qui
	# pèse surtout au ralenti) ne suit k qu'en dessous de 1 : sans quoi un petit moteur (k < 0,8) calait au départ, et au-
	# dessus le ralenti du pack décrochait au premier pas (k = 1,9 à 3, mesuré : le régime tombait à zéro avant qu'on
	# n'accélère).
	EngineFriction = 18000.0 * minf(k, 1.0)
	EngineDrag = 0.006 * k
	# l'embrayage du pack transmet au plus ClutchGrip : sans lui, le surcroît de couple le fait patiner, le moteur monte au
	# limiteur pendant que les roues restent sous le régime de passage, et la boîte ne monte plus (mesuré à k = 3)
	ClutchGrip = 176.125 * k * 1.15


# Premier pas, ou reprise après un gel : vitesse du corps et des roues, relevés de vitesse des roues à jour.
func repartir(v_monde: Vector3) -> void:
	linear_velocity = v_monde
	angular_velocity = Vector3.ZERO
	var v_av: float = v_monde.dot(global_transform.basis.z) / float(LengthScale)
	for w in roues:
		w.repartir(v_monde, v_av / float(_tailles.get(w, 1.0)))


# Vitesse le long de l'avant de la voiture (m/s), négative en marche arrière.
func vitesse_avant() -> float:
	return linear_velocity.dot(global_transform.basis.z)


# Frein réellement appliqué (pédale ou frein à main) : les feux de freinage de la Car.
func freine() -> bool:
	return brakepedal > 0.05 or handbrakepull > 0.05


func rapport() -> String:
	if gear < 0:
		return "R"
	if gear == 0:
		return "N"
	return str(gear)


# Temps passé dans les scripts du châssis (corps + quatre roues) au dernier pas physique complet, en microsecondes.
func cout_dernier_pas_us() -> int:
	return _cout_dernier_pas


func _physics_process(delta):
	var t0 := Time.get_ticks_usec()
	# les roues du pas précédent ont tourné après le corps : le pas précédent est complet
	_cout_dernier_pas = _cout_car_us + cout_roues_us
	cout_roues_us = 0
	if Controlled and gear == 0 and gas and sassistdel > DELAI_MARCHE_AVANT:
		sassistdel = DELAI_MARCHE_AVANT
	super(delta)
	_cout_car_us = Time.get_ticks_usec() - t0


# Après les impulsions des quatre roues (appelé par la dernière, cf. ChassisRoue) : ce qui manque au pack.
func apres_roues() -> void:
	var au_sol := _au_sol()
	if au_sol:
		_resistance_roulement()
		_frein_moteur()
	_trainee()
	if au_sol:
		_adherence_arret()
	_repos()


# Le pack calcule à chaque image le couple du moteur pour un affichage de debug : rien à afficher ici.
func _process(_delta):
	pass


# Pédales. Sans conducteur : le stationnement, quoi qu'on presse à côté. Avec : le pack, puis le maintien à l'arrêt.
func controls():
	if not Controlled:
		gas = false
		brake = false
		handbrake = false
		left = false
		right = false
		gaspedal = 0.0
		brakepedal = FREIN_MAINTIEN
		handbrakepull = MaxHandbrake
		_maintien = false
		return
	# assistance de direction dosée par la vitesse (cf. DIRECTION en tête) : le pack la lit dans controls()
	var dose := smoothstep(ASSISTANCE_V0, ASSISTANCE_V1, absf(vitesse_avant()))
	SteeringAssistance = ASSISTANCE_DERIVE * dose
	SteeringAssistanceAngular = ASSISTANCE_LACET * dose
	super.controls()
	# BOÎTE BLOQUÉE EN DEUXIÈME (trouvé le 2026-09-24) : le pack borne ses pédales (limits) APRÈS avoir décidé des
	# passages de rapport (transmission). Pied au plancher, la boîte voyait donc un accélérateur à 1,2 et attendait
	# 6 500 x 1,1 = 7 150 tr/min (x le rayon du pneu, en pieds) pour monter — au-dessus du limiteur à 7 000 : en deuxième,
	# le moteur n'y arrive jamais, et la voiture plafonnait à 83-86 km/h. Bornées ici, avant la boîte.
	gaspedal = clampf(gaspedal, 0.0, MaxThrottle)
	brakepedal = clampf(brakepedal, 0.0, MaxBrake)
	handbrakepull = clampf(handbrakepull, 0.0, MaxHandbrake)
	# LIMITEUR : la vitesse de pointe de la fiche ; les gaz s'effacent sur les 2 derniers m/s
	var v_av := vitesse_avant()
	if v_av > v_max - 2.0:
		gaspedal = minf(gaspedal, clampf((v_max - v_av) / 2.0, 0.0, 1.0))
	_antipatinage()
	if gas and _maintien:
		# on accélère : le maintien lâche tout de suite, sans attendre que la pédale remonte au rythme du pack
		brakepedal = 0.0
		_maintien = false
	elif not gas and not brake and not handbrake:
		var v := linear_velocity.length()
		if v < V_MAINTIEN and _au_sol():
			brakepedal = maxf(brakepedal, FREIN_MAINTIEN if v < V_ARRET else FREIN_RALENTIR)
			_maintien = true
	else:
		_maintien = false


# ANTIPATINAGE. Le pack en déclare un (TTCS) mais ne l'a jamais écrit : `tcsweight`, qui divise la consigne des gaz,
# restait à zéro. Sans lui, le couple de la berline de l'étape 1 faisait patiner les roues avant de 20 à 45 m/s au départ.
# On l'alimente ici : au-delà de la consigne de glissement des roues motrices, les gaz sont coupés en proportion (le
# rapport engagé et la boîte n'en sont pas affectés : la pédale, elle, reste où le joueur l'a mise).
# LA CONSIGNE EST LE GLISSEMENT OÙ LE PNEU SATURE (2026-09-24). Le pneu du pack pousse en proportion du glissement jusqu'à
# son adhérence, puis plafonne ; au-delà, il ne pousse pas plus, mais il n'a plus rien pour tenir la voiture en travers.
# La consigne était 1,5 m/s + 25 % de la vitesse, bien au-delà : à 90 km/h les roues arrière d'une sportive de 588 kW
# (lowpoly_fenyr) patinaient de 3 à 7 m/s, et elle partait de travers en ligne droite, volant au centre, jusqu'à faire
# demi-tour. Ce glissement se lit dans wheel.gd : adhérence / raideur du pneu, où la charge se simplifie (la raideur
# suit la charge, CHARGE_REF) et où la raideur baisse avec la vitesse (`deviding` = v / 50 + 0,5, en unités du pack, au
# moins 1) : GLISSE_SATURATION x adhérence x max(1, v / (50 x 0,3) + 0,5), soit 0,95 m/s à l'arrêt, 2 m/s à 90 km/h.
func _antipatinage() -> void:
	if gear == 0:
		return
	var v_sol := absf(vitesse_avant())
	var glisse := 0.0
	for w in c_pws:
		glisse = maxf(glisse, absf(float(w.wv) * float(_tailles.get(w, 1.0)) * float(LengthScale)) - v_sol)
	var consigne := PART_ANTIPATINAGE * GLISSE_SATURATION * FichesVehicules.nombre(fiche, "adherence")
	consigne *= maxf(1.0, v_sol / (float(LengthScale) * 50.0) + 0.5)
	tcsweight = maxf(0.0, glisse - consigne) * GAIN_ANTIPATINAGE


func _au_sol() -> bool:
	for w in roues:
		if w.is_colliding():
			return true
	return false


# Résistance au roulement : une force constante opposée au roulement, tant que les roues touchent le sol.
func _resistance_roulement() -> void:
	var avant := global_transform.basis.z
	var v := linear_velocity.dot(avant)
	if absf(v) < 0.05:
		return
	var impulsion := minf(CRR * mass * _g / float(Engine.physics_ticks_per_second), absf(v) * mass)
	apply_central_impulse(-signf(v) * avant * impulsion)


# FREIN MOTEUR (2026-09-24). Pied levé, en prise, une vraie voiture ralentit aussi par son moteur. Celui du pack n'en
# donne presque pas : sa boîte automatique n'embraye qu'en proportion du régime (plein à 4 000 tr/min), et pied levé le
# régime tombe. Tant que le corps recevait l'amortissement du projet (cf. configurer), celui-ci en tenait lieu, trop
# fort : la berline, pied levé à 49 km/h, s'arrêtait en 15 s (0,9 m/s²). Sans lui, elle roulait encore à 17 km/h au bout
# d'une minute, comme au point mort. FREIN_MOTEUR, plus le roulement et la traînée : ~0,55 m/s² à 50 km/h, l'ordre de
# grandeur d'une automatique pied levé ; il s'efface sous V_MAINTIEN, où le maintien à l'arrêt prend le relais.
func _frein_moteur() -> void:
	if not Controlled or gear <= 0 or gaspedal > 0.05 or brakepedal > 0.05:
		return
	var avant := global_transform.basis.z
	var v := linear_velocity.dot(avant)
	if v < V_MAINTIEN:
		return
	apply_central_impulse(-avant * minf(FREIN_MOTEUR / float(Engine.physics_ticks_per_second), v - V_MAINTIEN) * mass)


# Traînée aérodynamique en v² : cx de la fiche, surface frontale mesurée sur le modèle, rapportée à la masse de la fiche.
func _trainee() -> void:
	var v := linear_velocity
	var s := v.length()
	if s < 0.5:
		return
	apply_central_impulse(-v * (s * _c_trainee * mass / float(Engine.physics_ticks_per_second)))


# ADHÉRENCE À L'ARRÊT : freinée (frein, maintien, frein à main, stationnement) et presque arrêtée, la voiture est tenue —
# sa vitesse le long du sol et la poussée de la pente pendant ce pas sont annulées, dans la limite de MU_ARRET. Pas en
# marche arrière demandée (S tenu : la pédale d'accélérateur monte, gaspedal > 0).
# La vitesse est lue dans l'ÉTAT DIRECT du corps, qui compte déjà les impulsions des roues de ce pas : `linear_velocity`
# n'est relue qu'après le pas physique. Avec elle, la gravité était compensée deux fois — par les pneus freinés et par
# ce calcul — et la voiture MONTAIT la rampe à 16 % à 2,4 cm/s (mesuré).
func _adherence_arret() -> void:
	if Controlled and not ((brakepedal > 0.3 or handbrakepull > 0.3) and gaspedal < 0.05):
		return
	var n := Vector3.ZERO
	for w in roues:
		if w.is_colliding():
			n += w.get_collision_normal()
	if n.length() < 0.01:
		return
	n = n.normalized()
	var etat := PhysicsServer3D.body_get_direct_state(get_rid())
	var v: Vector3 = etat.linear_velocity if etat != null else linear_velocity
	var v_sol := v - n * v.dot(n)
	if v_sol.length() > V_ARRET:
		return
	var pas := 1.0 / float(Engine.physics_ticks_per_second)
	var g := Vector3(0.0, -_g, 0.0)
	var impulsion := -(v_sol + (g - n * g.dot(n)) * pas) * mass
	var limite := MU_ARRET * mass * _g * pas
	if impulsion.length() > limite:
		impulsion *= limite / impulsion.length()
	apply_central_impulse(impulsion)


# Sans conducteur et immobile depuis REPOS_PAS pas : on fige le corps, qui ne coûte alors plus rien.
func _repos() -> void:
	if Controlled:
		_pas_repos = 0
		return
	if linear_velocity.length() < REPOS_V and angular_velocity.length() < REPOS_V:
		_pas_repos += 1
		if _pas_repos >= REPOS_PAS:
			figer(false)
	else:
		_pas_repos = 0


func figer(par_culler: bool) -> void:
	if fige:
		return
	fige = true
	_gel_culler = par_culler
	freeze = true
	set_physics_process(false)
	for w in roues:
		w.set_physics_process(false)
		w.enabled = false


func degeler() -> void:
	if not fige:
		return
	fige = false
	_gel_culler = false
	_pas_repos = 0
	freeze = false
	set_physics_process(true)
	for w in roues:
		w.enabled = true
		w.set_physics_process(true)
	repartir(Vector3.ZERO)


# SimulationCuller (via Car.set_simulation_active) : gel hors champ ; au réveil, on ne dégèle que ce que LUI a gelé.
func activer_simulation(actif: bool) -> void:
	if not actif:
		figer(true)
	elif _gel_culler:
		degeler()


# Choc reçu (Car.knock) : le corps repart, poussé.
func pousser(dir: Vector3, force: float) -> void:
	degeler()
	var d := Vector3(dir.x, 0.0, dir.z)
	if d.length() < 0.01:
		return
	apply_central_impulse(d.normalized() * force * 0.5 * mass)


# Choc donné : la voiture de la circulation qu'on percute est sonnée, comme avec la voiture arcade
# (Car._resolve_drive_collisions). Elle reste immobile pour la physique (corps cinématique, masse infinie) : c'est le
# châssis qui encaisse le choc, d'où le rebond.
func _contact(body: Node) -> void:
	if not Controlled or body == get_parent() or not body.is_in_group("vehicle") or not body.has_method("knock"):
		return
	var v := linear_velocity.length()
	if v < 1.0:
		return
	var d := (body as Node3D).global_position - global_position
	d.y = 0.0
	body.knock(d.normalized() if d.length() > 0.01 else global_transform.basis.z, v * 0.6 + 4.0)
