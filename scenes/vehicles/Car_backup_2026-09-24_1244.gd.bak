extends CharacterBody3D

# Voiture arcade (CharacterBody3D, pas de VehicleBody3D).
#  - En circulation : suit CircuitPath (spawn/despawn via LoopSpawner).
#  - Conduite : le joueur monte (E via InteractZone), la voiture quitte sa
#    trajectoire scriptée. À la descente -> épave inerte, despawn après 25 s.
#  - Réactions de choc (recul / tilt) : SCRIPTÉES, pas de vraie physique de
#    collision (cf. note du groupe 2 point 8).

# Hauteur d'origine PAR DÉFAUT en circulation (fallback si le modèle FBX ne
# charge pas). En temps normal `_ride_height` est recalculé par
# _fit_collision_to_model() à partir de la vraie boîte de collision ajustée au
# modèle, pour que le bas de caisse repose pile sur la chaussée (dessus à 0.05).
const RIDE_HEIGHT := 0.66
const ROAD_TOP_Y := 0.05         # = CityKitBuilder.SURFACE_Y (surface roulable au-dessus de l'herbe)
const LANE_SNAP := 4.0

# Calque visuel (doit correspondre à Car.tscn et au cull_mask exclu par les
# décalques de passage piéton dans World.tscn) : exclut cette voiture de la
# projection des décalques, qui sinon "fuient" sur la caisse. Le placeholder
# MeshInstance3D de la scène l'a déjà via son propre `layers`, mais il est
# caché (visible=false) dès qu'un modèle FBX aléatoire est chargé -> il faut
# le réappliquer explicitement sur CHAQUE mesh du modèle réellement affiché.
const DECAL_EXCLUDE_LAYERS := 4

const CAR_MODELS := [
	"res://assets/vehicle_models/NormalCar1.fbx",
	"res://assets/vehicle_models/NormalCar2.fbx",
	"res://assets/vehicle_models/SportsCar.fbx",
	"res://assets/vehicle_models/SportsCar2.fbx",
	"res://assets/vehicle_models/SUV.fbx",
	"res://assets/vehicle_models/Taxi.fbx",
]
# "Cop.fbx" volontairement exclu -> réservé police
# Repli seulement : la circulation tire ses modèles dans le catalogue ci-dessous.

# Catalogue des réglages par modèle (resources/vehicle_models/*.tres) : variantes
# de couleur, échelle, orientation, décalage Y, rôle et poids dans la circulation.
const VehicleCatalog := preload("res://scripts/data/VehicleCatalog.gd")

# Modèle imposé (concessionnaire : le joueur choisit un modèle précis dans
# CarDealershipPanel) -- doit être défini AVANT add_child() (donc avant
# _ready()/_setup_model()) puisque c'est là qu'il est lu. Vide = modèle
# tiré au sort dans le catalogue (rôle civil, pondéré par traffic_weight),
# comme pour une voiture de circulation normale.
@export var forced_model_path: String = ""

# Réglages du modèle visuel : remplacés au chargement par ceux du catalogue
# quand le modèle y figure ; ces valeurs ne servent qu'aux modèles absents.
@export var model_scale := 1.0
@export var model_yaw_deg := 180.0        # orientation native du FBX (comme le modèle Player)
# Décalage vertical du modèle visuel par rapport à l'origine. -0.6 posait
# l'origine du FBX pile sur le bas de la BoxShape3D -> la caisse visible
# s'enfonçait dans la route. Relevé à -0.45 pour qu'elle repose dessus. À
# peaufiner par modèle dans resources/vehicle_models/*.tres.
@export var model_y_offset := -0.45
@export var debug_hitbox := false         # imprime la taille de boîte ajustée par modèle
# Axe de roulement par défaut (repère local de la roue). Depuis le 2026-09-21 il n'est plus appliqué tel quel :
# chaque roue reçoit SON axe, relevé sur la géométrie posée (cf. _mesurer_roue), parce que le X local ne tombe
# pas dans le même sens d'un pack à l'autre. Ne sert plus que de repli pour une roue sans maillage.
@export var wheel_spin_axis := Vector3(1, 0, 0)
# Axe de braquage des roues avant. IMPORTANT : exprimé dans le repère de la
# CAISSE (pas de la roue) -> (0,1,0) = verticale voiture = pivot de direction.
# Appliqué en pré-multiplication dans _update_visuals pour que le braquage se
# fasse toujours autour d'un axe vertical, quelle que soit l'orientation native
# du noeud de roue dans le modèle importé (sinon la roue "cabre" au lieu de braquer).
@export var wheel_steer_axis := Vector3(0, 1, 0)

# --- conduite ---
const DRIVE_ACCEL := 16.0
const DRIVE_MAX_SPEED := 24.0
const DRIVE_REVERSE_MAX := 8.0
const DRIVE_FRICTION := 9.0
const DRIVE_BRAKE := 26.0
# RAYON DE BRAQUAGE DU JOUEUR, PAR MODÈLE (2026-09-22). Historique : le lacet valait TURN_RATE x v / DRIVE_MAX_SPEED,
# soit un rayon CONSTANT de 24 / 2,4 = 10 m à toute vitesse et pour tous les modèles ; le 2026-09-21 il descendait à
# 5,5 m sous 4 m/s, toujours le même pour une citadine et un autocar. C'est maintenant le modèle BICYCLETTE, sur
# l'empattement L MESURÉ du modèle (_mesurer_empattement) : lacet = v x tan(δ) / L, δ = consigne x angle_braquage(v).
#  - À l'arrêt et à basse vitesse, δ vaut MAX_STEER_RAD (29,8°), l'angle que les roues avant montrent à fond : le
#    rayon décrit par l'origine de la voiture est L / tan(δ), et le rayon « entre murs » des fiches techniques (roue
#    avant extérieure, cf. rayon_entre_murs) en découle — environ 5,5 m pour une berline, plus de 12 m pour l'autocar.
#  - Pour rester stable à vitesse, le braquage se réduit : δ ne dépasse pas l'angle qui tient l'accélération latérale
#    à BRAQUAGE_A_LAT (tan δ = L x a / v²). Le rayon croît alors comme v² / a, pour tous les modèles.
# Les roues avant montrent l'angle δ réellement appliqué (cf. _physics_process). La circulation n'est pas concernée :
# elle suit son graphe, et ses roues prennent l'angle de son virage (_braquage_ia).
const BRAQUAGE_A_LAT := 15.0      # m/s² : accélération latérale au plus, braquage à fond (~1,5 g, voiture d'arcade)
# Franchissement de bordure, JOUEUR SEULEMENT (cf. _try_step_up). 0,22 m : les bordures de la carte font
# 0,150 m mesurés sur la collision cuite, la marge couvre les raccords de tuiles sans rendre franchissable un
# muret. 0,32 m d'avance testée : un peu plus que ce que la voiture parcourt en une frame à pleine vitesse.
const STEP_UP_MAX := 0.22
const STEP_UP_AHEAD := 0.32
const ABANDON_DESPAWN := 25.0
const GRAVITY := 18.0
const WHEEL_RADIUS := 0.34
const MAX_STEER_RAD := 0.52       # ~30° de braquage visuel
const KNOCK_TIME := 1.2           # durée pendant laquelle une voiture percutée est "sonnée"
const CRUSH_MIN_SPEED := 5.0      # vitesse mini pour écraser un PNJ
const MAX_STAINS := 8

# --- circulation IA : accélération / freinage / virage progressifs ---
const AI_ACCEL := 3.5             # m/s² pour rejoindre la vitesse de croisière
const BRAKE_EPS := 0.05           # m/s de marge : en deçà, la consigne "descend" par simple bruit
const BRAKE_STOP_SPEED := 0.4     # m/s sous quoi la voiture compte comme arrêtée, feux allumés
const AI_DECEL := 12.0            # m/s² pour freiner (obstacle, arrêt) — DOIT correspondre à la
								   # décélération utilisée dans la formule de distance de freinage
								   # ci-dessous, sinon la voiture peut dépasser la marge de sécurité.
const AI_TURN_RATE_DEG := 100.0   # °/s de rotation max -> virage fluide, pas de snap
# Taux de virage PROPORTIONNEL à la vitesse actuelle (rayon de braquage
# réaliste) plutôt qu'un taux fixe : évite l'effet "pivote sur place" quand
# la voiture est encore lente en sortie de carrefour/d'arrêt, tout en
# gardant une trajectoire large et naturelle une fois lancée.
const MIN_TURN_RADIUS := 6.5      # rayon de braquage visé à vitesse de croisière (m)
const MIN_TURN_RATE_DEG := 35.0   # plancher : peut quand même finir un virage à très basse vitesse
const MAX_TURN_RATE_DEG := 130.0  # plafond : jamais un virage plus serré que ça, même très vite

# --- circulation IA : pas de dépassement, suit la voiture/l'obstacle devant ---
# Détection large : à la vitesse de croisière max (~14 m/s), la distance de
# freinage réelle (v²/2a) est d'environ 12 m -> il faut voir l'obstacle bien
# avant pour avoir le temps de ralentir sans dépasser OBSTACLE_BUMPER_GAP.
const OBSTACLE_LOOK_AHEAD := 22.0     # distance de détection devant soi (m)
# Espace visé entre pare-chocs à l'arrêt, longueurs RÉELLES des deux véhicules
# comprises (bus, camions du catalogue) ; remplace l'ancien écart fixe de 5.5 m de
# centre à centre, calibré pour deux voitures de ~4.2 m (5.5 - 2 x 2.1 = 1.3).
const OBSTACLE_BUMPER_GAP := 1.3        # m
const OBSTACLE_DEFAULT_HALF_LENGTH := 2.0 # véhicule sans _half_length : demi-boîte par défaut de Car.tscn
const OBSTACLE_LANE_HALF_WIDTH := 2.5 # tolérance latérale pour considérer "sur ma voie"
# Voiture qui en retient une autre (file, cédez-le-passage) : gardée éveillée par SimulationCuller tant que l'autre
# attend, même si elle est hors de vue du joueur, pour que la file avance au lieu de rester figée.
const SIM_KEEP_AWAKE_META := &"sim_keep_awake_frame"
const SIM_KEEP_AWAKE_FRAMES := 120

var _path: CircuitPath
var _cur_edge := -1
var _from_node := -1
var _edge_progress := 0.0
var _speed := 10.0
var _lateral := 2.0
var _ring_skip := -1                  # sorties à laisser passer sur l'anneau ; -1 = pas sur un anneau
var _ring_lane := 2.0                 # voie tenue sur l'anneau : RING_INNER ou RING_OUTER
# Véhicule suivi : le plus proche devant, dans le couloir de _obstacle_speed_limit, relevé à chaque
# recheck (null s'il n'y en a pas), et la place qui reste avant de devoir s'arrêter derrière lui. Sert à
# la priorité de virage des AUTRES voitures (cf. retenue_par_une_voiture) et au diagnostic.
var _devant: Object = null
var _devant_ecart := INF
var _passe_outre: Object = null       # véhicule traversé pour rompre un cycle de suivi (cf. _cycle_de_suivi)
var _passe_outre_t := 0.0
# DIAGNOSTIC, sans aucun effet sur la conduite : ce qui a limité la vitesse au dernier calcul
# ("suit", "cede_anneau", "fusion_anneau", "insertion", "priorite_virage", "feu") et le véhicule en
# cause. Lu par les sondes de circulation : sans lui, une sonde doit REFAIRE les règles de Car.gd pour
# dire pourquoi une voiture est arrêtée, et elle se trompe dès que les règles changent (payé le
# 2026-09-21 : la sonde du rond-point décrivait encore les anciennes règles après la correction).
var diag_raison := ""
var diag_objet: Object = null
var _diag_carrefour := ""
var _diag_carrefour_objet: Object = null
var _edges_left := 20
var _ai_speed := 0.0              # vitesse réelle actuelle (rampe vers _speed, ou vers 0 si bloquée)
# Vrai tant que la voiture décélère vers une consigne plus basse (carrefour, obstacle, véhicule
# suivi). Lu par VehicleLights pour les feux de freinage ; sans aucun effet sur la conduite.
var _braking := false
var _heading_deg := 0.0           # cap actuel lissé (degrés autour de Y), tourne à AI_TURN_RATE_DEG max
# Vrai dès que la voiture s'est engagée dans un carrefour à feu VERT (déjà
# dans la marge d'arrêt à ce moment-là) : le feu ne peut plus la faire
# s'arrêter pour CETTE traversée, même s'il passe à l'orange/rouge entre
# temps. Remis à faux à chaque nouvelle arête (nouvelle traversée).
var _committed_to_cross := false
# Vrai dès que la voiture a décidé, à son point de décision, de freiner pour
# s'arrêter à ce carrefour : reste vraie jusqu'à l'arrêt complet (ou la
# nouvelle arête suivante), ne revient pas en arrière même si le feu change
# entre-temps -> évite de changer d'avis en pleine décélération.
var _committed_to_stop := false

# Prochaine arête déjà décidée à l'avance (dès l'approche d'un carrefour à
# feu, cf. _intersection_speed_limit) au lieu d'être tirée au hasard pile au
# moment d'atteindre le noeud. Nécessaire pour la priorité de virage
# ci-dessous : il faut savoir SI et COMMENT la voiture va tourner avant
# qu'elle n'entre dans le bloc, pas seulement au moment d'y entrer.
var _planned_next_edge := -1

# Priorité de virage entre 2 voitures qui tournent en même temps au même
# carrefour (pas concerné si l'une des deux va tout droit) : la voiture
# arrivée en premier dans la zone (rang le plus bas) passe en premier,
# l'autre attend qu'elle ait dégagé le bloc -> règle simple et déterministe,
# pas un tirage au hasard.
var _turn_priority_node := -1        # noeud pour lequel une priorité est active (-1 = aucune)
var _turn_priority_seq := -1         # rang d'arrivée pour CE passage (plus petit = arrivé avant)
var _turn_priority_is_turn := false  # ce passage est-il un vrai virage (pas tout droit) ?
static var _turn_priority_counter := 0
const TURN_DOT_THRESHOLD := 0.7      # < ce cos(angle) entre direction entrante/sortante = virage

# détection d'obstacle : recalculée ~10x/s (pas 60x/s) et avec un léger
# déphasage aléatoire par voiture pour étaler le coût sur plusieurs frames
# plutôt que de le concentrer -> coût CPU quasi divisé par 6 à densité de
# trafic élevée (84 voitures), le freinage restant fluide entre deux recalculs
# grâce à la rampe move_toward sur _ai_speed.
const OBSTACLE_RECHECK_INTERVAL := 0.033
var _obstacle_recheck_timer := 0.0
var _cached_obstacle_speed_limit := 999.0

# liste des véhicules, mise en cache UNE fois par frame physique et partagée
# entre toutes les voitures (évite 84 appels redondants à get_nodes_in_group).
static var _vehicle_cache: Array = []
static var _vehicle_cache_frame: int = -1

# Index spatial des véhicules, reconstruit en même temps que la liste ci-dessus.
#
# Le suivi de voiture (_obstacle_speed_limit) et le cédez-le-passage du rond-point
# parcouraient les 252 véhicules pour CHAQUE voiture, ~30 fois par seconde chacune :
# ~32 000 itérations par frame, dont deux lectures de propriété par réflexion
# ("_half_length" in o, puis o.get(...)) à chaque itération. Mesuré à ~15 ms par
# frame sur les ~22 ms de scripts voiture (CityPerfTest headless, 252 voitures) :
# de loin le premier poste de coût du jeu.
#
# La grille range les véhicules par cellule de GRID_CELL m ; une voiture n'examine
# plus que les 3x3 cellules autour du point cherché. La cellule (24 m) est plus
# large que la plus longue portée de recherche (OBSTACLE_LOOK_AHEAD = 22 m), et le
# bloc 3x3 déborde d'au moins une cellule entière dans chaque direction : tout
# véhicule à portée y est donc TOUJOURS présent. Le résultat est le même qu'avec le
# parcours complet, ce n'est pas une approximation.
#
# Les positions servent uniquement à choisir les candidats ; le calcul lui-même relit
# la position réelle du véhicule, donc rien ne dépend de la fraîcheur de la grille.
# Marge : 24 - 22 = 2 m, alors qu'une voiture parcourt ~0,2 m par frame à 12 m/s.
const GRID_CELL := 24.0
static var _grid: Dictionary = {}   # clé entière de cellule (cf. _cell_key) -> Array d'indices dans _vehicle_cache

var driven_by_player := false
var has_npc_driver := false
# Vrai pour une voiture achetée au concessionnaire (CarDealershipPanel) :
# jamais spawnée via LoopSpawner/CircuitPath (donc jamais concernée par le
# budget d'arêtes de circulation), et exemptée du despawn d'abandon de 25s
# qui s'applique normalement à une voiture IA laissée à l'arrêt.
var is_player_owned := false
var _abandoned := false
var _abandon_gen := 0                 # numéro de la dernière sortie du joueur (cf. stop_drive)
var _drive_speed := 0.0
var _player_braking := false
var _player_near := false
var _steer_input := 0.0

# choc
var _knock_time := 0.0
var _knock_vel := Vector3.ZERO
var _recoil_vel := Vector3.ZERO
var _tilt_pitch := 0.0
var _tilt_roll := 0.0
# ASSIETTE SUR UNE PENTE (2026-09-21). La boîte de collision de la voiture ne s'incline jamais : move_and_slide la
# fait monter une rampe, mais elle reste horizontale, appuyée sur son arête avant (en montée) ou arrière (en
# descente). Sur 12 %, une voiture de 4,5 m roulait donc l'essieu arrière suspendu 0,27 m au-dessus de la rampe.
# Le MODÈLE prend l'angle du sol et descend pour que ses deux essieux touchent la pente. Visuel seulement : la
# physique ne change pas.
# REFAIT LE 2026-09-24 : le sol est relevé AU RAYON SOUS CHAQUE ESSIEU (_poser_assiette), le modèle cabré de l'écart entre
# les deux et descendu pour que chaque essieu se pose sur le sien. Avant, il prenait la normale du sol sous la BOÎTE et
# descendait d'une demi-longueur x tan(angle) — juste sur une pente continue, faux à chaque raccord : au pied d'une rampe,
# la boîte (qui glisse sur son arête avant) touche déjà la pente alors que les roues sont encore sur le plat, et le modèle
# était cabré de tout l'angle de la rampe et descendu d'autant. Mesuré à l'entrée d'un parking à étages (rampe d'accès
# de 27 %, ConduiteReelleTest, étape « entree ») : le dessous de la berline à 0,5 m SOUS le sol ; encore 2 cm sous le
# sol sur la rampe adoucie à 9,6 %. Sur une pente continue, les deux calculs donnent la même pose.
var _pente := 0.0
var _abaisse := 0.0                       # descente du modèle (m) pour que ses essieux se posent sur leur sol
var _sol_essieux := Vector2(NAN, NAN)     # sol relevé sous l'essieu avant (x) et arrière (y), suivi à vitesse bornée
var _z_essieu_av := -1.3                  # essieux, repère de la voiture (avant = -z), MESURÉS (cf. _mesurer_empattement)
var _z_essieu_ar := 1.3
var _stains := 0

# visuel
var _model: Node3D
var model_path := ""                  # modèle réellement chargé (tirage de circulation ou forced_model_path)
var _wheels: Array[Node3D] = []
var _wheels_front: Array[Node3D] = []
var _wheel_rest: Dictionary = {}
var _wheel_axis: Dictionary = {}      # roue -> axe de roulement dans SON repère local (cf. _mesurer_roue)
var _wheel_radius: Dictionary = {}    # roue -> rayon RÉEL, en mètres dans le repère de la voiture
var _wheel_angle: Dictionary = {}     # roue -> angle de roulement cumulé
var _wheel_pas_max: Dictionary = {}   # roue -> plus grand pas angulaire par image AFFICHÉE (cf. _mesurer_roue)
var _wheel_pas_image: Dictionary = {} # roue -> angle déjà parcouru depuis la dernière image affichée
var _roues_image := -1                # image affichée (Engine.get_process_frames) du dernier pas de roue
var _wheel_centre: Dictionary = {}    # roue -> centre géométrique, dans SON repère local (pivot de rotation)
var _wheel_rest_origin: Dictionary = {}   # roue -> position de repos du noeud
var _wheel_parent_base: Dictionary = {}   # roue -> [base de son PARENT dans la voiture, son inverse] (cf. BRAQUAGE)
var _empattement := 2.6               # essieu avant -> essieu arrière, MESURÉ sur les roues (cf. _mesurer_empattement)
var _voie := 1.6                      # entre les centres des roues avant, MESURÉE (cf. _mesurer_empattement)
var _steer_visual := 0.0
var _ride_height := RIDE_HEIGHT       # recalculé selon la boîte ajustée au modèle
var _half_length := 2.0               # demi-longueur (axe -Z avant) de la caisse, recalculée au modèle réel ; 2.0 = moitié de la boîte par défaut de Car.tscn (size.z=4)
# Boîte englobante du modèle (+2 cm), dans le repère de la voiture : une DONNÉE, plus la forme physique (cf. ENVELOPPE).
# Longueur, hauteur de caisse, bande d'impact des taches et tests en dépendent. Par défaut, la boîte de Car.tscn.
var _boite_caisse := AABB(Vector3(-0.9, -0.6, -2.0), Vector3(1.8, 1.2, 4.0))

@onready var _prompt: Label3D = $EnterPrompt

func _ready() -> void:
	add_to_group("vehicle")
	# garde la caisse collée au sol sur les pentes (rampes de bordure) : évite le
	# décollement au sommet et le rebond en redescendant
	floor_snap_length = 0.5
	has_npc_driver = randf() < 0.5
	_setup_model()
	$InteractZone.body_entered.connect(_on_zone_entered)
	$InteractZone.body_exited.connect(_on_zone_exited)
	$CrushZone.body_entered.connect(_on_crush_zone_entered)
	set_process(false)   # _process ne sert qu'à la conduite réaliste (cf. CONDUITE RÉALISTE)
	call_deferred("_print_ride_diag")

# Diagnostic ponctuel : compare la géométrie de collision de la voiture au sol
# réellement sous elle. Imprimé pour la 1re voiture spawnée seulement.
# À retirer une fois la hauteur validée.
static var _diag_done := false
func _print_ride_diag() -> void:
	if _diag_done:
		return
	_diag_done = true
	var bottom_offset := _boite_caisse.position.y              # bas de caisse / origine
	var bottom_global := global_position.y + bottom_offset
	print("[Car diag] boîte de caisse taille=%s  centre local Y=%.3f  -> bas de caisse à %.3f sous l'origine"
		% [_boite_caisse.size, _boite_caisse.get_center().y, -bottom_offset])
	print("[Car diag] origine Y=%.3f  ride_height=%.2f  -> bas de caisse Y global=%.3f"
		% [global_position.y, _ride_height, bottom_global])
	var st := get_world_3d().direct_space_state
	var q := PhysicsRayQueryParameters3D.create(
		global_position + Vector3.UP * 0.5, global_position + Vector3.DOWN * 4.0)
	q.exclude = [get_rid()]
	q.collision_mask = 1
	var h := st.intersect_ray(q)
	if h.is_empty():
		print("[Car diag] aucun sol détecté sous la voiture")
		return
	var ground_y := float((h["position"] as Vector3).y)
	print("[Car diag] sol sous la voiture Y=%.3f  -> écart bas-de-caisse/sol=%.3f (négatif = pénètre)"
		% [ground_y, bottom_global - ground_y])

func _setup_model() -> void:
	var path := forced_model_path
	if path == "":
		path = VehicleCatalog.pick_traffic_path()
	if path == "":   # catalogue vide ou illisible : ancien tirage uniforme
		path = CAR_MODELS[randi() % CAR_MODELS.size()]
	model_path = path
	_apply_model_settings(path)
	var scene := load(path) as PackedScene
	if scene == null:
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(randf(), randf(), randf())
		$MeshInstance3D.material_override = mat
		return
	$MeshInstance3D.visible = false
	_model = scene.instantiate() as Node3D
	add_child(_model)
	_model.scale = Vector3.ONE * model_scale
	_model.rotation_degrees.y = model_yaw_deg
	_model.position.y = model_y_offset

	# le placeholder caché avait déjà le bon calque (cf. DECAL_EXCLUDE_LAYERS) :
	# le modèle réellement affiché doit l'avoir aussi, sur CHAQUE mesh (un FBX
	# de voiture a souvent plusieurs MeshInstance3D : caisse, roues, vitres...).
	var model_meshes := _model.find_children("*", "MeshInstance3D", true, false)
	if _model is MeshInstance3D:
		model_meshes.append(_model)
	for mm in model_meshes:
		(mm as MeshInstance3D).layers = DECAL_EXCLUDE_LAYERS

	# repère les roues (best-effort ; si le modèle est monobloc -> rien ne se passe)
	for w in _model.find_children("*heel*", "", true, false):
		var w3 := w as Node3D
		if w3 == null:
			continue
		_wheels.append(w3)
		_wheel_rest[w3] = w3.transform.basis
		_wheel_rest_origin[w3] = w3.transform.origin
		_mesurer_roue(w3)
		var wn := String(w3.name).to_lower()
		var front_by_name := wn.contains("front") or wn.contains("_f") or wn.contains("fl") or wn.contains("fr")
		# ATTENTION : position dans le repère du PARENT de la roue, qui n'est l'avant de la voiture que si ce parent
		# n'est pas tourné. Faux pour les 54 modèles city_* (parent tourné de 90° autour de X, cf. BRAQUAGE) : ce
		# sont leurs noms (Wheel_FL / Wheel_FR) qui les classent. VehicleCatalogTest vérifie 2 roues avant par modèle.
		var front_by_pos := w3.position.z > 0.0   # +Z local = avant (modèle tourné de 180°)
		if front_by_name or front_by_pos:
			_wheels_front.append(w3)
	_mesurer_empattement()

	_fit_collision_to_model()

# Réglages visuels propres au modèle (resources/vehicle_models/*.tres) : échelle,
# orientation native et décalage vertical. Un modèle absent du catalogue garde
# les valeurs de l'inspecteur.
func _apply_model_settings(path: String) -> void:
	var data := VehicleCatalog.find_by_path(path)
	if data == null:
		return
	model_scale = data.model_scale
	model_yaw_deg = data.model_yaw_deg
	model_y_offset = data.model_y_offset

# Ajuste la BoxShape3D de la caisse aux dimensions RÉELLES du modèle chargé
# (SUV, SportsCar, Taxi... ont des gabarits différents) au lieu d'une boîte
# unique. On calcule l'AABB combinée de tous les MeshInstance3D du modèle dans
# le repère de la voiture, puis on en fait une boîte + on recale la hauteur de
# circulation. Ne touche NI CrushZone NI InteractZone : le comportement de
# collision (choc, écrasement PNJ, poussée) est inchangé, seule la boîte de
# caisse est mieux dimensionnée.
func _fit_collision_to_model() -> void:
	if _model == null:
		return
	var cs := get_node_or_null("CollisionShape3D") as CollisionShape3D
	if cs == null:
		return

	# AABB combinée de tous les meshes du modèle, exprimée dans le repère de la
	# voiture (invariant de la position/rotation courante de la voiture).
	var world_to_car := global_transform.affine_inverse()
	var meshes := _model.find_children("*", "MeshInstance3D", true, false)
	if _model is MeshInstance3D:
		meshes.append(_model)   # cas d'un modèle monobloc
	var aabb := AABB()
	var has := false
	for n in meshes:
		var mi := n as MeshInstance3D
		if mi == null or mi.mesh == null:
			continue
		var b := (world_to_car * mi.global_transform) * mi.mesh.get_aabb()
		if has:
			aabb = aabb.merge(b)
		else:
			aabb = b
			has = true
	if not has:
		return

	var size := aabb.size
	# garde-fou : AABB aberrante (mesh helper parasite, échelle folle) -> on
	# garde la boîte par défaut de Car.tscn
	if size.x <= 0.05 or size.z <= 0.05 or size.length() > 40.0:
		if debug_hitbox:
			print("[Car hitbox] AABB inexploitable %s -> boîte par défaut conservée" % size)
		return
	size += Vector3(0.04, 0.04, 0.04)   # micro-marge, la boîte ne dépasse pas du modèle

	# la caisse peut ne pas être centrée sur l'origine
	_boite_caisse = AABB(aabb.get_center() - size * 0.5, size)
	_half_length = size.z * 0.5         # pour arrêter la voiture AVANT le carrefour, pas son origine dessus

	# repose le bas de la boîte sur la chaussée (+1 cm) pour la circulation
	var box_bottom_local := _boite_caisse.position.y
	_ride_height = ROAD_TOP_Y + 0.01 - box_bottom_local
	_poser_enveloppes(cs)
	_poser_zone_de_tir()
	if debug_hitbox:
		print("[Car hitbox] %s -> L=%.2f l=%.2f h=%.2f  centre=(%.2f,%.2f,%.2f)  ride_h=%.2f"
			% [String(_model.name), size.z, size.x, size.y,
				_boite_caisse.get_center().x, _boite_caisse.get_center().y, _boite_caisse.get_center().z, _ride_height])

# Boîte englobante du modèle dans le repère de la voiture (cf. _boite_caisse), pour les tests et les sondes.
func boite_caisse() -> AABB:
	return _boite_caisse

# ENVELOPPE QUI SUIT LA SILHOUETTE (2026-09-23, CLAUDE.md §12). La forme physique était la boîte englobante : devant la
# bande capot / pare-brise elle débordait de la caisse de 1,44 m en médiane sur les 72 modèles (3,22 m au pire), et le
# joueur ne voulait plus « un gros cube autour de la voiture ». C'est maintenant l'ENVELOPPE CONVEXE du modèle, calculée
# une fois par modèle sur ses sommets : 0,32 m de débord au même endroit. Convexe et pas le maillage exact : deux formes
# concaves ne se touchent pas dans Jolt, et une voiture en trimesh traversait la route (mesuré, -12,7 m en 1,5 s).
# Deux retouches, et seulement deux :
#  - les RÉTROVISEURS ne gonflent pas l'enveloppe : les sommets plus larges que la caisse sous la ceinture (bas 55 % de
#    la hauteur, où il n'y a ni rétroviseur ni galerie) sont ramenés à cette largeur ;
#  - sous les pare-chocs, l'enveloppe descend VERTICALEMENT jusqu'au sol, comme la boîte : c'est cette face basse qui
#    touche les bordures de 0,15 m, et le franchissement du joueur (_try_step_up) comme l'arrêt de la circulation devant
#    elles (CarKerbTest) en dépendent. Capot, toit et coffre gardent leur pente.
# Repli : la boîte, si le modèle n'a rien de mesurable.
# Camions, bus et pick-up : enveloppes PAR PIÈCE, faites dans Blender (tools/enveloppes_pieces.py, à partir de
# tools/EnveloppesExport.gd) et lues ici : une enveloppe unique relierait le toit de la cabine au bout de la benne.
static var _enveloppes := {}   # model_path -> Array de ConvexPolygonShape3D, dans le repère de la voiture
const ENVELOPPES_PIECES := "res://scenes/vehicles/enveloppes_pieces.json"
static var _pieces := {}       # id du modèle -> enveloppes (listes de points), lu une fois
static var _pieces_lues := false

func _poser_enveloppes(cs: CollisionShape3D) -> void:
	if not _enveloppes.has(model_path):
		var formes := _enveloppes_par_piece()
		if formes.is_empty():
			var coque := _enveloppe_silhouette()
			if coque != null:
				formes.append(coque)
		_enveloppes[model_path] = formes
	var formes: Array = _enveloppes[model_path]
	if formes.is_empty():
		var box := BoxShape3D.new()
		box.size = _boite_caisse.size
		cs.shape = box
		cs.position = _boite_caisse.get_center()
		return
	cs.shape = formes[0]
	cs.position = Vector3.ZERO
	for i in range(1, formes.size()):
		var c := CollisionShape3D.new()
		c.name = "Enveloppe_%d" % i
		c.shape = formes[i]
		add_child(c)

func _enveloppes_par_piece() -> Array:
	if not _pieces_lues:
		_pieces_lues = true
		var f := FileAccess.open(ENVELOPPES_PIECES, FileAccess.READ)
		if f != null:
			var lu = JSON.parse_string(f.get_as_text())
			if lu is Dictionary:
				_pieces = lu
	var data := VehicleCatalog.find_by_path(model_path)
	var formes: Array = []
	if data == null or not _pieces.has(data.id):
		return formes
	for env in _pieces[data.id]:
		var pts := PackedVector3Array()
		for p in env:
			pts.append(Vector3(float(p[0]), float(p[1]), float(p[2])))
		var forme := ConvexPolygonShape3D.new()
		forme.points = pts
		formes.append(forme)
	return formes

func _enveloppe_silhouette() -> ConvexPolygonShape3D:
	var faces := PackedVector3Array()
	var liste := _model.find_children("*", "MeshInstance3D", true, false)
	if _model is MeshInstance3D:
		liste.append(_model)
	for n in liste:
		var mi := n as MeshInstance3D
		if mi.mesh != null and mi.visible:
			faces.append_array(_xf_dans_voiture(mi) * mi.mesh.get_faces())
	if faces.size() < 12:
		return null
	var bas := INF
	for v in faces:
		bas = minf(bas, v.y)
	var h := _boite_caisse.size.y
	var demi_largeur := 0.0
	for v in faces:
		if v.y <= bas + 0.55 * h:
			demi_largeur = maxf(demi_largeur, absf(v.x))
	var avant := INF
	var arriere := -INF
	for i in faces.size():
		var v := faces[i]
		if absf(v.x) > demi_largeur:
			faces[i] = Vector3(signf(v.x) * demi_largeur, v.y, v.z)
		if v.y <= bas + 0.35 * h:
			avant = minf(avant, v.z)
			arriere = maxf(arriere, v.z)
	# jupe : les quatre coins au sol à l'aplomb du pare-chocs avant et arrière
	faces.append_array(PackedVector3Array([Vector3(-demi_largeur, bas, avant), Vector3(demi_largeur, bas, avant), Vector3(demi_largeur, bas, arriere),
			Vector3(-demi_largeur, bas, avant), Vector3(demi_largeur, bas, arriere), Vector3(-demi_largeur, bas, arriere)]))
	var am := ArrayMesh.new()
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = faces
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return am.create_convex_shape(true, false)

# ZONE DE TIR EXACTE (2026-09-23, CLAUDE.md §12). Le rayon d'arme du joueur ne voyait pas les voitures (masque décor + PNJ) :
# les balles les traversaient. La voiture porte maintenant, sur une couche À ELLE, COUCHE_TIRS, les triangles exacts de son
# modèle : un tir s'arrête sur la tôle ou la vitre, pas sur l'enveloppe. Rien d'autre ne regarde cette couche (masque
# vide) : ni le déplacement, ni les rayons de sol des PNJ et des lampadaires, qui se poseraient sinon sur les toits.
# Un trimesh sur un corps qui bouge ne sert ici qu'aux rayons ; pour le déplacement il traverserait la route (§12).
const COUCHE_TIRS := 8                  # couche 4
static var _zones_de_tir := {}          # model_path -> ConcavePolygonShape3D, dans le repère de la voiture

func _poser_zone_de_tir() -> void:
	if not _zones_de_tir.has(model_path):
		var faces := PackedVector3Array()
		var liste := _model.find_children("*", "MeshInstance3D", true, false)
		if _model is MeshInstance3D:
			liste.append(_model)
		for n in liste:
			var mi := n as MeshInstance3D
			if mi.mesh != null and mi.visible:
				faces.append_array(_xf_dans_voiture(mi) * mi.mesh.get_faces())
		var forme: ConcavePolygonShape3D = null
		if not faces.is_empty():
			forme = ConcavePolygonShape3D.new()
			forme.set_faces(faces)
			forme.backface_collision = true
		_zones_de_tir[model_path] = forme
	if _zones_de_tir[model_path] == null:
		return
	var corps := StaticBody3D.new()
	corps.name = "ZoneDeTir"
	corps.collision_layer = COUCHE_TIRS
	corps.collision_mask = 0
	var c := CollisionShape3D.new()
	c.shape = _zones_de_tir[model_path]
	corps.add_child(c)
	add_child(corps)

# --- circulation scriptée -----------------------------------------

func setup(path: CircuitPath, start_node: int, speed: float, lateral: float, edges_budget := 20) -> void:
	_path = path
	_from_node = start_node
	_speed = speed
	_lateral = lateral
	_edges_left = edges_budget
	_cur_edge = _path.pick_next_edge(_from_node, -1)
	_edge_progress = 0.0
	_snap_to_path()

func _physics_process(delta: float) -> void:
	if _chassis != null:
		# conduite réaliste (cf. CONDUITE RÉALISTE) : la physique est celle du châssis, la voiture le suit
		_suivre_chassis()
		_drive_speed = _chassis.vitesse_avant()
		_player_braking = driven_by_player and _chassis.freine()
		return
	if driven_by_player:
		_drive_physics(delta)
		# les roues avant montrent l'angle de braquage réellement appliqué (réduit à vitesse, cf. angle_braquage)
		_update_visuals(delta, _drive_speed, _steer_input * angle_braquage(_drive_speed) / MAX_STEER_RAD)
		return

	if _knock_time > 0.0:
		_knock_time -= delta
		_knock_vel = _knock_vel.lerp(Vector3.ZERO, clampf(delta * 2.5, 0.0, 1.0))
		velocity = _knock_vel
		velocity.y = 0.0 if is_on_floor() else velocity.y - GRAVITY * delta
		move_and_slide()
		_update_visuals(delta, _speed * 0.3, 0.0)
		return

	if _abandoned:
		if not is_on_floor():
			velocity.y -= GRAVITY * delta
			move_and_slide()
		_update_visuals(delta, 0.0, 0.0)
		return

	if _path == null or _cur_edge < 0:
		return

	# avance selon la vitesse RÉELLE actuelle (rampe), pas la vitesse de
	# croisière cible -> l'accélération/le freinage se répercutent sur la
	# progression le long de la route, pas juste sur l'affichage.
	_edge_progress += _ai_speed * delta
	var edge_len := _path.edge_length(_cur_edge)
	if _edge_progress >= edge_len:
		_edge_progress -= edge_len
		_from_node = _path.edge_other_node(_cur_edge, _from_node)
		_edges_left -= 1
		if _edges_left <= 0:
			queue_free()
			return
		# Réutilise l'arête déjà décidée à l'avance à l'approche du carrefour
		# (cf. _intersection_speed_limit) si elle existe, pour rester cohérent
		# avec la décision qui a servi à établir la priorité de virage ; sinon
		# (rond-point, simple passage...) tire au hasard comme d'habitude.
		var next_edge: int = _planned_next_edge if _planned_next_edge >= 0 else _choisir_arete(_from_node, _cur_edge)
		if next_edge < 0:
			queue_free()
			return
		_cur_edge = next_edge
		_committed_to_cross = false   # nouvelle arête -> nouvelle traversée, nouvelle décision
		_committed_to_stop = false
		_planned_next_edge = -1

	var target_dir := _path.direction_at(_cur_edge, _from_node, _edge_progress)
	var turn_rate_deg := clampf(rad_to_deg(_ai_speed / MIN_TURN_RADIUS), MIN_TURN_RATE_DEG, MAX_TURN_RATE_DEG)
	var cap_avant := _heading_deg
	_heading_deg = _turn_toward(_heading_deg, _heading_from_dir(target_dir), turn_rate_deg * delta)
	var heading_dir := _dir_from_heading(_heading_deg)

	_obstacle_recheck_timer -= delta
	_passe_outre_t -= delta
	if _obstacle_recheck_timer <= 0.0:
		_obstacle_recheck_timer = OBSTACLE_RECHECK_INTERVAL + randf_range(-0.02, 0.02)
		_diag_carrefour = ""
		_diag_carrefour_objet = null
		var lim_suivi := _obstacle_speed_limit(heading_dir, _speed)
		var lim_carrefour := _intersection_speed_limit(_speed)
		_cached_obstacle_speed_limit = minf(lim_suivi, lim_carrefour)
		if _cached_obstacle_speed_limit >= _speed - 0.01:
			diag_raison = ""
			diag_objet = null
		elif lim_suivi <= lim_carrefour:
			diag_raison = "suit"
			diag_objet = _devant
		else:
			diag_raison = _diag_carrefour
			diag_objet = _diag_carrefour_objet
	var desired_speed: float = _cached_obstacle_speed_limit
	var accel := AI_ACCEL if desired_speed > _ai_speed else AI_DECEL
	# Feux de freinage : c'est ICI que la voiture décide de ralentir, et nulle part ailleurs. Il
	# n'existait aucun indicateur de freinage sur Car — seul _committed_to_stop existait, et il ne
	# couvre que l'arrêt à un carrefour, pas le suivi de véhicule. On le relève donc sur la rampe
	# elle-même : la consigne est sous la vitesse actuelle, donc on décélère. Rien d'inventé.
	_braking = desired_speed < _ai_speed - BRAKE_EPS
	_ai_speed = move_toward(_ai_speed, desired_speed, accel * delta)

	velocity = heading_dir * _ai_speed
	velocity.y = 0.0
	move_and_slide()

	# trajet en 3D (ponts, bretelles de la carte) : hauteur du graphe + hauteur de caisse (graphe du centre-ville à y = 0)
	var ideal := _path.sample_offset(_cur_edge, _from_node, _edge_progress, _path.lane_offset(_cur_edge, _lane_pref()))
	ideal.y += _ride_height
	global_position = global_position.lerp(ideal, clampf(delta * LANE_SNAP, 0.0, 1.0))
	rotation_degrees.y = _heading_deg
	_update_visuals(delta, _ai_speed, _braquage_ia(wrapf(_heading_deg - cap_avant, -180.0, 180.0), delta))

func _snap_to_path() -> void:
	if _path == null or _cur_edge < 0:
		return
	var ideal := _path.sample_offset(_cur_edge, _from_node, _edge_progress, _path.lane_offset(_cur_edge, _lane_pref()))
	ideal.y += _ride_height
	global_position = ideal
	_heading_deg = _heading_from_dir(_path.direction_at(_cur_edge, _from_node, _edge_progress))
	_ai_speed = 0.0   # départ à l'arrêt -> accélération progressive dès la 1re frame
	_committed_to_cross = false
	_committed_to_stop = false
	_planned_next_edge = -1
	_turn_priority_node = -1
	rotation_degrees.y = _heading_deg

# --- helpers cap/vitesse IA -----------------------------------------

static func _heading_from_dir(dir: Vector3) -> float:
	return rad_to_deg(atan2(-dir.x, -dir.z))

static func _dir_from_heading(deg: float) -> Vector3:
	var r := deg_to_rad(deg)
	return Vector3(-sin(r), 0.0, -cos(r))

static func _turn_toward(current_deg: float, target_deg: float, max_step_deg: float) -> float:
	var diff := wrapf(target_deg - current_deg, -180.0, 180.0)
	return current_deg + clampf(diff, -max_step_deg, max_step_deg)

# Cellule encodée en un seul entier plutôt qu'en Vector2i : clé de dictionnaire
# nettement moins chère à hacher, et cette fonction est appelée pour chaque
# véhicule à chaque frame. CELL_BIAS recentre les coordonnées négatives (la ville
# est en X/Z négatifs) ; sa plage couvre +/- 49 km, très au-delà de la carte.
const CELL_BIAS := 2048
const CELL_STRIDE := 4096

static func _cell_key(p: Vector3) -> int:
	return (floori(p.x / GRID_CELL) + CELL_BIAS) * CELL_STRIDE + floori(p.z / GRID_CELL) + CELL_BIAS

static func _cell_key_xz(cx: int, cz: int) -> int:
	return (cx + CELL_BIAS) * CELL_STRIDE + cz + CELL_BIAS

# Reconstruit liste + grille, une seule fois par frame physique pour toutes les
# voitures. Volontairement réduit au strict minimum (une position + un rangement
# par véhicule) : cette passe court sur les 252 véhicules, y compris ceux que
# SimulationCuller a endormis, alors qu'en jeu seule une dizaine de voitures est
# active. Tout ce qui peut n'être lu que pour les quelques candidats réellement
# retenus (la demi-longueur, par exemple) est laissé aux boucles appelantes.
func _refresh_vehicle_index() -> void:
	var f := Engine.get_physics_frames()
	if f == _vehicle_cache_frame:
		return
	_vehicle_cache_frame = f
	_vehicle_cache = get_tree().get_nodes_in_group("vehicle")
	# Les paniers sont VIDÉS, pas détruits : _grid.clear() relâchait chaque frame
	# la centaine de tableaux des cellules occupées, qu'il fallait ensuite
	# réallouer un par un. Les cellules restent d'une frame à l'autre.
	for bucket in _grid.values():
		(bucket as Array).clear()
	for i in _vehicle_cache.size():
		var o := _vehicle_cache[i] as Node3D
		if o == null:
			continue
		var key := _cell_key(o.global_position)
		var bucket: Variant = _grid.get(key)
		if bucket == null:
			bucket = []
			_grid[key] = bucket
		(bucket as Array).append(i)

# Indices des véhicules des cellules autour de `center`, `rings` anneaux autour de
# la cellule centrale (1 -> bloc 3x3, 2 -> 5x5). Le bloc couvre toujours au moins
# `rings * GRID_CELL` mètres dans chaque direction depuis `center`, puisque celui-ci
# est quelque part dans la cellule centrale : 24 m avec 1 anneau, 48 m avec 2.
func _nearby_indices(center: Vector3, rings: int = 1) -> Array:
	var cx := floori(center.x / GRID_CELL)
	var cz := floori(center.z / GRID_CELL)
	var side := rings * 2 + 1
	var out: Array = []
	for dx in side:
		for dz in side:
			var bucket: Variant = _grid.get(_cell_key_xz(cx + dx - rings, cz + dz - rings))
			if bucket != null and not (bucket as Array).is_empty():
				out.append_array(bucket as Array)
	return out

# Vitesse maximale sûre compte tenu des véhicules devant soi sur la voie
# (autre voiture IA arrêtée, épave, OU la voiture du joueur qui bloque le
# passage — toutes dans le groupe "vehicle"). Ralentit progressivement en
# approche puis s'arrête à une distance de sécurité ; ne dépasse jamais.
func _obstacle_speed_limit(heading_dir: Vector3, cruise_speed: float) -> float:
	_refresh_vehicle_index()
	var right := heading_dir.cross(Vector3.UP).normalized()
	var nearest := INF
	var nearest_body: Object = null
	var my_pos := global_position
	var sur_anneau := is_on_ring()
	for idx in _nearby_indices(my_pos):
		var o := _vehicle_cache[idx] as Node3D
		if o == self or o == null:
			continue
		if o == _passe_outre and _passe_outre_t > 0.0:
			continue
		if sur_anneau and o.has_method("ring_arrival_distance"):
			# sur l'anneau, on ne suit que ce qui est sur SON chemin (cf. RING_INNER)
			var ecart := _ring_gap_to(o)
			if ecart < INF:
				var moitie: float = o.get("_half_length") if "_half_length" in o else OBSTACLE_DEFAULT_HALF_LENGTH
				if ecart - moitie < nearest:
					nearest = ecart - moitie
					nearest_body = o
				continue
			if o.is_on_ring() or o.waits_for_ring():
				continue    # autre voie de l'anneau, ou voiture qui attend à une entrée : c'est elle qui cède
			if _ring_skip != 0:
				continue    # voiture d'une bretelle de sortie qu'on ne prend pas
		var rel: Vector3 = o.global_position - my_pos
		rel.y = 0.0
		var fwd_dist := rel.dot(heading_dir)
		if fwd_dist <= 0.0 or fwd_dist > OBSTACLE_LOOK_AHEAD:
			continue
		if absf(rel.dot(right)) > OBSTACLE_LANE_HALF_WIDTH:
			continue
		# distance jusqu'à l'ARRIÈRE de l'obstacle (moins sa demi-longueur réelle),
		# pas jusqu'à son centre : un bus de 11 m ne s'aborde pas comme une citadine
		var other_half: float = o.get("_half_length") if "_half_length" in o else OBSTACLE_DEFAULT_HALF_LENGTH
		if fwd_dist - other_half < nearest:
			nearest = fwd_dist - other_half
			nearest_body = o
	if nearest == INF:
		_devant = null
		_devant_ecart = INF
		return cruise_speed
	var brake_dist := nearest - (_half_length + OBSTACLE_BUMPER_GAP)
	_devant = nearest_body
	_devant_ecart = brake_dist
	if brake_dist < RETENUE_ECART and _ai_speed < RETENUE_VITESSE and _cycle_de_suivi(nearest_body):
		# cf. _cycle_de_suivi : c'est à moi de passer, les autres me suivront
		_passe_outre = nearest_body
		_passe_outre_t = PASSE_OUTRE_DUREE
		_devant = null
		_devant_ecart = INF
		return cruise_speed
	if brake_dist <= 0.0:
		_keep_awake(nearest_body)
		return 0.0
	# Distance de freinage physique (v² = 2·a·d) plutôt qu'une réduction
	# proportionnelle arbitraire : garantit que la voiture peut TOUJOURS
	# s'arrêter pile à OBSTACLE_BUMPER_GAP de l'obstacle en freinant à AI_DECEL, quelle que
	# soit sa vitesse d'approche, au lieu de risquer de dépasser la marge de
	# sécurité si elle referme l'écart plus vite qu'elle ne peut ralentir.
	var max_safe_speed := sqrt(2.0 * AI_DECEL * brake_dist)
	if max_safe_speed < cruise_speed:
		_keep_awake(nearest_body)
	return minf(cruise_speed, max_safe_speed)

# Vitesse imposée par la signalisation à l'approche du PROCHAIN noeud sur
# l'arête courante :
#  - carrefour classique avec feu : s'arrête si le feu de cette approche
#    n'est pas vert (rouge OU orange) ;
#  - entrée du rond-point (arête d'approche, PAS déjà sur l'anneau) : cédez-
#    le-passage -> s'arrête si une voiture est déjà engagée sur l'anneau à
#    proximité de ce point d'entrée ;
#  - déjà engagé sur l'anneau (arête one_way) : prioritaire, aucun arrêt ici.
# Même formule de distance de freinage que _obstacle_speed_limit. La marge
# d'arrêt (ligne d'arrêt virtuelle) doit placer l'AVANT de la caisse à la
# limite de la zone, pas son origine : on ajoute donc la demi-longueur RÉELLE
# de la voiture (_half_length, mesurée sur le modèle) à la demi-taille réelle
# du bloc carrefour (12x12m mesuré sur RoadsCollision -> 6.0), pas juste une
# constante arbitraire.
#
# Durci après l'ajout de la ligne d'arrêt basée sur le passage piéton : le pire
# cas mesuré (crosswalk_clear_distance max réel = 13.10m + CROSSWALK_STOP_MARGIN
# 0.5 + demi-longueur max réelle observée sur les 6 modèles de voiture = 2.13m)
# donne une marge d'arrêt de ~15.73m ; à la vitesse de croisière réelle actuelle
# (CarSpawner : speed_min=speed_max=12.0, distance de freinage = 6.0m à
# AI_DECEL=12.0) le seuil de décision atteint ~21.73m, tout juste sous
# l'ancien 22.0 -- sans marge de sécurité en cas de vitesse de croisière plus
# élevée à l'avenir ou de survitesse transitoire (après un choc par ex.).
# Porté à 28.0 pour couvrir confortablement jusqu'à ~16 m/s de croisière
# (distance de freinage ~10.7m à ce même AI_DECEL) sans jamais laisser la
# zone de contrôle "sortie" (remaining > seuil) devenir plus courte que la
# vraie distance de décision -> évite un freinage tardif/brutal juste après
# l'ouverture de la zone.
const INTERSECTION_CHECK_DIST := 28.0
const INTERSECTION_HALF_SIZE := 6.0     # 12x12m réel (RoadsCollision "RoadFlat_*"), pas une estimation
const STOP_LINE_BUFFER := 0.5           # petit espace visuel entre le pare-choc et la zone
const CROSSWALK_STOP_MARGIN := 0.5      # petite marge additionnelle avant le bord du passage piéton (0.3 laissait une marge réelle mesurée de seulement ~0.08m à cause du léger dépassement inhérent au freinage discret, déjà présent sur STOP_LINE_BUFFER)
const YIELD_STOP_BUFFER := 1.0          # le rond-point n'a pas de bloc 12x12 : juste la caisse + une marge

# ANNEAU À DEUX VOIES ET INTERBLOCAGE (2026-09-21). Une file se figeait pour de bon sur l'anneau d'Echo
# Circle. Reproduit en 47 s de jeu par une sonde (10 voitures immobiles de 50 s à 300 s, 3 sorties en
# 5 minutes), et le cycle d'attente relevé voiture par voiture :
#   - la voiture qui ATTEND à une entrée cédait le passage à toute voiture de l'anneau à moins de
#     14 m du point d'entrée, même ARRÊTÉE, même déjà passée ;
#   - la voiture de l'ANNEAU, elle, cherchait ses obstacles dans un couloir DROIT de 22 m le long de
#     son cap. Sur un cercle de 30 m, ce couloir file tangent à l'anneau, donc vers l'extérieur, là où
#     attendent les voitures des entrées : elle freinait pour une voiture qui n'était pas sur sa route.
# Chacune attendait l'autre. D'où deux règles, qui valent pour tous les anneaux (rond-point et
# échangeurs) :
#   1. sur l'anneau, on ne suit que ce qui est sur SON chemin : les voitures de l'anneau dans SA voie,
#      devant soi, mesurées LE LONG DU GRAPHE et non en ligne droite ; une voiture qui attend à une
#      entrée est ignorée — c'est elle qui cède ;
#   2. à l'entrée, on ne cède qu'aux voitures de l'anneau qui ARRIVENT sur ce point (en amont, à moins
#      de RING_YIELD_UPSTREAM m le long de l'anneau) ou qui l'occupent encore, pas à celles déjà passées.
#
# Et DEUX VOIES sur l'anneau (intérieure à -2 m, extérieure à +2 m de l'axe du graphe). La voie est
# tirée à l'ENTRÉE, moitié-moitié : les deux sont permises pour aller en face, et Echo Circle n'a que
# deux branches. La voiture garde sa voie ; en sortant, celle de la voie INTÉRIEURE traverse
# l'extérieure, donc elle CÈDE à une voiture de l'extérieure qui est à sa hauteur ou juste derrière —
# jamais l'inverse, ce qui ne peut pas faire de cycle. Le nombre de sorties à laisser passer est tiré
# à l'entrée aussi, jamais celle par laquelle on est arrivé (pas de demi-tour) ; avec deux branches,
# tout le monde sort à la première.
const RING_INNER := -2.0
const RING_OUTER := 2.0
const RING_YIELD_UPSTREAM := 18.0       # m le long de l'anneau, en amont du point d'entrée
const RING_YIELD_DOWNSTREAM := 4.0      # m : une voiture de l'anneau qui vient de passer occupe encore l'entrée
const RING_SAME_LANE := 1.0             # m d'écart entre deux voies pour les dire « la même »
const RING_MERGE_ZONE := 16.0           # m avant sa sortie où la voie intérieure regarde l'extérieure
const RING_MERGE_BEHIND := 8.0          # m : une voiture de l'extérieure si peu derrière passe d'abord
const RING_MERGE_AHEAD := 2.5           # m : ... ou à peine devant
const MERGE_CHECK_DIST := 80.0          # bretelle d'insertion : surveillance du point de convergence
const MERGE_STOP_BEFORE := 42.0         # arrêt avant le raccord à la chaussée (RoadNetwork.BLEND 40 m + marge)
const MERGE_YIELD_RADIUS := 45.0

func _intersection_speed_limit(cruise_speed: float) -> float:
	if _path == null or _cur_edge < 0:
		return cruise_speed

	# Nettoyage : une fois assez loin APRÈS être sortie du bloc dont elle
	# avait la priorité de virage, elle libère la place pour les suivantes.
	if _turn_priority_node >= 0 and _from_node == _turn_priority_node \
			and _edge_progress >= INTERSECTION_HALF_SIZE + _half_length:
		_turn_priority_node = -1

	if _path.is_ring_edge(_cur_edge):
		# déjà sur l'anneau : prioritaire sur les entrées ; seule la voie intérieure, en sortant, cède à
		# la voie extérieure qu'elle doit traverser
		return _ring_merge_limit(cruise_speed)

	var next_node := _path.edge_other_node(_cur_edge, _from_node)
	var remaining := _path.edge_length(_cur_edge) - _edge_progress

	# bretelle d'insertion (carte 3D) : attend, avant la zone où elle rejoint la chaussée, qu'aucun véhicule de
	# l'autre branche n'arrive au point de convergence
	if _path.must_yield(_cur_edge, next_node) and remaining <= MERGE_CHECK_DIST:
		if remaining < MERGE_STOP_BEFORE + _half_length - 1.0:
			return cruise_speed   # déjà engagée dans le raccord : ne s'arrête plus au bord de la chaussée
		var merge_pos := _path.node_pos(next_node)
		_refresh_vehicle_index()
		for idx in _nearby_indices(merge_pos, 2):
			var o := _vehicle_cache[idx] as Node3D
			if o == self or o == null or not o.has_method("nears_node"):
				continue
			if o.nears_node(next_node, _cur_edge, MERGE_YIELD_RADIUS):
				_keep_awake(o)
				_diag_carrefour = "insertion"
				_diag_carrefour_objet = o
				var brake := remaining - (MERGE_STOP_BEFORE + _half_length)
				return 0.0 if brake <= 0.0 else minf(cruise_speed, sqrt(2.0 * AI_DECEL * brake))
		return cruise_speed

	if remaining > INTERSECTION_CHECK_DIST:
		return cruise_speed

	if _path.is_roundabout_node(next_node):
		# cédez-le-passage : une voiture de l'anneau ARRIVE-t-elle sur ce point d'entrée, ou l'occupe-t-elle
		# encore ? Pas « est-elle à moins de 14 m » : celle qui est déjà passée ne compte plus, et c'est
		# la voiture de l'anneau qui ne compte plus les voitures en attente (cf. RING_INNER).
		var stop_margin := _half_length + YIELD_STOP_BUFFER
		var must_stop := false
		var entry_pos := _path.node_pos(next_node)
		_refresh_vehicle_index()
		for idx in _nearby_indices(entry_pos, 2):
			var o := _vehicle_cache[idx] as Node3D
			if o == self or o == null or not o.has_method("ring_arrival_distance"):
				continue
			if float(o.ring_arrival_distance(next_node)) <= RING_YIELD_UPSTREAM:
				must_stop = true
				_keep_awake(o)
				_diag_carrefour = "cede_anneau"
				_diag_carrefour_objet = o
				break
		if not must_stop:
			return cruise_speed
		var brake_dist := remaining - stop_margin
		if brake_dist <= 0.0:
			return 0.0
		return minf(cruise_speed, sqrt(2.0 * AI_DECEL * brake_dist))

	# --- carrefour classique avec feu ---
	# Ligne d'arrêt de base (bord du bloc 12x12), reculée en plus jusqu'au
	# bord du décalque de passage piéton (taille RÉELLE mesurée sur chaque
	# approche, cf. CircuitPath.crosswalk_stop_dist, pas une constante
	# théorique -- les décalques "_1" et "_5" n'ont pas la même distance au
	# centre) quand cette approche en a un, + une petite marge visuelle.
	var stop_margin2 := INTERSECTION_HALF_SIZE + STOP_LINE_BUFFER
	var crosswalk_edge := _path.crosswalk_clear_distance(_cur_edge, next_node)
	if crosswalk_edge > 0.0:
		stop_margin2 = maxf(stop_margin2, crosswalk_edge + CROSSWALK_STOP_MARGIN)
	stop_margin2 += _half_length

	# Planifie l'arête de sortie et détecte si c'est un vrai virage UNE SEULE
	# FOIS par traversée, dès qu'on est dans la zone de surveillance ->
	# nécessaire pour la priorité de virage ci-dessous, avant même de savoir
	# ce que dira le feu. Ceci ne freine PAS la voiture : juste préparation.
	if _planned_next_edge < 0:
		_planned_next_edge = _path.pick_next_edge(next_node, _cur_edge)
		_turn_priority_node = next_node
		_turn_priority_seq = _turn_priority_counter
		_turn_priority_counter += 1
		if _planned_next_edge >= 0:
			var incoming := _path.direction_at(_cur_edge, _from_node, _path.edge_length(_cur_edge))
			var outgoing := _path.direction_at(_planned_next_edge, next_node, 0.0)
			_turn_priority_is_turn = incoming.dot(outgoing) < TURN_DOT_THRESHOLD
		else:
			_turn_priority_is_turn = false

	# --- priorité de virage : contrainte CONTINUE (recalculée à chaque
	# recheck, comme le suivi de voiture), JAMAIS figée par une décision
	# définitive -> dès que l'autre voiture a dégagé le bloc, celle qui
	# attendait doit pouvoir repartir immédiatement, pas rester bloquée pour
	# le reste de la traversée. Ne s'active qu'à partir de SA PROPRE distance
	# de freinage (comme le feu) pour ne pas ralentir inutilement de loin.
	var turn_priority_limit := cruise_speed
	if _turn_priority_is_turn:
		var own_stop_t := (_ai_speed * _ai_speed) / (2.0 * AI_DECEL)
		if remaining <= stop_margin2 + own_stop_t:
			var must_yield_for_turn := false
			# Seules les voitures qui approchent CE carrefour peuvent avoir la
			# priorité dessus, et aucune ne le surveille au-delà de
			# INTERSECTION_CHECK_DIST (28 m) : 2 anneaux de grille (>= 48 m autour
			# du noeud) les contiennent donc toutes. Même résultat que le parcours
			# des 252 véhicules, sans le parcourir.
			_refresh_vehicle_index()
			for idx in _nearby_indices(_path.node_pos(next_node), 2):
				var o := _vehicle_cache[idx] as Node3D
				if o == self or o == null or not o.has_method("blocks_turn_at"):
					continue
				# JAMAIS à une voiture qui est DERRIÈRE soi sur sa propre arête : elle ne peut pas passer
				# avant, puisqu'elle nous suit. Payé le 2026-09-21 aux deux bouts des branches d'Echo Circle :
				# sur la bretelle de sortie, la voiture de tête cédait la priorité de virage à la voiture qui
				# la suivait (inscrite plus tôt au même noeud), et celle-ci la suivait — les deux attendaient
				# pour toujours, et la file remontait jusque sur l'anneau.
				if int(o.get("_cur_edge")) == _cur_edge and int(o.get("_from_node")) == _from_node \
						and float(o.get("_edge_progress")) < _edge_progress:
					continue
				# NI à une voiture ARRÊTÉE derrière une autre : elle ne peut pas passer avant celle qui la
				# retient. Payé le même jour, sur toute la carte, par une sonde qui remontait les files :
				# les files figées restantes étaient TOUTES des cycles de priorité de virage de ce genre —
				# au carrefour (-100, -316), la voiture engagée dans le bloc cédait à celle qui attendait
				# DERRIÈRE ELLE sur une autre approche ; au bout de la branche ouest d'Echo Circle, A cédait
				# à B, bloquée derrière C, qui cédait à D, bloquée derrière A. Une voiture qui ne peut pas
				# avancer ne réclame plus sa priorité ; elle la retrouve dès que la voie devant elle se libère.
				if o.has_method("retenue_par_une_voiture") and o.retenue_par_une_voiture():
					continue
				if o.blocks_turn_at(next_node, _turn_priority_seq):
					must_yield_for_turn = true
					_diag_carrefour = "priorite_virage"
					_diag_carrefour_objet = o
					break
			if must_yield_for_turn:
				var brake_dist_y := remaining - stop_margin2
				turn_priority_limit = 0.0 if brake_dist_y <= 0.0 else sqrt(2.0 * AI_DECEL * brake_dist_y)

	# --- feu : décision UNE FOIS "j'y vais" (n'y revient plus ensuite, pour
	# ne pas piler en plein milieu du carrefour si le feu change pendant la
	# traversée). En revanche, tant qu'on n'a PAS encore franchi ce cap, on
	# continue de revérifier le feu à CHAQUE recheck, y compris une fois déjà
	# à l'arrêt : sinon, une voiture arrêtée au rouge ne redémarre jamais,
	# `remaining` restant figé (elle n'avance plus) une fois immobilisée, ce
	# qui gelait aussi la décision "je m'arrête" pour toujours -- exactement
	# le bug de priorité de virage déjà vu, réintroduit ici côté freinage.
	var light_limit := cruise_speed
	if _committed_to_cross:
		_committed_to_stop = false
		light_limit = cruise_speed
	else:
		var own_stopping_dist := (_ai_speed * _ai_speed) / (2.0 * AI_DECEL)
		var decision_threshold := stop_margin2 + own_stopping_dist
		if remaining > decision_threshold and not _committed_to_stop:
			light_limit = cruise_speed
		elif _path.light_allows(_cur_edge, next_node):
			_committed_to_cross = true
			_committed_to_stop = false
			light_limit = cruise_speed
		else:
			_committed_to_stop = true
			if _diag_carrefour == "":
				_diag_carrefour = "feu"
			var brake_dist2 := remaining - stop_margin2
			light_limit = 0.0 if brake_dist2 <= 0.0 else minf(cruise_speed, sqrt(2.0 * AI_DECEL * brake_dist2))

	return minf(light_limit, turn_priority_limit)

# Utilisé par les AUTRES voitures pour l'arbitrage de priorité de virage
# ci-dessus : renvoie le noeud de carrefour concerné, le rang d'arrivée pour
# cette traversée, et si c'est un vrai virage. Vide si aucune priorité active
# OU si la voiture est DÉFINITIVEMENT à l'arrêt à son feu (_committed_to_stop) :
# une voiture immobilisée au rouge n'occupe plus le bloc et ne doit jamais
# bloquer indéfiniment une autre voiture. En revanche une voiture encore EN
# TRAIN DE DÉCIDER (pas encore committed dans un sens ou l'autre) compte
# toujours -- sinon deux voitures qui arrivent en même temps se
# "doubleraient" l'une l'autre au lieu de respecter l'ordre d'arrivée, le
# rang le plus bas n'ayant pas encore eu la CHANCE de committed_to_cross.
# Répond directement à la seule question que l'appelant se posait ("cette
# voiture-ci me bloque-t-elle ?") au lieu de renvoyer un Dictionary que
# l'appelant décortiquait : la version précédente allouait un Dictionary par
# voiture comparée, pour chaque voiture qui tourne, à chaque revérification.
# Mêmes conditions, lues en direct : aucun décalage d'une frame sur l'arbitrage.
func blocks_turn_at(node: int, seq: int) -> bool:
	# Figée par SimulationCuller : ne bloque personne pendant la pause, garde son rang pour la reprise.
	# Conduite par le joueur ou laissée là : elle ne suit plus les règles du trafic, son rang non plus.
	if _turn_priority_node < 0 or _committed_to_stop or not is_physics_processing() or driven_by_player or _abandoned:
		return false
	return _turn_priority_node == node and _turn_priority_is_turn and _turn_priority_seq < seq

# Arrêtée (ou presque) derrière un véhicule qu'elle suit de près : elle ne peut pas passer avant lui.
# Les autres ne lui cèdent donc pas la priorité de virage tant qu'elle est dans cet état.
const RETENUE_VITESSE := 0.5            # m/s
const RETENUE_ECART := 3.0              # m de place avant de devoir s'arrêter derrière le véhicule suivi

func retenue_par_une_voiture() -> bool:
	return _ai_speed < RETENUE_VITESSE and _devant != null and is_instance_valid(_devant) and _devant_ecart < RETENUE_ECART

# INTERBLOCAGE PHYSIQUE AU MILIEU D'UN CARREFOUR (2026-09-21). Une fois les cycles de priorité de virage
# supprimés, la sonde de toute la carte en a trouvé un dernier genre, au carrefour à feux (-28, -316) :
# quatre voitures engagées dans le bloc, une par approche, chacune arrêtée derrière la suivante dans son
# couloir d'obstacles — A suit B, B suit C, C suit D, D suit A. Aucune règle ne peut les départager, elles
# se suivent en rond pour toujours. On remonte donc la chaîne des voitures suivies ; si elle revient à
# soi, UNE SEULE voiture du cycle passe outre : celle de plus petit identifiant, pour que ce soit toujours
# la même quel que soit l'ordre des revérifications. Elle se dégage, et les autres la suivent.
# Toutes les voitures du cycle doivent être ARRÊTÉES : des voitures qui roulent l'une derrière l'autre
# sur un anneau forment elles aussi une boucle, et celle-là n'est pas un interblocage. La voiture qui passe
# outre ignore le véhicule traversé pendant PASSE_OUTRE_DUREE, le temps de le dépasser, au lieu de repiler
# à chaque revérification.
const CYCLE_SUIVI_MAX := 8
const PASSE_OUTRE_DUREE := 4.0          # s

func _cycle_de_suivi(depart: Object) -> bool:
	var plus_petit := get_instance_id()
	var cur: Object = depart
	for k in CYCLE_SUIVI_MAX:
		if cur == null or not is_instance_valid(cur) or not ("_devant" in cur):
			return false
		if cur == self:
			return get_instance_id() == plus_petit
		if float(cur.get("_ai_speed")) >= RETENUE_VITESSE:
			return false
		plus_petit = mini(plus_petit, cur.get_instance_id())
		# Lu SANS TYPE et vérifié AVANT d'être affecté (2026-09-23). Le _devant d'une autre voiture date de SA
		# dernière revérification : la voiture qu'elle suivait a pu être libérée depuis (budget d'arêtes épuisé,
		# recyclage de LoopSpawner). Affectée telle quelle à `cur`, typée Object, elle levait « Trying to assign
		# invalid previously freed instance » avant même le test de validité en tête de boucle (34 fois en 30 min
		# de jeu le 2026-09-22). Chaîne rompue : pas de cycle, false — ce que rendait déjà la fonction interrompue.
		var suivante = cur.get("_devant")
		if not is_instance_valid(suivante):
			return false
		cur = suivante
	return false

# Utilisé par les AUTRES voitures pour savoir si celle-ci est déjà engagée
# sur l'anneau du rond-point (priorité), pour le cédez-le-passage ci-dessus.
func is_on_ring() -> bool:
	return _path != null and _cur_edge >= 0 and _path.is_ring_edge(_cur_edge)

# Voiture qui attend (ou s'apprête) à entrer sur un anneau : arête d'approche dont le noeud d'arrivée est
# un noeud d'anneau. Une voiture de l'anneau ne la suit jamais : c'est elle qui cède.
func waits_for_ring() -> bool:
	if _path == null or _cur_edge < 0 or _path.is_ring_edge(_cur_edge):
		return false
	return _path.is_roundabout_node(_path.edge_other_node(_cur_edge, _from_node))

# Distance, le long de l'anneau, qui sépare cette voiture du noeud `node` qu'elle s'apprête à franchir :
# 0 si elle vient de le passer (elle occupe encore l'entrée), INF si elle n'est pas sur l'anneau ou n'y
# arrive pas dans les deux prochaines arêtes. Sert au cédez-le-passage des entrées.
func ring_arrival_distance(node: int) -> float:
	if not is_on_ring():
		return INF
	if _from_node == node and _edge_progress <= RING_YIELD_DOWNSTREAM:
		return 0.0
	var fin := _path.edge_other_node(_cur_edge, _from_node)
	var reste := _path.edge_length(_cur_edge) - _edge_progress
	if fin == node:
		return reste
	if _exits_at_end():
		return INF    # elle sort avant d'y arriver
	var suivante := _ring_next(fin, _cur_edge)
	if suivante >= 0 and _path.edge_other_node(suivante, fin) == node:
		return reste + _path.edge_length(suivante)
	return INF

# Écart, le long de l'anneau, jusqu'à la voiture `o` si elle est DEVANT dans la MÊME voie (au plus deux
# arêtes plus loin, OBSTACLE_LOOK_AHEAD au plus) ; INF sinon.
func _ring_gap_to(o: Node3D) -> float:
	if not o.is_on_ring():
		return INF
	if absf(_path.lane_offset(_cur_edge, _lane_pref()) - float(o.ring_lane())) > RING_SAME_LANE:
		return INF
	var o_edge: int = int(o.get("_cur_edge"))
	var o_prog: float = float(o.get("_edge_progress"))
	var ecart := INF
	if o_edge == _cur_edge:
		ecart = o_prog - _edge_progress if o_prog > _edge_progress else INF
	elif _exits_at_end():
		return INF    # on sort au bout de cette arête : ce qui est plus loin sur l'anneau n'est pas sur notre route
	else:
		var fin := _path.edge_other_node(_cur_edge, _from_node)
		var cumul := _path.edge_length(_cur_edge) - _edge_progress
		var e := _ring_next(fin, _cur_edge)
		var n := fin
		for k in 2:
			if e < 0:
				break
			if e == o_edge:
				ecart = cumul + o_prog
				break
			cumul += _path.edge_length(e)
			n = _path.edge_other_node(e, n)
			e = _ring_next(n, e)
	return ecart if ecart <= OBSTACLE_LOOK_AHEAD else INF

# Décalage latéral RÉEL de la voie visée sur l'arête courante (sert aux autres voitures de l'anneau).
func ring_lane() -> float:
	if _path == null or _cur_edge < 0:
		return 0.0
	return _path.lane_offset(_cur_edge, _lane_pref())

# Arête de l'anneau qui part du noeud `node` (l'anneau est à sens unique : il n'y en a qu'une).
func _ring_next(node: int, arrivee: int) -> int:
	for e in _path.node_edges(node):
		if e != arrivee and _path.is_ring_edge(e) and int(_path.edges[e]["a"]) == node:
			return e
	return -1

# Voie visée : sur l'anneau, celle tirée à l'entrée ; ailleurs, la voie de la voiture.
func _lane_pref() -> float:
	if _path != null and _cur_edge >= 0 and _path.is_ring_edge(_cur_edge):
		return _ring_lane
	return _lateral

# Ce noeud d'anneau a-t-il une sortie (une arête hors anneau qui en part) ?
func _ring_has_exit(node: int) -> bool:
	for e in _path.node_edges(node):
		if not _path.is_ring_edge(e) and int(_path.edges[e]["a"]) == node:
			return true
	return false

# Sort-on de l'anneau au bout de l'arête courante ?
func _exits_at_end() -> bool:
	return _ring_skip == 0 and _ring_has_exit(_path.edge_other_node(_cur_edge, _from_node))

# Voie INTÉRIEURE qui va sortir : elle traverse la voie extérieure, donc elle cède à une voiture de
# l'extérieure qui est à sa hauteur ou juste derrière sur la même arête. Jamais l'inverse.
func _ring_merge_limit(cruise_speed: float) -> float:
	if absf(_ring_lane - RING_INNER) > 0.01 or not _exits_at_end():
		return cruise_speed
	var reste := _path.edge_length(_cur_edge) - _edge_progress
	if reste > RING_MERGE_ZONE:
		return cruise_speed
	_refresh_vehicle_index()
	for idx in _nearby_indices(global_position):
		var o := _vehicle_cache[idx] as Node3D
		if o == self or o == null or not o.has_method("ring_lane") or not o.is_on_ring():
			continue
		if int(o.get("_cur_edge")) != _cur_edge or absf(float(o.ring_lane()) - _path.lane_offset(_cur_edge, RING_OUTER)) > RING_SAME_LANE:
			continue
		if o.retenue_par_une_voiture():
			continue    # arrêtée derrière une autre : elle ne passera pas avant nous (cf. priorité de virage)
		var ecart := float(o.get("_edge_progress")) - _edge_progress
		if ecart > -RING_MERGE_BEHIND and ecart < RING_MERGE_AHEAD:
			_keep_awake(o)
			_diag_carrefour = "fusion_anneau"
			_diag_carrefour_objet = o
			var frein := reste - (_half_length + 1.0)
			return 0.0 if frein <= 0.0 else minf(cruise_speed, sqrt(2.0 * AI_DECEL * frein))
	return cruise_speed

# Arête suivante au noeud `node`, en arrivant par `arrivee`. Hors anneau : tirage habituel. À l'entrée
# d'un anneau : on tire combien de sorties laisser passer. Sur l'anneau : on continue tant qu'il en reste,
# puis on sort à la suivante.
func _choisir_arete(node: int, arrivee: int) -> int:
	if not _path.is_roundabout_node(node):
		return _path.pick_next_edge(node, arrivee)
	var anneau := -1
	var sorties: Array = []
	for e in _path.node_edges(node):
		if e == arrivee or (_path.is_edge_one_way(e) and int(_path.edges[e]["a"]) != node):
			continue
		if _path.is_ring_edge(e):
			anneau = e
		else:
			sorties.append(e)
	if anneau < 0:
		return _path.pick_next_edge(node, arrivee)
	if not _path.is_ring_edge(arrivee):
		_ring_skip = _tirer_sorties(node, anneau)
		_ring_lane = RING_INNER if randf() < 0.5 else RING_OUTER
		return anneau
	if sorties.is_empty():
		return anneau
	if _ring_skip > 0:
		_ring_skip -= 1
		return anneau
	_ring_skip = -1
	return sorties[randi() % sorties.size()]

# Sorties à laisser passer, tirées à l'entrée : de 0 (la première) à toutes sauf la dernière rencontrée,
# qui ramènerait par où l'on est venu. On compte les sorties en faisant le tour de l'anneau sur le graphe.
func _tirer_sorties(entree: int, premiere: int) -> int:
	var sorties := 0
	var n := _path.edge_other_node(premiere, entree)
	var e := premiere
	for k in 64:
		if n == entree:
			break
		for x in _path.node_edges(n):
			if not _path.is_ring_edge(x) and int(_path.edges[x]["a"]) == n:
				sorties += 1
				break
		e = _ring_next(n, e)
		if e < 0:
			break
		n = _path.edge_other_node(e, n)
	var plafond := maxi(0, sorties - 2)
	var r := randf()
	if plafond == 0 or r < 0.45:
		return 0
	if plafond == 1 or r < 0.80:
		return 1
	return 2

# Utilisé par les voitures d'une bretelle d'insertion : celle-ci arrive-t-elle (ou vient-elle de passer) au noeud
# `node` par une autre arête que `except_edge`, à moins de `radius` m ?
func nears_node(node: int, except_edge: int, radius: float) -> bool:
	if _path == null or _cur_edge < 0 or _cur_edge == except_edge or not is_physics_processing():
		return false
	if _path.edge_other_node(_cur_edge, _from_node) == node:
		return _path.edge_length(_cur_edge) - _edge_progress <= radius
	return _from_node == node and _edge_progress <= 10.0

# --- conduite ---------------------------------------------------

func _drive_physics(delta: float) -> void:
	var throttle := Input.get_axis("move_back", "move_forward")
	_steer_input = Input.get_axis("move_right", "move_left")

	# Feux de freinage du JOUEUR : la pédale, pas la vitesse. brake_lights_on() ne regardait que
	# _drive_speed < BRAKE_STOP_SPEED, donc les feux ne s'allumaient qu'une fois la voiture presque
	# arrêtée — appuyer sur S en roulant ne faisait rien. C'est ici, et nulle part ailleurs, que la
	# voiture du joueur décide de freiner : marche arrière demandée alors qu'on avance encore.
	_player_braking = throttle < 0.0 and _drive_speed > 0.5
	if throttle > 0.0:
		_drive_speed = move_toward(_drive_speed, DRIVE_MAX_SPEED, DRIVE_ACCEL * delta)
	elif throttle < 0.0:
		if _drive_speed > 0.5:
			_drive_speed = move_toward(_drive_speed, 0.0, DRIVE_BRAKE * delta)
		else:
			_drive_speed = move_toward(_drive_speed, -DRIVE_REVERSE_MAX, DRIVE_ACCEL * delta)
	else:
		_drive_speed = move_toward(_drive_speed, 0.0, DRIVE_FRICTION * delta)

	if absf(_drive_speed) > 0.3:
		# modèle bicyclette (cf. BRAQUAGE_A_LAT) : lacet = v x tan(δ) / L ; en marche arrière, v < 0 et la voiture
		# tourne de l'autre côté, comme une vraie
		rotate_y(_drive_speed * tan(_steer_input * angle_braquage(_drive_speed)) / _empattement * delta)

	# Montée de trottoir : voir _try_step_up, appelée après move_and_slide.
	# (La réponse précédente était scenes/world/CurbRamp.gd, qui construisait des rampes de collision le
	# long des trottoirs. Il ne reconnaissait que des StaticBody3D nommés *Walk* portant une seule
	# BoxShape3D — la disposition du monde d'essai d'origine — alors que les trottoirs de la carte cuite
	# sont des trimesh de RoadCell et des piles de boîtes sous Sol_*, et il n'était attaché à aucun nœud
	# de World.tscn : il ne tournait plus du tout. Supprimé le 2026-09-19.)

	# recul de choc (décroît vite)
	_recoil_vel = _recoil_vel.lerp(Vector3.ZERO, clampf(delta * 6.0, 0.0, 1.0))

	if not is_on_floor():
		velocity.y -= GRAVITY * delta
	else:
		velocity.y = 0.0
	var fwd := -global_transform.basis.z
	velocity.x = fwd.x * _drive_speed + _recoil_vel.x
	velocity.z = fwd.z * _drive_speed + _recoil_vel.z
	move_and_slide()
	_try_step_up(fwd)
	_resolve_drive_collisions(fwd)
	# assiette sur une pente (cf. ASSIETTE)
	_poser_assiette(delta)


# ASSIETTE : le sol sous chaque essieu, relevé au rayon (décor seulement, calque 1), suivi à ASSIETTE_VITESSE au plus —
# une pente continue est suivie exactement, une marche (bordure de 15 cm) est montée en ~0,06 s, comme par un pneu. En
# l'air, le modèle revient dans l'axe de la boîte. Le modèle est cabré de asin((avant - arrière) / empattement) et
# descendu pour que l'essieu arrière se pose sur son sol (l'avant suit, par construction) : _pente et _abaisse, que
# _update_visuals applique.
const ASSIETTE_VITESSE := 2.5            # m/s : vitesse verticale maximale du sol suivi sous un essieu
const ENVELOPPE_BAS := 0.02              # bas des pneus (et de l'enveloppe) au-dessus du bas de _boite_caisse (sa marge)

func _poser_assiette(delta: float) -> void:
	var xf := global_transform
	var bas := xf.origin.y + _boite_caisse.position.y + ENVELOPPE_BAS    # bas des pneus, modèle au repos
	var cible := Vector2(bas, bas)
	if is_on_floor():
		var espace := get_world_3d().direct_space_state
		var exclure: Array[RID] = [get_rid()]
		for k in 2:
			var p := xf * Vector3(0.0, 0.0, _z_essieu_av if k == 0 else _z_essieu_ar)
			var hit := espace.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, bas + 0.6, p.z), Vector3(p.x, bas - 0.8, p.z), 1, exclure))
			if not hit.is_empty():
				if k == 0:
					cible.x = (hit["position"] as Vector3).y
				else:
					cible.y = (hit["position"] as Vector3).y
	if is_nan(_sol_essieux.x) or absf(_sol_essieux.x - cible.x) > 1.0 or absf(_sol_essieux.y - cible.y) > 1.0:
		_sol_essieux = cible          # première fois, ou voiture déplacée : pas de rattrapage à l'écran
	else:
		var pas := ASSIETTE_VITESSE * delta
		_sol_essieux = Vector2(move_toward(_sol_essieux.x, cible.x, pas), move_toward(_sol_essieux.y, cible.y, pas))
	var s := clampf((_sol_essieux.x - _sol_essieux.y) / maxf(_z_essieu_ar - _z_essieu_av, 0.5), -0.6, 0.6)
	_pente = asin(s)
	_abaisse = clampf(_sol_essieux.y - bas + _z_essieu_ar * s, -1.0, 0.05)


# Angle de braquage à fond à la vitesse `v` (cf. BRAQUAGE_A_LAT) : MAX_STEER_RAD tant que l'accélération latérale
# reste sous BRAQUAGE_A_LAT, puis l'angle qui l'y tient.
func angle_braquage(v: float) -> float:
	var v2 := v * v
	if v2 < 0.01:
		return MAX_STEER_RAD
	return minf(MAX_STEER_RAD, atan(_empattement * BRAQUAGE_A_LAT / v2))


# Rayon décrit par l'origine de la voiture, braquage à fond, à la vitesse `v` : L / tan(δ).
func rayon_braquage(v: float) -> float:
	return _empattement / tan(angle_braquage(v))


# Rayon de braquage « entre murs », celui des fiches techniques : la roue avant EXTÉRIEURE, braquage à fond, à basse
# vitesse. Le centre du virage est sur l'essieu arrière prolongé, à L / tan(δ) du milieu de la voiture.
func rayon_entre_murs() -> float:
	var r := _empattement / tan(MAX_STEER_RAD) + _voie * 0.5
	return sqrt(r * r + _empattement * _empattement)

# Franchissement de bordure. move_and_slide() ne monte AUCUNE marche verticale, si basse soit-elle : mesuré, la
# voiture arcade s'arrête net devant les bordures de 0,150 m, à 3, 6, 10 et 15 m/s, aussi bien sur le trimesh
# d'une artère que sur les boîtes du centre-ville. On relève donc la caisse à la main quand elle bute sur une
# face verticale basse ayant du sol juste derrière.
#
# Réservé au joueur : `driven_by_player` est faux pour les 252 voitures de la circulation, qui gardent donc
# exactement le comportement d'avant et restent arrêtées par les bordures. Les PNJ ne passent pas par ici.
func _try_step_up(fwd: Vector3) -> void:
	if not driven_by_player or not is_on_floor() or absf(_drive_speed) < 0.5:
		return
	# sens de MARCHE, pas d'orientation : en marche arrière la bordure est derrière la voiture
	var dir := fwd * signf(_drive_speed)
	var bute := false
	for i in get_slide_collision_count():
		var n := get_slide_collision(i).get_normal()
		# face quasi verticale, prise de face : une pente reste gérée par move_and_slide
		if absf(n.y) <= 0.35 and dir.dot(-n) > 0.3:
			bute = true
			break
	if not bute:
		return
	var lift := Vector3.UP * STEP_UP_MAX
	if test_move(global_transform, lift):
		return                                   # pas la place de se relever : tunnel, pont, autre voiture
	var releve := global_transform.translated(lift)
	var devant := dir * STEP_UP_AHEAD
	if test_move(releve, devant):
		return                                   # vrai mur : la caisse ne passe pas non plus au-dessus
	var contact := KinematicCollision3D.new()
	if not test_move(releve.translated(devant), Vector3.DOWN * (STEP_UP_MAX + 0.05), contact):
		return                                   # rien sur quoi se reposer : un trou, pas une marche
	# On pose la caisse exactement là où l'essai vient de la faire atterrir : relevée, avancée, puis redescendue
	# jusqu'au contact. Se contenter de la relever sur place ne suffit pas — mesuré : à 3 m/s la voiture se
	# relevait 14 fois de suite et retombait à chaque fois sur la chaussée, parce qu'avec 0,05 m parcourus par
	# frame sa caisse restait presque entièrement au-dessus de la route et que l'accrochage au sol
	# (floor_snap_length) la ramenait aussitôt contre la face de la bordure.
	global_position += lift + devant + contact.get_travel()

func _resolve_drive_collisions(fwd: Vector3) -> void:
	for i in get_slide_collision_count():
		var c := get_slide_collision(i)
		var n := c.get_normal()
		if absf(n.y) > 0.7:
			continue   # sol / marche, pas un mur
		var other := c.get_collider()
		var frontality := clampf(-fwd.dot(n), -1.0, 1.0)   # 1 = choc pile de face

		if other != null and other.is_in_group("vehicle") and other.has_method("knock"):
			other.knock(-n, absf(_drive_speed) * 0.6 + 4.0)
			_drive_speed *= 0.35
			_recoil_vel = n * (absf(_drive_speed) * 0.4 + 4.0)
			_tilt_pitch = -0.12 * maxf(frontality, 0.3)
		else:
			# mur / obstacle statique : on tue la vitesse selon la frontalité
			_drive_speed *= clampf(1.0 - 0.95 * maxf(frontality, 0.0), 0.0, 1.0)
			_recoil_vel = n * (3.0 + 3.0 * maxf(frontality, 0.0))
			_tilt_pitch = -0.10 * maxf(frontality, 0.2)
		_tilt_roll = clampf(n.dot(global_transform.basis.x), -1.0, 1.0) * 0.08

func knock(dir: Vector3, strength: float) -> void:
	if _chassis != null:
		_chassis.pousser(dir, strength)
		return
	var d := Vector3(dir.x, 0.0, dir.z)
	if d.length() < 0.01:
		return
	_knock_vel = d.normalized() * strength
	_knock_time = KNOCK_TIME
	_tilt_roll = 0.1
	_tilt_pitch = -0.06

func get_drive_speed() -> float:
	return _drive_speed

# --- visuel (roues + tilt) -----------------------------------

func _update_visuals(delta: float, fwd_speed: float, steer_target: float) -> void:
	if not _wheels.is_empty():
		_steer_visual = lerpf(_steer_visual, steer_target * MAX_STEER_RAD, clampf(delta * 10.0, 0.0, 1.0))
		# steer_b : dans le repère de la VOITURE (wheel_steer_axis = sa verticale), puis ramené dans le repère du
		#           PARENT de chaque roue avant (cf. BRAQUAGE plus bas) -> rotation garantie autour de la
		#           verticale, la roue pivote gauche/droite.
		var steer_b := Basis(wheel_steer_axis.normalized(), _steer_visual)
		# LE PLAFOND VAUT PAR IMAGE AFFICHÉE, PAS PAR PAS PHYSIQUE. _update_visuals tourne dans _physics_process,
		# à 60 Hz fixes ; sous 60 images/s — l'UHD 750 de référence rend une image en 30 à 100 ms — plusieurs pas
		# physiques s'enchaînent entre deux images affichées et leurs rotations s'additionnent : deux pas de 20°
		# font 40° à l'écran, au-delà de la demi-période d'une jante octogonale, et la roue repart à l'envers. On
		# compte donc ce que chaque roue a déjà tourné depuis la dernière image affichée.
		var image := Engine.get_process_frames()
		if image != _roues_image:
			_roues_image = image
			_wheel_pas_image.clear()
		for w in _wheels:
			# chaque roue roule autour de SON axe, à SA vitesse angulaire (v / rayon réel) : le haut du pneu
			# va vers l'avant quand la voiture avance (cf. _mesurer_roue)
			var r: float = _wheel_radius.get(w, WHEEL_RADIUS)
			var pas_max: float = _wheel_pas_max.get(w, ROUE_PAS_DEFAUT)
			var deja: float = _wheel_pas_image.get(w, 0.0)
			var pas := clampf((fwd_speed / r) * delta, -pas_max - deja, pas_max - deja)
			_wheel_pas_image[w] = deja + pas
			var angle: float = fmod(float(_wheel_angle.get(w, 0.0)) + pas, TAU)
			_wheel_angle[w] = angle
			# spin_b : dans le repère roue (post-multiplié via rest).
			var spin_b := Basis(_wheel_axis.get(w, wheel_spin_axis.normalized()), angle)
			var rest: Basis = _wheel_rest[w]
			# roulement DANS le repère de la roue, braquage AUTOUR : le braquage ne tourne pas avec la roue
			var b := rest * spin_b
			if w in _wheels_front:
				var m: Array = _wheel_parent_base.get(w, [Basis.IDENTITY, Basis.IDENTITY])
				b = (m[1] as Basis) * steer_b * (m[0] as Basis) * b
			# rotation autour du CENTRE de la roue, pas de l'origine de son noeud : certains modèles ont le
			# pivot ailleurs (cf. _mesurer_roue), et la roue tournait alors en excentrique
			var c: Vector3 = _wheel_centre.get(w, Vector3.ZERO)
			var o: Vector3 = _wheel_rest_origin.get(w, w.transform.origin)
			w.transform = Transform3D(b, o + rest * c - b * c)

	# tilt de carrosserie : revient à zéro
	_tilt_pitch = lerpf(_tilt_pitch, 0.0, clampf(delta * 6.0, 0.0, 1.0))
	_tilt_roll = lerpf(_tilt_roll, 0.0, clampf(delta * 6.0, 0.0, 1.0))
	if _model != null:
		# la rotation du modèle se compose avec son lacet de catalogue (ordre YXZ) : avec le lacet de 180°, un angle
		# positif autour de son X BAISSE le nez de la voiture ; pour le lever d'un angle `_pente`, il faut donc
		# _pente x cos(lacet) (vérifié par WheelSpinTest / ParkingStructureTest sur le nez du modèle)
		_model.rotation.x = _tilt_pitch + _pente * cos(deg_to_rad(model_yaw_deg))
		_model.rotation.z = _tilt_roll
		_model.rotation.y = deg_to_rad(model_yaw_deg)
		_model.position.y = model_y_offset + _abaisse

# ROUES QUI ROULENT À L'ENDROIT (2026-09-21). Toutes les roues tournaient autour du X LOCAL de leur noeud,
# dans le même sens, quel que soit le modèle. Relevé sur les 72 modèles du catalogue posés comme ici
# (sonde jetable) : le X local tombe bien sur l'essieu partout, mais pas dans le même SENS d'un pack à
# l'autre — sur les six modèles d'origine du jeu (normalcar1, normalcar2, sportscar, sportscar2, suv, taxi),
# il pointe vers +X de la voiture au lieu de -X, et leurs 18 roues roulaient À L'ENVERS : le haut du pneu
# partait vers l'arrière quand la voiture avançait. La roue avant droite de normalcar2 a en plus son pivot à
# 0,32 m du centre de la roue : elle décrivait un cercle et montait dans la carrosserie. Et la vitesse angulaire
# était calculée sur un rayon fixe de 0,34 m, quand les roues posées font de 0,234 à 0,721 m (blindé SWAT).
# Chaque roue reçoit donc, une fois, à la pose du modèle :
#  - SON axe : l'axe local qui tombe sur l'essieu (le X de la voiture), orienté pour qu'une vitesse POSITIVE
#    fasse avancer le haut du pneu vers l'avant de la voiture (-Z) — le signe du déterminant compte, une roue
#    posée en miroir tourne en sens inverse de son axe ;
#  - SON rayon : la moitié de la hauteur de ses maillages dans le repère de la voiture, échelle comprise ;
#  - SON centre : le milieu de ses maillages, autour duquel elle tourne (et non l'origine de son noeud) ;
#  - SON plus grand pas par image affichée. EFFET STROBOSCOPIQUE, vu à l'image : à 12 m/s et 60 images/s, une roue de
#    0,30 m tourne de 38° par image ; sa jante octogonale ne se distingue d'elle-même qu'à 45° près, et l'oeil
#    la voit donc RECULER de 7° par image. Toute roue dont le pas par image dépasse la moitié de sa période
#    de symétrie paraît tourner à l'envers ou s'arrêter. On mesure la symétrie de chaque jante sur ses
#    sommets (la plus petite fréquence angulaire qui ressort, cf. _symetrie_roue) et on plafonne le pas à
#    45 % de sa période : au-delà de quelques m/s la roue tourne un peu moins vite que la voiture ne roule,
#    mais toujours DANS LE BON SENS — c'est ce que l'oeil lit.
const ROUE_PAS_DEFAUT := 0.35         # rad par image (20°), pour une roue sans maillage mesurable

# BRAQUAGE DANS LE REPÈRE DE LA VOITURE (2026-09-21). Le braquage était une rotation autour de (0, 1, 0)
# pré-multipliée à la base de repos de la roue — donc exprimée dans le repère du PARENT de la roue, pas dans celui
# de la caisse comme le disait le commentaire. Les 54 modèles city_* rangent leurs roues sous un noeud tourné de
# 90° autour de X (repère Z-up du pack) : le Y de ce parent est l'axe AVANT-ARRIÈRE de la voiture, et une roue
# braquée à fond s'y inclinait de 29,8° comme un carrossage, sans pivoter du tout. Mesuré sur les 72 modèles,
# IDENTIQUE avant et après le chantier des roues (975a4bf / 8b466f1) : défaut antérieur. Les 18 autres modèles
# (lowpoly, modèles d'origine) n'ont pas de noeud tourné et braquaient juste. Le lacet de 180° du catalogue n'y
# est pour rien : une rotation autour de la verticale, conjuguée par un lacet, reste la même rotation.
# Le braquage est maintenant une rotation autour de la verticale DE LA VOITURE, ramenée dans le repère du parent
# de la roue par conjugaison : M⁻¹ · R(verticale, angle) · M, M = base du parent dans la voiture (échelle et miroir
# compris). Le roulement reste appliqué dans le repère de la roue, À L'INTÉRIEUR : le braquage ne tourne pas avec
# elle. WheelSpinTest vérifie, roues avant braquées à fond des deux côtés et à trois angles de roulement : axe du
# moyeu horizontal (carrossage nul), angle de braquage exact, bon côté, centre de la roue immobile.

# Empattement : distance, le long de la voiture, entre le milieu des roues avant et le milieu des autres, mesurée
# sur leurs centres (repère de la voiture) ; voie : écart latéral entre les roues avant. Servent au braquage du
# joueur (modèle bicyclette, cf. BRAQUAGE_A_LAT) et au braquage visuel de la circulation.
func _mesurer_empattement() -> void:
	var za := 0.0
	var na := 0
	var zr := 0.0
	var nr := 0
	var xa := Vector2(INF, -INF)
	for w in _wheels:
		var c := _xf_dans_voiture(w) * (_wheel_centre.get(w, Vector3.ZERO) as Vector3)
		if w in _wheels_front:
			za += c.z
			na += 1
			xa = Vector2(minf(xa.x, c.x), maxf(xa.y, c.x))
		else:
			zr += c.z
			nr += 1
	if na > 0 and nr > 0:
		_empattement = maxf(absf(zr / float(nr) - za / float(na)), 0.5)
		_z_essieu_av = za / float(na)
		_z_essieu_ar = zr / float(nr)
	if na >= 2:
		_voie = maxf(xa.y - xa.x, 0.5)


# BRAQUAGE VISUEL DE LA CIRCULATION (2026-09-21). Les voitures de la circulation passaient un braquage NUL à
# _update_visuals : leurs roues avant ne pivotaient jamais, même dans un virage serré. On le déduit du virage
# qu'elles décrivent réellement : un cap qui tourne de ω rad/s à la vitesse v trace un rayon R = v / ω, et des
# roues avant à l'empattement L font alors l'angle atan(L / R) = atan(L·ω / v). Un cap qui augmente tourne à
# gauche (rotation autour de +Y), comme _steer_input > 0 chez le joueur. Visuel seulement : la conduite n'en
# dépend pas.
func _braquage_ia(dcap_deg: float, delta: float) -> float:
	if delta <= 0.0:
		return 0.0
	var omega := deg_to_rad(dcap_deg) / delta
	var v := maxf(absf(_ai_speed), 0.5)
	return clampf(atan(_empattement * omega / v) / MAX_STEER_RAD, -1.0, 1.0)

# Mesures par modèle et par roue, faites UNE fois : toutes les voitures d'un même modèle ont les mêmes roues,
# et la mesure de symétrie parcourt tous les sommets de la roue.
static var _mesures_roues := {}

func _mesurer_roue(w: Node3D) -> void:
	var cle := "%s|%s" % [model_path, String(_model.get_path_to(w))]
	if _mesures_roues.has(cle):
		var m: Array = _mesures_roues[cle]
		_wheel_axis[w] = m[0]
		_wheel_radius[w] = m[1]
		_wheel_pas_max[w] = m[2]
		_wheel_centre[w] = m[4]
		_wheel_parent_base[w] = m[5]
		return
	var b := _base_dans_voiture(w)
	var meilleur := wheel_spin_axis.normalized()
	var alignement := -1.0
	for e: Vector3 in [Vector3(1, 0, 0), Vector3(0, 1, 0), Vector3(0, 0, 1)]:
		var a := absf((b * e).normalized().x)
		if a > alignement:
			alignement = a
			meilleur = e
	var axe_voiture := (b * meilleur).normalized() * signf(b.determinant())
	# rotation d'un petit angle positif autour de l'axe : le sommet (+Y) se déplace selon axe x Y
	if axe_voiture.cross(Vector3.UP).dot(Vector3(0, 0, -1)) < 0.0:
		meilleur = -meilleur
	_wheel_axis[w] = meilleur
	# rayon réel : demi-hauteur des maillages de la roue dans le repère de la voiture
	var haut := -INF
	var bas := INF
	var meshes := w.find_children("*", "MeshInstance3D", true, false)
	if w is MeshInstance3D:
		meshes.append(w)
	for mi_n in meshes:
		var mi := mi_n as MeshInstance3D
		if mi.mesh == null:
			continue
		var xf := _xf_dans_voiture(mi)
		var aabb := mi.mesh.get_aabb()
		for k in 8:
			var y := (xf * aabb.get_endpoint(k)).y
			haut = maxf(haut, y)
			bas = minf(bas, y)
	if haut > bas:
		_wheel_radius[w] = maxf((haut - bas) * 0.5, 0.05)
	# CENTRE GÉOMÉTRIQUE, dans le repère local de la roue : milieu de la boîte de ses maillages. Le pivot du
	# noeud n'y est pas toujours — mesuré sur normalcar2, la roue avant droite a son origine décalée, et elle
	# tournait en excentrique. On tourne autour de ce centre (cf. _update_visuals), et la symétrie se lit
	# autour de lui aussi.
	var inv_w := _xf_dans_voiture(w).affine_inverse()
	var lmin := Vector3(INF, INF, INF)
	var lmax := Vector3(-INF, -INF, -INF)
	for mi_n in meshes:
		var mi := mi_n as MeshInstance3D
		if mi.mesh == null:
			continue
		var xf_l := inv_w * _xf_dans_voiture(mi)
		var bx := mi.mesh.get_aabb()
		for k in 8:
			var q := xf_l * bx.get_endpoint(k)
			lmin = lmin.min(q)
			lmax = lmax.max(q)
	_wheel_centre[w] = (lmin + lmax) * 0.5 if lmax.x >= lmin.x else Vector3.ZERO
	var n_sym := _symetrie_roue(w, meilleur, _wheel_centre[w])
	_wheel_pas_max[w] = 0.45 * TAU / float(n_sym) if n_sym > 1 else PI * 0.5
	var base_parent := _base_dans_voiture(w.get_parent())
	_wheel_parent_base[w] = [base_parent, base_parent.inverse()]
	_mesures_roues[cle] = [_wheel_axis[w], _wheel_radius.get(w, WHEEL_RADIUS), _wheel_pas_max[w], n_sym, _wheel_centre[w],
			_wheel_parent_base[w]]


# Mesures d'une roue (axe local, rayon, pas maximal par image, ordre de symétrie, centre local, base du parent), pour
# les tests.
func mesure_roue(w: Node3D) -> Array:
	return _mesures_roues.get("%s|%s" % [model_path, String(_model.get_path_to(w))], [])


# Ordre de symétrie de rotation d'une roue autour de son axe `axe` (repère local) : les sommets de ses
# maillages, projetés sur le disque, en angle ; la plus petite fréquence k (3 à 24) dont la composante de
# Fourier ressort est la période de la jante (un motif à N branches n'a de composantes qu'aux multiples de
# N). 1 si rien ne ressort (roue lisse : aucun motif à confondre).
func _symetrie_roue(w: Node3D, axe: Vector3, centre: Vector3) -> int:
	var inv := _xf_dans_voiture(w).affine_inverse()
	var i_axe := 0 if absf(axe.x) > 0.5 else (1 if absf(axe.y) > 0.5 else 2)
	var i_u := (i_axe + 1) % 3
	var i_v := (i_axe + 2) % 3
	var angles := PackedFloat32Array()
	var rayons := PackedFloat32Array()
	var r_max := 0.0
	var meshes := w.find_children("*", "MeshInstance3D", true, false)
	if w is MeshInstance3D:
		meshes.append(w)
	for mi_n in meshes:
		var mi := mi_n as MeshInstance3D
		if mi.mesh == null:
			continue
		var xf := inv * _xf_dans_voiture(mi)
		for s in mi.mesh.get_surface_count():
			for v: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
				var l := xf * v - centre
				var r := Vector2(l[i_u], l[i_v]).length()
				angles.append(atan2(l[i_v], l[i_u]))
				rayons.append(r)
				r_max = maxf(r_max, r)
	if angles.is_empty() or r_max <= 0.0:
		return 1
	for k in range(3, 25):
		var c := 0.0
		var sn := 0.0
		var n := 0
		for i in angles.size():
			if rayons[i] < r_max * 0.15:
				continue
			c += cos(k * angles[i])
			sn += sin(k * angles[i])
			n += 1
		if n > 0 and sqrt(c * c + sn * sn) / float(n) >= 0.3:
			return k
	return 1


# Transformation d'un noeud du modèle dans le repère de la voiture, composée à la main : ne dépend pas de
# l'arbre (le modèle vient d'être ajouté, et le basculement de caisse est nul à la pose).
func _xf_dans_voiture(n: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var cur: Node = n
	while cur != null and cur != self:
		if cur is Node3D:
			t = (cur as Node3D).transform * t
		cur = cur.get_parent()
	return t


func _base_dans_voiture(n: Node) -> Basis:
	return _xf_dans_voiture(n).basis


func start_drive() -> void:
	driven_by_player = true
	_abandoned = false
	_player_near = false
	_drive_speed = 0.0
	_prompt.visible = false
	_abandon_gen += 1   # une disparition programmée à une sortie précédente ne vaut plus (cf. stop_drive)
	appliquer_mode_conduite()

func stop_drive() -> void:
	driven_by_player = false
	_abandoned = true
	_drive_speed = 0.0
	velocity = Vector3.ZERO
	if _chassis != null:
		_chassis.Controlled = false   # stationnement : pédales à zéro, frein à main (ChassisReel.controls)
	# DISPARITION APRÈS ABANDON (corrigé le 2026-09-24). Le compte à rebours était branché sur queue_free sans condition :
	# ressorti puis remonté dans les 25 s, le joueur voyait la voiture disparaître sous lui 25 s après sa PREMIÈRE sortie
	# — et lui avec, puisqu'il est assis sur son siège. Chaque sortie a maintenant son numéro, et seule la dernière, la
	# voiture toujours abandonnée, la fait disparaître.
	_abandon_gen += 1
	if not is_player_owned:
		get_tree().create_timer(ABANDON_DESPAWN).timeout.connect(_disparaitre_si_abandonnee.bind(_abandon_gen))

func _disparaitre_si_abandonnee(gen: int) -> void:
	if gen == _abandon_gen and not driven_by_player:
		queue_free()

# Voiture EN STATIONNEMENT (ParkedVehicles) : aucun trajet, aucune IA, elle se pose au sol et
# attend qu'on la prenne. `_abandoned` est exactement l'état qui convient — c'est celui d'une voiture
# laissée là — et c'est le seul qui laisse la gravité agir quand `_path` est nul : sans lui,
# _physics_process sort immédiatement et la voiture reste en l'air. Aucun compte à rebours de
# disparition n'est armé ici ; il n'est créé que dans stop_drive(), quand le joueur la quitte.
func park() -> void:
	_abandoned = true
	_drive_speed = 0.0
	velocity = Vector3.ZERO


# Voiture à l'arrêt que personne ne conduit : garée par ParkedVehicles, ou abandonnée par le joueur.
func is_parked() -> bool:
	return _abandoned and not driven_by_player


func is_occupied() -> bool:
	return driven_by_player

# Coupure de calcul hors champ et loin du joueur (SimulationCuller) : l'état reste figé tel quel, sans
# suppression ni déplacement. À la reprise, relecture immédiate du feu et des obstacles au lieu de repartir
# sur la limite de vitesse mise en cache avant la pause.
func set_simulation_active(active: bool) -> void:
	set_physics_process(active)
	if active:
		_obstacle_recheck_timer = 0.0
	if _chassis != null:
		_chassis.activer_simulation(active)
		set_process(active)

# Garde éveillée (SimulationCuller) la voiture qui retient celle-ci.
static func _keep_awake(o: Object) -> void:
	o.set_meta(SIM_KEEP_AWAKE_META, Engine.get_physics_frames() + SIM_KEEP_AWAKE_FRAMES)

# --- CONDUITE RÉALISTE : ESSAI (2026-09-24, étape 1, CLAUDE.md §13) ---------------------------------------------------
#
# F7 (EssaiConduiteReelle, sur le joueur) bascule `conduite_reelle`, coupée au lancement. Quand elle est active et que le
# joueur conduit un modèle dont le châssis se mesure (les 72 : cf. _mesures_chassis), la voiture se dote d'un châssis
# physique réglé sur sa fiche (ChassisReel, le cœur du pack VitaVehicle ; FichesVehicules, CLAUDE.md §14) et le SUIT au
# lieu de rouler en arcade. Elle garde son nœud et tout ce qui y est accroché — modèle,
# feux, gyrophares, zone de tir, zone d'écrasement, taches, place dans la circulation — et prend la position et le cap du
# châssis ; son modèle prend en plus le roulis et le tangage, ses roues leur rotation, leur braquage et leur débattement.
# Ce qui lit la voiture continue de marcher : `_drive_speed` (écrasement, caméra), `_player_braking` (feux de freinage),
# `driven_by_player` (feux, gyrophares, culler). Le corps arcade est coupé (couches à zéro) tant que le châssis existe.
# À la descente, le châssis reste — pédales à zéro, frein à main — et se fige une fois arrêté : la voiture reste là où
# elle s'est arrêtée, penchée sur une rampe s'il le faut. Il n'est rendu à l'arcade que si on remonte (ou si on bascule)
# F7 coupé : un corps arcade ne sait pas s'incliner, une voiture arrêtée en pente sauterait.
const ChassisReel := preload("res://scenes/vehicles/ChassisReel.gd")
static var conduite_reelle := false
static var _mesures_chassis_cache := {}   # model_path -> mesures, dans le repère du châssis
var _chassis: RigidBody3D = null
var _roue_chassis := {}      # roue du modèle -> roue du châssis
var _centre_repos := {}      # roue du modèle -> centre de sa roue de châssis au repos (repère du châssis)
var _couches_arcade := Vector2i(-1, -1)
var _cap_chassis := 0.0
var _model_repos := Transform3D.IDENTITY
var cout_visuels_us := 0     # dernière image : suivi du châssis + modèle + roues (mesure du coût, ConduiteReelleTest)


# Repère du châssis dans celui de la voiture : le pack a l'avant en +Z et la gauche en +X, la voiture l'avant en -Z.
static func repere_chassis() -> Transform3D:
	return Transform3D(Basis(Vector3(-1, 0, 0), Vector3(0, 1, 0), Vector3(0, 0, -1)), Vector3.ZERO)


func conduite_reelle_possible() -> bool:
	return not _mesures_chassis().is_empty()


# La fiche physique du modèle (FichesVehicules, CLAUDE.md §14) ; {} s'il n'en a pas (le châssis prend alors les valeurs
# par défaut de la berline).
func fiche_physique() -> Dictionary:
	var data := VehicleCatalog.find_by_path(model_path)
	return FichesVehicules.fiche(data.id) if data != null else {}


# Met la voiture conduite dans le mode choisi (F7) : à la montée, et à la bascule en roulant.
func appliquer_mode_conduite() -> void:
	if not driven_by_player:
		return
	if conduite_reelle and conduite_reelle_possible():
		_activer_chassis()
	elif _chassis != null:
		_retirer_chassis()


func chassis() -> RigidBody3D:
	return _chassis


# Pour le bandeau de l'essai (EssaiConduiteReelle).
func infos_conduite() -> Dictionary:
	return {"essai": conduite_reelle_possible(), "reelle": _chassis != null,
			"rapport": _chassis.rapport() if _chassis != null else "", "kmh": absf(_drive_speed) * 3.6}


# Corps à exclure d'une requête de place autour de la voiture (Player._sortie_libre) : elle-même et son châssis.
func rids_exclus() -> Array[RID]:
	var r: Array[RID] = [get_rid()]
	if _chassis != null:
		r.append(_chassis.get_rid())
	return r


func _activer_chassis() -> void:
	if _chassis == null:
		var m := _mesures_chassis()
		if m.is_empty():
			return
		var ch = ChassisReel.new()
		ch.configurer(m, MAX_STEER_RAD, fiche_physique())
		ch.top_level = true
		ch.transform = global_transform * repere_chassis()
		_model_repos = _pose_repos_modele()
		add_child(ch)
		_chassis = ch
		_roue_chassis.clear()
		_centre_repos.clear()
		for r: Dictionary in m["roues"]:
			if String(r["chemin"]) == "":
				continue      # roue physique sans roue de modèle : la seconde roue d'un essieu arrière d'une seule pièce
			var w := _model.get_node_or_null(NodePath(String(r["chemin"]))) as Node3D
			if w != null:
				_roue_chassis[w] = ch.get_node(String(r["nom"]))
				_centre_repos[w] = r["centre"]
		ch.repartir(-global_transform.basis.z * _drive_speed + Vector3(0.0, velocity.y, 0.0))
		_couches_arcade = Vector2i(collision_layer, collision_mask)
		collision_layer = 0
		collision_mask = 0
		_cap_chassis = rotation.y
		# le modèle et ses roues sont reposés à l'image (_process) : avant VehicleLights, qui y lit la place des phares et
		# des feux, sinon ils traîneraient d'une image derrière la voiture (0,5 m à 108 km/h)
		process_priority = -10
		set_process(true)
	else:
		_chassis.degeler()
	_chassis.Controlled = true


func _retirer_chassis() -> void:
	var ch := _chassis
	_suivre_chassis()
	var v: Vector3 = ch.linear_velocity
	_chassis = null
	_roue_chassis.clear()
	_centre_repos.clear()
	# hors de l'espace physique TOUT DE SUITE : libéré en différé, il restait un pas à la même place que la voiture arcade
	# qui reprend, et les deux corps se repoussaient (mesuré : 0,76 m de chute à la bascule F7)
	remove_child(ch)
	ch.queue_free()
	if _couches_arcade.x >= 0:
		collision_layer = _couches_arcade.x
		collision_mask = _couches_arcade.y
	velocity = v
	_drive_speed = v.dot(-global_transform.basis.z)
	if _model != null:
		_model.transform = _model_repos
	process_priority = 0
	set_process(false)


func _pose_repos_modele() -> Transform3D:
	return Transform3D(Basis(Vector3.UP, deg_to_rad(model_yaw_deg)).scaled(Vector3.ONE * model_scale), Vector3(0.0, model_y_offset, 0.0))


# La voiture prend la position du châssis et son cap, jamais son roulis ni son tangage : caméra, sortie, circulation et
# zones continuent de voir une voiture droite, comme en arcade.
func _suivre_chassis() -> void:
	var k := _chassis.global_transform
	var avant := k.basis.z
	if Vector2(avant.x, avant.z).length() > 0.05:
		_cap_chassis = atan2(-avant.x, -avant.z)
	global_transform = Transform3D(Basis(Vector3.UP, _cap_chassis), k.origin)


# À l'image : relu APRÈS le pas physique, le châssis est à sa place exacte (le suivi du _physics_process a un pas de
# retard). Rien ne tourne pour les voitures sans châssis (set_process(false)).
func _process(delta: float) -> void:
	if _chassis == null:
		set_process(false)
		return
	var t0 := Time.get_ticks_usec()
	_suivre_chassis()
	_visuels_chassis(delta)
	cout_visuels_us = Time.get_ticks_usec() - t0


# Le modèle collé au châssis (roulis, tangage, débattement de la caisse), et chaque roue à sa roue de châssis : roulement
# à SA vitesse (celle du pneu, qui peut patiner ou bloquer), braquage à SON angle (géométrie d'Ackermann du pack),
# débattement vertical de SA suspension. Mêmes conventions que _update_visuals : axe et centre relevés par _mesurer_roue,
# braquage conjugué par la base du parent de la roue (cf. BRAQUAGE), plafond anti-stroboscope par image.
func _visuels_chassis(delta: float) -> void:
	var k := _chassis.global_transform
	if _model != null:
		_model.transform = global_transform.affine_inverse() * k * repere_chassis() * _model_repos
	var echelle: float = _chassis.LengthScale
	for w in _wheels:
		var r = _roue_chassis.get(w)
		if r == null:
			continue
		var rayon: float = _wheel_radius.get(w, WHEEL_RADIUS)
		var pas_max: float = _wheel_pas_max.get(w, ROUE_PAS_DEFAUT)
		var v_roue: float = float(r.wv) * float(r.w_size) * echelle
		var angle: float = fmod(float(_wheel_angle.get(w, 0.0)) + clampf(v_roue / rayon * delta, -pas_max, pas_max), TAU)
		_wheel_angle[w] = angle
		var rest: Basis = _wheel_rest[w]
		var b := rest * Basis(_wheel_axis.get(w, wheel_spin_axis.normalized()), angle)
		var m: Array = _wheel_parent_base.get(w, [Basis.IDENTITY, Basis.IDENTITY])
		if w in _wheels_front:
			b = (m[1] as Basis) * Basis(Vector3.UP, (r as Node3D).rotation.y) * (m[0] as Basis) * b
		var centre_k: Vector3 = (r as Node3D).transform * ((r as Node3D).get_node("animation") as Node3D).position
		var decal := (m[1] as Basis) * Vector3(0.0, centre_k.y - (_centre_repos[w] as Vector3).y, 0.0)
		var c: Vector3 = _wheel_centre.get(w, Vector3.ZERO)
		var o: Vector3 = _wheel_rest_origin.get(w, w.transform.origin)
		w.transform = Transform3D(b, o + rest * c - b * c + decal)


# Mesures du modèle pour son châssis, une fois par modèle, dans le REPÈRE DU CHÂSSIS, le modèle pris dans sa pose de REPOS
# (le basculement arcade du moment n'y entre pas) : centre et rayon de chaque roue, sol sous les pneus, coque.
func _mesures_chassis() -> Dictionary:
	if _mesures_chassis_cache.has(model_path):
		return _mesures_chassis_cache[model_path]
	if _model == null or _wheels_front.size() != 2 or _wheels.size() < 3:
		return {}
	var vers_chassis := repere_chassis().affine_inverse() * _pose_repos_modele()
	var roues: Array = []
	var arriere: Array = []
	var y_sol := INF
	var x_avant := 0.0
	for w in _wheels:
		var c: Vector3 = vers_chassis * (_xf_dans_modele(w) * (_wheel_centre.get(w, Vector3.ZERO) as Vector3))
		var r: float = _wheel_radius.get(w, WHEEL_RADIUS)
		y_sol = minf(y_sol, c.y - r)
		if w in _wheels_front:
			x_avant = maxf(x_avant, absf(c.x))
			roues.append({"chemin": String(_model.get_path_to(w)), "centre": c, "rayon": r, "avant": true,
					"nom": "fl" if c.x > 0.0 else "fr"})
		else:
			arriere.append([String(_model.get_path_to(w)), c, r])
	if roues[0]["nom"] == roues[1]["nom"]:
		return {}
	roues[0]["jumelle"] = roues[1]["nom"]
	roues[1]["jumelle"] = roues[0]["nom"]
	# Essieux arrière, de l'avant vers l'arrière (repère du châssis : l'avant en +z) : deux roues à moins de 0,3 m en z
	# sont sur le même essieu, un tandem en fait deux (car, benne à ordures, city_truck_03). Un essieu d'UNE roue centrée
	# est d'une seule pièce dans le modèle (les six modèles d'origine : « BackWheels » porte les deux roues) : il reçoit
	# deux roues physiques à la voie de l'avant, et la roue du modèle suit celle de gauche.
	arriere.sort_custom(func(a, b): return (a[1] as Vector3).z > (b[1] as Vector3).z)
	var essieux: Array = []
	for e: Array in arriere:
		if not essieux.is_empty() and absf((((essieux.back() as Array)[0] as Array)[1] as Vector3).z - (e[1] as Vector3).z) < 0.3:
			(essieux.back() as Array).append(e)
		else:
			essieux.append([e])
	for k in essieux.size():
		var suffixe := "" if essieux.size() == 1 else str(k + 1)
		var essieu: Array = essieux[k]
		if essieu.size() == 1:
			var c: Vector3 = essieu[0][1]
			if absf(c.x) > 0.3 * x_avant:
				return {}      # une roue arrière seule et décentrée : modèle incomplet
			roues.append({"chemin": essieu[0][0], "centre": Vector3(x_avant, c.y, c.z), "rayon": essieu[0][2], "avant": false, "nom": "rl" + suffixe})
			roues.append({"chemin": "", "centre": Vector3(-x_avant, c.y, c.z), "rayon": essieu[0][2], "avant": false, "nom": "rr" + suffixe})
		elif essieu.size() == 2 and signf((essieu[0][1] as Vector3).x) != signf((essieu[1][1] as Vector3).x):
			for e: Array in essieu:
				roues.append({"chemin": e[0], "centre": e[1], "rayon": e[2], "avant": false,
						"nom": ("rl" if (e[1] as Vector3).x > 0.0 else "rr") + suffixe})
		else:
			return {}
		roues[roues.size() - 2]["jumelle"] = roues[roues.size() - 1]["nom"]
		roues[roues.size() - 1]["jumelle"] = roues[roues.size() - 2]["nom"]
	var plancher := y_sol + FichesVehicules.nombre(fiche_physique(), "garde_cm") / 100.0
	var coques := _coques_pieces(plancher)
	if coques.is_empty():
		var coque := _coque_chassis(vers_chassis, plancher)
		if coque == null:
			return {}
		coques = [coque]
	# surface frontale pour la traînée : la boîte du modèle (largeur x hauteur, rétroviseurs et roues compris) x 0,8, la
	# part qu'en occupe une vraie silhouette de voiture
	var m := {"roues": roues, "y_sol": y_sol, "coques": coques, "surface": _boite_caisse.size.x * _boite_caisse.size.y * 0.8,
			"voie": 2.0 * x_avant, "hauteur": _boite_caisse.size.y - 0.04, "essieux_arriere": essieux.size()}
	_mesures_chassis_cache[model_path] = m
	return m


# Les coques par pièce des modèles qui en ont (camions, bus, pick-up : cf. ENVELOPPES) : une enveloppe unique joindrait le
# toit de la cabine au bout de la benne. Les pièces des roues sont écartées (elles ne franchissent pas l'axe de la
# voiture ; ce sont les rayons du châssis qui la portent), le bas des autres relevé au plancher.
func _coques_pieces(plancher: float) -> Array:
	_enveloppes_par_piece()
	var data := VehicleCatalog.find_by_path(model_path)
	var out: Array = []
	if data == null or not _pieces.has(data.id):
		return out
	var vers_chassis := repere_chassis().affine_inverse()
	for env in _pieces[data.id]:
		var pts := PackedVector3Array()
		var x_min := INF
		var x_max := -INF
		for p in env:
			var q := vers_chassis * Vector3(float(p[0]), float(p[1]), float(p[2]))
			x_min = minf(x_min, q.x)
			x_max = maxf(x_max, q.x)
			pts.append(Vector3(q.x, maxf(q.y, plancher), q.z))
		if x_min > 0.0 or x_max < 0.0:
			continue
		var forme := ConvexPolygonShape3D.new()
		forme.points = pts
		out.append(forme)
	return out


# La coque du châssis : la silhouette du modèle comme l'enveloppe arcade (cf. ENVELOPPE, rétroviseurs ramenés à la
# largeur de la caisse), mais son bas RELEVÉ à la garde au sol de la fiche au-dessus du sol au lieu de descendre jusqu'aux
# pneus : ce sont les roues à rayon qui portent la voiture, la coque ne doit toucher ni la chaussée ni une bordure.
func _coque_chassis(vers_chassis: Transform3D, plancher: float) -> ConvexPolygonShape3D:
	var faces := PackedVector3Array()
	var liste := _model.find_children("*", "MeshInstance3D", true, false)
	if _model is MeshInstance3D:
		liste.append(_model)
	for n in liste:
		var mi := n as MeshInstance3D
		if mi.mesh != null and mi.visible:
			faces.append_array((vers_chassis * _xf_dans_modele(mi)) * mi.mesh.get_faces())
	if faces.size() < 12:
		return null
	var bas := INF
	for v in faces:
		bas = minf(bas, v.y)
	var h := _boite_caisse.size.y
	var demi_largeur := 0.0
	for v in faces:
		if v.y <= bas + 0.55 * h:
			demi_largeur = maxf(demi_largeur, absf(v.x))
	for i in faces.size():
		var v := faces[i]
		faces[i] = Vector3(clampf(v.x, -demi_largeur, demi_largeur), maxf(v.y, plancher), v.z)
	var am := ArrayMesh.new()
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = faces
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return am.create_convex_shape(true, false)

# --- zone d'interaction + éjection PNJ -------------------------

func _on_zone_entered(body: Node3D) -> void:
	if body.is_in_group("player") and body.has_method("notify_car_in_range"):
		_player_near = true
		body.notify_car_in_range(self)
		_refresh_prompt()

func _on_zone_exited(body: Node3D) -> void:
	if body.is_in_group("player") and body.has_method("notify_car_out_of_range"):
		_player_near = false
		body.notify_car_out_of_range(self)
		_prompt.visible = false

func _refresh_prompt() -> void:
	_prompt.visible = _player_near and not driven_by_player

func eject_driver() -> void:
	if not has_npc_driver:
		return
	has_npc_driver = false
	var npc_scene := load("res://scenes/npc/NPC.tscn") as PackedScene
	if npc_scene == null:
		return
	var npc := npc_scene.instantiate()
	get_tree().current_scene.add_child(npc)
	if npc.has_method("setup_ejected"):
		var eject_point := get_node_or_null("EjectPoint") as Node3D
		var spawn_pos: Vector3 = eject_point.global_position if eject_point != null else global_position
		var pedgraph := get_tree().current_scene.get_node_or_null("PedGraph") as PathGraph
		npc.setup_ejected(spawn_pos, pedgraph)

# --- écrasement PNJ ------------------------------------------

func _on_crush_zone_entered(body: Node3D) -> void:
	if not driven_by_player or absf(_drive_speed) < CRUSH_MIN_SPEED:
		return
	if body.is_in_group("npc") and body.has_method("take_damage"):
		body.take_damage(999, body.global_position, Vector3.UP)   # réutilise la mort PNJ + sang au sol
		_add_body_stain()

# TACHE DE SANG SUR LA CAISSE RÉELLE (2026-09-23). La tache était posée à z = -2,02 fixe, le pare-chocs de la voiture
# d'essai d'origine. Relevé sur les 72 modèles contre l'avant de leur boîte de collision : 62 l'avaient à plus de 5 cm
# DERRIÈRE leur point le plus avancé (autocar 3,72 m, bus 3,24 : invisible dans la caisse), 5 à plus de 5 cm DEVANT,
# dans le vide (micro-citadine 0,79 m). Et même au bon z, un quad vertical n'épouse pas un avant galbé : jugées sur la
# vraie caisse (un point par centimètre), aucune des 1 728 taches tirées (24 par modèle) n'y était entièrement posée.
# Elle est maintenant posée SUR la carrosserie, mesurée sur ses triangles comme les roues : un rayon tiré de devant vers
# l'arrière, à une hauteur d'impact de piéton, touche le premier triangle du modèle ; la tache s'y couche selon la
# normale, TACHE_DECOLLEMENT au-dessus, et n'est gardée que si son centre est vu de face et que ses points, un tous les
# TACHE_PAS au plus, ont la carrosserie derrière eux, entre TACHE_JEU_MIN et TACHE_JEU_MAX, et rien de la voiture devant.
# 9 points laissaient passer des taches derrière les barreaux d'une calandre ou à cheval sur un creux ; et les ROUES comptent
# comme obstacle (jamais comme support) : sans elles, des taches se posaient sous un garde-boue, face à la roue,
# invisibles. Sinon elle rétrécit, puis on tire un autre point. Rangée sous le modèle : elle suit son basculement.
const TACHE_DECOLLEMENT := 0.015          # m au-dessus de la surface, contre le z-fighting
const TACHE_JEU_MIN := 0.005              # m : un point plus près de la surface l'effleure (creux) et s'y enfonce vite
const TACHE_JEU_MAX := 0.03               # m : un point de la tache plus loin de la surface flotte dans le vide
const TACHE_DEVANT := 0.5                 # m devant la tache où rien de la voiture ne doit se trouver
const TACHE_HAUTEUR := Vector2(0.25, 1.2) # m au-dessus du bas de la caisse : jambes et bassin d'un piéton
const TACHE_LARGEUR := 0.4                # fraction de la largeur de la caisse, de part et d'autre de l'axe
const TACHE_ESSAIS := 24
const TACHE_REDUCTIONS := 4               # tailles essayées au même point : x 1, 0,7, 0,49, 0,34
const TACHE_META := &"tache_de_sang"

# Triangles du modèle dans son propre repère, une fois par modèle (toutes les voitures d'un même modèle ont la même
# carrosserie) : [TriangleMesh, un octet par triangle, 1 s'il est à une roue]. TriangleMesh fait l'intersection en C++.
static var _carrosseries := {}

func _add_body_stain() -> void:
	if _stains >= MAX_STAINS or _model == null:
		return
	var carrosserie := _carrosserie()
	if carrosserie.is_empty():
		return
	var boite := _boite_caisse
	var vers_voiture := _xf_dans_voiture(_model)
	var ctx := {"tm": carrosserie[0], "roues": carrosserie[1], "vers_modele": vers_voiture.affine_inverse(),
			"vers_voiture": vers_voiture}
	var bas := boite.position.y
	var avant := boite.position.z
	var haut := maxf(minf(TACHE_HAUTEUR.y, boite.size.y * 0.85), TACHE_HAUTEUR.x)
	for essai in TACHE_ESSAIS:
		var x := randf_range(-TACHE_LARGEUR, TACHE_LARGEUR) * boite.size.x
		var y := bas + randf_range(TACHE_HAUTEUR.x, haut)
		var impact := _toucher_carrosserie(ctx, Vector3(x, y, avant - 1.0), Vector3(x, y, avant + boite.size.z))
		if impact.is_empty() or impact["roue"]:
			continue
		var n: Vector3 = impact["normal"]
		if n.z > -0.35 or n.y < -0.6:
			continue    # dessus du capot, flanc, dessous de caisse : une face qu'un piéton debout devant ne voit pas
		var taille := Vector2(randf_range(0.25, 0.5), randf_range(0.25, 0.5))
		var roulis := randf() * TAU
		for reduction in TACHE_REDUCTIONS:
			var xf := _pose_tache(impact["position"], n, roulis)
			if _tache_sur_carrosserie(ctx, xf, taille):
				_poser_tache(ctx["vers_modele"] * xf, taille)
				return
			taille *= 0.7

func _carrosserie() -> Array:
	if _carrosseries.has(model_path):
		return _carrosseries[model_path]
	var liste := _model.find_children("*", "MeshInstance3D", true, false)
	if _model is MeshInstance3D:
		liste.append(_model)
	var faces := PackedVector3Array()
	var roues := PackedByteArray()
	for n in liste:
		var mi := n as MeshInstance3D
		if mi.mesh == null or mi.has_meta(TACHE_META) or not _visible_dans_modele(mi):
			continue
		var f := _xf_dans_modele(mi) * mi.mesh.get_faces()
		faces.append_array(f)
		var marque := PackedByteArray()
		marque.resize(f.size() / 3)
		marque.fill(1 if _dans_une_roue(mi) else 0)
		roues.append_array(marque)
	var resultat := []
	if not faces.is_empty():
		var tm := TriangleMesh.new()
		if tm.create_from_faces(faces):
			resultat = [tm, roues]
	_carrosseries[model_path] = resultat
	return resultat

# Premier triangle du modèle sur le segment de -> a (repère de la voiture) : point et normale tournée vers `de`, dans le
# repère de la voiture, et s'il est à une roue ; vide si rien.
func _toucher_carrosserie(ctx: Dictionary, de: Vector3, a: Vector3) -> Dictionary:
	var vers_modele: Transform3D = ctx["vers_modele"]
	var vers_voiture: Transform3D = ctx["vers_voiture"]
	var hit := (ctx["tm"] as TriangleMesh).intersect_segment(vers_modele * de, vers_modele * a)
	if hit.is_empty():
		return {}
	var n := (vers_voiture.basis * (hit["normal"] as Vector3)).normalized()
	if n.dot(a - de) > 0.0:
		n = -n
	var roues: PackedByteArray = ctx["roues"]
	var i := int(hit["face_index"])
	return {"position": vers_voiture * (hit["position"] as Vector3), "normal": n, "roue": i < roues.size() and roues[i] == 1}

# Repère de la tache dans celui de la voiture : couchée sur la surface, sa face (+Z du quad) selon la normale n,
# tournée de `roulis` autour d'elle.
func _pose_tache(p: Vector3, n: Vector3, roulis: float) -> Transform3D:
	var x := Vector3.UP.cross(n)
	if x.length() < 0.01:
		x = Vector3.RIGHT
	x = x.normalized()
	return Transform3D(Basis(n, roulis) * Basis(x, n.cross(x), n), p + n * TACHE_DECOLLEMENT)

# La tache épouse-t-elle la caisse ? Son centre vu de face (rien de la voiture devant lui vers l'avant), puis une grille
# de points à TACHE_PAS au plus, les coins d'abord (ce sont eux qui lâchent le plus souvent) : la carrosserie derrière
# chacun, jamais une roue, entre TACHE_JEU_MIN et TACHE_JEU_MAX, tournée comme la tache, et rien de la voiture devant
# sur TACHE_DEVANT. Un pas relatif (5 x 5 points, 12,5 cm sur une tache de 50) laissait un barreau de pare-buffle
# passer entre deux points.
const TACHE_PAS := 0.04

func _tache_sur_carrosserie(ctx: Dictionary, xf: Transform3D, taille: Vector2) -> bool:
	if not _toucher_carrosserie(ctx, xf.origin + Vector3(0, 0, -0.001), xf.origin + Vector3(0, 0, -5.0)).is_empty():
		return false
	for c in [Vector2(-0.5, -0.5), Vector2(0.5, -0.5), Vector2(-0.5, 0.5), Vector2(0.5, 0.5)]:
		if not _point_sur_carrosserie(ctx, xf, c * taille):
			return false
	var nx := int(ceil(taille.x / TACHE_PAS)) + 1
	var ny := int(ceil(taille.y / TACHE_PAS)) + 1
	for i in nx:
		for j in ny:
			if (i == 0 or i == nx - 1) and (j == 0 or j == ny - 1):
				continue
			var local := Vector2((float(i) / (nx - 1) - 0.5) * taille.x, (float(j) / (ny - 1) - 0.5) * taille.y)
			if not _point_sur_carrosserie(ctx, xf, local):
				return false
	return true

func _point_sur_carrosserie(ctx: Dictionary, xf: Transform3D, local: Vector2) -> bool:
	var n := xf.basis.z
	var p := xf * Vector3(local.x, local.y, 0.0)
	var dessous := _toucher_carrosserie(ctx, p + n * TACHE_DEVANT, p - n * TACHE_JEU_MAX)
	if dessous.is_empty() or dessous["roue"]:
		return false    # dans le vide, ou sur une roue
	var jeu := (p - (dessous["position"] as Vector3)).dot(n)
	# jeu trop petit : quelque chose de la voiture devant le point, ou la surface qui l'effleure ; normale trop
	# écartée : une face qui ne porte pas la tache (flanc, arête)
	return jeu >= TACHE_JEU_MIN and (dessous["normal"] as Vector3).dot(n) >= 0.5

func _poser_tache(xf_modele: Transform3D, taille: Vector2) -> void:
	_stains += 1
	var q := QuadMesh.new()
	q.size = taille
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(0.22, 0.0, 0.0, randf_range(0.55, 0.85))
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	var mi := MeshInstance3D.new()
	mi.mesh = q
	mi.material_override = mat
	mi.transform = xf_modele
	mi.set_meta(TACHE_META, true)
	_model.add_child(mi)

func _dans_une_roue(n: Node) -> bool:
	for w in _wheels:
		if w == n or w.is_ancestor_of(n):
			return true
	return false

func _visible_dans_modele(n: Node) -> bool:
	var cur: Node = n
	while cur != null and cur != _model:
		if cur is Node3D and not (cur as Node3D).visible:
			return false
		cur = cur.get_parent()
	return true

# Transformation d'un noeud du modèle dans le repère du MODÈLE (cf. _xf_dans_voiture).
func _xf_dans_modele(n: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var cur: Node = n
	while cur != null and cur != _model:
		if cur is Node3D:
			t = (cur as Node3D).transform * t
		cur = cur.get_parent()
	return t


# Feux de freinage allumés : la voiture décélère, ou elle est à l'arrêt. Lu par VehicleLights.
# Quand c'est le joueur qui conduit cette Car (modèle arcade), c'est _drive_speed qui fait foi.
func brake_lights_on() -> bool:
	# Une voiture laissée là n'a personne au volant : ses feux doivent être ÉTEINTS. Sans cette
	# sortie, les véhicules en stationnement des lieux (ParkedVehicles) auraient leurs feux de
	# freinage allumés en permanence, puisque _ai_speed y vaut zéro.
	if is_parked():
		return false
	if driven_by_player:
		return _player_braking or absf(_drive_speed) < BRAKE_STOP_SPEED
	return _braking or _ai_speed < BRAKE_STOP_SPEED
