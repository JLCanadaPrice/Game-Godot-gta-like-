extends Node3D

# Feux de véhicules et véhicules en stationnement, vérifiés dans le MONDE CUIT.
#
# Ce que le test couvre, et pourquoi :
#  - FREINS DU JOUEUR : appuyer sur S en roulant doit allumer les feux. C'est le défaut corrigé le
#    2026-09-20 : brake_lights_on() ne regardait que la vitesse quand le joueur conduisait, donc les
#    feux ne s'allumaient qu'une fois la voiture presque arrêtée, et jamais en roulant ;
#  - VOITURE GARÉE : feux éteints. Sans cette règle, un véhicule à l'arrêt (vitesse nulle) allumerait
#    ses feux de freinage en permanence — ce que la section « véhicules garés » aurait introduit sur
#    les quatorze véhicules des lieux ;
#  - GYROPHARES : éteints par défaut, bascule par l'API, et chaque feu dans SA couleur selon ce qu'est
#    le véhicule (2026-09-21) : POLICE rouge à gauche, bleu à droite, les deux moitiés ALTERNENT, le
#    blanc du milieu jamais allumé ; POMPIERS : ALTERNANCE, les rouges et les blancs jamais ensemble, la
#    gauche et la droite jamais ensemble, tous les feux servent et jamais tous à la fois ; AMBULANCE
#    « sapin de Noël » : au moins trois groupes de phase qui ne battent pas ensemble, et ses feux jaunes
#    passés au blanc ; et le CAS MIXTE du jeu : une voiture de police allumée à côté d'une voiture du même
#    modèle éteinte, chacune dans SON calque (la moitié bleue disparaissait, 2026-09-21) ;
#  - STATIONNEMENT : les véhicules des lieux sont de VRAIES voitures du groupe `vehicle`, avec leur
#    collision, à l'endroit que la cuisson a écrit dans sa fiche.

const WORLD := preload("res://scenes/world/World.tscn")
const CAR := preload("res://scenes/vehicles/Car.tscn")
const PLACES_JSON := "res://scenes/world/map/generated/places/places.json"
const DOWNTOWN_JSON := "res://scenes/world/downtown/generated/parked.json"
# Voitures garées dans les trois parkings à étages (2026-09-22). Troisième fichier parce que deux cuiseurs
# différents écrivent les fiches du centre-ville ; la liste doit rester LA MÊME que celle de ParkedVehicles,
# sinon ce test compte des véhicules posés sans fiche — c'est ce qui l'a fait échouer le jour où on l'a ajouté.
const DOWNTOWN_PARKINGS_JSON := "res://scenes/world/downtown/generated/parked_parkings.json"
# Chemins RÉELS du catalogue : _couleurs_gyro lit le rôle dans resources/vehicle_models, un chemin
# inventé n'y est pas et retomberait sur le rôle vide.
const VEH := "res://assets/vehicle_models_extra/city_vehicles_UNVERIFIED_LICENSE/"
const POLICE := VEH + "Police/Veh_Police_Sedan.glb"
const POMPIER := VEH + "Emergency/Veh_Firetruck.glb"
const AMBULANCE := VEH + "Emergency/Veh_Ambulance.glb"
const BERLINE := "res://assets/vehicle_models_extra/city_vehicles_UNVERIFIED_LICENSE/Sedans/Veh_Sedan_01_Blue.glb"

var _fautes: Array[String] = []
var _monde: Node = null


func _ready() -> void:
	_monde = WORLD.instantiate()
	add_child(_monde)
	for s in ["CarSpawner", "NpcSpawner"]:
		var n := _monde.get_node_or_null(s)
		if n != null:
			n.set_process(false)
	for k in 8:
		await get_tree().physics_frame
	await _freins_joueur()
	await _flaque_de_frein()
	_stationnement()
	_gyro_motif()
	_gyro_api()
	await _gyro_mixte()
	_verdict()


# --- freins du joueur -----------------------------------------------------------------------------

func _freins_joueur() -> void:
	var car := CAR.instantiate()
	car.forced_model_path = BERLINE
	add_child(car)
	car.global_position = Vector3(0, 400, 0)
	car.driven_by_player = true
	car.set("_drive_speed", 10.0)
	# pas de pédale : en roulant, les feux doivent être ÉTEINTS
	Input.action_release("move_back")
	for k in 3:
		await get_tree().physics_frame
	var au_repos: bool = car.call("brake_lights_on")
	# pédale enfoncée en roulant : les feux doivent être ALLUMÉS, de jour comme de nuit
	car.set("_drive_speed", 10.0)
	Input.action_press("move_back")
	for k in 3:
		await get_tree().physics_frame
	var en_freinant: bool = car.call("brake_lights_on")
	Input.action_release("move_back")
	if au_repos:
		_fautes.append("feux de freinage allumés alors que le joueur roule sans freiner")
	if not en_freinant:
		_fautes.append("feux de freinage ÉTEINTS alors que le joueur appuie sur le frein en roulant")
	# voiture garée : personne au volant, feux éteints
	car.driven_by_player = false
	car.call("park")
	for k in 2:
		await get_tree().physics_frame
	var garee: bool = car.call("brake_lights_on")
	if garee:
		_fautes.append("feux de freinage allumés sur une voiture garée")
	print("VEHICLE_LIGHTS_FREINS roule %s / freine %s / garee %s" % [str(au_repos), str(en_freinant), str(garee)])
	car.queue_free()


# --- la flaque de freinage tombe DERRIERE la voiture ----------------------------------------------
# Elle etait posee a 0,25 m de l'ORIGINE du vehicule, c'est-a-dire de son centre : la lumiere se
# trouvait donc SOUS la caisse. On exige maintenant qu'elle soit au-dela de la poupe.

func _flaque_de_frein() -> void:
	var vl := _monde.get_node_or_null("VehicleLights")
	if vl == null:
		return
	var car := CAR.instantiate()
	car.forced_model_path = BERLINE
	add_child(car)
	car.global_position = Vector3(0, 300, 0)
	car.driven_by_player = true
	car.set("_drive_speed", 10.0)
	Input.action_press("move_back")
	# la camera doit voir la voiture : VehicleLights ne pose que ce qui est a portee
	var cam := Camera3D.new()
	add_child(cam)
	cam.make_current()
	cam.global_position = Vector3(0, 302, 12)
	cam.look_at(Vector3(0, 300, 0), Vector3.UP)
	var cycle := _monde.get_node_or_null("DayNight")
	if cycle != null:
		cycle.set("paused", true)
		cycle.call("set_hour", 1.0)
	for k in 10:
		await get_tree().process_frame
	Input.action_release("move_back")
	var spots: Array = []
	for n in vl.get_children():
		if n is SpotLight3D and String(n.name).begins_with("Frein_") and (n as SpotLight3D).visible:
			spots.append(n)
	if spots.is_empty():
		_fautes.append("aucune flaque de freinage posee la nuit sur une voiture qui freine")
		car.queue_free()
		cam.queue_free()
		return
	# DEUX flaques, une par feu (2026-09-21) : une source unique sur l'axe ne montrait qu'une tache.
	# CONVENTION, verifiee dans Car.gd : l'AVANT d'une voiture est -basis.z (var fwd := -basis.z), donc
	# sa POUPE est +basis.z. Le modele, lui, porte un lacet de 180° (model_yaw_deg), si bien que son
	# propre +Z est l'avant : les deux reperes sont opposes. Mesurer le recul sur le mauvais des deux
	# donne un resultat de signe inverse, ce qui est arrive une fois ici.
	var xf: Transform3D = car.global_transform
	var arriere: Vector3 = xf.basis.z.normalized()
	var cote: Vector3 = xf.basis.x.normalized()
	var demi := 2.08   # demi-longueur mesuree d'une berline du pack a l'echelle 1,65
	if spots.size() != 2:
		_fautes.append("%d flaque(s) de freinage sur une voiture qui freine, il en faut 2 (une par feu)" % spots.size())
	var reculs := PackedFloat32Array()
	var lateraux := PackedFloat32Array()
	for l: SpotLight3D in spots:
		var rel: Vector3 = l.global_position - xf.origin
		reculs.append(rel.dot(arriere))
		lateraux.append(rel.dot(cote))
		if rel.dot(arriere) < demi - 0.05:
			_fautes.append("une flaque de freinage part de %.2f m de l'origine, soit SOUS la voiture (poupe a %.2f m)" % [rel.dot(arriere), demi])
		if l.light_cull_mask & 4 != 0:
			_fautes.append("la flaque de freinage eclaire la carrosserie : le calque 3 doit etre exclu")
	if lateraux.size() == 2 and (lateraux[0] * lateraux[1] >= 0.0 or minf(absf(lateraux[0]), absf(lateraux[1])) < 0.3):
		_fautes.append("les deux flaques ne sont pas de part et d'autre de l'axe (%.2f m et %.2f m)" % [lateraux[0], lateraux[1]])
	var l: SpotLight3D = spots[0]
	var recul: float = reculs[0]
	print("VEHICLE_LIGHTS_FLAQUE %d flaque(s), recul %s m (poupe a %.2f m), lateral %s m, masque %d"
			% [spots.size(), str(reculs), demi, str(lateraux), l.light_cull_mask])
	car.queue_free()
	cam.queue_free()


# --- véhicules en stationnement -------------------------------------------------------------------

func _stationnement() -> void:
	var fiches: Array = []
	for chemin in [PLACES_JSON, DOWNTOWN_JSON, DOWNTOWN_PARKINGS_JSON]:
		if not FileAccess.file_exists(chemin):
			_fautes.append("%s absent : la cuisson n'a pas écrit les véhicules garés" % chemin)
			continue
		var data = JSON.parse_string(FileAccess.get_file_as_string(chemin))
		if typeof(data) == TYPE_DICTIONARY and data.has("parked"):
			fiches.append_array(data["parked"])
	var attendus := fiches.size()
	var noeud := _monde.get_node_or_null("ParkedVehicles")
	if noeud == null:
		_fautes.append("ParkedVehicles absent de World.tscn")
		return
	var poses: Array[Node3D] = []
	for c in noeud.get_children():
		if c is Node3D and (c as Node3D).is_in_group("vehicle"):
			poses.append(c as Node3D)
	if poses.size() != attendus:
		_fautes.append("%d vehicule(s) gare(s) pose(s) pour %d fiche(s)" % [poses.size(), attendus])
	var sans_collision := 0
	var loin := 0
	var pire := 0.0
	for c in poses:
		if c.find_children("*", "CollisionShape3D", true, false).is_empty():
			sans_collision += 1
		var meilleur := 1e9
		for f: Dictionary in fiches:
			var p: Array = f["pos"]
			meilleur = minf(meilleur, Vector2(c.global_position.x - float(p[0]), c.global_position.z - float(p[2])).length())
		pire = maxf(pire, meilleur)
		if meilleur > 1.5:
			loin += 1
	if sans_collision > 0:
		_fautes.append("%d vehicule(s) gare(s) sans collision : impossible a heurter ni a voler" % sans_collision)
	if loin > 0:
		_fautes.append("%d vehicule(s) gare(s) a plus de 1,5 m de leur fiche (pire %.2f m)" % [loin, pire])
	print("VEHICLE_LIGHTS_GARES %d vehicules poses sur %d fiches, ecart maxi %.2f m, %d sans collision"
			% [poses.size(), attendus, pire, sans_collision])


# --- motif du gyrophare ---------------------------------------------------------------------------

func _gyro_motif() -> void:
	var vl := _monde.get_node_or_null("VehicleLights")
	if vl == null:
		_fautes.append("VehicleLights absent de World.tscn")
		return
	# police : les deux moitiés ALTERNENT, jamais ensemble, double éclat par phase
	var g: Array = vl.get("GYRO_GAUCHE")
	var d: Array = vl.get("GYRO_DROITE")
	var ensemble := 0
	var ng := 0
	var nd := 0
	for k in g.size():
		if bool(g[k]) and bool(d[k]):
			ensemble += 1
		ng += 1 if bool(g[k]) else 0
		nd += 1 if bool(d[k]) else 0
	if ensemble > 0:
		_fautes.append("police : rouge et bleu allumes ensemble sur %d temps, ils doivent ALTERNER" % ensemble)
	if ng != 2 or nd != 2:
		_fautes.append("double eclat attendu par moitie : %d a gauche, %d a droite" % [ng, nd])
	# genres
	var genres := {}
	for pair in [["police", POLICE], ["pompiers", POMPIER], ["sapin", AMBULANCE]]:
		var obtenu := String(vl.call("_genre_urgence", pair[1]))
		genres[pair[0]] = obtenu
		if obtenu != pair[0]:
			_fautes.append("%s : genre d'urgence attendu %s, obtenu %s" % [String(pair[1]).get_file(), pair[0], obtenu])
	# géométrie : quels feux tombent dans quels calques, sur les vrais modèles
	var plans := {}
	for pair in [["police", POLICE], ["pompiers", POMPIER], ["sapin", AMBULANCE]]:
		var inst: Node3D = (load(pair[1]) as PackedScene).instantiate()
		add_child(inst)
		plans[pair[0]] = vl.call("plan_urgence", pair[1], inst)
		inst.queue_free()
	var pol: Dictionary = plans["police"]
	if not (pol.has("urg_rouge") and pol.has("urg_bleu") and pol.has("urg_bleu_repos")) or pol.size() != 3:
		_fautes.append("police : calques attendus urg_rouge, urg_bleu et urg_bleu_repos seulement, obtenu %s" % str(pol.keys()))
	elif int(pol["urg_bleu_repos"]["tri"]) != int(pol["urg_bleu"]["tri"]):
		_fautes.append("police : le calque des rampes eteintes n'a pas la geometrie de la moitie bleue (%d triangles contre %d)"
				% [int(pol["urg_bleu_repos"]["tri"]), int(pol["urg_bleu"]["tri"])])
	else:
		if float(pol["urg_rouge"]["fx_max"]) >= 0.0:
			_fautes.append("police : du rouge allume a DROITE de l'axe (fx max %.2f)" % float(pol["urg_rouge"]["fx_max"]))
		if float(pol["urg_bleu"]["fx_min"]) <= 0.0:
			_fautes.append("police : du bleu allume a GAUCHE de l'axe (fx min %.2f)" % float(pol["urg_bleu"]["fx_min"]))
		# le segment BLANC du milieu ne doit appartenir a aucun calque allume
		if float(pol["urg_rouge"]["fx_max"]) > -0.1 or float(pol["urg_bleu"]["fx_min"]) < 0.1:
			_fautes.append("police : un calque allume deborde sur le segment blanc du milieu")
	var pom: Dictionary = plans["pompiers"]
	for fam in ["pomp_rouge_g", "pomp_rouge_d", "pomp_blanc_g", "pomp_blanc_d"]:
		if not pom.has(fam):
			_fautes.append("pompiers : calque %s absent (rouges et blancs, gauche et droite), obtenu %s" % [fam, str(pom.keys())])
	for fam in pom:
		if String(fam).ends_with("_g") and float(pom[fam]["fx_max"]) >= 0.0:
			_fautes.append("pompiers : un feu de GAUCHE a droite de l'axe dans %s" % fam)
		if String(fam).ends_with("_d") and float(pom[fam]["fx_min"]) <= 0.0:
			_fautes.append("pompiers : un feu de DROITE a gauche de l'axe dans %s" % fam)
	# l'alternance, temps par temps sur un cycle : jamais rouge ET blanc, jamais gauche ET droite, jamais
	# tout, et chaque calque du camion allumé au moins une fois
	var n_temps: int = vl.get("POMPIERS_TEMPS_N")
	var deja := {}
	var melanges := 0
	var cotes := 0
	var tout := 0
	for k in n_temps:
		var t := (k + 0.5) / float(n_temps)
		var rouge := false
		var blanc := false
		var gauche := false
		var droite := false
		var allumes := 0
		for fam in pom:
			if not bool(vl.call("pompiers_allume", fam, t)):
				continue
			allumes += 1
			deja[fam] = true
			rouge = rouge or String(fam).begins_with("pomp_rouge")
			blanc = blanc or String(fam).begins_with("pomp_blanc")
			gauche = gauche or String(fam).ends_with("_g")
			droite = droite or String(fam).ends_with("_d")
		melanges += 1 if rouge and blanc else 0
		cotes += 1 if gauche and droite else 0
		tout += 1 if allumes == pom.size() else 0
	if melanges > 0:
		_fautes.append("pompiers : rouges et blancs allumes ensemble sur %d temps, ils doivent ALTERNER" % melanges)
	if cotes > 0:
		_fautes.append("pompiers : gauche et droite allumees ensemble sur %d temps, elles doivent ALTERNER" % cotes)
	if tout > 0:
		_fautes.append("pompiers : tous les feux allumes au meme instant sur %d temps" % tout)
	if deja.size() != pom.size():
		_fautes.append("pompiers : %d calque(s) jamais allume(s) sur un cycle" % (pom.size() - deja.size()))
	var sap: Dictionary = plans["sapin"]
	var groupes := 0
	for k in 4:
		if sap.has("sapin_%d_rouge" % k) or sap.has("sapin_%d_blanc" % k):
			groupes += 1
	if groupes < 3:
		_fautes.append("ambulance : %d groupe(s) de phase, il en faut au moins 3 pour le sapin de Noel" % groupes)
	if not sap.has("sapin_repos"):
		_fautes.append("ambulance : ses feux jaunes ne sont pas passes au blanc (calque sapin_repos absent)")
	# rythme du sapin : les groupes ne battent pas ensemble — sur deux secondes, deux groupes quelconques
	# different sur au moins un quart des instants
	var pire := 1.0
	for a in 4:
		for b in range(a + 1, 4):
			var diff := 0
			for i in 100:
				var t := i * 0.02
				if bool(vl.call("sapin_allume", a, t)) != bool(vl.call("sapin_allume", b, t)):
					diff += 1
			pire = minf(pire, diff / 100.0)
	if pire < 0.25:
		_fautes.append("sapin de Noel : deux groupes battent presque ensemble (%.0f %% d'instants differents seulement)" % (pire * 100.0))
	print("VEHICLE_LIGHTS_GYRO police %d/%d eclats, %d chevauchement, %s ; pompiers %s, alternance : %d temps rouge+blanc, %d temps gauche+droite, %d temps tout allume ; sapin %d groupes, %s, groupes les plus proches differents %.0f %% du temps"
			% [ng, nd, ensemble, str(pol.keys()), str(pom.keys()), melanges, cotes, tout, groupes, "jaunes -> blanc" if sap.has("sapin_repos") else "JAUNES RESTES JAUNES", pire * 100.0])


# --- allumage des gyrophares ----------------------------------------------------------------------

func _gyro_api() -> void:
	var vl := _monde.get_node_or_null("VehicleLights")
	if vl == null:
		return
	var urgence: Node3D = null
	for v in get_tree().get_nodes_in_group(&"vehicle"):
		var body := v as Node3D
		if body == null or not body.is_inside_tree():
			continue
		if bool(vl.call("_urgence", vl.call("_cle", body))):
			urgence = body
			break
	if urgence == null:
		_fautes.append("aucun vehicule d'urgence dans la scene : le gyrophare ne peut pas etre verifie")
		return
	if bool(vl.call("gyro_on", urgence)):
		_fautes.append("gyrophare ALLUME par defaut : il doit etre eteint tant qu'aucun evenement ne l'allume")
	var apres: bool = vl.call("toggle_gyro", urgence)
	if not apres or not bool(vl.call("gyro_on", urgence)):
		_fautes.append("toggle_gyro n'allume pas la rampe")
	var n: int = vl.call("allumer_urgences", false)
	if bool(vl.call("gyro_on", urgence)):
		_fautes.append("allumer_urgences(false) n'eteint pas la rampe")
	print("VEHICLE_LIGHTS_GYRO_API eteint par defaut, bascule OK, %d vehicule(s) d'urgence adressable(s)" % n)


# UNE voiture de police allumée, UNE autre du MÊME modèle éteinte, à portée l'une de l'autre : c'est la
# situation du jeu (le joueur allume SA voiture avec R devant les voitures de patrouille garées). Payé
# le 2026-09-21 : le calque de la moitié bleue était réaffecté à la voiture éteinte, et la voiture
# allumée n'avait plus de bleu. On regarde les VRAIES instances posées par VehicleLights, dans les deux
# phases.
func _gyro_mixte() -> void:
	var vl := _monde.get_node_or_null("VehicleLights")
	if vl == null:
		return
	var sedans: Array = []
	for v in get_tree().get_nodes_in_group(&"vehicle"):
		var body := v as Node3D
		if body != null and body.is_inside_tree() and String(vl.call("_cle", body)) == POLICE:
			sedans.append(body)
	if sedans.size() < 2:
		_fautes.append("cas mixte : il faut deux voitures de police du meme modele dans la scene, trouve %d" % sedans.size())
		return
	var allumee: Node3D = sedans[0]
	var eteinte: Node3D = sedans[1]
	vl.call("allumer_urgences", false)
	vl.call("set_gyro", allumee, true)
	var cam := Camera3D.new()
	add_child(cam)
	cam.global_position = allumee.global_position + Vector3(4, 3, 0)
	cam.make_current()
	var mats: Array = vl.get("_mats_gyro")
	var racine_on: Node3D = vl.call("_racine_modele", allumee)
	var racine_off: Node3D = vl.call("_racine_modele", eteinte)
	var bilan := ""
	for phase: Array in [[4, "bleue", 1], [0, "rouge", 6]]:
		vl.set("gyro_force", phase[0])
		await get_tree().process_frame
		await get_tree().process_frame
		var calques: Dictionary = (vl.get("_par_modele") as Dictionary).get(POLICE, {})
		var bleu = calques.get("urg_bleu")
		var repos = calques.get("urg_bleu_repos")
		if not (bleu is MultiMeshInstance3D) or not (repos is MultiMeshInstance3D):
			_fautes.append("cas mixte, phase %s : calques urg_bleu / urg_bleu_repos absents" % phase[1])
			continue
		var mb := (bleu as MultiMeshInstance3D).multimesh
		var mr := (repos as MultiMeshInstance3D).multimesh
		# QUELS véhicules sont dans quel calque (les transformations d'un MultiMesh ne se relisent pas en
		# headless : le serveur de rendu factice les rend à zéro)
		var dans_bleu: Array = vl.call("racines_posees", POLICE, "urg_bleu")
		var dans_repos: Array = vl.call("racines_posees", POLICE, "urg_bleu_repos")
		# la voiture allumée est dans le calque des rampes allumées, et seulement elle
		if not (bleu as MultiMeshInstance3D).visible or mb.visible_instance_count != 1 or dans_bleu != [racine_on]:
			_fautes.append("cas mixte, phase %s : la moitie bleue de la voiture ALLUMEE n'est pas posee (%d instance(s))"
					% [phase[1], mb.visible_instance_count])
		# dans la phase bleue elle brille, dans la phase rouge elle repose
		var attendu: Material = mats[1] if phase[1] == "bleue" else mats[6]
		if mb.mesh.surface_get_material(0) != attendu:
			_fautes.append("cas mixte, phase %s : mauvais materiau sur la moitie bleue de la voiture allumee" % phase[1])
		# la voiture éteinte est dans SON calque, lentille bleue au repos
		if not (repos as MultiMeshInstance3D).visible or mr.visible_instance_count != 1 or dans_repos != [racine_off] 				or mr.mesh.surface_get_material(0) != mats[6]:
			_fautes.append("cas mixte, phase %s : la voiture ETEINTE n'a pas sa lentille bleue au repos" % phase[1])
		bilan += " phase %s : allumee %d instance, eteinte %d instance ;" % [phase[1], mb.visible_instance_count, mr.visible_instance_count]
	vl.set("gyro_force", -1)
	vl.call("allumer_urgences", false)
	cam.queue_free()
	print("VEHICLE_LIGHTS_GYRO_MIXTE une voiture de police allumee, une du meme modele eteinte :%s" % bilan)


func _verdict() -> void:
	if _fautes.is_empty():
		print("VEHICLE_LIGHTS_RESULT OK")
	else:
		for f in _fautes:
			print("VEHICLE_LIGHTS_FAUTE %s" % f)
		print("VEHICLE_LIGHTS_RESULT FAIL %d faute(s)" % _fautes.size())
	get_tree().quit(0)
