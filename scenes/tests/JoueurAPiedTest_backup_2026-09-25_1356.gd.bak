extends Node

# Test headless du JOUEUR À PIED (2026-09-25, CLAUDE.md §16) : le VRAI joueur (Player.tscn) sur un sol plat d'essai près
# de l'origine, piloté par ses actions comme au clavier.
#
#  1. PIEDS
#   - l'import de Suit.gltf garde les pistes de POSITION des pieds dans Walk et Run (le reciblage humanoïde les
#     supprimait : pieds figés, pointe enfoncée de 18 à 20 cm, pied traîné à la vitesse du corps) ;
#   - en avançant (5 m/s) : Run, joué à 5 / 3,02 ; les pieds bougent (pas d'au moins 0,6 m dans le sens du déplacement, repère
#     du joueur) et restent POSÉS pendant l'appui : vitesse médiane de l'os du pied sous (plancher + 0,1) x la vitesse
#     du corps. Le plancher est ce que donne la même mesure quand l'animation est jouée exactement à sa vitesse propre
#     (le déroulé du pied, talon puis pointe) : 0,16-0,17 pour Run et les courses de côté, 0,14 et 0,44 pour Run_Back
#     (pied gauche, pied droit), mesuré sur la pose. La SEMELLE (le plus bas des sommets des chaussures, par peau
#     linéaire comme le moteur) reste au sol : 5e et 95e centiles pendant l'appui entre -3 et +3 cm ;
#   - reculer, aller à gauche, à droite : Run_Back, Run_Left, Run_Right, pieds posés ; en diagonale avant droite : Run,
#     modèle tourné de 45° vers la droite, pieds posés ;
#   - Maj (13,5 m/s) : Run à la cadence maximale (2) ; le glissement qui reste est imprimé (c'est la vitesse de course
#     qui dépasse ce que l'animation peut suivre, pas un défaut du test) ;
#   - arrêt : Idle, pieds immobiles.
#
#  2. ARME SORTIE (touche 1, l'action toggle_weapon) : le bras droit se tend en position de tir (PoseTirModifier).
#     Mesuré sur la pose AFFICHÉE (relevée au signal skeleton_updated : hors de lui, le squelette rend la pose de
#     l'animation, modificateurs retirés) : arme rangée, bras pendant (main à plus de 45° sous l'épaule) ; sortie, en
#     0,4 s au plus, bras tendu à 95 % au moins et canon à moins de 1° du point visé (le point sous le réticule),
#     caméra droite, baissée de 20° ou levée de 15° ; en courant, bras toujours tendu, canon toujours sur le point visé
#     (1,5° au plus) et pieds toujours posés ; un tir en courant ne fige plus les jambes (Run continue) et relève le
#     canon de 5 à 10°, revenu sous 1° en 0,3 s ; rangée, le bras retombe.
#
#  3. VISÉE (clic droit maintenu, l'action aim), arme rangée au départ, en regard libre (Alt) caméra tournée de 60° :
#     l'arme sort, le regard libre s'arrête et le CORPS pivote vers où regarde la caméra ; en 0,5 s la caméra est
#     rapprochée (bras de 1,6 m au lieu de 4), décalée vers l'épaule droite (0,55 m) et zoomée (champ de 55° au lieu de
#     75) ; le réticule du HUD est visible et plein ; le canon est sur le point visé. En avançant, en pas chassé à
#     gauche, et Maj tenue : 3 m/s, Run / Run_Left à leur cadence d'origine (0,99), pieds posés, bras tendu, canon sur
#     le point visé. Relâché : la caméra revient EN DOUCEUR (après une image, encore loin de sa place ; revenue en
#     1,2 s, champ de 75°, plus d'épaule), le réticule reste (arme sortie) mais pâli. En VOITURE : monter en visant coupe
#     la visée (caméra de conduite sans zoom ni épaule) et viser en voiture ne fait rien ; on redescend sans viser.
#     Un PNJ debout à 8 m, pris sous le réticule et touché, perd des points de vie.
#
# Lancer : Godot --headless --path <projet> --fixed-fps 60 res://scenes/tests/JoueurAPiedTest.tscn

const JOUEUR := preload("res://scenes/player/Player.tscn")
const CAR := preload("res://scenes/vehicles/Car.tscn")
const PNJ := preload("res://scenes/npc/NPC.tscn")
const HUD := preload("res://scenes/ui/HUD.tscn")
const BERLINE := "res://assets/vehicle_models_extra/city_vehicles_UNVERIFIED_LICENSE/Sedans/Veh_Sedan_01_Blue.glb"
const PLANCHER := {"Run": [0.17, 0.17], "Run_Back": [0.14, 0.44], "Run_Left": [0.17, 0.17], "Run_Right": [0.17, 0.17]}
const PIEDS := ["LeftFoot", "RightFoot"]

var _errors: Array[String] = []
var _player: CharacterBody3D
var _skel: Skeleton3D
var _anim: AnimationPlayer
var _infl := {"LeftFoot": [], "RightFoot": []}   # sommets des chaussures : [[os, sommet lié, poids], ...]
var _releves: Array = []
var _enregistre := false
var _prec := {}
var _epaule := Vector3.ZERO      # pose AFFICHÉE (skeleton_updated) : épaule et main droites, dans le monde
var _main := Vector3.ZERO


func _ready() -> void:
	print("JOUEUR_A_PIED_TEST_BEGIN")
	process_priority = 1000   # relevés après l'animation de l'image
	var sol := StaticBody3D.new()
	var forme := CollisionShape3D.new()
	var boite := BoxShape3D.new()
	boite.size = Vector3(400.0, 2.0, 400.0)
	forme.shape = boite
	sol.add_child(forme)
	add_child(sol)
	sol.position = Vector3(0.0, -1.0, 0.0)
	_player = JOUEUR.instantiate() as CharacterBody3D
	add_child(_player)
	_player.global_position = Vector3(0.0, 1.0, 0.0)
	await _frames(40)
	_skel = _player.find_children("*", "Skeleton3D", true, false)[0] as Skeleton3D
	_skel.skeleton_updated.connect(_pose_affichee)
	_anim = _player.get("_anim") as AnimationPlayer
	_peau()
	_check_pistes()
	await _check_marche("avance", ["move_forward"], "Run", 5.0)
	await _check_marche("recule", ["move_back"], "Run_Back", 5.0)
	await _check_marche("gauche", ["move_left"], "Run_Left", 5.0)
	await _check_marche("droite", ["move_right"], "Run_Right", 5.0)
	await _check_marche("diagonale", ["move_forward", "move_right"], "Run", 5.0)
	await _check_course()
	await _check_arret()
	await _check_arme()
	await _check_visee()
	await _check_visee_voiture()
	await _check_visee_pnj()
	print("JOUEUR_A_PIED_RESULT %s %s" % ["OK" if _errors.is_empty() else "FAIL", " | ".join(_errors)])
	get_tree().quit(0 if _errors.is_empty() else 1)


func _check_pistes() -> void:
	var manque: PackedStringArray = []
	for clip: String in ["Walk", "Run"]:
		var a := _anim.get_animation(clip)
		for os: String in PIEDS:
			if a.find_track(NodePath("%GeneralSkeleton:" + os), Animation.TYPE_POSITION_3D) < 0:
				manque.append("%s/%s" % [clip, os])
	var ok := manque.is_empty()
	print("JOUEUR_A_PIED_PISTES position des pieds dans Walk et Run : %s | %s" % ["présentes" if ok else "MANQUE " + ", ".join(manque), _ok(ok)])
	if not ok:
		_errors.append("pistes de position des pieds")


# Avance avec `actions` : 0,6 s de mise en train, puis 1,5 s de relevés.
func _check_marche(nom: String, actions: Array, clip_attendu: String, vitesse: float) -> void:
	var r := await _mesure(actions)
	var ok: bool = r["anim"] == clip_attendu and absf(float(r["corps"]) - vitesse) < 0.05
	var txt := "JOUEUR_A_PIED_%s %s : corps %.2f m/s, anim %s x %.2f, modèle tourné de %+.0f° |" % [nom.to_upper(), actions,
			r["corps"], r["anim"], r["cadence"], rad_to_deg(float(_player.get("_lacet_modele")))]
	if nom == "diagonale":
		ok = ok and absf(rad_to_deg(float(_player.get("_lacet_modele"))) - 45.0) < 3.0
	for k in PIEDS.size():
		var p: Dictionary = r[PIEDS[k]]
		var plafond: float = (float(PLANCHER.get(clip_attendu, [0.17, 0.17])[k]) + 0.1) * vitesse
		var ok_pied: bool = float(p["ampl"]) >= 0.6 and float(p["glisse"]) <= plafond \
				and float(p["bas"]) >= -0.03 and float(p["haut"]) <= 0.03
		ok = ok and ok_pied
		txt += " %s : %.2f m de pas, glisse %.2f m/s (au plus %.2f), semelle %+.3f / %+.3f m |" % [PIEDS[k].trim_suffix("Foot"),
				p["ampl"], p["glisse"], plafond, p["bas"], p["haut"]]
	print(txt + " " + _ok(ok))
	if not ok:
		_errors.append(nom)


func _check_course() -> void:
	var r := await _mesure(["move_forward", "sprint"])
	var ok: bool = r["anim"] == "Run" and absf(float(r["cadence"]) - 2.0) < 0.01
	print("JOUEUR_A_PIED_COURSE Maj : corps %.2f m/s, anim %s x %.2f (cadence maximale) ; les pieds glissent encore de %.2f / %.2f m/s | %s" % [
			r["corps"], r["anim"], r["cadence"], r["LeftFoot"]["glisse"], r["RightFoot"]["glisse"], _ok(ok)])
	if not ok:
		_errors.append("course")


func _check_arret() -> void:
	var r := await _mesure([])
	var ok: bool = r["anim"] == "Idle" and float(r["LeftFoot"]["glisse"]) < 0.05 and float(r["RightFoot"]["glisse"]) < 0.05
	print("JOUEUR_A_PIED_ARRET anim %s, pieds %.2f / %.2f m/s | %s" % [r["anim"], r["LeftFoot"]["glisse"], r["RightFoot"]["glisse"], _ok(ok)])
	if not ok:
		_errors.append("arrêt")


func _check_arme() -> void:
	var pt: Object = _player.get("_pose_tir")
	if pt == null:
		print("JOUEUR_A_PIED_ARME pas de PoseTirModifier sur le squelette | ÉCHEC")
		_errors.append("arme : pas de pose de tir")
		return
	await _frames(20)
	var rangee := _bras()
	await _basculer_arme()
	await _frames(24)
	var sortie := _bras()
	var ecart := _ecart_canon()
	await _tangage(-20.0)
	var ecart_bas := _ecart_canon()
	var bras_bas := _bras()
	await _tangage(15.0)
	var ecart_haut := _ecart_canon()
	var bras_haut := _bras()
	await _tangage(-10.0)
	var ok: bool = float(rangee[1]) < -45.0 and absf(float(pt.get("poids")) - 1.0) < 0.001 and float(sortie[0]) >= 95.0 \
			and ecart < 1.0 and ecart_bas < 1.0 and ecart_haut < 1.0
	print("JOUEUR_A_PIED_ARME rangée : main %+.0f° sous l'épaule | sortie (0,4 s) : bras tendu à %.0f %%, main %+.0f°, canon à %.2f° du point visé ; caméra -20° : main %+.0f°, canon à %.2f° ; caméra +15° : main %+.0f°, canon à %.2f° | %s" % [
			rangee[1], sortie[0], sortie[1], ecart, bras_bas[1], ecart_bas, bras_haut[1], ecart_haut, _ok(ok)])
	if not ok:
		_errors.append("arme sortie")
	# en courant, arme sortie
	var r := await _mesure(["move_forward"])
	var plafond := (0.17 + 0.1) * 5.0
	ok = r["anim"] == "Run" and float(r["bras_min"]) >= 95.0 and float(r["ecart_max"]) <= 1.5 \
			and float(r["LeftFoot"]["glisse"]) <= plafond and float(r["RightFoot"]["glisse"]) <= plafond
	print("JOUEUR_A_PIED_ARME_COURSE anim %s x %.2f, bras tendu à %.0f %% au moins, canon à %.2f° du point visé au plus, pieds : glisse %.2f / %.2f m/s (au plus %.2f) | %s" % [
			r["anim"], r["cadence"], r["bras_min"], r["ecart_max"], r["LeftFoot"]["glisse"], r["RightFoot"]["glisse"], plafond, _ok(ok)])
	if not ok:
		_errors.append("arme en courant")
	# tir en courant : les jambes continuent, le canon se relève puis revient
	Input.action_press("move_forward")
	await _frames(30)
	var avant := _elevation_canon()
	var balles: int = (_player.get("weapon") as Object).get("current_ammo")
	_player.call("_shoot")
	await _frames(2)
	var coup := _elevation_canon() - avant
	var anim_tir := String(_anim.current_animation)
	await _frames(18)
	var apres := _ecart_canon()
	Input.action_release("move_forward")
	var tire: bool = int((_player.get("weapon") as Object).get("current_ammo")) == balles - 1
	ok = tire and anim_tir == "Run" and coup >= 5.0 and coup <= 10.0 and apres < 1.0
	print("JOUEUR_A_PIED_TIR en courant : balle partie %s, anim pendant le tir %s, canon relevé de %.1f°, revenu à %.2f° du point visé en 0,3 s | %s" % [
			tire, anim_tir, coup, apres, _ok(ok)])
	if not ok:
		_errors.append("tir en courant")
	await _frames(30)
	await _basculer_arme()
	await _frames(24)
	var baissee := _bras()
	ok = float(pt.get("poids")) < 0.001 and float(baissee[1]) < -45.0
	print("JOUEUR_A_PIED_ARME_RANGEE poids %.2f, main %+.0f° sous l'épaule | %s" % [pt.get("poids"), baissee[1], _ok(ok)])
	if not ok:
		_errors.append("arme rangée")


func _check_visee() -> void:
	var hud := HUD.instantiate() as Control
	hud.get_node("Minimap").free()   # la minicarte veut la carte du monde : hors sujet ici
	add_child(hud)
	var reticule := hud.get_node("Crosshair") as Control
	var arm := _player.get_node("SpringArm3D") as SpringArm3D
	var cam := _player.get_node("SpringArm3D/Camera3D") as Camera3D
	var fov0 := cam.fov
	var long0 := arm.spring_length
	var arme0: bool = _player.get("weapon_equipped")
	# regard libre (Alt), caméra tournée de 60° : le corps ne suit pas
	_action("free_look", true)
	await _frames(2)
	arm.rotation.y = deg_to_rad(60.0)
	var cap_camera := arm.global_rotation.y
	await _frames(2)
	Input.action_press("aim")
	await _frames(30)
	var ok_corps: bool = not bool(_player.get("_free_look")) and absf(arm.rotation.y) < deg_to_rad(2.0) \
			and absf(wrapf(_player.global_rotation.y - cap_camera, -PI, PI)) < deg_to_rad(2.0)
	_action("free_look", false)
	await _frames(2)
	var epaule: float = _player.get("_shoulder")
	var ecart := _ecart_canon()
	var ok: bool = not arme0 and bool(_player.get("weapon_equipped")) and bool(_player.call("is_aiming")) and ok_corps \
			and absf(arm.spring_length - 1.6) < 0.05 and absf(epaule - 0.55) < 0.02 and absf(cam.fov - 55.0) < 0.5 \
			and reticule.visible and reticule.modulate.a > 0.99 and ecart < 1.0
	print("JOUEUR_A_PIED_VISEE clic droit (arme rangée, regard libre à 60°) : arme sortie %s, corps tourné vers la caméra %s | caméra : bras %.2f m (était %.2f), épaule %.2f m, champ %.1f° (était %.1f) | réticule visible %s, opacité %.1f | canon à %.2f° du point visé | %s" % [
			_player.get("weapon_equipped"), ok_corps, arm.spring_length, long0, epaule, cam.fov, fov0, reticule.visible, reticule.modulate.a, ecart, _ok(ok)])
	if not ok:
		_errors.append("visée")
	# se déplacer en visant
	for cas: Array in [["avance", ["move_forward"], "Run"], ["gauche", ["move_left"], "Run_Left"], ["Maj", ["move_forward", "sprint"], "Run"]]:
		var r := await _mesure(cas[1])
		var plafond := (0.17 + 0.1) * 3.0
		ok = r["anim"] == cas[2] and absf(float(r["corps"]) - 3.0) < 0.05 and absf(float(r["cadence"]) - 3.0 / 3.02) < 0.02 \
				and float(r["LeftFoot"]["glisse"]) <= plafond and float(r["RightFoot"]["glisse"]) <= plafond \
				and float(r["bras_min"]) >= 95.0 and float(r["ecart_max"]) <= 1.5
		print("JOUEUR_A_PIED_VISEE_%s en visant : corps %.2f m/s, anim %s x %.2f, pieds : glisse %.2f / %.2f m/s (au plus %.2f), bras tendu à %.0f %% au moins, canon à %.2f° au plus | %s" % [
				String(cas[0]).to_upper(), r["corps"], r["anim"], r["cadence"], r["LeftFoot"]["glisse"], r["RightFoot"]["glisse"],
				plafond, r["bras_min"], r["ecart_max"], _ok(ok)])
		if not ok:
			_errors.append("visée en se déplaçant (%s)" % cas[0])
	# relâcher : retour en douceur
	await _frames(20)
	Input.action_release("aim")
	await _frames(1)
	var long1 := arm.spring_length
	var fov1 := cam.fov
	await _frames(72)
	ok = long1 > 1.65 and long1 < 2.5 and fov1 < 60.0 and absf(arm.spring_length - long0) < 0.05 and absf(cam.fov - fov0) < 0.5 \
			and absf(float(_player.get("_shoulder"))) < 0.02 and not bool(_player.call("is_aiming")) and reticule.visible \
			and reticule.modulate.a < 0.7
	print("JOUEUR_A_PIED_VISEE_RELACHEE après une image : bras %.2f m, champ %.1f° (en route) ; après 1,2 s : bras %.2f m, champ %.1f°, épaule %.2f m | réticule visible %s, opacité %.1f | %s" % [
			long1, fov1, arm.spring_length, cam.fov, _player.get("_shoulder"), reticule.visible, reticule.modulate.a, _ok(ok)])
	if not ok:
		_errors.append("visée relâchée")
	hud.queue_free()


func _check_visee_voiture() -> void:
	var arm := _player.get_node("SpringArm3D") as SpringArm3D
	var cam := _player.get_node("SpringArm3D/Camera3D") as Camera3D
	var fov0: float = _player.get("_fov_normal")
	var voiture := CAR.instantiate() as Node3D
	voiture.set("forced_model_path", BERLINE)
	add_child(voiture)
	voiture.set("has_npc_driver", false)
	voiture.global_position = _player.global_position + _player.global_transform.basis.x * 4.0 + Vector3.UP * 0.2
	voiture.call("park")
	await _frames(20)
	Input.action_press("aim")
	await _frames(20)
	var visait: bool = _player.call("is_aiming")
	_player.call("_enter_vehicle", voiture)
	await _frames(10)
	var coupe: bool = not bool(_player.call("is_aiming")) and absf(cam.fov - fov0) < 0.01 and absf(float(_player.get("_shoulder"))) < 0.001 \
			and arm.position.is_equal_approx(Vector3(0.0, 1.6, 0.0))
	Input.action_release("aim")
	await _frames(2)
	Input.action_press("aim")
	await _frames(20)
	var bras_voiture := arm.spring_length
	var rien: bool = not bool(_player.call("is_aiming")) and absf(cam.fov - fov0) < 0.01 and bras_voiture > 7.0
	Input.action_release("aim")
	await _frames(2)
	_player.call("_exit_vehicle")
	await _frames(30)
	var dehors: bool = not bool(_player.get("_driving")) and not bool(_player.call("is_aiming")) and _player.is_on_floor()
	var ok := visait and coupe and rien and dehors
	print("JOUEUR_A_PIED_VISEE_VOITURE visait en montant %s, visée coupée en voiture (champ %.1f°, épaule 0, pivot %s) %s, viser en voiture ne fait rien %s (bras de la caméra de conduite %.1f m), redescendu à pied sans viser %s | %s" % [
			visait, cam.fov, arm.position, coupe, rien, bras_voiture, dehors, _ok(ok)])
	if not ok:
		_errors.append("visée et voiture")
	voiture.queue_free()
	await _frames(5)


func _check_visee_pnj() -> void:
	var pnj := PNJ.instantiate() as Node3D
	add_child(pnj)
	var devant := -_player.global_transform.basis.z
	pnj.global_position = _player.global_position + devant * 8.0 + Vector3.UP * 0.05
	await _frames(10)
	var pv0: int = pnj.get("_hp")
	Input.action_press("aim")
	await _frames(30)
	# le réticule sur le PNJ : le corps (donc la caméra) tourné vers lui, caméra baissée vers sa poitrine
	var arm := _player.get_node("SpringArm3D") as SpringArm3D
	var cam := _player.get_node("SpringArm3D/Camera3D") as Camera3D
	for passe in 3:
		var vers := pnj.global_position + Vector3.UP * 0.3 - cam.global_position
		_player.rotation.y = atan2(-vers.x, -vers.z)
		arm.rotation.x = atan2(vers.y, Vector2(vers.x, vers.z).length())
		await _frames(6)
	_player.call("_shoot")
	await _frames(5)
	var pv1: int = pnj.get("_hp")
	Input.action_release("aim")
	var ok := pv1 < pv0
	print("JOUEUR_A_PIED_VISEE_PNJ PNJ à 8 m sous le réticule, un tir : points de vie %d -> %d | %s" % [pv0, pv1, _ok(ok)])
	if not ok:
		_errors.append("PNJ touché en visant")
	await _frames(40)
	pnj.queue_free()


func _action(nom: String, appui: bool) -> void:
	var ev := InputEventAction.new()
	ev.action = nom
	ev.pressed = appui
	Input.parse_input_event(ev)


func _basculer_arme() -> void:
	for appui: bool in [true, false]:
		var ev := InputEventAction.new()
		ev.action = "toggle_weapon"
		ev.pressed = appui
		Input.parse_input_event(ev)
		await _frames(2)


func _tangage(deg: float) -> void:
	(_player.get_node("SpringArm3D") as Node3D).rotation.x = deg_to_rad(deg)
	await _frames(12)


func _pose_affichee() -> void:
	_epaule = _skel.global_transform * _skel.get_bone_global_pose(_skel.find_bone("RightUpperArm")).origin
	_main = _skel.global_transform * _skel.get_bone_global_pose(_skel.find_bone("RightHand")).origin


# [part du bras tendu (%), élévation de la main vue de l'épaule (°)], sur la pose affichée
func _bras() -> Array:
	var longueur := _skel.get_bone_global_rest(_skel.find_bone("RightUpperArm")).origin.distance_to(
			_skel.get_bone_global_rest(_skel.find_bone("RightLowerArm")).origin) \
			+ _skel.get_bone_global_rest(_skel.find_bone("RightLowerArm")).origin.distance_to(
			_skel.get_bone_global_rest(_skel.find_bone("RightHand")).origin)
	var v := _main - _epaule
	return [100.0 * v.length() / longueur, rad_to_deg(atan2(v.y, Vector2(v.x, v.z).length()))]


# Angle entre l'axe du canon (+X de l'arme, cf. Weapon.gd) et la direction bouche -> point visé, en degrés.
func _ecart_canon() -> float:
	var arme := _player.get("_weapon_node") as Node3D
	var bouche := (_player.get("muzzle_point") as Node3D).global_position
	var cible: Vector3 = _player.call("_point_vise")
	return rad_to_deg((arme.global_transform.basis * Vector3.RIGHT).normalized().angle_to((cible - bouche).normalized()))


func _elevation_canon() -> float:
	var arme := _player.get("_weapon_node") as Node3D
	return rad_to_deg(asin(clampf((arme.global_transform.basis * Vector3.RIGHT).normalized().y, -1.0, 1.0)))


func _mesure(actions: Array) -> Dictionary:
	for a: String in actions:
		Input.action_press(a)
	await _frames(36)
	_releves.clear()
	_prec.clear()
	_enregistre = true
	await _frames(90)
	_enregistre = false
	for a: String in actions:
		Input.action_release(a)
	var corps := PackedFloat32Array()
	var anims := {}
	for e: Dictionary in _releves:
		corps.append(float(e["v"]))
		anims[e["anim"]] = int(anims.get(e["anim"], 0)) + 1
	var anim := ""
	for a: String in anims:
		if anim == "" or int(anims[a]) > int(anims[anim]):
			anim = a
	var r := {"corps": _q(corps, 0.5), "anim": anim, "cadence": float(_releves[-1]["cadence"])}
	var bras_min := INF
	var ecart_max := 0.0
	for e: Dictionary in _releves:
		if e.has("bras"):
			bras_min = minf(bras_min, float(e["bras"]))
			ecart_max = maxf(ecart_max, float(e["ecart"]))
	r["bras_min"] = bras_min
	r["ecart_max"] = ecart_max
	# amplitude du pas dans le SENS du déplacement (repère du joueur) : d'avant en arrière en avançant, de côté en pas chassés
	var sens := Vector3.ZERO
	for a: String in actions:
		sens += {"move_forward": Vector3.FORWARD, "move_back": Vector3.BACK, "move_left": Vector3.LEFT, "move_right": Vector3.RIGHT}.get(a, Vector3.ZERO)
	sens = sens.normalized() if sens != Vector3.ZERO else Vector3.FORWARD
	for os: String in PIEDS:
		var zmin := INF
		var zmax := -INF
		var lmin := INF
		for e: Dictionary in _releves:
			var l: float = (e[os]["local"] as Vector3).dot(sens)
			zmin = minf(zmin, l)
			zmax = maxf(zmax, l)
			lmin = minf(lmin, float(e[os]["semelle_loc"]))
		var glisse := PackedFloat32Array()
		var haut := PackedFloat32Array()
		for e: Dictionary in _releves:
			if float(e[os]["semelle_loc"]) <= lmin + 0.025 and e[os].has("v"):
				glisse.append(float(e[os]["v"]))
				haut.append(float(e[os]["semelle"]))
		r[os] = {"ampl": zmax - zmin, "glisse": _q(glisse, 0.5), "bas": _q(haut, 0.05), "haut": _q(haut, 0.95)}
	return r


func _process(delta: float) -> void:
	if not _enregistre or delta <= 0.0:
		return
	var xf := _player.global_transform
	var e := {"v": Vector2(_player.velocity.x, _player.velocity.z).length(), "anim": String(_anim.current_animation),
			"cadence": _anim.speed_scale}
	for os: String in PIEDS:
		var g := _skel.global_transform * _skel.get_bone_global_pose(_skel.find_bone(os))
		var s := _semelle(os)
		var d := {"local": xf.affine_inverse() * g.origin, "semelle": s.y, "semelle_loc": (xf.affine_inverse() * s).y + 0.9}
		if _prec.has(os):
			var dv: Vector3 = (g.origin - (_prec[os] as Vector3)) / delta
			d["v"] = Vector2(dv.x, dv.z).length()
		_prec[os] = g.origin
		e[os] = d
	var pt: Object = _player.get("_pose_tir")
	if pt != null and float(pt.get("poids")) > 0.999:
		e["bras"] = _bras()[0]
		e["ecart"] = _ecart_canon()
	_releves.append(e)


# Sommets des chaussures (maillage Suit_Feet), rangés à gauche ou à droite selon leur os dominant (pied ou tibia du
# côté), avec toutes leurs influences, pour la peau linéaire de _semelle.
func _peau() -> void:
	var cote := {"LeftFoot": "LeftFoot", "LeftLowerLeg": "LeftFoot", "RightFoot": "RightFoot", "RightLowerLeg": "RightFoot"}
	for n in _player.find_children("*", "MeshInstance3D", true, false):
		var mi := n as MeshInstance3D
		if mi.skin == null or mi.mesh == null or not String(mi.name).contains("Feet"):
			continue
		var bind_os := PackedInt32Array()
		for b in mi.skin.get_bind_count():
			bind_os.append(_skel.find_bone(String(mi.skin.get_bind_name(b))))
		for s in mi.mesh.get_surface_count():
			var arr := mi.mesh.surface_get_arrays(s)
			var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var bo: PackedInt32Array = arr[Mesh.ARRAY_BONES]
			var we: PackedFloat32Array = arr[Mesh.ARRAY_WEIGHTS]
			if bo.is_empty():
				continue
			var par := bo.size() / v.size()
			for i in v.size():
				var infl := []
				var best := -1
				var best_w := -1.0
				for k in par:
					var w := we[i * par + k]
					if w <= 0.0:
						continue
					infl.append([bind_os[bo[i * par + k]], mi.skin.get_bind_pose(bo[i * par + k]) * v[i], w])
					if w > best_w:
						best_w = w
						best = bind_os[bo[i * par + k]]
				var c: String = cote.get(_skel.get_bone_name(best), "")
				if c != "":
					(_infl[c] as Array).append(infl)


# Point le plus bas de la chaussure, dans le monde.
func _semelle(os: String) -> Vector3:
	var bas := Vector3(0.0, INF, 0.0)
	var poses := {}
	for infl: Array in _infl[os]:
		var p := Vector3.ZERO
		for e: Array in infl:
			if not poses.has(e[0]):
				poses[e[0]] = _skel.global_transform * _skel.get_bone_global_pose(e[0])
			p += (poses[e[0]] as Transform3D) * (e[1] as Vector3) * float(e[2])
		if p.y < bas.y:
			bas = p
	return bas


func _q(a: PackedFloat32Array, q: float) -> float:
	if a.is_empty():
		return NAN
	var b := a.duplicate()
	b.sort()
	return b[clampi(int(q * b.size()), 0, b.size() - 1)]


func _frames(count: int) -> void:
	for i in count:
		await get_tree().physics_frame


func _ok(ok: bool) -> String:
	return "OK" if ok else "ÉCHEC"
