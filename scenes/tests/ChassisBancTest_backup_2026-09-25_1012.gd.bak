extends Node3D

# BANC D'ESSAI DES CHÂSSIS (2026-09-24, CLAUDE.md §14 ; depuis le soir même, le châssis façon GTA V, §15). Chaque
# véhicule, conduit par le joueur avec les réglages de SA fiche (FichesVehicules, resources/vehicle_physics/
# fiches_vehicules.csv, aux noms du handling.meta de GTA V), passe les mêmes essais sur un sol plat de 8 km, deux bordures
# (0,15 m, celle des trottoirs de la carte ; 0,17 m, celle de la raquette de l'aérogare) et la collision cuite d'un parking
# à étages :
#  - repos : garde au sol de la coque, pneus sur le sol ;
#  - accélération pied au plancher : 0-50, 0-100 km/h, vitesse atteinte, rapports affichés, PATINAGE au démarrage (roues
#    motrices plus vite que le sol) et ÉCRASEMENT de la caisse (cabrage, rapporté) ;
#  - freinage fort depuis 100 km/h (sa vitesse de pointe si elle est plus basse) : distance, droit, et PLONGÉE de la caisse
#    (rapportée) ;
#  - FREINAGE FORT EN TOURNANT (2026-09-24) : à 100 km/h, le stick tenu à droite de quoi mettre 4° aux roues avant (c'est
#    déjà un virage à la limite des pneus avant à cette vitesse ; 10 % du volant jusqu'au 2026-09-24, 38 % depuis que le
#    braquage est réduit avec la vitesse), puis S à fond jusqu'à l'arrêt, le stick toujours tenu. Sans aide de
#    direction, c'est la physique qui doit garder la voiture dans l'axe de sa trajectoire : l'arrière garde la moitié de sa
#    charge (centre de tangage du freinage) et le répartiteur de freinage lui laisse de quoi tenir en travers ;
#  - FREINER ET TOURNER (2026-09-24 au soir) : lancé à 50, 80 puis 120 km/h (120 depuis le 2026-09-25) en ligne droite, S à
#    fond ET braquage à fond à droite en même temps, jusqu'à l'arrêt. La voiture doit TOURNER, pas aller tout droit : l'ABS
#    ne bloque jamais les roues avant et leur laisse de quoi diriger (« freiner en virage peut élargir un peu la
#    trajectoire, mais la voiture doit toujours tourner »). Relevés : trajectoire tournée (cap de la VITESSE) avant l'arrêt,
#    rayon moyen (distance / trajectoire tournée), décalage latéral, dérive au plus fort, distance d'arrêt, et le RAYON à
#    chaque palier de vitesse franchi en ralentissant (tous les 10 km/h) : il doit se resserrer ;
#  - BRAQUÉ À FOND EN ROUE LIBRE ET SOUS LES GAZ (2026-09-25) : lancé à 50, 80 et 120 km/h, D tenu, sans pédale ou W tenu.
#    Relevés entre 0,4 et 0,9 s (le volant est à fond, la vitesse encore proche du départ) : rayon, accélération latérale
#    vraie, glissement des pneus avant rapporté au pic de leur courbe (fTractionCurveLateral / 2), patinage des roues
#    motrices ; en roue libre, le rayon à chaque palier de vitesse franchi : il doit se resserrer quand la voiture ralentit ;
#  - PAS DE TONNEAU : braquage à fond, vitesse tenue, à 50, 80, 110 km/h et à la vitesse de pointe : roulis, roues levées,
#    glissade. Il glisse ou il sous-vire ; il ne se couche pas. Et (2026-09-25) les roues avant y suivent la RÉDUCTION DU
#    BRAQUAGE DE GTA V : volant à fond, leur angle « bicyclette » (tiré des angles des deux roues, Ackermann compris) vaut
#    fSteeringLock x (0,15 + 0,9^(v - 7,2)), v en m/s, bornée à 1 (ChassisGTA.reduction_gta) ;
#  - FREIN À MAIN (2026-09-24) : en ligne droite depuis 50 km/h, seul puis avec le frein au pied ; s'il est plus fort que
#    les pneus arrière (fiche), les roues arrière se bloquent, et l'ABS ne les desserre pas ; la voiture freine droit ;
#  - DÉRAPAGE AU FREIN À MAIN à 50, 80 et 110 km/h : braquage à fond et frein à main jusqu'à 15° de dérive (1 s au plus) :
#    l'arrière part en glisse (ou pas, selon la fiche) ; puis LE JOUEUR lâche le frein à main, CONTRE-BRAQUE et remet les
#    gaz (PiloteClavier : ses seules touches, avec un temps de réaction) jusqu'à ce que la voiture soit droite. Le châssis ne
#    braque jamais les roues à sa place (2026-09-24, « c'est MOI qui contre-braque ») : c'est ce qui prouve qu'une glisse se
#    rattrape au clavier. La voiture ne se couche pas ;
#  - bordures de 0,15 et 0,17 m, de face et à 30°, à 3 m/s : la coque ne touche pas ;
#  - entrée du parking à étages à 4 et 7 m/s, s'il passe sous la barre de 2,15 m : la coque ne touche pas.
# Échoue sur : une caisse à plus de 45° de la verticale, deux roues d'un même côté en l'air plus de 0,3 s, un contact de
# coque sur une bordure ou à l'entrée du parking, 50 km/h (ou sa vitesse de pointe si elle
# est plus basse) pas atteints en 30 s, un freinage qui dévie de plus de 15°, un véhicule sans châssis ; un frein à main
# plus fort que les pneus arrière qui ne les bloque pas (80 % du temps au moins), seul ou avec le frein au pied, ou qui fait
# tourner la voiture en ligne droite (5° au plus) ; un freinage en tournant qui fait partir la voiture (dérive au-delà de
# FREIN_VIRAGE_DERIVE) ; freiner et braquer à fond qui laisse la voiture aller presque tout droit (décalage latéral sous
# FREIN_BRAQUE_ECART fois l'avance : la trajectoire tournée seule ne suffit pas, le pivot final au ralenti la gonfle) ou la fait partir en tête-à-queue (dérive au-delà de FREIN_BRAQUE_DERIVE) ; un dérapage que le joueur ne rattrape pas en DERAPAGE_APRES s (dérive
# sous 5° et lacet sous 0,15 rad/s, tenus 0,3 s), ou qui finit arrêté en travers ; une sportive qui ne dérape pas au moins
# deux fois plus que le camion (city_sports_car_02 et city_truck_01, s'ils sont du passage). Depuis le 2026-09-25 : des roues
# avant qui ne suivent pas la courbe de GTA V, vitesse tenue (écart médian au-delà de COURBE_TOLERANCE, lissage compris) ;
# braqué à fond, en freinant ou en roue libre, un virage qui S'OUVRE en ralentissant (le rayon d'un palier plus de 10 %
# au-dessus de celui du palier plus rapide) ; une traction (fDriveBiasFront au-dessus de 0,5) à qui les gaz font perdre plus
# de 15 % de son accélération latérale braquée à fond (GAZ_TENUE).
# Rapporté sans être jugé : garde au sol du DESSOUS DU MODÈLE (ce qu'on voit) sur les bordures et à l'entrée du parking —
# les modèles les plus bas (9 à 15 cm) passent visuellement dans l'arête d'une bordure de 15 cm prise de face.
# Arguments après « -- » : --modeles=id1,id2 (par défaut les six silhouettes de réglage), --tous, --lot=i/n (i-ème part
# de n de la liste, pour répartir sur plusieurs processus), --phases=a,b, --trace.
# Lancer : Godot --headless --fixed-fps 60 res://scenes/tests/ChassisBancTest.tscn [-- --tous --lot=1/4]

const CAR := preload("res://scenes/vehicles/Car.tscn")
const CarScript := preload("res://scenes/vehicles/Car.gd")
const PiloteClavier := preload("res://scenes/tests/PiloteClavier.gd")
const PARKING := "res://scenes/world/downtown/generated/buildings/parking_collision.res"
const SILHOUETTES := ["city_microcar", "city_sedan_01", "city_sports_car_02", "city_suv_02", "city_truck_01", "city_bus_01"]
const PHASES := ["repos", "acceleration", "freinage", "frein_virage", "frein_braque_50", "frein_braque_80", "frein_braque_120",
		"braque_libre_50", "braque_libre_80", "braque_libre_120", "braque_gaz_50", "braque_gaz_80", "braque_gaz_120", "frein_main",
		"virage_50", "virage_80", "virage_110", "virage_vmax",
		"derapage_50", "derapage_80", "derapage_110", "bordure_15_face", "bordure_15_biais", "bordure_17_face", "bordure_17_biais",
		"parking"]
# Frein à main : la sportive doit déraper facilement, le camion beaucoup moins (demande du joueur, 2026-09-24). Quand les
# deux sont du passage, la dérive de la sportive doit valoir au moins DERAPAGE_RAPPORT fois celle du camion, à chaque vitesse.
const SPORTIVE := "city_sports_car_02"
const CAMION := "city_truck_01"
const DERAPAGE_RAPPORT := 2.0
const KMH := 1.0 / 3.6
const DEPART_ACCEL := Vector3(-3000.0, 0.0, 1000.0)
const DEPART_FREIN := Vector3(-3000.0, 0.0, 0.0)
const DEPART_VIRAGE := Vector3(-3000.0, 0.0, -1500.0)
const DEPART_DERAPAGE := Vector3(-3000.0, 0.0, -3000.0)
const DEPART_FREIN_VIRAGE := Vector3(-1500.0, 0.0, 3000.0)
# volant tenu (au stick), à droite : ce qui donne FREIN_VIRAGE_ROUES aux roues avant au coup de frein. Jusqu'au 2026-09-24 :
# 10 % du volant, soit 4° à 100 km/h avec la butée de 40° à toute vitesse ; depuis que le braquage est réduit avec la
# vitesse comme dans GTA V (2026-09-25 ; 0,264 à 100 km/h), il faut 38 % du volant pour les mêmes 4° — le même virage.
const FREIN_VIRAGE_ROUES := 4.0    # °
const DEPART_BRAQUE := Vector3(0.0, 0.0, -3000.0)
const BRAQUE_DUREE := 6.0          # s au plus, braqué à fond en roue libre (jusqu'à 20 km/h) ou sous les gaz (3 s)
const BRAQUE_FENETRE := 12         # pas : rayon de la trajectoire (chemin / cap de la vitesse tourné) sur cette fenêtre
const PALIERS := [110.0, 100.0, 90.0, 80.0, 70.0, 60.0, 50.0, 40.0, 30.0]   # km/h : rayon relevé à chaque palier franchi
const PALIER_TOLERANCE := 1.1      # d'un palier au suivant (plus lent), le rayon ne doit pas s'ouvrir de plus de 10 %
const COURBE_TOLERANCE := 0.3      # ° : écart toléré entre l'angle des roues et la courbe de GTA V, vitesse tenue
const GAZ_TENUE := 0.85            # traction braquée à fond : accélération latérale sous les gaz / en roue libre, au moins
const FREIN_VIRAGE_DERIVE := 20.0  # ° : au-delà, la voiture part
const DEPART_FREIN_BRAQUE := Vector3(1500.0, 0.0, -1500.0)
const FREIN_BRAQUE_ECART := 0.12   # décalage latéral / avance au moins, entre le coup de frein et l'arrêt (tout droit : 0)
const FREIN_BRAQUE_DERIVE := 60.0  # ° : au-delà (au-dessus de 3 m/s), c'est un tête-à-queue
const DERAPAGE_LIGNE := 1.5
const DERAPAGE_TIRE := 1.0       # s au plus : braquage à fond et frein à main, sans gaz...
const DERAPAGE_LACHE := 15.0     # ... lâché à cette dérive (°) : l'arrière est parti
const DERAPAGE_APRES := 4.0      # s : le joueur contre-braque et remet les gaz jusqu'à ce que la voiture soit droite
const BORDURES := {"15": [Vector3(1500.0, 0.0, 1500.0), 0.15], "17": [Vector3(1500.0, 0.0, 1700.0), 0.17]}
const BORDURE_TAILLE := Vector2(30.0, 12.0)
const PARKING_POS := Vector3(2500.0, 0.0, 2500.0)
const BARRE := 2.15
const ACCEL_DUREE := 40.0
const VIRAGE_LIGNE := 1.5
const VIRAGE_BRAQUE := 3.5
const VIRAGE_APRES := 2.0

var _modeles: Array = []          # [id, chemin du modèle]
var _k := -1
var _voiture: Node3D
var _ch: RigidBody3D
var _phases: Array = []
var _i := 0
var _t := 0.0
var _e := {}
var _res := {}
var _tableau: Array[String] = []
var _fautes: Array[String] = []
var _h_repos := 0.45
var _trace := false
var _bordures := {}
var _parking: StaticBody3D
var _dessous := PackedVector3Array()
var _tous := {}                   # id -> résultats, pour les comparaisons entre modèles
var _pilote = PiloteClavier.new()   # le joueur qui contre-braque (dérapages)


func _ready() -> void:
	var sol := _statique(Vector3(0.0, -0.5, 0.0), BoxShape3D.new(), "Sol")
	(sol.get_child(0) as CollisionShape3D).shape.size = Vector3(8000.0, 1.0, 8000.0)
	for cle in BORDURES:
		var b := BoxShape3D.new()
		var h: float = BORDURES[cle][1]
		b.size = Vector3(BORDURE_TAILLE.x, h, BORDURE_TAILLE.y)
		_bordures[cle] = _statique((BORDURES[cle][0] as Vector3) + Vector3(0.0, h * 0.5, 0.0), b, "Bordure_" + cle)
	_parking = _statique(PARKING_POS, load(PARKING), "Parking")
	var ids: Array = SILHOUETTES.duplicate()
	var lot := Vector2i(1, 1)
	_phases = PHASES.duplicate()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--modeles="):
			ids = Array(a.substr(10).split(","))
		elif a == "--tous":
			ids = []
			var fichiers := DirAccess.get_files_at("res://resources/vehicle_models/")
			fichiers.sort()
			for f in fichiers:
				if f.ends_with(".tres"):
					ids.append(f.get_basename())
		elif a.begins_with("--lot="):
			var p := a.substr(6).split("/")
			lot = Vector2i(int(p[0]), int(p[1]))
		elif a.begins_with("--phases="):
			_phases = Array(a.substr(9).split(","))
		elif a == "--trace":
			_trace = true
	for j in ids.size():
		if j % lot.y != lot.x - 1:
			continue
		var d = load("res://resources/vehicle_models/%s.tres" % ids[j])
		if d == null:
			_faute("%s : modèle inconnu" % ids[j])
			continue
		_modeles.append([String(ids[j]), String(d.model_paths[0])])
	print("CHASSIS_BANC %d véhicule(s) : %s" % [_modeles.size(), ", ".join(_modeles.map(func(m): return m[0]))])
	_suivant()


func _statique(pos: Vector3, forme: Shape3D, nom: String) -> StaticBody3D:
	var corps := StaticBody3D.new()
	corps.name = nom
	var cs := CollisionShape3D.new()
	cs.shape = forme
	corps.add_child(cs)
	corps.position = pos
	add_child(corps)
	return corps


func _faute(texte: String) -> void:
	_fautes.append(texte)
	print("CHASSIS_BANC_FAUTE %s" % texte)


func _id() -> String:
	return String(_modeles[_k][0])


func _fiche() -> Dictionary:
	return FichesVehicules.fiche(_id())


func _vmax() -> float:
	return FichesVehicules.vitesse_max(_fiche())


# --- boucle ------------------------------------------------------------------------------------------------------

func _suivant() -> void:
	if _voiture != null:
		_resume()
		remove_child(_voiture)
		_voiture.queue_free()
		_voiture = null
		_ch = null
	_k += 1
	if _k >= _modeles.size():
		_fin()
		return
	_voiture = CAR.instantiate() as Node3D
	_voiture.set("forced_model_path", String(_modeles[_k][1]))
	_voiture.name = "Banc_" + _id()
	add_child(_voiture)
	_voiture.set("has_npc_driver", false)
	_voiture.global_position = DEPART_ACCEL + Vector3(0.0, 1.0, 0.0)
	_voiture.call("park")
	_voiture.call("start_drive")
	_ch = _voiture.call("chassis")
	_res = {}
	_dessous = PackedVector3Array()
	_i = 0
	_t = 0.0
	_e = {}
	if _ch == null:
		_faute("%s : pas de châssis réaliste" % _id())
		_voiture.call("stop_drive")
		_suivant()


func _physics_process(delta: float) -> void:
	if _ch == null:
		return
	_t += delta
	if _i >= _phases.size():
		_suivant()
		return
	_pilote.observer(_ch, _t)
	var phase: String = _phases[_i]
	var fini := false
	if phase.begins_with("virage_"):
		fini = _p_virage(phase)
	elif phase.begins_with("frein_braque_"):
		fini = _p_frein_braque(phase)
	elif phase.begins_with("braque_"):
		fini = _p_braque(phase)
	elif phase.begins_with("derapage_"):
		fini = _p_derapage(phase)
	elif phase.begins_with("bordure_"):
		fini = _p_bordure(phase)
	else:
		fini = bool(call("_p_" + phase, phase))
	if _trace and Engine.get_physics_frames() % 15 == 0:
		var glisse := 0.0
		for w in _ch.get("roues"):
			if bool(w.motrice):
				glisse = maxf(glisse, absf(float(w.wv) * float(w.w_size) * float(_ch.get("LengthScale"))) - absf(_v()))
		var roues := []
		for w in _ch.get("roues"):
			roues.append("%s %.1f/%.0fN/%.1f°" % [w.name, float(w.wv) * float(w.w_size) * float(_ch.get("LengthScale")), float(w.charge),
					rad_to_deg(float(w.derive_pneu))])
		print("BANC_TRACE %s %s t=%.2f v=%.1f km/h rapport=%s gaz=%.2f frein=%.2f glisse=%.1f penche=%.1f° tangage=%.1f° pos=%s volant=%.3f lacet=%.3f roues=%s" % [
				_id(), phase, _t, _v() * 3.6, _ch.call("rapport"), float(_ch.get("gaspedal")), float(_ch.get("brakepedal")),
				glisse, _penche(), _tangage(), str(_ch.global_position.snappedf(0.01)), float(_ch.get("steer")), _ch.angular_velocity.y, str(roues)])
	if _trace and _t < 0.02:
		var pos := []
		for w in _ch.get("roues"):
			pos.append("%s %s" % [w.name, str((w as Node3D).position.snappedf(0.001))])
		print("BANC_ROUES %s %s cdg=%s %s" % [_id(), phase, str(_ch.center_of_mass.snappedf(0.001)), str(pos)])
	if fini or _t > 70.0:
		if not fini:
			_faute("%s : phase « %s » pas finie en 70 s" % [_id(), phase])
		_pedales()
		_i += 1
		_t = 0.0
		_e = {}
		_pilote.oublier()


# --- outils ------------------------------------------------------------------------------------------------------

func _pedales(gaz := false, frein := false, droite := false, gauche := false, frein_main := false) -> void:
	for a in ["gas", "brake", "left", "right", "handbrake"]:
		Input.action_release(a)
	if gaz:
		Input.action_press("gas")
	if frein:
		Input.action_press("brake")
	if droite:
		Input.action_press("right")
	if gauche:
		Input.action_press("left")
	if frein_main:
		Input.action_press("handbrake")


func _v() -> float:
	return float(_ch.call("vitesse_avant"))


func _regule(cible: float, droite := false) -> void:
	var v := _v()
	_pedales(v < cible, v > cible + 1.5, droite)


func _penche() -> float:
	return rad_to_deg(acos(clampf(_ch.global_transform.basis.y.dot(Vector3.UP), -1.0, 1.0)))


# Tangage de la caisse (deg) : + le nez en l'air (écrasement à l'accélération), - le nez plongé (freinage).
func _tangage() -> float:
	return rad_to_deg(asin(clampf(_ch.global_transform.basis.z.normalized().y, -1.0, 1.0)))


# Plus grand patinage des roues motrices (m/s) : vitesse du pneu moins celle du sol.
func _patinage() -> float:
	var p := 0.0
	for w in _ch.get("roues"):
		if bool(w.motrice) and w.is_colliding():
			p = maxf(p, absf(float(w.wv) * float(w.w_size)) - absf(_v()))
	return p


# LA COURBE DE GTA V, écrite ici indépendamment de ChassisGTA (le banc vérifie que le châssis la suit) : part de
# fSteeringLock donnée par le volant à fond à `v` m/s le long de l'avant (code d'ikt32, CustomSteering.cpp,
# calculateReduction), mêlée au réglage global `reduction_braquage` (1 : la courbe telle quelle).
func _courbe_gta(v: float) -> float:
	var mult := 1.0
	if v > 3.0:
		mult = minf(floorf((0.15 + pow(0.9, v - 7.2)) * 1000.0) / 1000.0, 1.0)
	return clampf(1.0 + (mult - 1.0) * FichesVehicules.reglage("reduction_braquage"), 0.0, 1.0)


# Angle « bicyclette » des roues avant (deg, positif), tiré des angles des deux roues (épure d'Ackermann : les cotangentes
# des deux roues encadrent celle de l'angle bicyclette à égale distance).
func _angle_bicyclette() -> float:
	var cot := 0.0
	var n := 0
	for w in _ch.get("roues"):
		if bool(w.avant):
			var a := absf(float(w.braquage))
			if a < 0.0001:
				return 0.0
			cot += 1.0 / tan(a)
			n += 1
	return rad_to_deg(atan(float(n) / cot)) if n > 0 else 0.0


# Glissement des pneus avant (deg, moyenne des roues avant) et leur pic (fTractionCurveLateral / 2).
func _glissement_avant() -> float:
	var s := 0.0
	var n := 0
	for w in _ch.get("roues"):
		if bool(w.avant):
			s += rad_to_deg(float(w.derive_pneu))
			n += 1
	return s / float(maxi(n, 1))


func _pic_avant() -> float:
	return rad_to_deg(float(_ch.get("derive_pic")))


# Trajectoire (cap de la VITESSE) : à appeler à chaque pas d'une phase braquée. Tient dans `_e` (clés « tr_ ») le chemin
# parcouru, le cap tourné, et sur BRAQUE_FENETRE pas le rayon (chemin / cap tourné) et l'accélération latérale vraie ; rend
# [rayon, a_lat].
func _trajectoire() -> Array:
	var vh := _ch.linear_velocity
	vh.y = 0.0
	var pos := _ch.global_position
	var pas := pos - (_e.get("tr_prec", pos) as Vector3)
	pas.y = 0.0
	_e["tr_prec"] = pos
	var da := 0.0
	if vh.length() > 0.5:
		var cap_v := atan2(vh.x, vh.z)
		if _e.has("tr_cap_v"):
			da = wrapf(cap_v - float(_e["tr_cap_v"]), -PI, PI)
			_e["tr_tourne"] = float(_e.get("tr_tourne", 0.0)) + da
		_e["tr_cap_v"] = cap_v
	_e["tr_chemin"] = float(_e.get("tr_chemin", 0.0)) + pas.length()
	var fen: Array = _e.get("tr_fen", [])
	fen.append([pas.length(), absf(da), vh])
	if fen.size() > BRAQUE_FENETRE:
		fen.pop_front()
	_e["tr_fen"] = fen
	if fen.size() < BRAQUE_FENETRE:
		return [INF, 0.0]
	var ds := 0.0
	var dc := 0.0
	for f in fen:
		ds += float(f[0])
		dc += float(f[1])
	var dv: Vector3 = (fen.back()[2] as Vector3) - (fen.front()[2] as Vector3)
	var dir := ((fen.back()[2] as Vector3) + (fen.front()[2] as Vector3)).normalized()
	var a_lat := (dv - dir * dv.dot(dir)).length() / (float(BRAQUE_FENETRE - 1) * get_physics_process_delta_time())
	return [ds / maxf(dc, 0.00001), a_lat]


# Rayon à chaque palier de vitesse franchi en ralentissant (`_e["paliers"]`, km/h -> m).
func _paliers(v_kmh: float, rayon: float) -> void:
	var p: Dictionary = _e.get("paliers", {})
	for palier: float in PALIERS:
		if not p.has(palier) and v_kmh <= palier and float(_e.get("v_depart", 0.0)) * 3.6 > palier + 2.0 and rayon < INF:
			p[palier] = rayon
	_e["paliers"] = p


# Le rayon se resserre-t-il quand la voiture ralentit ? Rend le premier palier où il s'ouvre (plus de PALIER_TOLERANCE fois
# celui du palier plus rapide), ou -1.
func _palier_qui_s_ouvre(p: Dictionary) -> float:
	var cles := p.keys()
	cles.sort()
	cles.reverse()
	for i in range(1, cles.size()):
		if float(p[cles[i]]) > PALIER_TOLERANCE * float(p[cles[i - 1]]):
			return float(cles[i])
	return -1.0


func _texte_paliers(p: Dictionary) -> String:
	var cles := p.keys()
	cles.sort()
	cles.reverse()
	var t := []
	for c in cles:
		t.append("%.0f km/h %.1f m" % [c, p[c]])
	return ", ".join(t)


func _placer(sol: Vector3, cap: float, v := 0.0) -> void:
	var xf := Transform3D(Basis(Vector3.UP, cap), sol + Vector3.UP * (_h_repos + 0.02))
	_voiture.global_transform = xf
	_ch.global_transform = xf * CarScript.repere_chassis()
	_ch.call("repartir", -xf.basis.z * v)


func _cap_vers_x() -> float:
	return -PI * 0.5


# Roues du châssis en l'air, par côté (gauche : +x du châssis ; noms « fl », « rl », « rl1 »...).
func _roues_en_l_air() -> Vector2i:
	var g := 0
	var d := 0
	var ng := 0
	var nd := 0
	for w in _ch.get("roues"):
		var gauche: bool = String(w.name).substr(1, 1) == "l"
		if gauche:
			ng += 1
		else:
			nd += 1
		if not w.is_colliding():
			if gauche:
				g += 1
			else:
				d += 1
	return Vector2i(1 if g == ng else 0, 1 if d == nd else 0)


func _contacts(corps: Node) -> bool:
	return corps in _ch.get_colliding_bodies()


# Garde au sol de la coque (bas de ses formes au-dessus du sol plat, y = 0).
# Diagnostic (--trace) : où la coque touche `corps`, dans le repère du châssis (avant en +z), et l'état des roues.
func _trace_contacts(corps: Node, phase: String) -> void:
	var etat := PhysicsServer3D.body_get_direct_state(_ch.get_rid())
	if etat == null:
		return
	var roues := []
	for w in _ch.get("roues"):
		roues.append("%s:%s%.2f" % [w.name, "" if w.is_colliding() else "air ", float(w.get("compress"))])
	for i in etat.get_contact_count():
		if etat.get_contact_collider_object(i) == corps:
			var p: Vector3 = _ch.global_transform.affine_inverse() * etat.get_contact_local_position(i)   # position MONDE, malgré le nom
			print("BANC_CONTACT %s %s t=%.2f point=%s tangage=%.1f° roues=%s" % [_id(), phase, _t, str(p.snappedf(0.01)),
					rad_to_deg(asin(clampf(_ch.global_transform.basis.z.y, -1.0, 1.0))), " ".join(roues)])


func _garde_coque() -> float:
	var bas := INF
	for c in _ch.get_children():
		if c is CollisionShape3D and (c as CollisionShape3D).shape is ConvexPolygonShape3D:
			var xf := (c as CollisionShape3D).global_transform
			for p in ((c as CollisionShape3D).shape as ConvexPolygonShape3D).points:
				bas = minf(bas, (xf * p).y)
	return bas


# Dessous du modèle, roues exceptées (cf. ConduiteReelleTest) : le point le plus bas de chaque tranche de 3 cm.
func _profil_dessous() -> PackedVector3Array:
	var modele: Node3D = _voiture.get("_model")
	var roues: Array = _voiture.get("_wheels")
	var vers_voiture := _voiture.global_transform.affine_inverse()
	var vers_modele := modele.global_transform.affine_inverse()
	var tranches := {}
	for n in modele.find_children("*", "MeshInstance3D", true, false):
		var mi := n as MeshInstance3D
		var roue := false
		for w: Node3D in roues:
			if w == mi or w.is_ancestor_of(mi):
				roue = true
		if roue or mi.mesh == null:
			continue
		for s in mi.mesh.get_surface_count():
			for p: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
				var g := mi.global_transform * p
				var q := vers_voiture * g
				var k := int(floor(q.z / 0.03))
				if not tranches.has(k) or q.y < float((tranches[k] as Array)[0]):
					tranches[k] = [q.y, vers_modele * g]
	# une tranche dont le point le plus bas est haut (la visière du toit d'un fourgon, qui dépasse du reste) n'est pas du
	# dessous : son rayon de mesure partirait au-dessus de la barre de hauteur et la prendrait pour le sol
	var haut_max := (_voiture.call("boite_caisse") as AABB).position.y + 0.8
	var out := PackedVector3Array()
	for k in tranches:
		if float((tranches[k] as Array)[0]) < haut_max:
			out.append((tranches[k] as Array)[1])
	return out


func _garde_dessous() -> float:
	if _dessous.is_empty():
		return INF
	var modele: Node3D = _voiture.get("_model")
	var xf := modele.global_transform
	var espace := get_world_3d().direct_space_state
	var exclus: Array[RID] = _voiture.call("rids_exclus")
	var mini := INF
	for q in _dessous:
		var p := xf * q
		var hit := espace.intersect_ray(PhysicsRayQueryParameters3D.create(p + Vector3.UP * 0.6, p + Vector3.DOWN * 1.5, 1, exclus))
		if not hit.is_empty():
			mini = minf(mini, p.y - (hit["position"] as Vector3).y)
	return mini


# --- phases (rendent true quand elles sont finies) ---------------------------------------------------------------

func _p_repos(_phase: String) -> bool:
	if not _e.has("pose"):
		_e["pose"] = true
		_placer(DEPART_ACCEL, _cap_vers_x())
		return false
	_pedales()
	if _t < 1.5:
		return false
	_h_repos = _voiture.global_position.y
	if _dessous.is_empty():
		_dessous = _profil_dessous()
	var rayons: Dictionary = _voiture.get("_wheel_radius")
	var centres: Dictionary = _voiture.get("_wheel_centre")
	var pneus := 0.0
	for w: Node3D in _voiture.get("_wheels"):
		var c: Vector3 = w.global_transform * (centres.get(w, Vector3.ZERO) as Vector3)
		pneus = maxf(pneus, absf(c.y - float(rayons.get(w, 0.3))))
	_res["repos"] = {"garde_coque": _garde_coque(), "garde_dessous": _garde_dessous(), "pneus": pneus, "penche": _penche()}
	return true


func _p_acceleration(_phase: String) -> bool:
	var v := _v()
	if not _e.has("t50"):
		_e["t50"] = -1.0
		_e["t100"] = -1.0
		_e["vmax"] = 0.0
		_e["rapport_max"] = 0
		_e["montees"] = 0
		_e["hesitations"] = 0
		_e["rapport"] = int(_ch.get("gear"))
		_e["t_vmax"] = -1.0
		_e["patinage"] = 0.0
		_e["cabre"] = 0.0
	_pedales(true)
	if _t < 3.0:
		_e["patinage"] = maxf(float(_e["patinage"]), _patinage())
		_e["cabre"] = maxf(float(_e["cabre"]), _tangage())
	var g := int(_ch.get("gear"))
	if g != int(_e["rapport"]):
		if g > int(_e["rapport"]):
			_e["montees"] = int(_e["montees"]) + 1
		elif int(_e["rapport"]) > 0 and v > 3.0:
			_e["hesitations"] = int(_e["hesitations"]) + 1
		_e["rapport"] = g
	_e["rapport_max"] = maxi(int(_e["rapport_max"]), g)
	if float(_e["t50"]) < 0.0 and v >= 50.0 * KMH:
		_e["t50"] = _t
	if float(_e["t100"]) < 0.0 and v >= 100.0 * KMH:
		_e["t100"] = _t
	if v > float(_e["vmax"]) + 0.05:
		_e["vmax"] = v
		_e["t_vmax"] = _t
	var plafond := _t - float(_e["t_vmax"]) > 4.0 and _t > 8.0
	if _t < ACCEL_DUREE and not plafond:
		return false
	_res["acceleration"] = {"t50": _e["t50"], "t100": _e["t100"], "vmax": float(_e["vmax"]) * 3.6, "t_vmax": _e["t_vmax"],
			"rapport_max": _e["rapport_max"], "montees": _e["montees"], "hesitations": _e["hesitations"],
			"patinage": _e["patinage"], "cabre": _e["cabre"]}
	return true


func _p_freinage(_phase: String) -> bool:
	var v0 := minf(100.0 * KMH, _vmax() * 0.95)
	if not _e.has("phase"):
		_e["phase"] = "lance"
		_placer(DEPART_FREIN, _cap_vers_x(), v0)
		return false
	match String(_e["phase"]):
		"lance":
			_regule(v0)
			if _t > 2.0:
				_e["phase"] = "freine"
				_e["x0"] = _voiture.global_position
				_e["cap0"] = _voiture.rotation.y
				_e["t0"] = _t
				_e["v0"] = _v()
				_e["plonge"] = 0.0
		"freine":
			_pedales(false, true)
			_e["plonge"] = minf(float(_e["plonge"]), _tangage())
			if _trace and Engine.get_physics_frames() % 6 == 0:
				var gl := []
				for w in _ch.get("roues"):
					gl.append("%s %.1f/%.0fN/fx %.0fN" % [w.name, float(w.wv) * float(w.w_size) * float(_ch.get("LengthScale")) - _v(), float(w.charge), float(w.fx)])
				print("BANC_FREIN %s t=%.2f v=%.1f km/h pedale=%.2f tangage=%.1f° glisse=%s" % [_id(), _t - float(_e["t0"]),
						_v() * 3.6, float(_ch.get("brakepedal")), _tangage(), str(gl)])
			if _v() < 0.3:
				var d := (_voiture.global_position - (_e["x0"] as Vector3))
				d.y = 0.0
				var dcap := rad_to_deg(absf(wrapf(_voiture.rotation.y - float(_e["cap0"]), -PI, PI)))
				_res["freinage"] = {"v0": float(_e["v0"]) * 3.6, "distance": d.length(), "temps": _t - float(_e["t0"]), "cap": dcap,
						"plonge": _e["plonge"]}
				return true
			if _t - float(_e.get("t0", _t)) > 20.0:
				_res["freinage"] = {"v0": float(_e["v0"]) * 3.6, "distance": -1.0, "temps": -1.0, "cap": 0.0, "plonge": _e["plonge"]}
				return true
	return false


# BRAQUÉ À FOND EN ROUE LIBRE OU SOUS LES GAZ (2026-09-25) : cf. en tête. Lancé à la vitesse de la phase (sa vitesse de
# pointe x 0,95 si elle est plus basse), D tenu, et rien d'autre (libre) ou W tenu (gaz). Roue libre : jusqu'à 20 km/h
# (BRAQUE_DUREE au plus), le rayon relevé à chaque palier ; gaz : 3 s.
func _p_braque(phase: String) -> bool:
	var mode := phase.get_slice("_", 1)
	var v0 := minf(float(phase.get_slice("_", 2)) * KMH, _vmax() * 0.95)
	if not _e.has("phase"):
		_e["phase"] = "lance"
		_placer(DEPART_BRAQUE, _cap_vers_x(), v0)
		return false
	match String(_e["phase"]):
		"lance":
			_regule(v0)
			if _t > 1.0:
				_e["phase"] = "braque"
				_e["t0"] = _t
				_e["v_depart"] = _v()
				_e["r"] = []
				_e["a"] = []
				_e["gl"] = []
				_e["patin"] = 0.0
				_e["penche"] = 0.0
				_e["up_min"] = 1.0
		"braque":
			_pedales(mode == "gaz", false, true)
			var tr := _trajectoire()
			var dt := _t - float(_e["t0"])
			var vh := _ch.linear_velocity
			vh.y = 0.0
			if dt >= 0.4 and dt <= 0.9:
				(_e["r"] as Array).append(tr[0])
				(_e["a"] as Array).append(tr[1])
				(_e["gl"] as Array).append(_glissement_avant())
				_e["v_fen"] = vh.length() * 3.6
			if dt <= 0.9:
				_e["patin"] = maxf(float(_e["patin"]), _patinage())
			if mode == "libre":
				_paliers(vh.length() * 3.6, float(tr[0]))
			_e["penche"] = maxf(float(_e["penche"]), _penche())
			_e["up_min"] = minf(float(_e["up_min"]), _ch.global_transform.basis.y.dot(Vector3.UP))
			var fini := dt > (3.0 if mode == "gaz" else BRAQUE_DUREE) or (mode == "libre" and vh.length() * 3.6 < 20.0)
			if fini:
				_res[phase] = {"v": float(_e["v_depart"]) * 3.6, "v_fen": _e.get("v_fen", 0.0), "rayon": _moyenne(_e["r"]),
						"a_lat": _moyenne(_e["a"]), "glissement": _moyenne(_e["gl"]), "pic": _pic_avant(), "patin": _e["patin"],
						"adherence": float(_ch.get("adherence_av")) * 9.81, "paliers": _e.get("paliers", {}),
						"tourne": rad_to_deg(absf(float(_e.get("tr_tourne", 0.0)))), "temps": dt, "v_fin": vh.length() * 3.6,
						"penche": _e["penche"], "up_min": _e["up_min"]}
				return true
	return false


func _moyenne(a) -> float:
	var arr: Array = a
	var s := 0.0
	var n := 0
	for x in arr:
		if float(x) < INF:
			s += float(x)
			n += 1
	return s / float(n) if n > 0 else NAN


# FREINER ET TOURNER : cf. en tête. S à fond et D (braquage à fond) pressés ensemble, jusqu'à l'arrêt.
func _p_frein_braque(phase: String) -> bool:
	var v0 := minf(float(phase.get_slice("_", 2)) * KMH, _vmax() * 0.95)
	if not _e.has("phase"):
		_e["phase"] = "lance"
		var decale := {"50": 0.0, "80": -200.0, "120": -400.0}
		_placer(DEPART_FREIN_BRAQUE + Vector3(0.0, 0.0, float(decale.get(phase.get_slice("_", 2), 0.0))), _cap_vers_x(), v0)
		return false
	var vh := _ch.linear_velocity
	vh.y = 0.0
	var avant := _ch.global_transform.basis.z
	avant.y = 0.0
	match String(_e["phase"]):
		"lance":
			_regule(v0)
			if _t > 1.5:
				_e["phase"] = "freine"
				_e["t0"] = _t
				_e["v1"] = _v()
				_e["x0"] = _ch.global_position
				_e["dir0"] = vh.normalized()
				_e["cap_v"] = atan2(vh.x, vh.z)
				_e["tourne"] = 0.0
				_e["chemin"] = 0.0
				_e["derive"] = 0.0
				_e["penche"] = 0.0
				_e["up_min"] = 1.0
				_e["prec"] = _ch.global_position
		"freine":
			_pedales(false, true, true)
			# rayon à chaque palier de vitesse franchi : il doit se resserrer quand la voiture ralentit (2026-09-25)
			var tr := _trajectoire()
			_e["v_depart"] = _e["v1"]
			_paliers(vh.length() * 3.6, float(tr[0]))
			var dtf := _t - float(_e["t0"])
			if dtf >= 0.4 and dtf <= 0.9:
				var gl: Array = _e.get("gl", [])
				gl.append(_glissement_avant())
				_e["gl"] = gl
			var pos := _ch.global_position
			var pas := pos - (_e["prec"] as Vector3)
			pas.y = 0.0
			_e["chemin"] = float(_e["chemin"]) + pas.length()
			_e["prec"] = pos
			if vh.length() > 1.0:
				var cap_v := atan2(vh.x, vh.z)
				_e["tourne"] = float(_e["tourne"]) + wrapf(cap_v - float(_e["cap_v"]), -PI, PI)
				_e["cap_v"] = cap_v
			if vh.length() > 3.0:
				_e["derive"] = maxf(float(_e["derive"]), rad_to_deg(vh.normalized().angle_to(avant.normalized())))
			_e["penche"] = maxf(float(_e["penche"]), _penche())
			_e["up_min"] = minf(float(_e["up_min"]), _ch.global_transform.basis.y.dot(Vector3.UP))
			if vh.length() < 1.0 or _t - float(_e["t0"]) > 12.0:
				var d := pos - (_e["x0"] as Vector3)
				d.y = 0.0
				var dir0: Vector3 = _e["dir0"]
				var tourne := absf(float(_e["tourne"]))
				_res[phase] = {"v": float(_e["v1"]) * 3.6, "tourne": rad_to_deg(tourne),
						"rayon": float(_e["chemin"]) / maxf(tourne, 0.001), "chemin": _e["chemin"],
						"lateral": (d - dir0 * d.dot(dir0)).length(), "avance": d.dot(dir0), "derive": _e["derive"],
						"temps": _t - float(_e["t0"]), "penche": _e["penche"], "up_min": _e["up_min"],
						"paliers": _e.get("paliers", {}), "glissement": _moyenne(_e.get("gl", [])), "pic": _pic_avant()}
				return true
	return false


# FREINAGE FORT EN TOURNANT : cf. en tête. Relevés : dérive au plus fort, cap pris pendant le freinage, distance, roulis.
func _p_frein_virage(_phase: String) -> bool:
	var v0 := minf(100.0 * KMH, _vmax() * 0.95)
	if not _e.has("phase"):
		_e["phase"] = "lance"
		_e["derive"] = 0.0
		_e["penche"] = 0.0
		_e["up_min"] = 1.0
		# le stick qui donne FREIN_VIRAGE_ROUES aux roues à la vitesse du coup de frein (braquage réduit comme dans GTA V)
		_e["stick"] = clampf(FREIN_VIRAGE_ROUES / (rad_to_deg(float(_ch.get("braquage_max"))) * _courbe_gta(v0)), 0.0, 1.0)
		_placer(DEPART_FREIN_VIRAGE, _cap_vers_x(), v0)
		return false
	for a in ["gas", "brake", "left", "right", "handbrake"]:
		Input.action_release(a)
	Input.action_press("right", float(_e["stick"]))
	var vh := _ch.linear_velocity
	vh.y = 0.0
	var avant := _ch.global_transform.basis.z
	avant.y = 0.0
	match String(_e["phase"]):
		"lance":
			if _v() < v0:
				Input.action_press("gas")
			if _t > 1.0:
				_e["phase"] = "freine"
				_e["cap0"] = atan2(avant.x, avant.z)
				_e["x0"] = _ch.global_position
				_e["v1"] = _v()
		"freine":
			Input.action_press("brake")
			if vh.length() > 3.0:
				_e["derive"] = maxf(float(_e["derive"]), rad_to_deg(vh.normalized().angle_to(avant.normalized())))
			_e["penche"] = maxf(float(_e["penche"]), _penche())
			_e["up_min"] = minf(float(_e["up_min"]), _ch.global_transform.basis.y.dot(Vector3.UP))
			if _v() < 0.5 or _t > 12.0:
				var d := _ch.global_position - (_e["x0"] as Vector3)
				d.y = 0.0
				_res["frein_virage"] = {"v": float(_e["v1"]) * 3.6, "derive": _e["derive"], "distance": d.length(),
						"cap": rad_to_deg(absf(wrapf(atan2(avant.x, avant.z) - float(_e["cap0"]), -PI, PI))), "penche": _e["penche"],
						"up_min": _e["up_min"], "stick": _e["stick"]}
				return true
	return false


# FREIN À MAIN, en ligne droite depuis 50 km/h, pendant 1 s : décélération obtenue, roues arrière bloquées, cap. Deux
# passages : le frein à main seul, puis avec le frein au pied en même temps (S + Espace) — l'ABS roue par roue ne doit
# desserrer que la part du frein au pied, jamais le frein à main. Ce que dit la fiche : `frein_main_ms2`, ou ce que tiennent
# les pneus arrière s'il est plus fort (ils se bloquent alors).
func _p_frein_main(_phase: String) -> bool:
	var v0 := minf(50.0 * KMH, _vmax() * 0.9)
	if not _e.has("phase"):
		_e["phase"] = "lance"
		_e["passe"] = int(_e.get("passe", 0))
		_e["pas"] = 0
		_e["bloquees"] = 0
		_placer(DEPART_FREIN + Vector3(0.0, 0.0, -300.0 - 40.0 * float(_e["passe"])), _cap_vers_x(), v0)
		return false
	match String(_e["phase"]):
		"lance":
			_regule(v0)
			if _t > 1.5:
				_e["phase"] = "tire"
				_e["t0"] = _t
				_e["v0"] = _v()
				_e["cap0"] = _voiture.rotation.y
		"tire":
			var pied := int(_e["passe"]) == 1
			_pedales(false, pied, false, false, true)
			var v := _v()
			if v > 3.0 and _t - float(_e["t0"]) > 0.1:
				_e["pas"] = int(_e["pas"]) + 1
				var bloquees := true
				for w in _ch.get("roues"):
					if String(w.name).begins_with("r") and absf(float(w.wv) * float(w.w_size) * float(_ch.get("LengthScale"))) > 0.15 * v:
						bloquees = false
				if bloquees:
					_e["bloquees"] = int(_e["bloquees"]) + 1
			if _t - float(_e["t0"]) >= 1.0 or v < 3.0:
				var duree := _t - float(_e["t0"])
				_res["frein_main_pied" if pied else "frein_main"] = {"v0": float(_e["v0"]) * 3.6, "decel": (float(_e["v0"]) - v) / maxf(duree, 0.01),
						"bloquees": float(_e["bloquees"]) / float(maxi(int(_e["pas"]), 1)),
						"cap": rad_to_deg(absf(wrapf(_voiture.rotation.y - float(_e["cap0"]), -PI, PI))),
						"bloque_attendu": bool(_ch.call("frein_main_bloque"))}
				if pied:
					return true
				_pedales()
				_e = {"passe": 1}
	return false


func _p_virage(phase: String) -> bool:
	var cible := _vmax() if phase == "virage_vmax" else float(phase.substr(7)) * KMH
	if cible > _vmax() + 0.5:
		return true      # au-delà de sa vitesse de pointe
	if not _e.has("phase"):
		_e["phase"] = "ligne"
		_e["penche"] = 0.0
		_e["up_min"] = 1.0
		_e["leve"] = 0.0
		_e["leve_max"] = 0.0
		_e["a_lat"] = 0.0
		_e["derive"] = 0.0
		_e["v_braque"] = 0.0
		_e["red"] = _courbe_gta(cible)     # la réduction du châssis, posée à vitesse (ChassisGTA.repartir)
		_placer(DEPART_VIRAGE, _cap_vers_x(), cible)
		return false
	# RÉPLIQUE DU LISSAGE de la réduction (celui du code d'ikt32 : lerp(précédente, courbe(v), 1 - 0,01^dt) à chaque pas),
	# nourrie de la même vitesse que le châssis lit au même pas ; l'angle des roues relu à ce pas est celui du pas précédent,
	# d'où la valeur d'avant la mise à jour. Une vitesse qui baisse dans la partie raide de la courbe (la balayeuse, qui ne
	# tient pas 50 km/h braquée à fond) met sinon 0,8° d'écart entre la courbe instantanée et les roues.
	var red_prec := float(_e["red"])
	_e["red"] = lerpf(red_prec, _courbe_gta(_v()), 1.0 - pow(0.01, get_physics_process_delta_time()))
	var up := _ch.global_transform.basis.y.dot(Vector3.UP)
	_e["up_min"] = minf(float(_e["up_min"]), up)
	_e["penche"] = maxf(float(_e["penche"]), _penche())
	var leve := _roues_en_l_air()
	if leve.x + leve.y > 0:
		_e["leve"] = float(_e["leve"]) + get_physics_process_delta_time()
		_e["leve_max"] = maxf(float(_e["leve_max"]), float(_e["leve"]))
	else:
		_e["leve"] = 0.0
	var vh := _ch.linear_velocity
	vh.y = 0.0
	match String(_e["phase"]):
		"ligne":
			_regule(cible)
			if _t > VIRAGE_LIGNE:
				_e["phase"] = "braque"
				_e["t0"] = _t
				_e["v_braque"] = _v()
		"braque":
			_regule(cible, true)
			# accélération latérale VRAIE : la variation de la vitesse perpendiculaire à elle-même, sur 10 pas (v x lacet
			# la surestime dès que la voiture pivote plus vite que sa trajectoire ne tourne)
			var hist: Array = _e.get("hist", [])
			hist.append(vh)
			if hist.size() > 10:
				hist.pop_front()
				var dv: Vector3 = (hist.back() as Vector3) - (hist.front() as Vector3)
				var dir := ((hist.back() as Vector3) + (hist.front() as Vector3)).normalized()
				var a_perp := (dv - dir * dv.dot(dir)).length() / (9.0 / 60.0)
				_e["a_lat"] = maxf(float(_e["a_lat"]), a_perp)
			_e["hist"] = hist
			var avant := _ch.global_transform.basis.z
			avant.y = 0.0
			if vh.length() > 2.0 and avant.length() > 0.1:
				_e["derive"] = maxf(float(_e["derive"]), rad_to_deg(vh.normalized().angle_to(avant.normalized())))
			# volant à fond depuis 1 s, vitesse tenue : l'angle des roues avant suit-il la courbe de GTA V ? (écart médian)
			if _t - float(_e["t0"]) > 1.0:
				var attendu := rad_to_deg(float(_ch.get("braquage_max"))) * red_prec
				var ecarts: Array = _e.get("ecarts", [])
				ecarts.append(absf(_angle_bicyclette() - attendu))
				_e["ecarts"] = ecarts
				_e["roues"] = _angle_bicyclette()
				_e["attendu"] = attendu
				var gl: Array = _e.get("gl", [])
				gl.append(_glissement_avant())
				_e["gl"] = gl
			if _t - float(_e["t0"]) > VIRAGE_BRAQUE:
				_e["phase"] = "apres"
				_e["t0"] = _t
		"apres":
			_pedales()
			if _t - float(_e["t0"]) > VIRAGE_APRES:
				var ecarts: Array = _e.get("ecarts", [0.0])
				ecarts.sort()
				_res[phase] = {"v": float(_e["v_braque"]) * 3.6, "penche": _e["penche"], "up_min": _e["up_min"],
						"leve": _e["leve_max"], "a_lat": _e["a_lat"], "derive": _e["derive"], "up_fin": up,
						"roues": _e.get("roues", 0.0), "attendu": _e.get("attendu", 0.0), "ecart_courbe": ecarts[ecarts.size() / 2],
						"glissement": _moyenne(_e.get("gl", [])), "pic": _pic_avant()}
				return true
	return false


# DÉRAPAGE AU FREIN À MAIN : lancé à la vitesse de la phase, braquage à fond à droite et frein à main (Espace), sans
# gaz, jusqu'à DERAPAGE_LACHE de dérive (DERAPAGE_TIRE s au plus) ; puis LE JOUEUR lâche le frein à main, contre-braque au
# clavier (PiloteClavier : ses touches, avec son temps de réaction) et remet les gaz tant que la voiture glisse, jusqu'à ce
# qu'elle soit droite. Relevés : roues arrière bloquées (part des pas du frein à main où toutes tournent à moins de 15 % de
# la vitesse au sol), dérive (angle entre la vitesse et l'axe de la caisse) au plus fort, cap pris au frein à main, temps
# de la reprise (dérive sous 5° et lacet sous 0,15 rad/s, tenus 0,3 s), appuis de contre-braquage, roulis, roues levées.
func _p_derapage(phase: String) -> bool:
	var cible := float(phase.get_slice("_", phase.get_slice_count("_") - 1)) * KMH
	if cible > _vmax() + 0.5:
		return true
	if not _e.has("phase"):
		_e["phase"] = "ligne"
		_e["penche"] = 0.0
		_e["up_min"] = 1.0
		_e["leve"] = 0.0
		_e["leve_max"] = 0.0
		_e["a_lat"] = 0.0
		_e["derive_max"] = 0.0
		_e["pas_tire"] = 0
		_e["pas_bloquees"] = 0
		_e["t15"] = -1.0
		_e["reprise"] = -1.0
		_e["calme"] = 0.0
		_e["appuis"] = 0
		_e["touche"] = 0
		_placer(DEPART_DERAPAGE, _cap_vers_x(), cible)
		return false
	var up := _ch.global_transform.basis.y.dot(Vector3.UP)
	_e["up_min"] = minf(float(_e["up_min"]), up)
	_e["penche"] = maxf(float(_e["penche"]), _penche())
	var leve := _roues_en_l_air()
	if leve.x + leve.y > 0:
		_e["leve"] = float(_e["leve"]) + get_physics_process_delta_time()
		_e["leve_max"] = maxf(float(_e["leve_max"]), float(_e["leve"]))
	else:
		_e["leve"] = 0.0
	var vh := _ch.linear_velocity
	vh.y = 0.0
	var avant := _ch.global_transform.basis.z
	avant.y = 0.0
	# dérive comptée au-dessus de 3 m/s : presque arrêtée, une voiture qui pivote encore a une vitesse de n'importe quel sens
	var derive := 0.0
	var roule := vh.length() > 3.0
	if roule and avant.length() > 0.1:
		derive = rad_to_deg(vh.normalized().angle_to(avant.normalized()))
	var cap := atan2(avant.x, avant.z)
	var hist: Array = _e.get("hist", [])
	hist.append(vh)
	if hist.size() > 10:
		hist.pop_front()
		var dv: Vector3 = (hist.back() as Vector3) - (hist.front() as Vector3)
		var dir := ((hist.back() as Vector3) + (hist.front() as Vector3)).normalized()
		if _e["phase"] != "ligne":
			_e["a_lat"] = maxf(float(_e["a_lat"]), (dv - dir * dv.dot(dir)).length() / (9.0 / 60.0))
	_e["hist"] = hist
	match String(_e["phase"]):
		"ligne":
			_regule(cible)
			if _t > DERAPAGE_LIGNE:
				_e["phase"] = "tire"
				_e["t0"] = _t
				_e["v0"] = _v()
				_e["cap0"] = cap
		"tire":
			_pedales(false, false, true, false, true)
			_e["derive_max"] = maxf(float(_e["derive_max"]), derive)
			if float(_e["t15"]) < 0.0 and derive >= 15.0:
				_e["t15"] = _t - float(_e["t0"])
			if roule:
				_e["pas_tire"] = int(_e["pas_tire"]) + 1
				# bloquée : la roue tourne à moins de 15 % de la vitesse au sol
				var bloquees := true
				for w in _ch.get("roues"):
					if String(w.name).begins_with("r") and absf(float(w.wv) * float(w.w_size) * float(_ch.get("LengthScale"))) > 0.15 * vh.length():
						bloquees = false
				if bloquees:
					_e["pas_bloquees"] = int(_e["pas_bloquees"]) + 1
			if _trace and Engine.get_physics_frames() % 6 == 0:
				print("BANC_DERAPAGE %s t=%.2f v=%.1f km/h derive=%.1f° lacet=%.2f volant=%.2f frein_main=%.2f roulis=%.1f°" % [
						_id(), _t - float(_e["t0"]), vh.length() * 3.6, derive, _ch.angular_velocity.y, float(_ch.get("steer")),
						float(_ch.get("handbrakepull")), _penche()])
			if derive >= DERAPAGE_LACHE or _t - float(_e["t0"]) >= DERAPAGE_TIRE:
				_e["phase"] = "contre"
				_e["cap_tire"] = rad_to_deg(absf(wrapf(cap - float(_e["cap0"]), -PI, PI)))
				_e["t1"] = _t
		"contre":
			# le joueur : Espace lâché, il contre-braque (ses touches) et remet les gaz tant que la voiture glisse
			var k: int = _pilote.contre_braquer(_ch, _t)
			if k != 0 and k != int(_e["touche"]):
				_e["appuis"] = int(_e["appuis"]) + 1
			_e["touche"] = k
			_pedales(roule and derive > 8.0, false, k > 0, k < 0)
			_e["derive_max"] = maxf(float(_e["derive_max"]), derive)
			if roule and derive < 5.0 and absf(_ch.angular_velocity.y) < 0.15:
				_e["calme"] = float(_e["calme"]) + get_physics_process_delta_time()
				if float(_e["calme"]) >= 0.3 and float(_e["reprise"]) < 0.0:
					_e["reprise"] = _t - float(_e["t1"]) - 0.3
			else:
				_e["calme"] = 0.0
			if _trace and Engine.get_physics_frames() % 6 == 0:
				print("BANC_DERAPAGE %s contre t=%.2f v=%.1f km/h derive=%.1f° lacet=%.2f volant=%.2f touche=%d roulis=%.1f°" % [
						_id(), _t - float(_e["t1"]), vh.length() * 3.6, derive, _ch.angular_velocity.y, float(_ch.get("steer")), k, _penche()])
			if float(_e["reprise"]) >= 0.0 or not roule or _t - float(_e["t1"]) > DERAPAGE_APRES:
				_res[phase] = {"v": float(_e["v0"]) * 3.6, "bloquees": float(_e["pas_bloquees"]) / float(maxi(int(_e["pas_tire"]), 1)),
						"derive_max": _e["derive_max"], "t15": _e["t15"], "cap_tire": _e["cap_tire"],
						"cap_total": rad_to_deg(absf(wrapf(cap - float(_e["cap0"]), -PI, PI))), "reprise": _e["reprise"],
						"arretee": not roule and float(_e["reprise"]) < 0.0, "appuis": _e["appuis"], "v_fin": vh.length() * 3.6,
						"penche": _e["penche"], "up_min": _e["up_min"], "leve": _e["leve_max"], "a_lat": _e["a_lat"], "up_fin": up}
				return true
	return false


func _p_bordure(phase: String) -> bool:
	var cle := phase.substr(8, 2)
	var biais := phase.ends_with("biais")
	var centre: Vector3 = BORDURES[cle][0]
	var corps: StaticBody3D = _bordures[cle]
	var cap := deg_to_rad(30.0) if biais else 0.0
	var avant := Vector3(-sin(cap), 0.0, -cos(cap))
	if not _e.has("depart"):
		var face := Vector3(centre.x, 0.0, centre.z + BORDURE_TAILLE.y * 0.5)
		_e["depart"] = face - avant * 9.0
		_e["contact"] = 0
		_e["garde"] = INF
		_placer(_e["depart"], cap)
		return false
	if _t < 0.5:
		_pedales()
		return false
	_regule(3.0)
	if _contacts(corps):
		_e["contact"] = int(_e["contact"]) + 1
		if _trace:
			_trace_contacts(corps, phase)
	var g := _garde_dessous()
	_e["garde"] = minf(float(_e["garde"]), g)
	var parcours := (_voiture.global_position - (_e["depart"] as Vector3)).dot(avant)
	if parcours < 9.0 + BORDURE_TAILLE.y / cos(cap) + 5.0 and _t < 30.0:
		return false
	_res[phase] = {"contact": _e["contact"], "garde_dessous": _e["garde"], "franchie": parcours >= 9.0 + BORDURE_TAILLE.y / cos(cap) + 5.0}
	return true


func _p_parking(_phase: String) -> bool:
	var hauteur: float = (_voiture.call("boite_caisse") as AABB).size.y - 0.04
	if hauteur > BARRE:
		_res["parking"] = {"trop_haut": hauteur}
		return true
	if not _e.has("k"):
		_e["k"] = 0
		_e["lignes"] = []
		_e["contact"] = 0
		_e["garde"] = INF
		_placer(PARKING_POS + Vector3(0.0, 0.0, 24.0), 0.0)
		return false
	var vitesse := 4.0 if int(_e["k"]) == 0 else 7.0
	var z := _voiture.global_position.z - PARKING_POS.z
	if _t < 0.5:
		_pedales()
		return false
	if z > 1.0:
		_regule(vitesse)
		if _contacts(_parking):
			_e["contact"] = int(_e["contact"]) + 1
		if z < 20.0:
			var g := _garde_dessous()
			_e["garde"] = minf(float(_e["garde"]), g)
			if _trace and (Engine.get_physics_frames() % 6 == 0 or g < 0.1):
				print("BANC_PARKING %s z=%.2f y=%.3f v=%.1f garde=%.3f tangage=%.1f°" % [_id(), z, _voiture.global_position.y, _v(), g,
						rad_to_deg(asin(clampf(_ch.global_transform.basis.z.y, -1.0, 1.0)))])
		return false
	if _v() > 0.3:
		_pedales(false, true)
		return false
	_e["k"] = int(_e["k"]) + 1
	if int(_e["k"]) < 2:
		_placer(PARKING_POS + Vector3(0.0, 0.0, 24.0), 0.0)
		_t = 0.0
		return false
	_res["parking"] = {"contact": _e["contact"], "garde_dessous": _e["garde"]}
	return true


# --- bilan -------------------------------------------------------------------------------------------------------

func _resume() -> void:
	var id := _id()
	var f := _fiche()
	var morceaux: Array[String] = []
	var r: Dictionary = _res.get("repos", {})
	if not r.is_empty():
		morceaux.append("repos : coque à %.3f m du sol, dessous du modèle à %.3f m, pneus à %.3f m" % [r["garde_coque"], r["garde_dessous"], r["pneus"]])
	var a: Dictionary = _res.get("acceleration", {})
	if not a.is_empty():
		morceaux.append("0-50 %s, 0-100 %s, %.0f km/h atteints (%s), rapport affiché %d, patinage au départ %.1f m/s, caisse cabrée de %.1f°" % [
				_temps(a["t50"]), _temps(a["t100"]), a["vmax"], _temps(a["t_vmax"]), a["rapport_max"], a["patinage"], a["cabre"]])
		var cible50 := minf(50.0, FichesVehicules.vitesse_max(f) * 3.6 * 0.9)
		if a["vmax"] < cible50 - 0.1 and (float(a["t50"]) < 0.0 or float(a["t50"]) > 30.0):
			_faute("%s : %.0f km/h pas atteints en 30 s (%.0f au plus)" % [id, cible50, a["vmax"]])
	var fr: Dictionary = _res.get("freinage", {})
	if not fr.is_empty():
		morceaux.append("freinage depuis %.0f km/h : %.1f m en %.2f s, cap %.1f°, caisse plongée de %.1f°" % [fr["v0"], fr["distance"], fr["temps"], fr["cap"], -float(fr["plonge"])])
		if float(fr["cap"]) > 15.0 or float(fr["distance"]) < 0.0:
			_faute("%s : freinage instable (cap %.1f°, distance %.1f m)" % [id, fr["cap"], fr["distance"]])
	var fv: Dictionary = _res.get("frein_virage", {})
	if not fv.is_empty():
		morceaux.append("freinage fort en tournant (volant à %.0f %%, %.0f° aux roues) depuis %.0f km/h : dérive %.1f° au plus, cap pris %.0f°, %.1f m, roulis %.1f°" % [
				float(fv["stick"]) * 100.0, FREIN_VIRAGE_ROUES, fv["v"], fv["derive"], fv["cap"], fv["distance"], fv["penche"]])
		if float(fv["derive"]) > FREIN_VIRAGE_DERIVE:
			_faute("%s : freinage fort en tournant, la voiture part (dérive %.0f°)" % [id, fv["derive"]])
		if float(fv["up_min"]) < cos(deg_to_rad(45.0)):
			_faute("%s : freinage fort en tournant, le véhicule se couche" % id)
	for ph in ["frein_braque_50", "frein_braque_80", "frein_braque_120"]:
		var fb: Dictionary = _res.get(ph, {})
		if fb.is_empty():
			continue
		morceaux.append("%s (S et braquage à fond à %.0f km/h) : trajectoire tournée de %.0f° avant l'arrêt, rayon moyen %.1f m, %.1f m de côté pour %.1f m en avant (%.1f m parcourus, %.2f s), dérive %.0f° au plus, roulis %.1f°, glissement avant %.1f° (pic %.1f°) ; rayon en ralentissant : %s" % [
				ph, fb["v"], fb["tourne"], fb["rayon"], fb["lateral"], fb["avance"], fb["chemin"], fb["temps"], fb["derive"], fb["penche"],
				fb["glissement"], fb["pic"], _texte_paliers(fb["paliers"])])
		if float(fb["lateral"]) < FREIN_BRAQUE_ECART * maxf(float(fb["avance"]), 0.1):
			_faute("%s : %s, la voiture va presque tout droit (%.1f m de côté pour %.1f m en avant)" % [id, ph, fb["lateral"], fb["avance"]])
		if float(fb["derive"]) > FREIN_BRAQUE_DERIVE:
			_faute("%s : %s, tête-à-queue (dérive %.0f°)" % [id, ph, fb["derive"]])
		if float(fb["up_min"]) < cos(deg_to_rad(45.0)):
			_faute("%s : %s, le véhicule se couche" % [id, ph])
		var s_ouvre := _palier_qui_s_ouvre(fb["paliers"])
		if s_ouvre >= 0.0:
			_faute("%s : %s, le virage s'ouvre en ralentissant (à %.0f km/h : %s)" % [id, ph, s_ouvre, _texte_paliers(fb["paliers"])])
	for ph in ["braque_libre_50", "braque_libre_80", "braque_libre_120", "braque_gaz_50", "braque_gaz_80", "braque_gaz_120"]:
		var bq: Dictionary = _res.get(ph, {})
		if bq.is_empty():
			continue
		morceaux.append("%s (lancé à %.0f km/h, %.0f km/h entre 0,4 et 0,9 s) : rayon %.1f m, %.1f m/s² (%.0f %% de l'adhérence avant), glissement avant %.1f° (pic %.1f°), patinage %.1f m/s ; %.0f° tournés en %.1f s, %.0f km/h au bout ; roulis %.1f°%s" % [
				ph, bq["v"], bq["v_fen"], bq["rayon"], bq["a_lat"], 100.0 * float(bq["a_lat"]) / maxf(float(bq["adherence"]), 0.1),
				bq["glissement"], bq["pic"], bq["patin"], bq["tourne"], bq["temps"], bq["v_fin"], bq["penche"],
				"" if (bq["paliers"] as Dictionary).is_empty() else " ; rayon en ralentissant : " + _texte_paliers(bq["paliers"])])
		if float(bq["up_min"]) < cos(deg_to_rad(45.0)):
			_faute("%s : %s, le véhicule se couche" % [id, ph])
		var ouvre := _palier_qui_s_ouvre(bq["paliers"])
		if ouvre >= 0.0:
			_faute("%s : %s, le virage s'ouvre en ralentissant (à %.0f km/h : %s)" % [id, ph, ouvre, _texte_paliers(bq["paliers"])])
	# REMETTRE LES GAZ EN TOURNANT NE FAIT PAS TOUT DROIT (2026-09-25) : quand les roues avant poussent le plus
	# (fDriveBiasFront au-dessus de 0,5), elles peuvent patiner et perdre de leur tenue en travers ; les gaz doivent garder au
	# moins GAZ_TENUE de l'accélération latérale de la roue libre, lancée à la même vitesse.
	if FichesVehicules.nombre(f, "fDriveBiasFront") > 0.5:
		for v in ["50", "80", "120"]:
			var gz: Dictionary = _res.get("braque_gaz_" + v, {})
			var lb: Dictionary = _res.get("braque_libre_" + v, {})
			if gz.is_empty() or lb.is_empty():
				continue
			if float(gz["a_lat"]) < GAZ_TENUE * float(lb["a_lat"]):
				_faute("%s : braqué à fond à %s km/h, les gaz font aller tout droit (%.1f m/s² sous les gaz pour %.1f en roue libre)" % [id, v, gz["a_lat"], lb["a_lat"]])
	for ph in ["virage_50", "virage_80", "virage_110", "virage_vmax"]:
		var v: Dictionary = _res.get(ph, {})
		if v.is_empty():
			continue
		morceaux.append("%s (%.0f km/h) : %.1f° de roulis, %.1f m/s², dérive %.0f°, roues levées %.2f s, caisse %.0f° au pire ; roues avant à %.2f° pour %.2f° selon la courbe de GTA V (écart médian %.2f°), glissement avant %.1f° (pic %.1f°)" % [
				ph, v["v"], _roulis(v), v["a_lat"], v["derive"], v["leve"], rad_to_deg(acos(clampf(v["up_min"], -1.0, 1.0))),
				v["roues"], v["attendu"], v["ecart_courbe"], v["glissement"], v["pic"]])
		if float(v["up_min"]) < cos(deg_to_rad(45.0)) or float(v["up_fin"]) < 0.9:
			_faute("%s : %s, le véhicule se couche (caisse à %.0f°)" % [id, ph, rad_to_deg(acos(clampf(v["up_min"], -1.0, 1.0)))])
		if float(v["leve"]) > 0.3:
			_faute("%s : %s, deux roues d'un même côté en l'air %.2f s" % [id, ph, v["leve"]])
		if float(v["ecart_courbe"]) > COURBE_TOLERANCE:
			_faute("%s : %s, les roues avant ne suivent pas la courbe de GTA V (%.2f° pour %.2f°)" % [id, ph, v["roues"], v["attendu"]])
	var fm: Dictionary = _res.get("frein_main", {})
	if not fm.is_empty():
		# plus fort que ses pneus arrière (le châssis le dit, sur les valeurs EFFECTIVES : la fiche x les multiplicateurs
		# globaux de reglages_conduite.tres), il doit les bloquer
		var bloque := bool(fm.get("bloque_attendu", false))
		morceaux.append("frein à main seul depuis %.0f km/h : %.1f m/s² (fiche, multiplicateur compris : %.1f ; %s), roues arrière bloquées %.0f %% du temps, cap %.1f°" % [
				fm["v0"], fm["decel"], FichesVehicules.frein_main_ms2(f), "plus fort que les pneus arrière" if bloque else "sous ce que tiennent les pneus arrière",
				float(fm["bloquees"]) * 100.0, fm["cap"]])
		var fp: Dictionary = _res.get("frein_main_pied", {})
		if not fp.is_empty():
			morceaux.append("avec le frein au pied : %.1f m/s², roues arrière bloquées %.0f %% du temps, cap %.1f°" % [fp["decel"], float(fp["bloquees"]) * 100.0, fp["cap"]])
		# plus fort que ses pneus arrière, il les bloque : seul, et avec le frein au pied (l'ABS ne desserre que celui-ci)
		for essai: Dictionary in [fm, fp]:
			if bloque and not essai.is_empty() and float(essai["bloquees"]) < 0.8:
				_faute("%s : frein à main plus fort que les pneus arrière, roues arrière bloquées %.0f %% du temps seulement" % [id, float(essai["bloquees"]) * 100.0])
			if not essai.is_empty() and float(essai["cap"]) > 5.0:
				_faute("%s : frein à main en ligne droite, la voiture tourne de %.1f°" % [id, essai["cap"]])
	for ph in _res.keys():
		if not String(ph).begins_with("derapage_"):
			continue
		var dr: Dictionary = _res[ph]
		morceaux.append("%s (%.0f km/h) : roues arrière bloquées %.0f %% du temps, dérive %.0f° au plus (15° en %s), cap pris %.0f° au frein à main ; le joueur contre-braque (%d appuis) : droite en %s, cap total %.0f°, %.0f km/h au bout ; roulis %.1f°, roues levées %.2f s, %.1f m/s²" % [
				ph, dr["v"], float(dr["bloquees"]) * 100.0, dr["derive_max"], _temps(dr["t15"]), dr["cap_tire"], dr["appuis"],
				_temps(dr["reprise"]), dr["cap_total"], dr["v_fin"], dr["penche"], dr["leve"], dr["a_lat"]])
		if float(dr["up_min"]) < cos(deg_to_rad(45.0)) or float(dr["up_fin"]) < 0.9:
			_faute("%s : %s, le véhicule se couche (caisse à %.0f°)" % [id, ph, rad_to_deg(acos(clampf(dr["up_min"], -1.0, 1.0)))])
		if float(dr["leve"]) > 0.3:
			_faute("%s : %s, deux roues d'un même côté en l'air %.2f s" % [id, ph, dr["leve"]])
		if bool(dr["arretee"]):
			_faute("%s : %s, le joueur ne la rattrape pas : arrêtée en travers" % [id, ph])
		elif float(dr["reprise"]) < 0.0:
			_faute("%s : %s, le joueur ne la rattrape pas en %.0f s" % [id, ph, DERAPAGE_APRES])
	for ph in ["bordure_15_face", "bordure_15_biais", "bordure_17_face", "bordure_17_biais"]:
		var b: Dictionary = _res.get(ph, {})
		if b.is_empty():
			continue
		morceaux.append("%s : coque %d pas, dessous du modèle %.3f m%s" % [ph, b["contact"], b["garde_dessous"], "" if b["franchie"] else ", PAS FRANCHIE"])
		if int(b["contact"]) > 0:
			_faute("%s : %s, la coque touche (%d pas)" % [id, ph, b["contact"]])
		if not bool(b["franchie"]):
			_faute("%s : %s pas franchie" % [id, ph])
	var p: Dictionary = _res.get("parking", {})
	if p.has("trop_haut"):
		morceaux.append("parking : %.2f m de haut, arrêté par la barre" % p["trop_haut"])
	elif not p.is_empty():
		morceaux.append("entrée de parking : coque %d pas, dessous du modèle %.3f m" % [p["contact"], p["garde_dessous"]])
		if int(p["contact"]) > 0:
			_faute("%s : entrée de parking, la coque touche (%d pas)" % [id, p["contact"]])
	print("CHASSIS_BANC %s (%s kg, poussée %s, %s km/h, traction %s) : %s" % [id, FichesVehicules.nombre(f, "fMass"),
			FichesVehicules.nombre(f, "fInitialDriveForce"), FichesVehicules.nombre(f, "fInitialDriveMaxFlatVel"),
			FichesVehicules.nombre(f, "fTractionCurveMax"), " ; ".join(morceaux)])
	_tableau.append(JSON.stringify({"id": id, "res": _res}))
	_tous[id] = _res


func _compare_derapages() -> void:
	if not (_tous.has(SPORTIVE) and _tous.has(CAMION)):
		return
	for ph in ["derapage_50", "derapage_80", "derapage_110"]:
		var s: Dictionary = (_tous[SPORTIVE] as Dictionary).get(ph, {})
		var c: Dictionary = (_tous[CAMION] as Dictionary).get(ph, {})
		if s.is_empty() or c.is_empty():
			continue
		print("CHASSIS_BANC_COMPARAISON %s : dérive %s %.0f°, %s %.0f°" % [ph, SPORTIVE, s["derive_max"], CAMION, c["derive_max"]])
		if float(s["derive_max"]) < DERAPAGE_RAPPORT * float(c["derive_max"]):
			_faute("%s : la sportive (%.0f°) ne dérape pas %.0f fois plus que le camion (%.0f°)" % [ph, s["derive_max"], DERAPAGE_RAPPORT, c["derive_max"]])


func _roulis(v: Dictionary) -> float:
	return float(v["penche"])


func _temps(t) -> String:
	return "%.1f s" % float(t) if float(t) >= 0.0 else "—"


func _fin() -> void:
	_pedales()
	_compare_derapages()
	for l in _tableau:
		print("CHASSIS_BANC_JSON " + l)
	print("CHASSIS_BANC_RESULT %s" % ("OK" if _fautes.is_empty() else "FAIL : " + " ; ".join(_fautes)))
	get_tree().quit()
