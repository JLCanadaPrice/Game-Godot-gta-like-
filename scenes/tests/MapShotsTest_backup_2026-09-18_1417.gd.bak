	# tournées vers la partie étroite du biseau. Coordonnées relevées sur le trajet des rubans (RampPoints).
	["bretelle_insertion_no_sol", Vector3(-903.3, 8.4, -715.7), Vector3(-938.3, 8.6, -711.3)],
