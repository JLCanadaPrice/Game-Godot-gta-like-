	["quartier_willow_lake_survol", Vector3(-1350, 110, 60), Vector3(-1600, 0, -250)],
	["quartier_eastgate_rue", Vector3(1098.6, 1.7, 338.0), Vector3(1104.4, 1.5, 238.2), "sol"],
