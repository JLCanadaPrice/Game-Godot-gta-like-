extends Node3D

# PARKING À ÉTAGES (Business_ParkingStructure) : ce qui le rend praticable, vérifié sur les exemplaires CUITS.
#
#  1. COLLISION PAR DALLE : sur chaque plateau de chaque exemplaire, un piéton (la capsule du joueur, rayon 0,4 m,
#     hauteur 1,8 m) et une voiture (Car.tscn, laissée là) lâchés à 1 m au-dessus du plancher s'y posent et y
#     restent. Avec l'ancienne boîte pleine, ils se posaient sur le TOIT de la boîte, 18 m plus haut.
#
#     Les quatre exemplaires : les trois du centre-ville et celui de l'aéroport (PlacesBake._parking_etages).
#  1b. EMPRISE DE L'AÉROPORT : aucun point d'une chaussée (RoadNetwork), aucun noeud ni arête du graphe de
#     circulation, aucun noeud du PedGraph ni du Circuit sous le parking de l'aéroport (emprise + 0,5 m).
#  2. RAYON DE BRAQUAGE DU JOUEUR, PAR MODÈLE, mesuré sur le vrai Car._drive_physics (arc parcouru / lacet), braquage
#     à fond, pour une berline, un camion et le bus, à 3, 8 et 16 m/s : il suit l'empattement mesuré de chaque modèle
#     (Car.rayon_braquage, modèle bicyclette) — 4,1 m pour la berline à 3 m/s, plus de 9 m pour le camion et le bus —,
#     et à vitesse l'accélération latérale reste à BRAQUAGE_A_LAT pour tous. Il valait 10 m à toute vitesse et pour
#     tous les modèles, puis 5,5 m à basse vitesse pour tous (2026-09-21).
#  3. RAMPE À 12 % : la voiture du joueur monte une vraie pente continue de 12 % (plat, pente, plat, sans ressaut aux
#     raccords), arrive en haut, puis redescend en marche arrière. À mi-pente, son modèle a l'assiette de la pente
#     (nez levé en montée) et ses roues touchent la pente : écart entre le bas de chaque roue et la pente sous 8 cm.
#     La boîte de collision restant horizontale, l'essieu arrière flottait avant à 0,27 m.
#  4. ESCALIER : dans chacun des quatre parkings, un piéton monte du rez au TOIT par l'escalier de la tour vitrée
#     (porte du rez, puis à chaque étage volée A, palier, volée B, arrivée ; porte du toit) et finit posé sur le toit.
#     À l'aéroport, c'est le VRAI joueur (Player.tscn), piloté comme au clavier (move_forward, corps tourné vers le
#     repère suivant) ; ailleurs, sa capsule.
#  4b. GARDE-CORPS, PIÉTON ET VOITURE : un piéton (capsule du joueur) et une voiture poussés à 3 et 4 m/s contre
#     chaque garde-corps — bord est de chaque trémie d'escalier, couloir de la volée A au toit, les DEUX parapets de
#     chaque rampe, les deux bords de chaque trémie de rampe, et le bout ouest de la trémie du toit. Aucun ne passe
#     par-dessus ni ne tombe : chacun reste du bon côté et debout sur son plancher.
#  4b bis. ÉCLAIRAGE INTÉRIEUR (2026-09-22) : les quatre parkings portent un maillage de lumières, TOUS sur le MÊME
#     matériau (sinon le moteur ne les regroupe plus) ; chaque niveau couvert a des luminaires ; et sous chaque
#     luminaire de la partie roulante il reste au moins 2,90 m de dégagement — un véhicule qui passe la barre de
#     2,15 m ne doit jamais pouvoir taper dedans. C'est exactement la faute déjà payée avec les boîtiers du modèle,
#     qui pendaient 20 cm au-dessus du tablier de la rampe.
#  4b ter. PLACES MARQUÉES (2026-09-22) : les 10 places de chaque niveau doivent être PLATES (le tablier sous les
#     quatre coins de la voiture, au niveau du plancher) et DÉGAGÉES sur 2 m de haut — un poteau, un bandeau de
#     plafonnier ou un bout de rampe dans une place, et la voiture cuite se retrouve encastrée. Et chaque fiche de
#     véhicule garé doit tomber sur une place de parking.
#  4c. BARRE DE HAUTEUR : à l'entrée de l'aéroport, un camion (2,79 m de caisse) et une berline (1,45 m) lancés à
#     4 m/s vers le passage. Le camion est arrêté DEHORS par le portique, la berline entre.
#  5. RAMPES INTÉRIEURES (2026-09-22) : la voiture du joueur, conduite comme au clavier (move_forward / move_left /
#     move_right, poursuite d'un tracé), monte du rez AU TOIT par les quatre rampes empilées — demi-tour de 4,70 m de
#     rayon à chaque bout, allée de retour côté façade —, puis redescend jusqu'au rez. Pente relevée sur la COLLISION
#     (rayons tous les 0,25 m sur l'axe et les deux bords de chaque rampe) : 16 % au plus, aucun ressaut de plus de
#     2 cm. C'est le VRAI joueur de l'escalier qui monte dans la voiture (Player._enter_vehicle) et qui en SORT sur le
#     toit puis au rez (Player._exit_vehicle) : il doit s'y retrouver debout, pied à 10 cm du plancher au plus. Il
#     était posé à y = 1,3 fixe, donc sous le sol partout où la carte est plus haute.
#
# Les plateaux sont relevés sur le maillage cuit (ParkingStructureKit.planchers), pas recopiés d'une constante.
#
# Lancer : Godot --headless --path <projet> res://scenes/tests/ParkingStructureTest.tscn

const Kit := preload("res://scenes/world/map/tools/ParkingStructureKit.gd")
const CENTRE_VILLE := "res://scenes/world/downtown/generated/Buildings.tscn"
const LIEUX := "res://scenes/world/map/generated/Places.tscn"
const MONDE := "res://scenes/world/World.tscn"
const Network := preload("res://scenes/world/map/tools/RoadNetwork.gd")
const JOUEUR := preload("res://scenes/player/Player.tscn")
const CAR := preload("res://scenes/vehicles/Car.tscn")
const BERLINE := "res://assets/vehicle_models_extra/city_vehicles_UNVERIFIED_LICENSE/Sedans/Veh_Sedan_01_Blue.glb"
const CATALOGUE := "res://resources/vehicle_models"
# véhicules lourds mesurés en plus de la berline : [modèle du catalogue, position de départ sur le sol témoin]
const LOURDS := [["city_truck_01", Vector3(-40.0, 1.0, 45.0)], ["city_bus_01", Vector3(55.0, 1.0, 45.0)]]
const GRAVITE := 9.8
const DUREE := 2.0
# Points de lâcher, repère du modèle : le long de la façade, sur les places, hors de la bande de rampe (z -7,45..-3,65),
# des poteaux du milieu (z ±0,54), de la cage d'escalier (x ±5,52, z > 7,48) ET de l'allée que la voiture parcourt
# (z 3,85) — deux voitures lâchées dessus, et le pilote reste coincé derrière.
const PIETON := Vector3(-12.0, 0.0, 8.0)
const VOITURE := Vector3(12.0, 0.0, 8.0)

var _fautes: Array[String] = []
var _pietons: Array = []     # [CharacterBody3D, altitude attendue du pied, libellé]
var _voitures: Array = []    # [Car, plancher, libellé]
var _t := 0.0
var _repos_voiture := 0.0    # hauteur de l'origine d'une voiture posée sur un sol plat (relevée sur le sol témoin)
var _temoin: Node3D
var _phase := "dalles"
var _pilote: Node3D          # voiture conduite par le « joueur » (start_drive), sur le sol témoin
var _vitesses := [3.0, 8.0, 16.0]
var _k_vitesse := 0
var _t_phase := 0.0
var _arc := 0.0
var _lacet := 0.0
var _prec := Vector3.ZERO
var _prec_lacet := 0.0
var _rayons := []
var _braqueurs: Array = []   # [voiture, libellé, arc, lacet, position et lacet précédents]
var _rampe_mi := {}          # relevé à mi-pente
var _rampe_haut := -1.0      # temps d'arrivée en haut
var _rampe_bas := -1.0       # temps de retour en bas
var _rampe_y_max := -INF
var _parkings: Array = []    # [noeud porteur de la transformation, maillage, planchers]
var _aeroport: MeshInstance3D
var _grimpeurs: Array = []   # [corps, repères (monde), indice, plancher d'arrivée (monde), libellé, vrai joueur ?]
var _t_escalier := 0.0
var _trace: PackedVector3Array
var _k_trace := 0
var _sens := "montee"
var _t_rampe_int := 0.0
var _rampe_int_bilan := {}
var _immobile := 0.0
var _joueur: CharacterBody3D  # le vrai joueur (Player.tscn), celui de l'escalier de l'aéroport
var _t_sortie := 0.0
const TEMOIN_Z := 3000.0
const RAMPE_X := 30.0
const PENTE := 0.12
const RAMPE_LONG := 20.0


func _ready() -> void:
	# sol témoin : une dalle plate à y = 0, loin de tout, pour relever la hauteur de repos d'une voiture
	var sol := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	var boite := BoxShape3D.new()
	boite.size = Vector3(140, 1, 140)
	cs.shape = boite
	cs.position.y = -0.5
	sol.add_child(cs)
	sol.position = Vector3(0, 0, TEMOIN_Z)
	add_child(sol)
	_temoin = _voiture(Vector3(-30, 1.0, TEMOIN_Z), "temoin")
	_rampe()
	_pilote = CAR.instantiate() as Node3D
	_pilote.set("forced_model_path", BERLINE)
	_pilote.name = "Pilote"
	add_child(_pilote)
	_pilote.global_position = Vector3(0, 1.0, TEMOIN_Z + 30.0)
	_braqueurs.append([_pilote, "berline city_sedan_01", 0.0, 0.0, Vector3.ZERO, 0.0])
	for l: Array in LOURDS:
		var data = load(CATALOGUE.path_join(String(l[0]) + ".tres"))
		var lourd := CAR.instantiate() as Node3D
		lourd.set("forced_model_path", String(data.model_paths[0]))
		lourd.name = "Braqueur_" + String(l[0])
		add_child(lourd)
		lourd.global_position = (l[1] as Vector3) + Vector3(0, 0, TEMOIN_Z)
		_braqueurs.append([lourd, String(l[0]), 0.0, 0.0, Vector3.ZERO, 0.0])
	var ville: Node3D = (load(CENTRE_VILLE) as PackedScene).instantiate()
	add_child(ville)
	var parkings: Array = []    # [noeud porteur de la transformation, maillage]
	for b in ville.get_children():
		if String(b.get_meta("model", "")) == Kit.CLE:
			parkings.append([b, (b.get_node("Mesh") as MeshInstance3D).mesh])
			var cs2 := b.get_node_or_null("StaticBody3D/CollisionShape3D") as CollisionShape3D
			if cs2 == null or not (cs2.shape is ConcavePolygonShape3D):
				_fautes.append("%s : collision %s, pas les triangles du modele" % [b.name, "absente" if cs2 == null else cs2.shape.get_class()])
	if parkings.size() != 3:
		_fautes.append("%d parking(s) a etages au centre-ville au lieu de 3" % parkings.size())
	var lieux: Node3D = (load(LIEUX) as PackedScene).instantiate()
	add_child(lieux)
	var aeroport: MeshInstance3D = null
	for mi_n in lieux.find_children(Kit.MODELE + "_*", "MeshInstance3D", true, false):
		aeroport = mi_n
	if aeroport == null:
		_fautes.append("parking a etages de l'aeroport absent de Places.tscn")
	else:
		parkings.append([aeroport, aeroport.mesh])
		_emprise_aeroport(aeroport)
	_aeroport = aeroport
	for e: Array in parkings:
		var b: Node3D = e[0]
		var planchers := Kit.planchers(e[1])
		_parkings.append([b, e[1], planchers])
		print("PARKING %s en %s : planchers %s" % [b.name, str(b.global_position.snapped(Vector3.ONE * 0.01)), str(planchers)])
		if planchers.size() != 5:
			_fautes.append("%s : %d plateaux releves au lieu de 5" % [b.name, planchers.size()])
		for k in planchers.size():
			var y: float = planchers[k]
			var p := b.global_transform * (PIETON + Vector3(0, y + 1.0, 0))
			_pietons.append([_pieton(p), (b.global_transform * Vector3(0, y, 0)).y, "%s niveau %d" % [b.name, k]])
			var c := b.global_transform * (VOITURE + Vector3(0, y + 1.0, 0))
			_voitures.append([_voiture(c, "%s niveau %d" % [b.name, k]), (b.global_transform * Vector3(0, y, 0)).y, "%s niveau %d" % [b.name, k]])


# Rien sous le parking de l'aéroport : ni chaussée, ni noeud ou arête du graphe de circulation, ni noeud piéton.
func _emprise_aeroport(mi: MeshInstance3D) -> void:
	var boite := mi.get_aabb()
	var coins: Array[Vector2] = []
	for k in 8:
		var q := mi.global_transform * boite.get_endpoint(k)
		coins.append(Vector2(q.x, q.z))
	var r := Rect2(coins[0], Vector2.ZERO)
	for c in coins:
		r = r.expand(c)
	r = r.grow(0.5)
	var net := Network.new()
	net.build()
	var sous_route := 0
	for rb in net.ribbons:
		if rb.kind in ["median", "rail"]:
			continue
		for q: Vector3 in rb.points:
			if r.has_point(Vector2(q.x, q.z)):
				sous_route += 1
	var noeuds := 0
	for q: Vector3 in net.g_nodes:
		if r.has_point(Vector2(q.x, q.z)):
			noeuds += 1
	var aretes := 0
	for e: Dictionary in net.g_edges:
		for q: Vector3 in e["points"]:
			if r.has_point(Vector2(q.x, q.z)):
				aretes += 1
				break
	var monde: Node = (load(MONDE) as PackedScene).instantiate()
	var pietons := 0
	var circuit := 0
	for nom_graphe in ["PedGraph", "Circuit"]:
		var g := monde.get_node_or_null(nom_graphe)
		if g == null:
			continue
		for q: Vector3 in g.get("nodes"):
			if r.has_point(Vector2(q.x, q.z)):
				if nom_graphe == "PedGraph":
					pietons += 1
				else:
					circuit += 1
	monde.free()
	print("PARKING_AEROPORT emprise x %.1f..%.1f z %.1f..%.1f : %d point(s) de chaussee, %d noeud(s) et %d arete(s) du graphe de circulation, %d noeud(s) pietons, %d du Circuit"
			% [r.position.x, r.end.x, r.position.y, r.end.y, sous_route, noeuds, aretes, pietons, circuit])
	if sous_route + noeuds + aretes + pietons + circuit > 0:
		_fautes.append("parking de l'aeroport sur une chaussee ou un graphe (%d + %d + %d + %d + %d)" % [sous_route, noeuds, aretes, pietons, circuit])


func _pieton(p: Vector3) -> CharacterBody3D:
	var corps := CharacterBody3D.new()
	var cs := CollisionShape3D.new()
	var capsule := CapsuleShape3D.new()
	capsule.radius = 0.4
	capsule.height = 1.8
	cs.shape = capsule
	corps.add_child(cs)
	corps.floor_snap_length = 0.4
	add_child(corps)
	corps.global_position = p
	return corps


func _voiture(p: Vector3, nom: String) -> Node3D:
	var car := CAR.instantiate() as Node3D
	car.set("forced_model_path", BERLINE)
	car.name = "Voiture_" + nom.validate_node_name()
	add_child(car)
	car.global_position = p
	car.call("park")
	return car


# Rampe témoin, d'un seul tenant (triangles jointifs) : plat de 10 m, pente de 12 % sur 20 m, plat de 10 m en haut.
# La voiture monte vers -z (son avant).
func _rampe() -> void:
	var y1 := PENTE * RAMPE_LONG
	var z0 := TEMOIN_Z
	var prof := [[z0 + 10.0, 0.001], [z0, 0.001], [z0 - RAMPE_LONG, y1], [z0 - RAMPE_LONG - 10.0, y1]]
	var faces := PackedVector3Array()
	for k in prof.size() - 1:
		var a: Array = prof[k]
		var b: Array = prof[k + 1]
		var p0 := Vector3(RAMPE_X - 5.0, a[1], a[0])
		var p1 := Vector3(RAMPE_X + 5.0, a[1], a[0])
		var p2 := Vector3(RAMPE_X + 5.0, b[1], b[0])
		var p3 := Vector3(RAMPE_X - 5.0, b[1], b[0])
		faces.append_array(PackedVector3Array([p0, p1, p2, p0, p2, p3]))
	var forme := ConcavePolygonShape3D.new()
	forme.set_faces(faces)
	forme.backface_collision = true
	var corps := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	cs.shape = forme
	corps.add_child(cs)
	add_child(corps)


func _hauteur_rampe(z: float) -> float:
	return clampf((TEMOIN_Z - z) * PENTE, 0.0, PENTE * RAMPE_LONG)


func _physics_process(delta: float) -> void:
	_t += delta
	match _phase:
		"dalles":
			for e: Array in _pietons:
				var corps: CharacterBody3D = e[0]
				corps.velocity.y = 0.0 if corps.is_on_floor() else corps.velocity.y - GRAVITE * delta
				corps.move_and_slide()
			if _t >= DUREE:
				_bilan_dalles()
				for b: Array in _braqueurs:
					(b[0] as Node).call("start_drive")
				_lumieres()
				_places()
				_phase = "braquage"
				_t_phase = 0.0
		"braquage":
			_braquage(delta)
		"rampe":
			_montee(delta)
		"escalier":
			_escalier(delta)
		"garde_corps":
			_garde_corps(delta)
		"barre":
			_barre(delta)
		"rampe_int":
			_rampe_int(delta)
		"sortie":
			_sortie(delta)


func _braquage(delta: float) -> void:
	var v: float = _vitesses[_k_vitesse]
	Input.action_press("move_left")
	_t_phase += delta
	for b: Array in _braqueurs:
		var car: Node3D = b[0]
		car.set("_drive_speed", v)
		var p := car.global_position
		var lacet := car.global_rotation.y
		if _t_phase > 0.5:
			b[2] = float(b[2]) + Vector2(p.x - (b[4] as Vector3).x, p.z - (b[4] as Vector3).z).length()
			b[3] = float(b[3]) + absf(wrapf(lacet - float(b[5]), -PI, PI))
		b[4] = p
		b[5] = lacet
	if _t_phase >= 1.5:
		for b: Array in _braqueurs:
			var car: Node3D = b[0]
			_rayons.append([b[1], v, float(b[2]) / maxf(float(b[3]), 0.0001), float(car.call("rayon_braquage", v)),
					float(car.get("_empattement"))])
			b[2] = 0.0
			b[3] = 0.0
		_t_phase = 0.0
		_k_vitesse += 1
		if _k_vitesse >= _vitesses.size():
			Input.action_release("move_left")
			for b: Array in _braqueurs.slice(1):
				(b[0] as Node).queue_free()
			_braqueurs = _braqueurs.slice(0, 1)
			_phase = "rampe"
			_pilote.set("_drive_speed", 0.0)
			_pilote.global_position = Vector3(RAMPE_X, 1.0, TEMOIN_Z + 8.0)
			_pilote.global_rotation = Vector3.ZERO
			_pilote.set("velocity", Vector3.ZERO)


func _montee(delta: float) -> void:
	_t_phase += delta
	var p := _pilote.global_position
	_rampe_y_max = maxf(_rampe_y_max, p.y)
	if _rampe_haut < 0.0:
		_pilote.set("_drive_speed", 4.0)
		if _rampe_mi.is_empty() and p.z < TEMOIN_Z - RAMPE_LONG * 0.5 and p.z > TEMOIN_Z - RAMPE_LONG * 0.5 - 1.0 and _t_phase > 1.0:
			_rampe_mi = _releve_roues()
		if p.z < TEMOIN_Z - RAMPE_LONG - 4.0:
			_rampe_haut = _t_phase
	else:
		_pilote.set("_drive_speed", -3.0)
		if p.z > TEMOIN_Z + 3.0:
			_rampe_bas = _t_phase
	if _rampe_bas > 0.0 or _t_phase > 30.0:
		_pilote.set("_drive_speed", 0.0)
		_debut_escalier()


# --- 4. escalier ----------------------------------------------------------------------------------------------------

# Repères de la montée, dans le repère du modèle (cf. ParkingStructureKit, constantes ESC_*) : devant la porte côté
# parking, zone de départ ; puis, à chaque étage, pied de la volée A, haut de la volée A, palier, haut de la volée B,
# arrivée ; au toit, la porte de la cage. Sur le palier, on passe d'une volée à l'autre au bout du mur d'échiffre, pas en
# diagonale à travers lui.
func _reperes_escalier(sols: PackedFloat32Array) -> Array:
	var y0: float = sols[0]
	var out: Array = [Vector3(-4.86, y0, 6.2), Vector3(-4.86, y0, 8.1), Vector3(-4.3, y0, 8.1)]
	for k in sols.size() - 1:
		var ya := (float(sols[k]) + float(sols[k + 1])) * 0.5
		var y1: float = sols[k + 1]
		out.append_array([Vector3(-1.1, ya, 8.1), Vector3(0.0, ya, 8.1), Vector3(0.0, ya, 9.25), Vector3(-1.1, ya, 9.25),
				Vector3(-4.95, y1, 9.25), Vector3(-4.95, y1, 8.1)])
		if k < sols.size() - 2:
			out.append(Vector3(-4.3, y1, 8.1))
	out.append(Vector3(-4.86, float(sols[sols.size() - 1]), 6.2))
	return out


func _debut_escalier() -> void:
	_phase = "escalier"
	_t_escalier = 0.0
	for e: Array in _parkings:
		var b: Node3D = e[0]
		var sols: PackedFloat32Array = e[2]
		var reperes: Array = []
		for r: Vector3 in _reperes_escalier(sols):
			reperes.append(b.global_transform * r)
		var depart: Vector3 = reperes[0] + Vector3(0, 1.0, 0)
		var vrai := b == _aeroport
		var corps: CharacterBody3D
		if vrai:
			corps = JOUEUR.instantiate() as CharacterBody3D
			add_child(corps)
			corps.global_position = depart
			_joueur = corps
		else:
			corps = _pieton(depart)
		_grimpeurs.append([corps, reperes, 1, (b.global_transform * Vector3(0, sols[sols.size() - 1], 0)).y, String(b.name), vrai])


func _escalier(delta: float) -> void:
	_t_escalier += delta
	var fini := true
	var avance_joueur := false
	for g: Array in _grimpeurs:
		var corps: CharacterBody3D = g[0]
		var reperes: Array = g[1]
		var k: int = g[2]
		if k >= reperes.size():
			if not g[5]:
				corps.velocity = Vector3(0, corps.velocity.y - GRAVITE * delta, 0) if not corps.is_on_floor() else Vector3.ZERO
				corps.move_and_slide()
			continue
		fini = false
		var cible: Vector3 = reperes[k]
		var d := Vector3(cible.x - corps.global_position.x, 0, cible.z - corps.global_position.z)
		if d.length() < 0.3:
			g[2] = k + 1
			continue
		if g[5]:
			# vrai joueur : corps tourné vers le repère, touche « avancer » (Player.gd marche selon l'orientation du corps)
			corps.global_rotation.y = atan2(-d.x, -d.z)
			avance_joueur = true
		else:
			var v := d.normalized() * 2.5
			corps.velocity.x = v.x
			corps.velocity.z = v.z
			corps.velocity.y = 0.0 if corps.is_on_floor() else corps.velocity.y - GRAVITE * delta
			corps.move_and_slide()
	if avance_joueur:
		Input.action_press("move_forward")
	else:
		Input.action_release("move_forward")
	if fini and _t_escalier > 1.0 or _t_escalier > 150.0:
		Input.action_release("move_forward")
		for g: Array in _grimpeurs:
			var corps: CharacterBody3D = g[0]
			var pied := corps.global_position.y - 0.9
			var arrive: bool = int(g[2]) >= (g[1] as Array).size()
			print("PARKING_ESCALIER %s : %s, pied a %.2f m pour le toit a %.2f (%s) en %.1f s"
					% [g[4], "vrai joueur" if g[5] else "capsule", pied, g[3], "arrive" if arrive else "BLOQUE au repere %d/%d" % [g[2], (g[1] as Array).size()], _t_escalier])
			if not arrive or absf(pied - float(g[3])) > 0.1:
				_fautes.append("escalier de %s : %s au repere %d, pied a %.2f pour %.2f" % [g[4], "vrai joueur" if g[5] else "pieton", g[2], pied, g[3]])
		_debut_garde_corps()


# --- 4b. garde-corps de l'escalier -----------------------------------------------------------------------------------

var _pousses: Array = []     # [capsule, parking, repère local de départ, direction locale, limite locale, plancher, libellé]
var _t_pousse := 0.0


func _debut_garde_corps() -> void:
	_phase = "garde_corps"
	_t_pousse = 0.0
	var zr: float = Kit.RAMPE_Z
	var bord: float = Kit.RAMPE_DEMI - Kit.RAMPE_GC          # face intérieure d'un parapet de rampe
	var bord_tremie: float = Kit.RAMPE_DEMI + Kit.RAMPE_JEU  # bord de la trémie, garde-corps juste derrière
	for e: Array in _parkings:
		var b: Node3D = e[0]
		var sols: PackedFloat32Array = e[2]
		for k in range(1, sols.size()):
			var y: float = sols[k]
			# ESCALIER, bord est de la trémie : garde-corps en x 0,64..0,70 ; le piéton part de x 1,3 vers -x
			_pousse(b, Vector3(1.3, y, 8.7), Vector3(-1, 0, 0), 0.70, y, "%s, bord est de la tremie d'escalier au niveau %d" % [b.name, k], false)
			# RAMPE, garde-corps au ras du plancher, de part et d'autre de la trémie : piéton ET voiture
			for sz: float in [-1.0, 1.0]:
				# le piéton part à 1,2 m du garde-corps, la voiture à 3 m : elle fait 4,2 m de long et naîtrait à
				# cheval dessus, ce qui la faisait ressortir SUR le garde-corps d'en face (payé le 2026-09-22)
				_pousse(b, Vector3(6.0, y, zr + sz * (bord_tremie + Kit.RAMPE_GC + 1.2)), Vector3(0, 0, -sz),
						zr + sz * (bord_tremie + Kit.RAMPE_GC), y,
						"%s, tremie de rampe au niveau %d, cote %s" % [b.name, k, "sud" if sz < 0.0 else "facade"], false)
				if sz > 0.0:
					_pousse(b, Vector3(6.0, y, zr + sz * (bord_tremie + Kit.RAMPE_GC + 3.0)), Vector3(0, 0, -sz),
							zr + sz * (bord_tremie + Kit.RAMPE_GC), y,
							"%s, tremie de rampe au niveau %d, cote facade" % [b.name, k], true)
		var yt: float = sols[sols.size() - 1]
		# TOIT : couloir de la volée A, et bout ouest de la trémie de rampe (aucune rampe ne part du toit)
		_pousse(b, Vector3(-5.05, yt, 8.1), Vector3(1, 0, 0), -4.54, yt, "%s, couloir de la volee A au toit" % b.name, false)
		var bt := Kit.rampe_bouts(float(sols[sols.size() - 1]) - float(sols[sols.size() - 2]))
		_pousse(b, Vector3(bt.x - 2.0, yt, zr), Vector3(1, 0, 0), bt.x - Kit.RAMPE_JEU - Kit.RAMPE_GC, yt,
				"%s, bout ouest de la tremie de rampe au toit" % b.name, true)
		# PARAPETS DE LA RAMPE, des deux côtés, à mi-pente de la rampe du rez : piéton ET voiture
		var h0: float = float(sols[1]) - float(sols[0])
		var b0 := Kit.rampe_bouts(h0)
		var y_mi: float = float(sols[0]) + Kit.rampe_hauteur(0.0, b0, h0)
		for sz2: float in [-1.0, 1.0]:
			var cote := "sud" if sz2 < 0.0 else "facade"
			_pousse(b, Vector3(0.0, y_mi, zr - sz2 * 1.0), Vector3(0, 0, sz2), zr + sz2 * bord, y_mi,
					"%s, parapet de la rampe du rez, cote %s (de cote)" % [b.name, cote], false)
			# la voiture ne peut pas se mettre en travers (4,2 m de long pour 3,5 m de voie) : elle MONTE la rampe,
			# braquée de 20° vers le parapet, comme une sortie de route
			# les deux voitures d'essai démarrent à 6 m l'une de l'autre : au même point, elles se catapultent
			_pousse_oblique(b, Vector3(sz2 * 3.0, float(sols[0]) + Kit.rampe_hauteur(sz2 * 3.0, b0, h0), zr), sz2, zr + sz2 * bord,
					"%s, parapet de la rampe du rez, cote %s (voiture en biais)" % [b.name, cote])


# `voiture` : au lieu du piéton, une VRAIE voiture poussée au même endroit (4 m/s, conduite comme par le joueur).
func _pousse(b: Node3D, local: Vector3, dir: Vector3, limite: float, plancher: float, libelle: String, voiture: bool) -> void:
	if not voiture:
		var corps := _pieton(b.global_transform * (local + Vector3(0, 1.0, 0)))
		_pousses.append([corps, b, dir, limite, plancher, libelle + " (pieton)", false, false])
		return
	var car := _voiture(b.global_transform * (local + Vector3(0, 0.9, 0)), libelle)
	car.call("start_drive")
	car.global_rotation = Vector3(0, b.global_rotation.y + atan2(-dir.x, -dir.z), 0)
	_pousses.append([car, b, dir, limite, plancher, libelle + " (voiture)", true, false])


# Voiture lancée DANS la voie de la rampe, braquée de 20° vers le parapet de `sz` : la seule façon de la pousser
# contre un parapet, une voiture de 4,2 m ne tenant pas en travers d'une voie de 3,5 m. Le plancher attendu est
# alors celui de la rampe à l'abscisse où elle finit, d'où le drapeau `rampe`.
func _pousse_oblique(b: Node3D, local: Vector3, sz: float, limite: float, libelle: String) -> void:
	var car := _voiture(b.global_transform * (local + Vector3(0, 0.9, 0)), libelle)
	car.call("start_drive")
	car.global_rotation = Vector3(0, b.global_rotation.y + atan2(-1.0, 0.0) - sz * deg_to_rad(20.0), 0)
	_pousses.append([car, b, Vector3(0, 0, sz), limite, 0.0, libelle, true, true])


func _garde_corps(delta: float) -> void:
	_t_pousse += delta
	for e: Array in _pousses:
		var corps: CharacterBody3D = e[0]
		var b: Node3D = e[1]
		if bool(e[6]):
			# voiture : on pousse comme le joueur, l'accélérateur au plancher dans son cap
			corps.set("_drive_speed", 4.0)
			continue
		var v: Vector3 = b.global_transform.basis * ((e[2] as Vector3) * 3.0)
		corps.velocity.x = v.x
		corps.velocity.z = v.z
		corps.velocity.y = 0.0 if corps.is_on_floor() else corps.velocity.y - GRAVITE * delta
		corps.move_and_slide()
	if _t_pousse < 3.0:
		return
	var arretes := 0
	var pietons := 0
	var voitures := 0
	for e: Array in _pousses:
		var corps: CharacterBody3D = e[0]
		var b: Node3D = e[1]
		var local := b.global_transform.affine_inverse() * corps.global_position
		var dir: Vector3 = e[2]
		var limite: float = e[3]
		var est_voiture := bool(e[6])
		if est_voiture:
			voitures += 1
		else:
			pietons += 1
		# le CENTRE du corps doit rester du côté d'où il vient : il est plus large que le garde-corps est épais
		var axe := 0 if absf(dir.x) > 0.5 else 2
		var pos: float = local.x if axe == 0 else local.z
		var sens: float = dir.x if axe == 0 else dir.z
		var franchi := pos < limite - 0.05 if sens < 0.0 else pos > limite + 0.05
		var repos: float = _repos_voiture if est_voiture else 0.9
		var pied := local.y - repos
		var tolerance := 0.15
		if bool(e[7]):
			# sur la rampe : le plancher attendu est celui de la voie à l'abscisse où le corps a fini, et la boîte de
			# collision restant horizontale sur la pente, l'origine monte d'une demi-longueur x pente (0,34 m)
			var sols2: PackedFloat32Array = Kit.planchers((b.get_node("Mesh") as MeshInstance3D).mesh if b.has_node("Mesh") else (b as MeshInstance3D).mesh)
			var h2: float = float(sols2[1]) - float(sols2[0])
			e[4] = float(sols2[0]) + Kit.rampe_hauteur(local.x, Kit.rampe_bouts(h2), h2)
			tolerance = 0.5
		if franchi or absf(pied - float(e[4])) > tolerance:
			_fautes.append("garde-corps %s : centre a %.2f (limite %.2f), pied a %.2f pour %.2f, fini en (%.2f, %.2f, %.2f) du modele"
					% [e[5], pos, limite, pied, e[4], local.x, local.y, local.z])
		else:
			arretes += 1
		corps.queue_free()
	print("PARKING_GARDE_CORPS %d pousses contre les garde-corps (%d pietons a 3 m/s, %d voitures a 4 m/s) : %d arretes du bon cote, debout sur leur plancher"
			% [_pousses.size(), pietons, voitures, arretes])
	_pousses.clear()
	_debut_barre()


# --- 4c. barre de hauteur ---------------------------------------------------------------------------------------------

var _barres: Array = []     # [voiture, libellé, doit passer ?]
var _t_barre := 0.0


# --- 4b bis. éclairage intérieur --------------------------------------------------------------------------------------

const LUM_TETES := ["res://scenes/world/map/generated/places/parking_lights.tres",
		"res://scenes/world/downtown/generated/parking_lights.tres"]
const LUM_DEGAGEMENT := 2.90     # sous un luminaire de la partie roulante
const LUM_CAGE_Z := 7.0          # au-delà (repère du modèle), on est dans la cage d'escalier : piétons seulement


func _lumieres() -> void:
	var noeuds := find_children("ParkingLumieres", "MeshInstance3D", true, false)
	if noeuds.size() != _parkings.size():
		_fautes.append("eclairage : %d maillage(s) de lumieres pour %d parking(s)" % [noeuds.size(), _parkings.size()])
	var materiaux := {}
	var triangles := 0
	for n in noeuds:
		var mi := n as MeshInstance3D
		if mi.mesh == null or mi.mesh.get_surface_count() == 0:
			_fautes.append("eclairage : %s sans maillage" % mi.name)
			continue
		triangles += mi.mesh.surface_get_array_index_len(0) / 3
		var mat := mi.mesh.surface_get_material(0)
		materiaux[mat.resource_path if mat != null else "?"] = true
		if not mi.visible:
			_fautes.append("eclairage : %s invisible (un parking est sombre de jour aussi)" % mi.name)
	if materiaux.size() != 1:
		_fautes.append("eclairage : %d materiaux au lieu d'un seul partage (%s)" % [materiaux.size(), str(materiaux.keys())])
	var tetes := PackedVector3Array()
	for chemin: String in LUM_TETES:
		if not ResourceLoader.exists(chemin):
			_fautes.append("eclairage : %s absent, cuisson a relancer" % chemin)
			continue
		tetes.append_array((load(chemin) as MapLampHeads).heads)
	if tetes.size() != _parkings.size() * 48:
		_fautes.append("eclairage : %d luminaire(s) au lieu de %d" % [tetes.size(), _parkings.size() * 48])
	# un luminaire par niveau couvert, et le dégagement sous ceux de la partie roulante
	var espace := get_world_3d().direct_space_state
	var pire := 99.0
	var pire_ou := ""
	var par_niveau := {}
	for t: Vector3 in tetes:
		var proche: Array = _parkings[0]
		for e: Array in _parkings:
			if (e[0] as Node3D).global_position.distance_to(t) < (proche[0] as Node3D).global_position.distance_to(t):
				proche = e
		var b: Node3D = proche[0]
		var sols: PackedFloat32Array = proche[2]
		var local := b.global_transform.affine_inverse() * t
		for k in sols.size() - 1:
			if local.y > float(sols[k]) and local.y <= float(sols[k + 1]) + 0.2:
				par_niveau["%s|%d" % [b.name, k]] = int(par_niveau.get("%s|%d" % [b.name, k], 0)) + 1
		if local.z > LUM_CAGE_Z:
			continue     # cage d'escalier ou auvent : aucune voiture n'y passe
		var q := PhysicsRayQueryParameters3D.create(t, t - Vector3(0, 6.0, 0), 1)
		var hit := espace.intersect_ray(q)
		if hit.is_empty():
			continue     # rien dessous à 6 m : bandeau au-dessus d'une trémie ouverte, pas un obstacle
		var libre: float = t.y - float((hit["position"] as Vector3).y)
		if libre < pire:
			pire = libre
			pire_ou = "%s a (%.1f, %.1f, %.1f) du modele" % [b.name, local.x, local.y, local.z]
	for e: Array in _parkings:
		var sols: PackedFloat32Array = e[2]
		for k in sols.size() - 1:
			if not par_niveau.has("%s|%d" % [(e[0] as Node3D).name, k]):
				_fautes.append("eclairage : %s niveau %d sans aucun luminaire" % [(e[0] as Node3D).name, k])
	if pire < LUM_DEGAGEMENT:
		_fautes.append("eclairage : %.2f m seulement sous un luminaire de la partie roulante (%s)" % [pire, pire_ou])
	print("PARKING_LUMIERES %d maillage(s), %d triangles, %d materiau(x) partage(s), %d luminaires ; degagement le plus faible sous un luminaire roulant %.2f m (%s)"
			% [noeuds.size(), triangles, materiaux.size(), tetes.size(), pire, pire_ou])


# --- 4b ter. places marquées ------------------------------------------------------------------------------------------

const PL_JSON := ["res://scenes/world/map/generated/places/places.json",
		"res://scenes/world/downtown/generated/parked_parkings.json"]
const PL_DEMI_X := 1.15          # demi-largeur d'une voiture du parc, plus un peu
const PL_DEMI_Z := 2.10          # demi-longueur
const PL_LIBRE := 2.00           # hauteur libre exigée au-dessus d'une place


func _places() -> void:
	var espace := get_world_3d().direct_space_state
	var total := 0
	var pire := 0.0
	var pire_ou := ""
	var bas := 99.0
	var bas_ou := ""
	for e: Array in _parkings:
		var b: Node3D = e[0]
		var sols: PackedFloat32Array = e[2]
		var maillage: Mesh = e[1]
		for pl: Dictionary in Kit.places(sols, Kit.Maillage.depuis(maillage)):
			total += 1
			var c: Vector3 = pl["centre"]
			var sol: float = (b.global_transform * c).y
			for d: Vector3 in [Vector3.ZERO, Vector3(PL_DEMI_X, 0, PL_DEMI_Z), Vector3(-PL_DEMI_X, 0, PL_DEMI_Z),
					Vector3(PL_DEMI_X, 0, -PL_DEMI_Z), Vector3(-PL_DEMI_X, 0, -PL_DEMI_Z)]:
				var p := b.global_transform * (c + d + Vector3(0, 1.0, 0))
				var hit := espace.intersect_ray(PhysicsRayQueryParameters3D.create(p, p - Vector3(0, 1.6, 0), 1))
				var ecart := 9.0 if hit.is_empty() else absf(float((hit["position"] as Vector3).y) - sol)
				if ecart > pire:
					pire = ecart
					pire_ou = "%s niveau %d, place x %.1f" % [b.name, int(pl["niveau"]), c.x]
			var p0 := b.global_transform * (c + Vector3(0, 0.15, 0))
			var haut := espace.intersect_ray(PhysicsRayQueryParameters3D.create(p0, p0 + Vector3(0, PL_LIBRE, 0), 1))
			var libre: float = PL_LIBRE if haut.is_empty() else float((haut["position"] as Vector3).y) - sol
			if libre < bas:
				bas = libre
				bas_ou = "%s niveau %d, place x %.1f" % [b.name, int(pl["niveau"]), c.x]
	if pire > 0.05:
		_fautes.append("places marquees : %.2f m d'ecart au plancher sous une place (%s)" % [pire, pire_ou])
	if bas < PL_LIBRE:
		_fautes.append("places marquees : %.2f m libres seulement au-dessus d'une place (%s)" % [bas, bas_ou])
	# les fiches de véhicules garés tombent-elles sur une place ?
	var hors := 0
	var fiches := 0
	for chemin: String in PL_JSON:
		if not FileAccess.file_exists(chemin):
			_fautes.append("places marquees : %s absent" % chemin)
			continue
		var data = JSON.parse_string(FileAccess.get_file_as_string(chemin))
		if typeof(data) != TYPE_DICTIONARY or not data.has("parked"):
			continue
		for f: Dictionary in data["parked"]:
			var pos: Array = f["pos"]
			var monde := Vector3(float(pos[0]), float(pos[1]), float(pos[2]))
			for e2: Array in _parkings:
				var b2: Node3D = e2[0]
				var local := b2.global_transform.affine_inverse() * monde
				if absf(local.x) > 24.5 or absf(local.z) > 12.5 or local.y < -1.0 or local.y > 20.0:
					continue
				fiches += 1
				if absf(local.z - (Kit.PL_Z - Kit.PL_PROF * 0.5)) > 0.6 or absf(local.x) < 5.5 or absf(local.x) > 20.2:
					hors += 1
	if hors > 0:
		_fautes.append("places marquees : %d vehicule(s) gare(s) hors d'une place" % hors)
	print("PARKING_PLACES %d places sur les %d parkings, ecart au plancher %.3f m au pire (%s), hauteur libre %.2f m au plus bas (%s) ; %d vehicules gares, %d hors place"
			% [total, _parkings.size(), pire, pire_ou, bas, bas_ou, fiches, hors])


func _debut_barre() -> void:
	if _aeroport == null:
		_debut_rampe_int()
		return
	_phase = "barre"
	_t_barre = 0.0
	var sols: PackedFloat32Array = Kit.planchers(_aeroport.mesh)
	for e: Array in [["city_truck_01", -2.0, false], ["city_sedan_01", 2.0, true]]:
		var data = load(CATALOGUE.path_join(String(e[0]) + ".tres"))
		var car := CAR.instantiate() as Node3D
		car.set("forced_model_path", String(data.model_paths[0]))
		car.set("is_player_owned", true)
		car.name = "Barre_" + String(e[0])
		add_child(car)
		car.global_position = _aeroport.global_transform * Vector3(float(e[1]), float(sols[0]) + 0.9, 20.0)
		var vers := _aeroport.global_transform.basis * Vector3(0, 0, -1)   # vers l'intérieur du parking
		car.global_rotation = Vector3(0, atan2(-vers.x, -vers.z), 0)
		car.call("start_drive")
		_barres.append([car, String(e[0]), bool(e[2])])


func _barre(delta: float) -> void:
	_t_barre += delta
	for e: Array in _barres:
		(e[0] as Node).set("_drive_speed", 4.0)
	if _t_barre < 6.0:
		return
	for e: Array in _barres:
		var car: Node3D = e[0]
		var local := _aeroport.global_transform.affine_inverse() * car.global_position
		var passe := local.z < Kit.BARRE_Z.x
		print("PARKING_BARRE %s (%.2f m de haut) : %s, fini a z %.2f du modele (portique a z %.2f, barre a %.2f m)"
				% [e[1], (car.call("boite_caisse") as AABB).size.y, "ENTRE" if passe else "arrete dehors",
				local.z, Kit.BARRE_Z.x, Kit.BARRE_HAUTEUR])
		if passe != bool(e[2]):
			_fautes.append("barre de hauteur : %s %s (z %.2f)" % [e[1], "est passe alors qu'il ne devrait pas" if passe else "n'est pas entre", local.z])
		car.queue_free()
	_barres.clear()
	_debut_rampe_int()


# --- 5. rampes intérieures --------------------------------------------------------------------------------------------

const RAMPE_RU := 4.7          # rayon des demi-tours aux deux bouts (option A, choisie par le joueur)
const RAMPE_RECUL := 0.5       # ligne droite entre la fin d'un demi-tour et le pied (ou le haut) de la rampe


func _debut_rampe_int() -> void:
	if _aeroport == null:
		_bilan()
		return
	_pente_rampe_int()
	_phase = "rampe_int"
	_sens = "montee"
	_pilote.set("is_player_owned", true)   # sinon stop_drive() l'efface 25 s après la sortie du joueur
	_preparer_trace(_trace_montee())
	if _joueur != null:
		_joueur.call("_enter_vehicle", _pilote)


func _preparer_trace(pts: PackedVector3Array) -> void:
	_trace = pts
	_k_trace = 0
	_t_rampe_int = 0.0
	_immobile = 0.0
	var d := _trace[1] - _trace[0]
	_pilote.set("_drive_speed", 0.0)
	_pilote.set("velocity", Vector3.ZERO)
	_pilote.global_position = _trace[0] + Vector3(0, 0.8, 0)
	_pilote.global_rotation = Vector3(0, atan2(-d.x, -d.z), 0)


# Trace de la montée, repère du modèle puis monde : allée de retour côté façade, demi-tour au bout ouest, rampe vers
# +x, demi-tour au bout est sur le plancher du dessus, et de nouveau, jusqu'au toit.
func _trace_montee() -> PackedVector3Array:
	var sols: PackedFloat32Array = Kit.planchers(_aeroport.mesh)
	var zr: float = Kit.RAMPE_Z
	var za := zr + 2.0 * RAMPE_RU
	var zc := zr + RAMPE_RU
	var pts: Array = [Vector3(10.0, sols[0], za), Vector3(4.0, sols[0], za)]
	for k in sols.size() - 1:
		var y0: float = sols[k]
		var h: float = sols[k + 1] - y0
		var b := Kit.rampe_bouts(h)
		var xo := b.x - RAMPE_RECUL
		var xe := b.y + RAMPE_RECUL
		var x := float(pts[pts.size() - 1].x) - 6.0
		while x > xo:
			pts.append(Vector3(x, y0, za))
			x -= 6.0
		for t in range(0, 181, 10):
			var a := deg_to_rad(float(t))
			pts.append(Vector3(xo - RAMPE_RU * sin(a), y0, zc + RAMPE_RU * cos(a)))
		var xr := xo + 1.0
		while xr < xe:
			pts.append(Vector3(xr, y0 + Kit.rampe_hauteur(xr, b, h), zr))
			xr += 1.5
		for t in range(0, 181, 10):
			var a := deg_to_rad(float(t))
			pts.append(Vector3(xe + RAMPE_RU * sin(a), sols[k + 1], zc - RAMPE_RU * cos(a)))
	var yt: float = sols[sols.size() - 1]
	pts.append(Vector3(6.0, yt, za))
	pts.append(Vector3(0.0, yt, za))
	return _monde(pts)


# Trace de la descente : la même, à l'envers.
func _trace_descente() -> PackedVector3Array:
	var m := _trace_montee()
	var out := PackedVector3Array()
	for i2 in range(m.size() - 1, -1, -1):
		out.append(m[i2])
	return out


func _monde(pts: Array) -> PackedVector3Array:
	var out := PackedVector3Array()
	for q: Vector3 in pts:
		out.append(_aeroport.global_transform * q)
	return out


# Conduite comme au clavier : poursuite du tracé à 4 m devant, direction par move_left / move_right (force
# proportionnelle à l'angle), accélérateur par move_forward autour de 4,5 m/s.
func _rampe_int(delta: float) -> void:
	_t_rampe_int += delta
	var pos := _pilote.global_position
	# repère le plus proche en avant
	var meilleur := _k_trace
	var d_min := INF
	for k in range(_k_trace, mini(_k_trace + 12, _trace.size())):
		var dd := Vector2(_trace[k].x - pos.x, _trace[k].z - pos.z).length()
		if dd < d_min:
			d_min = dd
			meilleur = k
	_k_trace = meilleur
	var cible := _trace[_trace.size() - 1]
	var cumul := 0.0
	for k in range(_k_trace, _trace.size() - 1):
		cumul += Vector2(_trace[k + 1].x - _trace[k].x, _trace[k + 1].z - _trace[k].z).length()
		if cumul >= 4.0:
			cible = _trace[k + 1]
			break
	var f := -_pilote.global_transform.basis.z
	var t := Vector3(cible.x - pos.x, 0, cible.z - pos.z).normalized()
	var angle := atan2(f.z * t.x - f.x * t.z, f.x * t.x + f.z * t.z)
	var braquage := clampf(angle * 2.5, -1.0, 1.0)
	Input.action_release("move_left")
	Input.action_release("move_right")
	if braquage > 0.02:
		Input.action_press("move_left", braquage)
	elif braquage < -0.02:
		Input.action_press("move_right", -braquage)
	var v: float = _pilote.get("_drive_speed")
	if v < 4.5:
		Input.action_press("move_forward")
	else:
		Input.action_release("move_forward")
	_immobile = _immobile + delta if absf(v) < 0.3 else 0.0
	# arrivée : au bout du tracé ET près de son dernier point (en plan, le départ au rez et l'arrivée au niveau 1
	# ne sont qu'à 2 m l'un de l'autre)
	var arrivee := _k_trace >= _trace.size() - 3 and (_trace[_trace.size() - 1] - pos).length() < 2.5
	if arrivee or _immobile > 4.0 or _t_rampe_int > 150.0:
		Input.action_release("move_forward")
		Input.action_release("move_left")
		Input.action_release("move_right")
		_rampe_int_bilan[_sens] = {"arrivee": arrivee, "temps": _t_rampe_int, "pos": pos, "immobile": _immobile > 4.0, "repere": _k_trace, "reperes": _trace.size()}
		if _joueur != null:
			_joueur.call("_exit_vehicle")
		_phase = "sortie"
		_t_sortie = 0.0


# Le joueur vient de sortir de la voiture : on le laisse retomber, puis on relève où il se tient. Plancher attendu :
# le TOIT au bout de la montée, le rez au bout de la descente.
func _sortie(delta: float) -> void:
	_t_sortie += delta
	if _t_sortie < 1.5:
		return
	if _joueur != null:
		var sols: PackedFloat32Array = Kit.planchers(_aeroport.mesh)
		var attendu := (_aeroport.global_transform * Vector3(0, sols[sols.size() - 1] if _sens == "montee" else sols[0], 0)).y
		_rampe_int_bilan[_sens]["sortie"] = [_joueur.global_position.y - 0.9, attendu, _joueur.is_on_floor()]
	if _sens == "montee":
		_sens = "descente"
		_preparer_trace(_trace_descente())
		if _joueur != null:
			_joueur.call("_enter_vehicle", _pilote)
		_phase = "rampe_int"
	else:
		_bilan()


# Pente et ressauts des rampes, relevés sur la COLLISION : rayons verticaux tous les 0,25 m sur l'axe de la voie et
# ses deux bords (0,3 m en dedans des parapets), sur les quatre rampes.
func _pente_rampe_int() -> void:
	var espace := get_world_3d().direct_space_state
	var sols: PackedFloat32Array = Kit.planchers(_aeroport.mesh)
	var demi: float = Kit.RAMPE_DEMI - Kit.RAMPE_GC - 0.3
	var pire := 0.0
	var pire_ou := ""
	var saut := 0.0
	var releves := 0
	for k in sols.size() - 1:
		var y0: float = sols[k]
		var h: float = sols[k + 1] - y0
		var b := Kit.rampe_bouts(h)
		for dz: float in [-demi, 0.0, demi]:
			var prec := Vector3.INF
			var x := b.x + 0.2
			while x < b.y - 0.2:
				var haut := _aeroport.global_transform * Vector3(x, y0 + Kit.rampe_hauteur(x, b, h) + 0.6, Kit.RAMPE_Z + dz)
				var q := PhysicsRayQueryParameters3D.create(haut, haut - Vector3(0, 1.2, 0), 1)
				var hit := espace.intersect_ray(q)
				if not hit.is_empty():
					var pos: Vector3 = hit["position"]
					releves += 1
					if prec != Vector3.INF:
						var dy := absf(pos.y - prec.y)
						var dxz := Vector2(pos.x - prec.x, pos.z - prec.z).length()
						if dxz > 0.01 and dy / dxz > pire:
							pire = dy / dxz
							pire_ou = "rampe %d, a %.1f m de l'axe, x %.1f" % [k, dz, x]
						saut = maxf(saut, dy - 0.25 * Kit.RAMPE_PENTE)
					prec = pos
				x += 0.25
	print("PARKING_RAMPE_INT pente relevee sur la collision des 4 rampes (%d releves) : %.1f %% au pire (%s) ; plus grand ecart d'un releve au suivant au-dela de la pente : %.3f m"
			% [releves, pire * 100.0, pire_ou, saut])
	if pire > Kit.RAMPE_PENTE + 0.005:
		_fautes.append("rampe interieure : pente de %.1f %% (%s)" % [pire * 100.0, pire_ou])
	if saut > 0.02:
		_fautes.append("rampe interieure : ressaut de %.3f m dans la voie" % saut)
	if releves < 1000:
		_fautes.append("rampe interieure : %d releves seulement, la collision de la voie n'est pas la" % releves)


# À mi-pente : assiette du modèle et écart du bas de chaque roue à la pente.
func _releve_roues() -> Dictionary:
	var pire := 0.0
	var ecarts := PackedStringArray()
	for w: Node3D in _pilote.get("_wheels"):
		var bas := INF
		var xz := Vector2.ZERO
		var meshes := w.find_children("*", "MeshInstance3D", true, false)
		if w is MeshInstance3D:
			meshes.append(w)
		for mi_n in meshes:
			var mi := mi_n as MeshInstance3D
			if mi.mesh == null:
				continue
			for s in mi.mesh.get_surface_count():
				for v: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
					var g := mi.global_transform * v
					if g.y < bas:
						bas = g.y
						xz = Vector2(g.x, g.z)
		var ecart := bas - _hauteur_rampe(xz.y)
		pire = maxf(pire, absf(ecart))
		ecarts.append("%s %+.3f" % [w.name, ecart])
	var modele: Node3D = _pilote.get("_model")
	var nez := (modele.global_transform * Vector3(0, 0.5, 2.0)).y - (modele.global_transform * Vector3(0, 0.5, -2.0)).y
	var out := {"pire": pire, "ecarts": ", ".join(ecarts), "pente": rad_to_deg(float(_pilote.get("_pente"))), "nez_moins_arriere": nez}
	# même relevé SANS l'assiette (le comportement d'avant) : la physique est la même, seul le modèle change
	var pente: float = _pilote.get("_pente")
	_pilote.set("_pente", 0.0)
	_pilote.call("_update_visuals", 0.0, 0.0, 0.0)
	var sans := 0.0
	for w: Node3D in _pilote.get("_wheels"):
		var bas := INF
		var xz := Vector2.ZERO
		var meshes := w.find_children("*", "MeshInstance3D", true, false)
		if w is MeshInstance3D:
			meshes.append(w)
		for mi_n in meshes:
			var mi := mi_n as MeshInstance3D
			for s in mi.mesh.get_surface_count():
				for v: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
					var g := mi.global_transform * v
					if g.y < bas:
						bas = g.y
						xz = Vector2(g.x, g.z)
		sans = maxf(sans, bas - _hauteur_rampe(xz.y))
	out["sans_assiette"] = sans
	_pilote.set("_pente", pente)
	_pilote.call("_update_visuals", 0.0, 0.0, 0.0)
	return out


func _bilan_dalles() -> void:
	_repos_voiture = _temoin.global_position.y
	var pire_pieton := 0.0
	for e: Array in _pietons:
		var corps: CharacterBody3D = e[0]
		var pied := corps.global_position.y - 0.9
		var ecart := absf(pied - float(e[1]))
		pire_pieton = maxf(pire_pieton, ecart)
		if not corps.is_on_floor() or ecart > 0.05:
			_fautes.append("pieton %s : pied a %.2f m pour un plancher a %.2f (%s)" % [e[2], pied, e[1], "au sol" if corps.is_on_floor() else "EN L'AIR"])
	var pire_voiture := 0.0
	for e: Array in _voitures:
		var car: Node3D = e[0]
		var ecart := absf(car.global_position.y - float(e[1]) - _repos_voiture)
		pire_voiture = maxf(pire_voiture, ecart)
		if ecart > 0.05:
			_fautes.append("voiture %s : origine a %.2f m pour un plancher a %.2f (repos %.2f)" % [e[2], car.global_position.y, e[1], _repos_voiture])
	print("PARKING_DALLES %d pietons et %d voitures poses sur les plateaux : ecart au plancher %.3f m au pire (pietons), %.3f m (voitures)"
			% [_pietons.size(), _voitures.size(), pire_pieton, pire_voiture])


func _bilan() -> void:
	set_physics_process(false)
	for sens in ["montee", "descente"]:
		if not _rampe_int_bilan.has(sens):
			continue
		var h: Dictionary = _rampe_int_bilan[sens]
		var p: Vector3 = h["pos"]
		var local := _aeroport.global_transform.affine_inverse() * p
		print("PARKING_RAMPE_INT %s : %s en %.1f s (repere %d/%d), arrivee en (%.1f, %.2f, %.1f) monde, hauteur %.2f m dans le repere du parking"
				% [sens, "ARRIVEE" if h["arrivee"] else ("IMMOBILE" if h["immobile"] else "TEMPS DEPASSE"), h["temps"], h["repere"], h["reperes"], p.x, p.y, p.z, local.y])
		if not h["arrivee"]:
			_fautes.append("rampe interieure, %s : la voiture n'est pas arrivee (repere %d/%d)" % [sens, h["repere"], h["reperes"]])
		if not h.has("sortie"):
			_fautes.append("rampe interieure, %s : pas de vrai joueur au volant" % sens)
		else:
			var so: Array = h["sortie"]
			print("PARKING_RAMPE_INT %s : le joueur sort de la voiture, pied a %.2f m pour un sol a %.2f (%s)"
					% [sens, so[0], so[1], "au sol" if so[2] else "EN L'AIR"])
			if absf(float(so[0]) - float(so[1])) > 0.1 or not so[2]:
				_fautes.append("rampe interieure, %s : a la sortie de la voiture, pied a %.2f m pour un sol a %.2f" % [sens, so[0], so[1]])
	var a_lat: float = _pilote.get("BRAQUAGE_A_LAT")
	var bas := {}
	for r: Array in _rayons:
		var mesure: float = r[2]
		var attendu: float = r[3]
		print("PARKING_BRAQUAGE %-22s empattement %.2f m, %2.0f m/s : rayon mesure %6.2f m, attendu %6.2f m, acceleration laterale %.1f m/s2"
				% [r[0], r[4], r[1], mesure, attendu, float(r[1]) * float(r[1]) / mesure])
		if absf(mesure - attendu) > maxf(0.35, 0.03 * attendu):
			_fautes.append("rayon de braquage de %s a %.0f m/s : %.2f m mesures pour %.2f attendus" % [r[0], r[1], mesure, attendu])
		if float(r[1]) * float(r[1]) / mesure > a_lat * 1.05:
			_fautes.append("%s a %.0f m/s : acceleration laterale %.1f m/s2 au-dela de %.1f" % [r[0], r[1], float(r[1]) * float(r[1]) / mesure, a_lat])
		if float(r[1]) < 4.0:
			bas[r[0]] = mesure
	# à basse vitesse le rayon suit le modèle : berline ~4 m (origine de la voiture ; ~5,3 m entre murs), camion et bus
	# au-delà de 9 m ; et à 16 m/s, tous au rayon de l'accélération latérale plafonnée
	if float(bas.get("berline city_sedan_01", 99.0)) > 4.6 or float(bas.get("city_truck_01", 0.0)) < 8.5 or float(bas.get("city_bus_01", 0.0)) < 8.5:
		_fautes.append("braquage a 3 m/s : berline %.2f m (attendu ~4,1), camion %.2f m et bus %.2f m (attendus > 8,5)"
				% [bas.get("berline city_sedan_01", -1.0), bas.get("city_truck_01", -1.0), bas.get("city_bus_01", -1.0)])
	if _rampe_mi.is_empty():
		_fautes.append("rampe a 12 pour cent : la voiture n'a jamais atteint le milieu de la pente (y max %.2f)" % _rampe_y_max)
	else:
		print("PARKING_RAMPE a mi-pente : assiette %.2f deg (pente %.2f deg), nez %+.3f m au-dessus de l'arriere, roues : %s"
				% [_rampe_mi["pente"], rad_to_deg(atan(PENTE)), _rampe_mi["nez_moins_arriere"], _rampe_mi["ecarts"]])
		print("PARKING_RAMPE sans l'assiette (le comportement d'avant, meme physique) : la roue la plus haute flottait a %.3f m de la pente" % _rampe_mi["sans_assiette"])
		if float(_rampe_mi["pire"]) > 0.08:
			_fautes.append("rampe a 12 pour cent : une roue a %.3f m de la pente" % _rampe_mi["pire"])
		if absf(float(_rampe_mi["pente"]) - rad_to_deg(atan(PENTE))) > 0.8 or float(_rampe_mi["nez_moins_arriere"]) <= 0.0:
			_fautes.append("rampe a 12 pour cent : assiette %.2f deg, nez %+.3f m (le nez doit etre plus haut en montee)" % [_rampe_mi["pente"], _rampe_mi["nez_moins_arriere"]])
	print("PARKING_RAMPE montee jusqu'en haut en %.1f s, redescente en marche arriere en %.1f s (y max %.2f m pour un palier a %.2f)"
			% [_rampe_haut, _rampe_bas - _rampe_haut if _rampe_bas > 0.0 else -1.0, _rampe_y_max, PENTE * RAMPE_LONG])
	if _rampe_haut < 0.0:
		_fautes.append("rampe a 12 pour cent : la voiture n'est jamais arrivee en haut")
	if _rampe_bas < 0.0:
		_fautes.append("rampe a 12 pour cent : la voiture n'est jamais redescendue")
	if _fautes.is_empty():
		print("PARKING_STRUCTURE_RESULT OK")
	else:
		for f in _fautes.slice(0, 30):
			print("PARKING_STRUCTURE_FAUTE %s" % f)
		print("PARKING_STRUCTURE_RESULT FAIL %d faute(s)" % _fautes.size())
	get_tree().quit()
