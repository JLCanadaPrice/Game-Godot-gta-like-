extends Node3D

# LES ROUES ROULENT À L'ENDROIT, sur TOUS les modèles du catalogue (2026-09-21).
#
# Le joueur voyait les roues « tourner vers le haut au lieu de rouler vers l'avant », sur toutes les
# voitures. Trois causes, mesurées sur les 72 modèles posés comme en jeu :
#  - sur les six modèles d'origine du jeu (normalcar1, normalcar2, sportscar, sportscar2, suv, taxi),
#    18 roues roulaient VRAIMENT à l'envers : leur X local pointe vers +X de la voiture, pas -X ;
#  - la roue avant droite de normalcar2 a son pivot à 0,32 m de son centre : elle tournait en excentrique ;
#  - partout ailleurs, le sens était juste, mais à la vitesse de croisière le pas par image dépassait la
#    demi-période de la jante (38° par image pour une jante octogonale de 45°) : l'oeil voyait la roue
#    reculer. C'est l'effet stroboscopique, et c'est lui que le joueur voyait sur « toutes » les voitures.
# Car._mesurer_roue donne maintenant à chaque roue son axe, son sens, son rayon réel, son centre et un pas
# maximal par image AFFICHÉE. Ce test pose une VRAIE Car de chaque modèle et vérifie, roue par roue, avec le
# vrai _update_visuals :
#  1. l'axe de roulement est l'essieu (le X de la voiture) ;
#  2. une vitesse POSITIVE fait avancer le HAUT du pneu vers l'avant de la voiture (-Z) ;
#  3. le rayon est plausible (0,15 à 0,8 m : le blindé SWAT porte des roues de 0,72 m, mesurées) ;
#  4. à 12 m/s et 60 images/s, le pas par image reste sous la moitié de la période de la jante ;
#  5. la roue tourne autour de SON CENTRE : le milieu de ses maillages ne bouge pas (normalcar2 avait une
#     roue au pivot décalé, qui tournait en excentrique) ;
#  6. IMAGE LENTE : à 15 images/s, quatre pas physiques de 1/60 s s'enchaînent entre deux images affichées
#     (_update_visuals tourne dans _physics_process). Leur somme reste sous la demi-période de la jante et
#     dans le bon sens, et l'image suivante tourne de nouveau — l'UHD 750 de référence rend entre 10 et 30
#     images/s, c'est là que l'effet stroboscopique reviendrait si le plafond valait par pas physique ;
#  7. BRAQUAGE (2026-09-21) : roues avant braquées à fond, à gauche puis à droite, à trois angles de roulement
#     différents. L'axe du moyeu tourne dans le plan HORIZONTAL (carrossage nul : le pneu reste vertical), de
#     l'angle de braquage exact, du bon côté (+1 = à gauche), et le centre de la roue ne bouge pas ; les roues
#     arrière ne bougent pas. Les 54 modèles city_* s'inclinaient de 29,8° au lieu de pivoter : leur braquage
#     était exprimé dans le repère du parent de la roue, tourné de 90° autour de X ;
#  8. CIRCULATION : le braquage visuel d'une voiture de la circulation est l'angle géométrique du virage
#     qu'elle décrit, atan(empattement / rayon), du bon côté, et nul en ligne droite.
#  9. RAYON DE BRAQUAGE PAR MODÈLE (2026-09-22) : calculé sur l'empattement et la voie MESURÉS de chaque modèle
#     (modèle bicyclette, Car.angle_braquage) et relevé par famille. Rayon « entre murs » (roue avant extérieure,
#     braquage à fond) de 5 à 6,5 m pour une berline, plus grand pour les camions, et le plus grand pour le bus et
#     l'autocar ; à basse vitesse, braquage à fond ; à vitesse, l'accélération latérale ne dépasse jamais
#     BRAQUAGE_A_LAT (le braquage se réduit), et l'angle ne fait que décroître avec la vitesse.
#
# Lancer : Godot --headless --path <projet> res://scenes/tests/WheelSpinTest.tscn

const CAR := preload("res://scenes/vehicles/Car.tscn")
const CATALOGUE := "res://resources/vehicle_models"
const V_PAS := 1.0             # m/s pour le contrôle de sens : un petit pas, sans ambiguïté
const DT := 0.05
const V_CROISIERE := 12.0      # m/s, vitesse de la circulation (CarSpawner)
const IMAGE := 1.0 / 60.0
const PAS_PAR_IMAGE_LENTE := 4 # pas physiques entre deux images affichées, à 15 images/s

var _fautes: Array[String] = []


func _ready() -> void:
	var d := DirAccess.open(CATALOGUE)
	var fichiers := Array(d.get_files()).filter(func(f): return f.ends_with(".tres"))
	fichiers.sort()
	var voitures: Array = []
	var k := 0
	for f: String in fichiers:
		var data = load(CATALOGUE.path_join(f))
		if data == null or data.model_paths.is_empty():
			continue
		var car := CAR.instantiate() as Node3D
		car.set("forced_model_path", String(data.model_paths[0]))
		add_child(car)
		car.global_position = Vector3(float(k) * 12.0, 200.0, 0.0)
		k += 1
		voitures.append([f.get_basename(), car])
	await get_tree().process_frame
	await get_tree().process_frame
	var roues_total := 0
	var pire_pivot := 0.0
	var pire_pivot_ou := ""
	var excentrees := PackedStringArray()
	var par_symetrie := {}
	var rayons := Vector2(INF, -INF)
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		car.set_physics_process(false)
		var roues: Array = car.get("_wheels")
		if roues.is_empty():
			_fautes.append("%s : aucune roue repérée" % nom)
			continue
		var inv_car := car.global_transform.affine_inverse()
		# sommet de chaque pneu, AVANT le pas
		var hauts := {}
		var centres := {}
		for w: Node3D in roues:
			hauts[w] = _sommet(w)
			centres[w] = _centre(w)
		car.call("_update_visuals", DT, V_PAS, 0.0)
		for w: Node3D in roues:
			roues_total += 1
			var m: Array = car.call("mesure_roue", w)
			if m.size() < 4:
				_fautes.append("%s / %s : aucune mesure de roue" % [nom, w.name])
				continue
			var axe: Vector3 = m[0]
			var rayon: float = m[1]
			var pas_max: float = m[2]
			var n_sym: int = m[3]
			# écart entre l'origine du noeud et le centre de la roue, DANS LE PLAN DE LA ROUE (l'écart le long de
			# l'essieu est sans effet), en mètres dans le repère de la voiture : c'est le rayon du cercle que la
			# roue décrivait quand elle tournait autour de l'origine de son noeud
			var ecart := inv_car.basis * w.global_transform.basis * (m[4] as Vector3)
			var ecart_pivot := Vector2(ecart.y, ecart.z).length()
			if ecart_pivot > 0.01:
				excentrees.append("%s/%s %.2f m" % [nom, w.name, ecart_pivot])
			if ecart_pivot > pire_pivot:
				pire_pivot = ecart_pivot
				pire_pivot_ou = "%s / %s" % [nom, w.name]
			par_symetrie[n_sym] = int(par_symetrie.get(n_sym, 0)) + 1
			if n_sym < 5:
				print("WHEEL_SPIN_DETAIL %s / %s : %d branches seulement, rayon %.3f m" % [nom, w.name, n_sym, rayon])
			rayons = Vector2(minf(rayons.x, rayon), maxf(rayons.y, rayon))
			# 1. essieu : l'axe de roulement, vu de la voiture, est latéral
			var b := inv_car.basis * w.global_transform.basis
			if absf((b * axe).normalized().x) < 0.9:
				_fautes.append("%s / %s : axe de roulement pas latéral (%s dans le repère de la voiture)" % [nom, w.name, str((b * axe).normalized())])
			# 2. sens : le haut du pneu va vers l'avant (-Z de la voiture)
			var avant: Array = hauts[w]
			var apres: Vector3 = w.global_transform * (avant[1] as Vector3)
			var depl := inv_car.basis * (apres - (avant[0] as Vector3))
			if depl.z >= 0.0:
				_fautes.append("%s / %s : le haut du pneu RECULE quand la voiture avance (%+.4f m vers l'avant)" % [nom, w.name, -depl.z])
			# 5. rotation autour du centre de la roue : son milieu ne bouge pas
			var derive := (_centre(w) - (centres[w] as Vector3)).length()
			if derive > 0.005:
				_fautes.append("%s / %s : la roue tourne en EXCENTRIQUE, son centre se deplace de %.3f m" % [nom, w.name, derive])
			# 3. rayon plausible
			if rayon < 0.15 or rayon > 0.8:
				_fautes.append("%s / %s : rayon %.3f m hors de 0,15 - 0,8 m" % [nom, w.name, rayon])
			# 4. stroboscope : à la vitesse de croisière, le pas par image reste sous la demi-période
			if n_sym > 1:
				var pas := minf(V_CROISIERE / rayon * IMAGE, pas_max)
				if pas >= PI / float(n_sym):
					_fautes.append("%s / %s : %.1f° par image à 12 m/s pour une jante de %d branches (demi-période %.1f°) : la roue paraîtrait reculer"
							% [nom, w.name, rad_to_deg(pas), n_sym, 180.0 / float(n_sym)])
	# 6. image lente : plusieurs pas physiques dans la MÊME image affichée
	await get_tree().process_frame
	var lentes := 0
	var pire_lente := 0.0
	var angles_avant := {}
	for pair: Array in voitures:
		var car: Node3D = pair[1]
		var ang: Dictionary = car.get("_wheel_angle")
		for w: Node3D in car.get("_wheels"):
			angles_avant[w] = float(ang.get(w, 0.0))
		for i in PAS_PAR_IMAGE_LENTE:
			car.call("_update_visuals", IMAGE, V_CROISIERE, 0.0)
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		var ang: Dictionary = car.get("_wheel_angle")
		for w: Node3D in car.get("_wheels"):
			var m: Array = car.call("mesure_roue", w)
			if m.size() < 4 or int(m[3]) <= 1:
				continue
			var tour := wrapf(float(ang[w]) - float(angles_avant[w]), -PI, PI)
			var demi := PI / float(m[3])
			lentes += 1
			pire_lente = maxf(pire_lente, tour / demi)
			if tour <= 0.0 or tour >= demi:
				_fautes.append("%s / %s : %.1f° entre deux images a 15 images/s pour une jante de %d branches (demi-periode %.1f°)"
						% [nom, w.name, rad_to_deg(tour), int(m[3]), rad_to_deg(demi)])
	# ... et l'image suivante roule de nouveau : le plafond vaut par image, il ne bloque pas la roue
	await get_tree().process_frame
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		var ang: Dictionary = car.get("_wheel_angle")
		var avant := {}
		for w: Node3D in car.get("_wheels"):
			avant[w] = float(ang.get(w, 0.0))
		car.call("_update_visuals", IMAGE, V_CROISIERE, 0.0)
		for w: Node3D in car.get("_wheels"):
			if wrapf(float(ang[w]) - float(avant[w]), -PI, PI) <= 0.0:
				_fautes.append("%s / %s : la roue ne tourne plus a l'image suivante" % [nom, w.name])
	print("WHEEL_SPIN_IMAGE_LENTE %d roues a 15 images/s (%d pas physiques par image) : pas le plus grand %.0f %% de la demi-periode de sa jante"
			% [lentes, PAS_PAR_IMAGE_LENTE, pire_lente * 100.0])
	# 7. braquage : roues avant braquées à fond, des deux côtés, à trois angles de roulement
	await get_tree().process_frame
	var max_steer: float = (voitures[0][1] as Node3D).get("MAX_STEER_RAD")
	var braquages := 0
	var pire_carrossage := 0.0
	var pire_carrossage_ou := ""
	var pire_ecart := 0.0
	var pire_ecart_ou := ""
	var pire_centre := 0.0
	var empattements := Vector2(INF, -INF)
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		var inv_car := car.global_transform.affine_inverse()
		var roues: Array = car.get("_wheels")
		var avant: Array = car.get("_wheels_front")
		var ang: Dictionary = car.get("_wheel_angle")
		var emp: float = car.get("_empattement")
		empattements = Vector2(minf(empattements.x, emp), maxf(empattements.y, emp))
		for roulement in [0.0, 1.1, 2.3]:
			for w: Node3D in roues:
				ang[w] = roulement
			for cote in [1.0, -1.0]:
				car.call("_update_visuals", 1.0, 0.0, 0.0)
				var moyeux0 := {}
				var centres0 := {}
				for w: Node3D in roues:
					moyeux0[w] = _moyeu(car, inv_car, w)
					centres0[w] = _pivot(car, w)
				car.call("_update_visuals", 1.0, 0.0, cote)
				for w: Node3D in roues:
					var a0: Vector3 = moyeux0[w]
					var a1: Vector3 = _moyeu(car, inv_car, w)
					var derive := (_pivot(car, w) - (centres0[w] as Vector3)).length()
					pire_centre = maxf(pire_centre, derive)
					if derive > 0.005:
						_fautes.append("%s / %s : le centre de la roue se deplace de %.3f m quand on braque" % [nom, w.name, derive])
					if not (w in avant):
						if a0.angle_to(a1) > deg_to_rad(0.1):
							_fautes.append("%s / %s : une roue ARRIERE bouge quand on braque (%.1f deg)" % [nom, w.name, rad_to_deg(a0.angle_to(a1))])
						continue
					braquages += 1
					var carrossage := rad_to_deg(asin(clampf(absf(a1.y), 0.0, 1.0)))
					if carrossage > pire_carrossage:
						pire_carrossage = carrossage
						pire_carrossage_ou = "%s / %s" % [nom, w.name]
					if carrossage > 0.5:
						_fautes.append("%s / %s : braquee a %s, le moyeu penche de %.1f deg (carrossage) au lieu de rester horizontal"
								% [nom, w.name, "gauche" if cote > 0.0 else "droite", carrossage])
					# angle signé autour de +Y : positif = le nez de la roue part à gauche
					var lacet := atan2(a0.cross(a1).y, a0.dot(a1))
					var ecart := absf(rad_to_deg(lacet - cote * max_steer))
					if ecart > pire_ecart:
						pire_ecart = ecart
						pire_ecart_ou = "%s / %s" % [nom, w.name]
					if ecart > 1.0:
						_fautes.append("%s / %s : braquee a %s, la roue pivote de %+.1f deg autour de la verticale au lieu de %+.1f"
								% [nom, w.name, "gauche" if cote > 0.0 else "droite", rad_to_deg(lacet), rad_to_deg(cote * max_steer)])
		car.call("_update_visuals", 1.0, 0.0, 0.0)
	print("WHEEL_SPIN_BRAQUAGE %d braquages de roue avant (gauche et droite, 3 angles de roulement) : carrossage max %.2f deg (%s), ecart a l'angle de braquage max %.2f deg (%s, attendu %.1f deg), centre deplace de %.1f mm au plus"
			% [braquages, pire_carrossage, pire_carrossage_ou, pire_ecart, pire_ecart_ou, rad_to_deg(max_steer), pire_centre * 1000.0])
	# 8. circulation : virage à gauche de 10 m de rayon à 10 m/s (1 rad/s), à droite, puis ligne droite
	var braq_min := INF
	var braq_max := -INF
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		var emp: float = car.get("_empattement")
		car.set("_ai_speed", 10.0)
		var dcap := rad_to_deg(1.0 * IMAGE)
		var g: float = car.call("_braquage_ia", dcap, IMAGE)
		var dr: float = car.call("_braquage_ia", -dcap, IMAGE)
		var droit: float = car.call("_braquage_ia", 0.0, IMAGE)
		var attendu := atan(emp / 10.0) / max_steer
		braq_min = minf(braq_min, rad_to_deg(g * max_steer))
		braq_max = maxf(braq_max, rad_to_deg(g * max_steer))
		if absf(g - attendu) > 0.01 or absf(dr + attendu) > 0.01 or absf(droit) > 1e-6:
			_fautes.append("%s : braquage de la circulation %.3f / %.3f / %.3f au lieu de %.3f / %.3f / 0 (gauche, droite, ligne droite)"
					% [nom, g, dr, droit, attendu, -attendu])
		car.set("_ai_speed", 0.0)
	print("WHEEL_SPIN_CIRCULATION empattements mesures %.2f a %.2f m ; virage a gauche de 10 m de rayon : roues avant a %.1f a %.1f deg a gauche selon l'empattement"
			% [empattements.x, empattements.y, braq_min, braq_max])
	_rayons_par_famille(voitures)
	var sym := PackedStringArray()
	var cles := par_symetrie.keys()
	cles.sort()
	for c in cles:
		sym.append("%d branches : %d" % [c, par_symetrie[c]])
	print("WHEEL_SPIN %d modeles, %d roues, rayons %.3f a %.3f m, symetries { %s }, pivot le plus decale %.3f m (%s)"
			% [voitures.size(), roues_total, rayons.x, rayons.y, ", ".join(sym), pire_pivot, pire_pivot_ou])
	print("WHEEL_SPIN_PIVOTS %d roue(s) au pivot hors du centre (> 1 cm dans le plan de la roue), toutes corrigees : %s"
			% [excentrees.size(), ", ".join(excentrees)])
	if _fautes.is_empty():
		print("WHEEL_SPIN_RESULT OK")
	else:
		for f in _fautes.slice(0, 40):
			print("WHEEL_SPIN_FAUTE %s" % f)
		print("WHEEL_SPIN_RESULT FAIL %d faute(s)" % _fautes.size())
	get_tree().quit(0)


# Axe du moyeu d'une roue, dans le repère de la voiture : son axe de roulement mesuré (Car.mesure_roue).
# 9. rayon de braquage de chaque modèle, par famille
# Familles d'après le nom du modèle, corrigé par la TAILLE mesurée : normalcar2 (empattement 2,00 m) est une citadine,
# pas une berline ; la balayeuse de voirie (1,77 m) est un engin compact, pas un camion.
const FAMILLES := [
	["bus et autocar", ["city_bus", "city_coach"]],
	["balayeuse compacte", ["city_sweeper"]],
	["camion", ["city_truck", "city_garbage", "city_firetruck", "city_utility", "city_police_truck", "city_swat"]],
	["fourgon", ["city_minivan", "city_van", "city_police_van", "city_emergency_van", "city_icecream", "city_news_van", "lowpoly_van", "city_stepvan", "city_mail", "city_ambulance"]],
	["suv et pick-up", ["city_suv", "city_police_suv", "city_pickup", "lowpoly_jeep", "lowpoly_armor", "suv"]],
	["limousine", ["city_limousine"]],
	["berline", ["city_sedan", "city_taxi", "city_police_sedan", "normalcar1", "taxi"]],
	["coupe, sport, citadine", ["city_coupe", "city_sports", "city_muscle", "city_retro", "city_hotrod", "city_microcar", "lowpoly_", "sportscar", "normalcar2"]],
]


func _famille(nom: String) -> String:
	for f: Array in FAMILLES:
		for prefixe: String in f[1]:
			if nom.begins_with(prefixe):
				return f[0]
	return "?"


func _rayons_par_famille(voitures: Array) -> void:
	var a_lat: float = CAR.instantiate().get("BRAQUAGE_A_LAT") if false else 15.0
	var par := {}
	for pair: Array in voitures:
		var nom: String = pair[0]
		var car: Node3D = pair[1]
		a_lat = float(car.get("BRAQUAGE_A_LAT"))
		var fam := _famille(nom)
		var murs: float = car.call("rayon_entre_murs")
		var r0: float = car.call("rayon_braquage", 0.0)
		var emp: float = car.get("_empattement")
		var voie: float = car.get("_voie")
		var e: Array = par.get(fam, [INF, -INF, "", "", 0])
		if murs < float(e[0]):
			e[0] = murs
			e[2] = nom
		if murs > float(e[1]):
			e[1] = murs
			e[3] = nom
		e[4] = int(e[4]) + 1
		par[fam] = e
		var caisse := Vector3.ZERO
		var cs := car.get_node_or_null("CollisionShape3D") as CollisionShape3D
		if cs != null and cs.shape is BoxShape3D:
			caisse = (cs.shape as BoxShape3D).size
		print("WHEEL_SPIN_RAYON_DETAIL %-22s %-24s empattement %.2f m, voie %.2f m : entre murs %.2f m, origine %.2f m ; caisse %.2f x %.2f x %.2f m"
				% [fam, nom, emp, voie, murs, r0, caisse.z, caisse.x, caisse.y])
		if fam == "?":
			_fautes.append("%s : famille inconnue pour le controle du rayon de braquage" % nom)
		# basse vitesse : braquage à fond ; vitesse : accélération latérale plafonnée, angle décroissant
		var max_steer: float = car.get("MAX_STEER_RAD")
		if absf(float(car.call("angle_braquage", 2.0)) - max_steer) > 1e-4:
			_fautes.append("%s : a 2 m/s le braquage n'est pas a fond (%.1f deg)" % [nom, rad_to_deg(float(car.call("angle_braquage", 2.0)))])
		var prec := INF
		for v in [2.0, 6.0, 10.0, 14.0, 18.0, 24.0]:
			var ang: float = car.call("angle_braquage", v)
			var r: float = car.call("rayon_braquage", v)
			if ang > prec + 1e-6:
				_fautes.append("%s : le braquage CROIT avec la vitesse a %.0f m/s" % [nom, v])
			prec = ang
			if v * v / r > a_lat + 0.01:
				_fautes.append("%s : a %.0f m/s, acceleration laterale %.1f m/s2 au-dela de %.1f" % [nom, v, v * v / r, a_lat])
	for f: Array in FAMILLES:
		if not par.has(f[0]):
			continue
		var e: Array = par[f[0]]
		print("WHEEL_SPIN_RAYON %-22s %2d modele(s) : rayon entre murs %.2f m (%s) a %.2f m (%s)" % [f[0], e[4], e[0], e[2], e[1], e[3]])
	var bornes := {"berline": Vector2(5.0, 6.5), "bus et autocar": Vector2(9.0, 16.0)}
	for fam: String in bornes:
		if not par.has(fam):
			_fautes.append("aucun modele de la famille %s" % fam)
			continue
		var b: Vector2 = bornes[fam]
		var e: Array = par[fam]
		if float(e[0]) < b.x or float(e[1]) > b.y:
			_fautes.append("%s : rayon entre murs de %.2f a %.2f m, hors de %.1f .. %.1f m" % [fam, e[0], e[1], b.x, b.y])
	for fam in ["camion", "bus et autocar"]:
		if par.has(fam) and par.has("berline") and float(par[fam][0]) <= float(par["berline"][1]):
			_fautes.append("%s : le plus petit rayon (%.2f m) n'est pas plus grand que celui des berlines (%.2f m)" % [fam, par[fam][0], par["berline"][1]])


func _moyeu(car: Node3D, inv_car: Transform3D, w: Node3D) -> Vector3:
	var m: Array = car.call("mesure_roue", w)
	var axe: Vector3 = m[0] if m.size() > 0 else Vector3.RIGHT
	return (inv_car.basis * w.global_transform.basis * axe).normalized()


# Centre de la roue dans le monde : son centre LOCAL mesuré (Car.mesure_roue, milieu de la boîte locale de ses
# maillages), ramené dans le monde. C'est le point autour duquel elle braque, et il doit rester fixe. Le milieu de
# la boîte MONDE (_centre) ne convient pas ici : une roue asymétrique le long de son essieu (moyeu saillant d'un
# seul côté, les six modèles d'origine) voit ce milieu glisser de 14 à 18 mm dès qu'elle pivote, même autour d'un
# axe parfait — c'était l'instrument qui bougeait, pas la roue.
func _pivot(car: Node3D, w: Node3D) -> Vector3:
	var m: Array = car.call("mesure_roue", w)
	var c: Vector3 = m[4] if m.size() > 4 else Vector3.ZERO
	return w.global_transform * c


# Milieu de la boîte monde des maillages d'une roue.
func _centre(w: Node3D) -> Vector3:
	var lo := Vector3(INF, INF, INF)
	var hi := Vector3(-INF, -INF, -INF)
	var meshes := w.find_children("*", "MeshInstance3D", true, false)
	if w is MeshInstance3D:
		meshes.append(w)
	for mi_n in meshes:
		var mi := mi_n as MeshInstance3D
		if mi.mesh == null:
			continue
		for s in mi.mesh.get_surface_count():
			for v: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
				var g := mi.global_transform * v
				lo = lo.min(g)
				hi = hi.max(g)
	return (lo + hi) * 0.5


# Sommet du pneu dans le monde, et le même point dans le repère LOCAL de la roue : [monde, local].
func _sommet(w: Node3D) -> Array:
	var haut := Vector3(0, -INF, 0)
	var meshes := w.find_children("*", "MeshInstance3D", true, false)
	if w is MeshInstance3D:
		meshes.append(w)
	for mi_n in meshes:
		var mi := mi_n as MeshInstance3D
		if mi.mesh == null:
			continue
		for s in mi.mesh.get_surface_count():
			for v: Vector3 in mi.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
				var g := mi.global_transform * v
				if g.y > haut.y:
					haut = g
	return [haut, w.global_transform.affine_inverse() * haut]
