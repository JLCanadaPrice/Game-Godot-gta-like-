ContactsManager="*res://autoloads/ContactsManager.gd"
PhoneManager="*res://autoloads/PhoneManager.gd"
CarRegistry="*res://autoloads/CarRegistry.gd"
AgencyRegistry="*res://autoloads/AgencyRegistry.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

